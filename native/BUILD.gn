# Decoder source sets. Chromium integration evidence lives in VERIFICATION.md.
source_set("profile_wire") {
  sources = [
    "profile_wire.cc",
    "profile_wire.h",
    "wire_reader.h",
  ]
}

source_set("profile_catalog") {
  sources = [
    "profile_catalog.cc",
    "profile_catalog.h",
  ]
  public_deps = [ ":profile_wire" ]
}

# The pure pixel algorithm, on its own. It is a leaf: it includes nothing of
# ours and it is what the sampling layer needs, so the sampling layer does not
# have to reach through the injection state below.
source_set("canvas_noise_algorithm") {
  sources = [
    "canvas_noise.cc",
    "canvas_noise.h",
  ]
}

# The renderer-side injection state: the apply entry point, the fingerprint
# overrides and the font tables. It also reads the per-URL target table, which
# is why it depends on :fp_target; the sampling layer reaches this target's
# algorithm through :canvas_noise_algorithm instead, so the dependency graph
# stays acyclic.
source_set("canvas_noise") {
  sources = [
    "canvas_apply.cc",
    "canvas_apply.h",
    "fp_overrides.cc",
    "fp_overrides.h",
    "font_family_traits.cc",
    "font_family_traits.h",
    "font_metrics.cc",
    "font_metrics.h",
    "product_brand.h",
  ]
  public_deps = [
    ":canvas_noise_algorithm",
    ":fp_target",
  ]
}

# L3 storage layer. Split into four source sets so each can be pulled in
# independently by the integration patches; see docs/cc-task-brief-l3.md.
source_set("storage_pin") {
  sources = [
    "storage_pin.cc",
    "storage_pin.h",
  ]
}

source_set("storage_consistency") {
  sources = [
    "storage_consistency.cc",
    "storage_consistency.h",
  ]
}

source_set("cache_record") {
  sources = [
    "cache_record.cc",
    "cache_record.h",
  ]
}

source_set("extension_pin") {
  sources = [
    "extension_pin.cc",
    "extension_pin.h",
  ]
}

# Cookie side of the cross-store lock. It answers three questions from a
# frozen snapshot: what value a page reads, whether a write must be refused,
# and how a browser cookie line merges with the snapshot. The Blink wiring
# is a separate patch; this target is the decision logic on its own.
source_set("cookie_mirror") {
  sources = [
    "cookie_mirror.cc",
    "cookie_mirror.h",
  ]
  public_deps = [ ":storage_consistency" ]
}

# L3W1 document decoder: the single configuration entry point for the storage
# layer. It pulls the four primitives above into one target because the
# decoder's public header exposes all of them in L3Config; consumers only need
# this label.
source_set("l3_wire") {
  sources = [
    "l3_wire.cc",
    "l3_wire.h",
  ]
  public_deps = [
    ":cache_record",
    ":extension_pin",
    ":storage_consistency",
    ":storage_pin",
  ]
}

# Renderer-side query surface over a frozen snapshot. Blink calls this instead
# of parsing documents itself.
source_set("l3_runtime") {
  sources = [
    "l3_runtime.cc",
    "l3_runtime.h",
  ]
  public_deps = [ ":l3_wire" ]
}

# The kernel side of the runner <-> kernel pipe, in four layers. The split is
# by dependency, not by convenience: the frame codec and the JSON reader must
# be testable without a crypto library, so they are separate source sets.
#
#   kernel_pipe_frame      the 8-byte header and the frame codec
#   kernel_pipe_json       the shallow JSON reader
#   kernel_pipe_keys       the machine-code derivation (BoringSSL)
#   kernel_pipe_envelope   the KeyEnvelope (BoringSSL)
#   kernel_pipe            the handshake and the frozen config bundle
#
# All of them are pure logic - no Chromium types - so they compile standalone
# for the gtest targets as well.
source_set("kernel_pipe_frame") {
  sources = [
    "kernel_pipe_frame.cc",
    "kernel_pipe_frame.h",
  ]
}

source_set("kernel_pipe_json") {
  sources = [
    "kernel_pipe_json.cc",
    "kernel_pipe_json.h",
  ]
}

source_set("kernel_pipe_keys") {
  sources = [
    "kernel_pipe_keys.cc",
    "kernel_pipe_keys.h",
  ]
  public_deps = [ ":kernel_pipe_frame" ]
  deps = [ "//third_party/boringssl" ]
}

source_set("kernel_pipe_envelope") {
  sources = [
    "kernel_pipe_envelope.cc",
    "kernel_pipe_envelope.h",
  ]
  public_deps = [
    ":kernel_pipe_frame",
    ":kernel_pipe_keys",
  ]
  deps = [ "//third_party/boringssl" ]
}

source_set("kernel_pipe") {
  sources = [
    "kernel_pipe.cc",
    "kernel_pipe.h",
  ]
  public_deps = [
    ":kernel_pipe_envelope",
    ":kernel_pipe_frame",
    ":kernel_pipe_json",
    ":kernel_pipe_keys",
  ]
  deps = [ "//third_party/boringssl" ]
}

# The collection rules for the machine facts (task M0). The rules are pure:
# given the candidates, they say which one wins. That is what makes them
# testable without a machine, and it is why the collector that talks to the
# device lives in integration/kernel_pipe_client.cc instead of here.
source_set("machine_facts") {
  sources = [
    "machine_facts.cc",
    "machine_facts.h",
  ]
}

# The uplink action table: an action name and the structural validator for its
# payload. One table, no new interface per action.
source_set("action_table") {
  sources = [
    "action_table.cc",
    "action_table.h",
  ]
  public_deps = [ ":kernel_pipe_json" ]
}

# The collection rules for the profile upload (task R). The kernel side
# owns which files are collected; the client side packs and uploads them.
# The rules arrive in the ConfigBundle, so this target needs the JSON reader
# and nothing else - no crypto, no Chromium.
source_set("profile_bundle") {
  sources = [
    "profile_bundle.cc",
    "profile_bundle.h",
  ]
  public_deps = [ ":kernel_pipe_json" ]
}

# The L3E1 document envelope: an L3W1 document sealed under a 32-byte master
# key the caller supplies (task N). It is a layer of its own because the
# crypto is its own dependency: the file format, the KDF and the AEAD live
# here and nowhere else.
#
# The master key never comes from this target. It is the caller's, and the
# caller's key source is the runner handshake - see
# docs/l3-reports/task-N.md.
source_set("l3_envelope") {
  sources = [
    "l3_envelope.cc",
    "l3_envelope.h",
  ]
  deps = [ "//third_party/boringssl" ]
}

# The seam between the pipe's session key and the envelope: the key is
# supplied by the caller and from nowhere else. A separate target because it
# is a separate layer, and because l3_envelope.cc is already near the 700
# line hard limit.
source_set("l3_envelope_session") {
  sources = [
    "l3_envelope_session.cc",
    "l3_envelope_session.h",
  ]
  # The BoringSSL dependency comes with :l3_envelope - this layer calls into
  # it, it does not reach for the crypto itself.
  public_deps = [ ":l3_envelope" ]
}

# The response monitor's rules: what to watch, how much of it, and how to
# read the configuration that says so (task T1). Pure logic - no Chromium, no
# crypto - so it can be tested on its own.
source_set("resp_monitor_config") {
  sources = [
    "resp_monitor_config.cc",
    "resp_monitor_config.h",
  ]
  public_deps = [ ":kernel_pipe_json" ]
}

# The response monitor's body capture: a tee that copies the first bytes of a
# response without touching the response (task T1).
source_set("resp_monitor_body") {
  sources = [
    "resp_monitor_body.cc",
    "resp_monitor_body.h",
  ]
}

# The response monitor's fan-out tee (task 0017). It turns one body chunk
# into two copies - the page's, byte for byte, and the monitor's, bounded -
# and it is written here rather than taken from the tree's prefetch tee,
# which serves one target at a time and may drop the early bytes (see
# resp_tee.h). It depends on the capture it fills.
source_set("resp_tee") {
  sources = [
    "resp_tee.cc",
    "resp_tee.h",
  ]
  public_deps = [ ":resp_monitor_body" ]
}

# The response monitor's matching and counting: which response belongs to
# which rule, and how many times a rule may say something about one URL
# (task T1).
source_set("resp_monitor") {
  sources = [
    "resp_monitor.cc",
    "resp_monitor.h",
  ]
  public_deps = [
    ":kernel_pipe_json",
    ":resp_monitor_config",
  ]
}

# The response monitor's report: the JSON that goes out on the uplink
# (task T1). It names the uplink action, so it depends on the action table.
source_set("resp_monitor_report") {
  sources = [
    "resp_monitor_report.cc",
    "resp_monitor_report.h",
  ]
  public_deps = [ ":action_table" ]
}

# The access policy (task T2). Four layers, split by dependency:
#
#   policy_rules   the rules, and how to read them out of the ConfigBundle
#   policy_match   the two matchers: a glob for a host, a regex for a URL
#   policy_block   the decision: send the request or cancel it
#   policy_report  the uplink payload for a decision
#
# policy_rules needs the URL validator, which lives in policy_match, so the
# dependency runs the other way round from the naming. There is no cycle:
# the header does not include the other, only the .cc does.
source_set("policy_rules") {
  sources = [
    "policy_rules.cc",
    "policy_rules.h",
    "ptr_exclusion.h",
  ]
  public_deps = [ ":policy_match" ]
}

# The matchers. The host matcher reuses the profile sync rules' glob, so
# this target depends on the profile bundle rather than carrying a second
# glob.
source_set("policy_match") {
  sources = [
    "policy_match.cc",
    "policy_match.h",
  ]
  public_deps = [ ":profile_bundle" ]
}

source_set("policy_block") {
  sources = [
    "policy_block.cc",
    "policy_block.h",
    "ptr_exclusion.h",
  ]
  public_deps = [
    ":policy_match",
    ":policy_rules",
  ]
}

source_set("policy_report") {
  sources = [
    "policy_report.cc",
    "policy_report.h",
  ]
  public_deps = [
    ":action_table",
    ":policy_block",
  ]
}

# Fingerprint value governance (task T3). Three layers, each one a
# dependency of the next:
#
#   fp_sampling    the sampling geometry, the fingerprint hash and the
#                  deterministic perturbation
#   fp_converge    the hamming distance and the convergence verdict
#   fp_target      the table of target values and the URL targeting
#
# fp_sampling reuses the canvas noise the kernel already had, so it
# depends on :canvas_noise_algorithm and on nothing else. fp_target reads the
# ConfigBundle, so it depends on the JSON reader; the glob form of the
# URL selection reuses the profile layer's matcher, so it depends on
# :profile_bundle too.
source_set("fp_sampling") {
  sources = [
    "fp_sampling.cc",
    "fp_sampling.h",
  ]
  public_deps = [ ":canvas_noise_algorithm" ]
}

source_set("fp_converge") {
  sources = [
    "fp_converge.cc",
    "fp_converge.h",
  ]
  public_deps = [ ":fp_sampling" ]
}

source_set("fp_target") {
  sources = [
    "fp_target.cc",
    "fp_target.h",
    "fp_target_match.cc",
    "fp_target_match.h",
    "ptr_exclusion.h",
  ]
  public_deps = [
    ":fp_sampling",
    ":kernel_pipe_json",
    ":profile_bundle",
  ]
}

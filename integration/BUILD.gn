import("//testing/test.gni")

# Browser-only dependency. No chrome/browser dependency (avoids a cycle).
source_set("bootstrap") {
  sources = [
    "browser_bootstrap.cc",
    "browser_bootstrap.h",
    "l3_bootstrap.cc",
    "l3_bootstrap.h",
    "official_defaults.cc",
    "official_defaults.h",
    "profile_bootstrap_state.cc",
    "profile_bootstrap_state.h",
  ]
  public_deps = [
    "//base",
    "//lengsuo/native:profile_wire",
    "//lengsuo/native:profile_catalog",
    # L3BootstrapState decodes the L3W1 document, so the browser side needs
    # the decoder. Without this the linker reports undefined
    # lengsuo::L3BootstrapState::Initialize.
    "//lengsuo/native:l3_wire",
    "//ui/display",
  ]
  # The "common" group is required: :common_sources is visibility-restricted
  # to //content/*. The group resolves to //content only in component builds,
  # which would cycle through content/browser (0005); builds therefore pin
  # is_component_build=false in args.gn.
  deps = [
    "//third_party/icu",
    "//content/public/common",
    "//third_party/blink/public/common",
  ]
}

# Browser side of the L3 Mojo channel (task O): answers each renderer's
# GetDocument() from the snapshot :bootstrap froze at startup. No
# chrome/browser dependency, so chrome/browser may depend on it freely.
source_set("l3_provisioning") {
  sources = [
    "l3_provisioning_impl.cc",
    "l3_provisioning_impl.h",
  ]
  public_deps = [
    "//base",
    "//lengsuo/native:l3_wire",
    "//lengsuo/public/mojom:l3_provisioning_mojom",
    "//mojo/public/cpp/bindings",
  ]
  deps = [ ":bootstrap" ]
}

test("bootstrap_unittests") {
  testonly = true
  sources = [
    "browser_bootstrap_unittest.cc",
    "l3_provisioning_impl_test.cc",
    "official_defaults_unittest.cc",
    "policy_throttle_test.cc",
  ]
  deps = [
    ":bootstrap",
    ":l3_provisioning",
    ":policy_throttle",
    "//lengsuo/native:l3_runtime",
    "//base",
    "//testing/gtest",
    "//third_party/blink/public/common",
    "//content/public/common",
    "//ui/display",
    "//base/test:run_all_unittests",
    "//base/test:test_support",
  ]
}

# The browser's half of the runner <-> kernel pipe (task Q). It owns the
# endpoint, the handshake and the uplink queue; the pure half (frame codec,
# handshake state machine, config freeze) is in //lengsuo/native:kernel_pipe.
#
# No chrome/browser dependency, so chrome/browser may depend on it freely.
source_set("kernel_pipe_client") {
  sources = [
    "kernel_pipe_client.cc",
    "kernel_pipe_client.h",
  ]
  public_deps = [
    "//base",
    "//lengsuo/native:action_table",
    "//lengsuo/native:kernel_pipe",
    # The machine-fact collection rules (task M0): the platform tag and the
    # storage-serial selection are pure functions, so the collector in
    # kernel_pipe_client.cc only has to read the machine.
    "//lengsuo/native:machine_facts",
  ]
}

# The access policy on the request path (task 0018). The decision itself is
# the pure half inline in policy_throttle.h, so it is unit-tested without a
# Chromium type; the .cc is the URLLoaderThrottle that carries the decision
# out, which is why this target needs the request-path and the pipe headers.
#
# It sits in integration/ rather than native/ because that is where the file
# lands: //lengsuo/integration/policy_throttle.cc, and GN sources are resolved
# against their own BUILD.gn's directory (a `..` path is rejected outright).
source_set("policy_throttle") {
  sources = [
    "policy_throttle.cc",
    "policy_throttle.h",
  ]
  public_deps = [
    # policy_throttle.h includes the policy layers, so anything that includes
    # it - chrome/browser does - needs them too.
    "//lengsuo/native:policy_report",
  ]
  deps = [
    ":kernel_pipe_client",
    "//net",
    "//services/network/public/cpp",
    "//third_party/blink/public/common",
  ]
}

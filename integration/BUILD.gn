import("//testing/test.gni")

# Browser-only dependency. No chrome/browser dependency (avoids a cycle).
source_set("bootstrap") {
  sources = [
    "browser_bootstrap.cc",
    "browser_bootstrap.h",
    "profile_bootstrap_state.cc",
    "profile_bootstrap_state.h",
  ]
  public_deps = [
    "//base",
    "//lengsuo/native:profile_wire",
    "//lengsuo/native:profile_catalog",
    "//ui/display",
  ]
  # The "common" group is required: :common_sources is visibility-restricted
  # to //content/*. The group resolves to //content only in component builds,
  # which would cycle through content/browser (0005); builds therefore pin
  # is_component_build=false in args.gn.
  deps = [
    "//third_party/icu",
    "//content/public/common",
    "//third_party/blink/public/common",
  ]
}

test("bootstrap_unittests") {
  testonly = true
  sources = [ "browser_bootstrap_unittest.cc" ]
  deps = [
    ":bootstrap",
    "//base",
    "//testing/gtest",
    "//third_party/blink/public/common",
    "//content/public/common",
    "//ui/display",
    "//base/test:run_all_unittests",
    "//base/test:test_support",
  ]
}

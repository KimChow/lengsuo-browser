+  // The access policy: it decides a request before the request is sent. A
+  // ruled-out request is cancelled here, and every decision goes up the
+  // existing uplink as a PolicyEvent. CreatePolicyThrottle returns nullptr
+  // when no policy is configured or when none of its rules could ever match,
+  // so a switched-off policy costs nothing on the request path.
+  if (auto policy_throttle = lengsuo::CreatePolicyThrottle()) {
+    result.push_back(std::move(policy_throttle));
+  }
+
   return result;

diff --git a/lengsuo/integration/BUILD.gn b/lengsuo/integration/BUILD.gn
new file mode 100644
index 0000000..0ca8185
--- /dev/null
+++ b/lengsuo/integration/BUILD.gn
@@ -0,0 +1,89 @@
+import("//testing/test.gni")
+
+# Browser-only dependency. No chrome/browser dependency (avoids a cycle).
+source_set("bootstrap") {
+  sources = [
+    "browser_bootstrap.cc",
+    "browser_bootstrap.h",
+    "l3_bootstrap.cc",
+    "l3_bootstrap.h",
+    "official_defaults.cc",
+    "official_defaults.h",
+    "profile_bootstrap_state.cc",
+    "profile_bootstrap_state.h",
+  ]
+  public_deps = [
+    "//base",
+    "//lengsuo/native:profile_wire",
+    "//lengsuo/native:profile_catalog",
+    # L3BootstrapState decodes the L3W1 document, so the browser side needs
+    # the decoder. Without this the linker reports undefined
+    # lengsuo::L3BootstrapState::Initialize.
+    "//lengsuo/native:l3_wire",
+    "//ui/display",
+  ]
+  # The "common" group is required: :common_sources is visibility-restricted
+  # to //content/*. The group resolves to //content only in component builds,
+  # which would cycle through content/browser (0005); builds therefore pin
+  # is_component_build=false in args.gn.
+  deps = [
+    "//third_party/icu",
+    "//content/public/common",
+    "//third_party/blink/public/common",
+  ]
+}
+
+# Browser side of the L3 Mojo channel (task O): answers each renderer's
+# GetDocument() from the snapshot :bootstrap froze at startup. No
+# chrome/browser dependency, so chrome/browser may depend on it freely.
+source_set("l3_provisioning") {
+  sources = [
+    "l3_provisioning_impl.cc",
+    "l3_provisioning_impl.h",
+  ]
+  public_deps = [
+    "//base",
+    "//lengsuo/native:l3_wire",
+    "//lengsuo/public/mojom:l3_provisioning_mojom",
+    "//mojo/public/cpp/bindings",
+  ]
+  deps = [ ":bootstrap" ]
+}
+
+test("bootstrap_unittests") {
+  testonly = true
+  sources = [
+    "browser_bootstrap_unittest.cc",
+    "l3_provisioning_impl_test.cc",
+    "official_defaults_unittest.cc",
+  ]
+  deps = [
+    ":bootstrap",
+    ":l3_provisioning",
+    "//lengsuo/native:l3_runtime",
+    "//base",
+    "//testing/gtest",
+    "//third_party/blink/public/common",
+    "//content/public/common",
+    "//ui/display",
+    "//base/test:run_all_unittests",
+    "//base/test:test_support",
+  ]
+}
+
+# The browser's half of the runner <-> kernel pipe (task Q). It owns the
+# endpoint, the handshake and the uplink queue; the pure half (frame codec,
+# handshake state machine, config freeze) is in //lengsuo/native:kernel_pipe.
+#
+# No chrome/browser dependency, so chrome/browser may depend on it freely.
+source_set("kernel_pipe_client") {
+  sources = [
+    "kernel_pipe_client.cc",
+    "kernel_pipe_client.h",
+  ]
+  public_deps = [
+    "//base",
+    "//lengsuo/native:action_table",
+    "//lengsuo/native:kernel_pipe",
+  ]
+}
diff --git a/lengsuo/integration/browser_bootstrap.cc b/lengsuo/integration/browser_bootstrap.cc
new file mode 100644
index 0000000..53f118c
--- /dev/null
+++ b/lengsuo/integration/browser_bootstrap.cc
@@ -0,0 +1,231 @@
+#include "lengsuo/integration/browser_bootstrap.h"
+#include <string>
+#include <vector>
+#include "base/time/time.h"
+#include "lengsuo/integration/l3_bootstrap.h"
+#include "third_party/icu/source/i18n/unicode/timezone.h"
+#include "base/files/file_util.h"
+#include "base/no_destructor.h"
+// renderer_preferences.h pulls in the mojom WebRtcIpHandlingPolicy enum.
+#include "third_party/blink/public/common/renderer_preferences/renderer_preferences.h"
+#include "third_party/blink/public/common/web_preferences/web_preferences.h"
+#include "third_party/blink/public/common/user_agent/user_agent_metadata.h"
+#include "ui/display/screen_infos.h"
+#include "build/build_config.h"
+#if BUILDFLAG(IS_WIN)
+#include <windows.h>
+#endif
+namespace lengsuo {
+bool IsValidProfileTimezone(std::string_view zone) {
+  // Bounded ASCII-only token, then a real system zone through ICU canonical
+  // lookup. Unknown, non-system (e.g. format-only) and malformed IDs fail.
+  if (zone.empty() || zone.size() > 64) return false;
+  for (const char byte : zone) {
+    if (static_cast<unsigned char>(byte) < 33 ||
+        static_cast<unsigned char>(byte) > 126)
+      return false;
+  }
+  UErrorCode status = U_ZERO_ERROR;
+  UBool system = false;
+  icu::UnicodeString canonical;
+  icu::TimeZone::getCanonicalID(
+      icu::UnicodeString::fromUTF8(
+          icu::StringPiece(zone.data(), static_cast<int32_t>(zone.size()))),
+      canonical, system, status);
+  return U_SUCCESS(status) && system;
+}
+
+namespace {
+ProfileBootstrapState& State() {
+  static base::NoDestructor<ProfileBootstrapState> state;
+  return *state;
+}
+// The L3 document is larger than the profile wire (it carries pin, cookie and
+// rule tables), so it gets its own bounded reader. The limit matches
+// fp::kMaxL3WireBytes; anything longer is rejected rather than truncated.
+std::optional<std::string> ReadL3Wire(const base::FilePath& path) {
+  base::File::Info info;
+  if (base::IsLink(path) || !base::GetFileInfo(path, &info) || info.is_directory ||
+      info.is_symbolic_link || info.size < 1 ||
+      info.size > static_cast<int64_t>(fp::kMaxL3WireBytes))
+    return std::nullopt;
+  std::string bytes;
+  if (!base::ReadFileToStringWithMaxSize(path, &bytes, fp::kMaxL3WireBytes))
+    return std::nullopt;
+  return bytes;
+}
+
+L3BootstrapState& L3State() {
+  static base::NoDestructor<L3BootstrapState> state;
+  return *state;
+}
+
+std::optional<std::string> ReadWire(const base::FilePath& path) {
+  // Runner owns this local file and must prevent replacement/redirection.
+  // Bounded reads are not wall-clock timeouts or authorization checks.
+  base::File::Info info;
+  if (base::IsLink(path) || !base::GetFileInfo(path, &info) || info.is_directory ||
+      info.is_symbolic_link || info.size < 1 || info.size > 4096)
+    return std::nullopt;
+  std::string bytes;
+  if (!base::ReadFileToStringWithMaxSize(path, &bytes, 4096))
+    return std::nullopt;
+  return bytes;
+}
+}  // namespace
+bool IsManagedBrowserCommand(const base::CommandLine& command) {
+  return command.HasSwitch(kProfileWireSwitch) ||
+         command.HasSwitch(kCatalogWireSwitch);
+}
+bool IsSafeProfilePath(const base::FilePath& path) {
+  if (path.empty() || !path.IsAbsolute() || path.IsNetwork() ||
+      path.ReferencesParent()) return false;
+#if BUILDFLAG(IS_WIN)
+  // Reject UNC, device namespaces and mapped network drives. Only a local
+  // fixed drive is supported for this first Windows integration.
+  const auto& value = path.value();
+  if (value.size() < 3 || value[1] != L':' ||
+      (value[2] != L'\\' && value[2] != L'/')) return false;
+  std::wstring root = value.substr(0, 3);
+  if (::GetDriveTypeW(root.c_str()) != DRIVE_FIXED) return false;
+#endif
+  return true;
+}
+bool InitializeBrowserProfile(const base::CommandLine& command) {
+  const bool requested = command.HasSwitch(kProfileWireSwitch);
+  const auto path = command.GetSwitchValuePath(kProfileWireSwitch);
+  if (!State().Initialize(requested, IsSafeProfilePath(path),
+                          [&]() { return ReadWire(path); })) return false;
+  if (const auto* profile = BrowserProfile();
+      profile && !IsValidProfileTimezone(profile->timezone)) return false;
+  const auto catalog_path = command.GetSwitchValuePath(kCatalogWireSwitch);
+  return State().InitializeCatalog(command.HasSwitch(kCatalogWireSwitch),
+      IsSafeProfilePath(catalog_path), [&]() { return ReadWire(catalog_path); });
+}
+int64_t L3ClockUnixSeconds() {
+  // The L3W1 signature line carries "<md5>_v1_t<unix-seconds>", so the
+  // freshness window is only meaningful in Unix seconds.
+  //
+  // Do NOT use ToDeltaSinceWindowsEpoch() here: that counts from 1601-01-01
+  // and runs 11644473600 seconds ahead of Unix time, so every document would
+  // look older than the window and startup would abort with
+  // "Lengsuo L3 bootstrap rejected".
+  return static_cast<int64_t>(base::Time::Now().InSecondsFSinceUnixEpoch());
+}
+
+bool InitializeBrowserL3(const base::CommandLine& command) {
+  const bool requested = command.HasSwitch(kL3WireSwitch);
+  const auto path = command.GetSwitchValuePath(kL3WireSwitch);
+  // The anti-rollback window is checked against the browser's clock here, so
+  // the renderer never has to trust its own.
+  const int64_t now = L3ClockUnixSeconds();
+  if (!L3State().Initialize(requested, IsSafeProfilePath(path),
+                             [&]() { return ReadL3Wire(path); }, now,
+                             kL3MaxAgeSeconds)) {
+    return false;
+  }
+  return true;
+}
+
+const fp::L3Config* BrowserL3Config() { return L3State().config(); }
+
+const ParsedProfile* BrowserProfile() { return State().profile(); }
+const CatalogUaEntry* BrowserUa() { return State().ua(); }
+const CatalogGpuEntry* BrowserGpu() { return State().gpu(); }
+bool ApplyUaMetadata(const CatalogUaEntry& entry,
+                     blink::UserAgentMetadata* metadata) {
+  metadata->brand_version_list.clear();
+  for (const auto& brand : entry.brands)
+    metadata->brand_version_list.emplace_back(brand.name, brand.version);
+  metadata->brand_full_version_list.clear();
+  for (const auto& brand : entry.full_versions)
+    metadata->brand_full_version_list.emplace_back(brand.name, brand.version);
+  metadata->platform = entry.platform;
+  metadata->platform_version = entry.platform_version;
+  metadata->architecture = entry.architecture;
+  metadata->bitness = entry.bitness;
+  metadata->model = entry.model;
+  metadata->mobile = entry.mobile;
+  return true;
+}
+bool ApplyProfileTouchPreferences(blink::web_pref::WebPreferences* prefs) {
+  const auto* profile = BrowserProfile();
+  if (!profile) return false;
+  return ApplyTouchPreferences(*profile, prefs);
+}
+bool ApplyScreenInfos(const ParsedProfile& profile,
+                      display::ScreenInfos* infos) {
+  display::ScreenInfo info = infos->current();
+  // The wire stores DPR in milli-units; restore with exact integer math.
+  info.device_scale_factor =
+      static_cast<float>(profile.dpr_milli) / 1000.f;
+  // Single-device model: one screen sized exactly like the profile. The
+  // profile carries no work-area semantics, so available == full rect.
+  const gfx::Rect rect(0, 0, static_cast<int>(profile.width),
+                       static_cast<int>(profile.height));
+  info.rect = rect;
+  info.available_rect = rect;
+  info.depth = profile.color_depth;
+  *infos = display::ScreenInfos(info);
+  return true;
+}
+bool ApplyProfileScreenInfos(display::ScreenInfos* infos) {
+  const auto* profile = BrowserProfile();
+  if (!profile) return false;
+  return ApplyScreenInfos(*profile, infos);
+}
+bool ApplyWebRtcPolicy(const ParsedProfile& profile,
+                       blink::RendererPreferences* prefs) {
+  // Schema 1 statement (nullopt): upstream behavior stays untouched.
+  if (!profile.webrtc_policy) return false;
+  using blink::mojom::WebRtcIpHandlingPolicy;
+  WebRtcIpHandlingPolicy policy;
+  // Checked switch over the wire range 0..3; anything else is rejected
+  // here without mutating prefs (the wire decoder already gates this).
+  switch (*profile.webrtc_policy) {
+    case 0: policy = WebRtcIpHandlingPolicy::kDefault; break;
+    case 1: policy = WebRtcIpHandlingPolicy::kDefaultPublicAndPrivateInterfaces; break;
+    case 2: policy = WebRtcIpHandlingPolicy::kDefaultPublicInterfaceOnly; break;
+    case 3: policy = WebRtcIpHandlingPolicy::kDisableNonProxiedUdp; break;
+    default: return false;
+  }
+  const bool changed = prefs->webrtc_ip_handling_policy != policy ||
+                       !prefs->webrtc_ip_handling_urls.empty() ||
+                       !prefs->webrtc_local_ips_allowed_urls.empty();
+  // Explicit profile policy takes priority: per-origin overrides and the
+  // mDNS local-IP exemption list are cleared. UDP port range is retained.
+  prefs->webrtc_ip_handling_policy = policy;
+  prefs->webrtc_ip_handling_urls.clear();
+  prefs->webrtc_local_ips_allowed_urls.clear();
+  return changed;
+}
+bool ApplyProfileWebRtcPolicy(blink::RendererPreferences* prefs) {
+  const auto* profile = BrowserProfile();
+  if (!profile) return false;
+  return ApplyWebRtcPolicy(*profile, prefs);
+}
+bool ApplyTouchPreferences(const ParsedProfile& profile,
+                           blink::web_pref::WebPreferences* prefs) {
+  const bool touch = profile.max_touch_points != 0;
+  using blink::mojom::PointerType;
+  using blink::mojom::HoverType;
+  const auto pointer = touch ? PointerType::kPointerCoarseType
+                             : PointerType::kPointerFineType;
+  const auto hover = touch ? HoverType::kHoverNone : HoverType::kHoverHoverType;
+  const int pointers = static_cast<int>(pointer);
+  const int hovers = static_cast<int>(hover);
+  const bool changed =
+      prefs->pointer_events_max_touch_points != profile.max_touch_points ||
+      prefs->touch_event_feature_detection_enabled != touch ||
+      prefs->available_pointer_types != pointers ||
+      prefs->primary_pointer_type != pointer ||
+      prefs->available_hover_types != hovers || prefs->primary_hover_type != hover;
+  prefs->pointer_events_max_touch_points = profile.max_touch_points;
+  prefs->touch_event_feature_detection_enabled = touch;
+  prefs->available_pointer_types = pointers;
+  prefs->primary_pointer_type = pointer;
+  prefs->available_hover_types = hovers;
+  prefs->primary_hover_type = hover;
+  return changed;
+}
+}  // namespace lengsuo
diff --git a/lengsuo/integration/browser_bootstrap.h b/lengsuo/integration/browser_bootstrap.h
new file mode 100644
index 0000000..92fb14c
--- /dev/null
+++ b/lengsuo/integration/browser_bootstrap.h
@@ -0,0 +1,67 @@
+#ifndef LENGSUO_INTEGRATION_BROWSER_BOOTSTRAP_H_
+#define LENGSUO_INTEGRATION_BROWSER_BOOTSTRAP_H_
+#include <cstdint>
+#include <string_view>
+#include "base/command_line.h"
+#include "base/files/file_path.h"
+#include "lengsuo/integration/profile_bootstrap_state.h"
+namespace blink::web_pref { struct WebPreferences; }
+namespace display { struct ScreenInfos; }
+namespace blink { struct UserAgentMetadata; struct RendererPreferences; }
+namespace lengsuo {
+namespace fp { struct L3Config; }
+// ICU-recognized system zones only; does not override renderer timezone.
+bool IsValidProfileTimezone(std::string_view zone);
+inline constexpr char kProfileWireSwitch[] = "lengsuo-profile-wire";
+inline constexpr char kCatalogWireSwitch[] = "lengsuo-catalog-wire";
+// Managed L3 document (pins / extension whitelist / consistency rules).
+inline constexpr char kL3WireSwitch[] = "lengsuo-l3-wire";
+bool IsManagedBrowserCommand(const base::CommandLine& command);
+bool IsSafeProfilePath(const base::FilePath& path);
+// Called exactly once from BrowserMainParts before BrowserProcess creation.
+bool InitializeBrowserProfile(const base::CommandLine& command);
+const ParsedProfile* BrowserProfile();
+const CatalogUaEntry* BrowserUa();
+// GPU face for the active profile's gpu slot, or nullptr when the loaded
+// catalog carries no GPU section or has no matching entry (upstream faces
+// then stay untouched).
+const CatalogGpuEntry* BrowserGpu();
+// Loads the managed L3 document (l3_bootstrap.h) and freezes it. Returns
+// false when a document was requested but could not be loaded or verified;
+// the caller must abort startup rather than continue unpinned.
+bool InitializeBrowserL3(const base::CommandLine& command);
+// Current time in **Unix** seconds (since 1970-01-01), the unit the L3W1
+// signature line uses. Exposed so the unit test can pin the epoch: reading
+// base::Time::ToDeltaSinceWindowsEpoch() here would count from 1601 and
+// make every document look older than the freshness window.
+int64_t L3ClockUnixSeconds();
+// The frozen L3 snapshot, or nullptr when this session has no L3 statement.
+// Read-only and immutable after startup; the Mojo provisioning interface
+// re-serializes it for each renderer that asks.
+const fp::L3Config* BrowserL3Config();
+bool ApplyUaMetadata(const CatalogUaEntry& entry,
+                     blink::UserAgentMetadata* metadata);
+// Returns true only when preferences actually change.
+bool ApplyTouchPreferences(const ParsedProfile& profile,
+                           blink::web_pref::WebPreferences* prefs);
+bool ApplyProfileTouchPreferences(blink::web_pref::WebPreferences* prefs);
+// Replaces screen geometry/DPR/depth with the profile values.
+bool ApplyScreenInfos(const ParsedProfile& profile,
+                      display::ScreenInfos* infos);
+// Profile-aware wrapper; returns false (upstream untouched) when no
+// profile is loaded.
+bool ApplyProfileScreenInfos(display::ScreenInfos* infos);
+// In-memory helper only: applies ParsedProfile::webrtc_policy to
+// RendererPreferences. nullopt (schema 1) leaves everything untouched.
+// Explicit 0..3 maps by checked switch onto mojom WebRtcIpHandlingPolicy,
+// clears webrtc_ip_handling_urls and webrtc_local_ips_allowed_urls (the
+// profile policy takes priority over per-origin overrides and mDNS local-IP
+// exemptions) and retains webrtc_udp_min_port/max_port. Invalid in-memory
+// values are rejected without mutation. Returns true only on change.
+// Loading a schema 2 profile into the browser remains gated: startup still
+// rejects v2 until runtime/network acceptance is complete.
+bool ApplyWebRtcPolicy(const ParsedProfile& profile,
+                       blink::RendererPreferences* prefs);
+bool ApplyProfileWebRtcPolicy(blink::RendererPreferences* prefs);
+}  // namespace lengsuo
+#endif
diff --git a/lengsuo/integration/browser_bootstrap_unittest.cc b/lengsuo/integration/browser_bootstrap_unittest.cc
new file mode 100644
index 0000000..5737fd6
--- /dev/null
+++ b/lengsuo/integration/browser_bootstrap_unittest.cc
@@ -0,0 +1,374 @@
+// Requires Chromium base/gtest build; standalone tests live separately.
+#include "lengsuo/integration/browser_bootstrap.h"
+#include <ctime>
+#include "build/build_config.h"
+#include "components/content_settings/core/common/content_settings_pattern.h"
+#include "third_party/blink/public/common/peerconnection/webrtc_ip_handling_url_entry.h"
+#include "third_party/blink/public/common/renderer_preferences/renderer_preferences.h"
+#include "third_party/blink/public/common/web_preferences/web_preferences.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/display/screen_infos.h"
+#include "ui/gfx/geometry/rect.h"
+#include "third_party/blink/public/common/user_agent/user_agent_metadata.h"
+namespace {
+#include "lengsuo/native/golden.inc"
+constexpr unsigned char kGoldenCatalog[] = {
+    76,  66,  80,  67,  49,  0,   0,   0,   1,   0,   2,   112,
+    49,  0,   1,   0,   2,   117, 97,  0,   0,   0,   7,   0,
+    19,  83,  121, 110, 116, 104, 47,  49,  46,  48,  32,  84,
+    101, 115, 116, 32,  69,  110, 118, 55,  2,   0,   5,   65,
+    108, 112, 104, 97,  0,   3,   49,  46,  50,  0,   4,   66,
+    101, 116, 97,  0,   3,   51,  46,  52,  2,   0,   5,   65,
+    108, 112, 104, 97,  0,   7,   49,  46,  50,  46,  55,  46,
+    56,  0,   4,   66,  101, 116, 97,  0,   7,   51,  46,  52,
+    46,  57,  46,  48,  0,   6,   84,  101, 115, 116, 79,  83,
+    0,   6,   49,  48,  46,  48,  46,  48,  0,   3,   120, 56,
+    54,  0,   2,   54,  52,  0,   0,   0};
+std::string CatalogWire() {
+  return std::string(reinterpret_cast<const char*>(kGoldenCatalog),
+                     sizeof(kGoldenCatalog));
+}
+}
+namespace lengsuo {
+TEST(BrowserBootstrap, TimezoneSystemIdsRejectUnknownAndUnsafeInput) {
+  for (auto zone : {"UTC", "America/New_York", "Europe/London", "Etc/GMT-8"})
+    EXPECT_TRUE(IsValidProfileTimezone(zone)) << zone;
+  for (auto zone : {"", "Mars/Olympus", "GMT+08:00", " UTC", "UTC ", "UTC\n"})
+    EXPECT_FALSE(IsValidProfileTimezone(zone)) << zone;
+  EXPECT_FALSE(IsValidProfileTimezone(std::string(65, 'a')));
+  EXPECT_FALSE(IsValidProfileTimezone(std::string_view("UTC\0junk", 8)));
+  EXPECT_FALSE(IsValidProfileTimezone("\xc3\xa9"));
+}
+
+TEST(BrowserBootstrap, RejectsSchemaTwoUntilPolicyInjectionIsAccepted) {
+  std::string wire(reinterpret_cast<const char*>(kGolden), sizeof(kGolden));
+  wire[8] = 2;
+  wire.insert(65, 1, static_cast<char>(3));
+  auto parsed = DecodeProfile(std::span<const std::uint8_t>(
+      reinterpret_cast<const std::uint8_t*>(wire.data()), wire.size()));
+  ASSERT_TRUE(parsed);
+  ASSERT_EQ(2u, parsed->schema_version);
+  ProfileBootstrapState state;
+  EXPECT_FALSE(state.Initialize(true, true,
+      [&]() -> std::optional<std::string> { return wire; }));
+  EXPECT_EQ(nullptr, state.profile());
+  EXPECT_FALSE(state.Initialize(true, true,
+      [&]() -> std::optional<std::string> { return wire; }));
+}
+TEST(BrowserBootstrap, CatalogBindingFreezesAndRejectsInvalidOrMissingSlot) {
+  for (int scenario : {0, 1, 2, 3, 4, 5}) {
+    ProfileBootstrapState state;
+    ASSERT_TRUE(state.Initialize(true, true, []() -> std::optional<std::string> {
+      return std::string(reinterpret_cast<const char*>(kGolden), sizeof(kGolden));
+    }));
+    auto wire = CatalogWire();
+    if (scenario == 1) wire[12] = '2';  // Different pool p2.
+    if (scenario == 2) wire[22] = 8;    // Different UA slot.
+    if (scenario == 3) wire.clear();
+    if (scenario == 4) wire.resize(4097, 'x');
+    if (scenario == 5) wire = "bad";
+    int reads = 0;
+    const bool initialized = state.InitializeCatalog(true, true,
+        [&]() -> std::optional<std::string> { ++reads; return wire; });
+    EXPECT_EQ(scenario == 0, initialized);
+    EXPECT_EQ(1, reads);
+    if (scenario == 0) {
+      ASSERT_NE(nullptr, state.ua());
+      EXPECT_EQ("Synth/1.0 Test Env7", state.ua()->ua_string);
+    } else {
+      EXPECT_EQ(nullptr, state.ua());
+    }
+    const auto* frozen = state.ua();
+    EXPECT_FALSE(state.InitializeCatalog(true, true,
+        []() -> std::optional<std::string> { return CatalogWire(); }));
+    EXPECT_EQ(frozen, state.ua());
+  }
+}
+TEST(BrowserBootstrap, UaMetadataUsesEveryCatalogFieldAndPreservesAbsentFields) {
+  auto bytes = CatalogWire();
+  auto catalog = DecodeCatalog(std::span<const std::uint8_t>(
+      reinterpret_cast<const std::uint8_t*>(bytes.data()), bytes.size()));
+  ASSERT_TRUE(catalog);
+  blink::UserAgentMetadata metadata;
+  metadata.full_version = "upstream";
+  metadata.wow64 = true;
+  metadata.form_factors = {"Desktop"};
+  metadata.brand_version_list.emplace_back("old", "0");
+  ASSERT_TRUE(ApplyUaMetadata(catalog->ua_entries[0], &metadata));
+  ASSERT_EQ(2u, metadata.brand_version_list.size());
+  EXPECT_EQ("Alpha", metadata.brand_version_list[0].brand);
+  EXPECT_EQ("1.2", metadata.brand_version_list[0].version);
+  ASSERT_EQ(2u, metadata.brand_full_version_list.size());
+  EXPECT_EQ("Beta", metadata.brand_full_version_list[1].brand);

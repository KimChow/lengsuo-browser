new file mode 100644
index 0000000..b6cced4
--- /dev/null
+++ b/lengsuo/native/canvas_noise.h
@@ -0,0 +1,53 @@
+// canvas_noise v1 — deterministic RGBA8 pixel perturbation (pure algorithm).
+//
+// Contract: docs/canvas-component-contract.md (frozen 2026-10-18, plan A).
+// Independent reference: tests/canvas_ref/gen_canvas_ref.py (Python).
+// Frozen bytes: tests/canvas_ref/golden_fixture.inc.
+//
+// This component is a pure algorithm library: no Chromium injection, no IPC,
+// no dynamic allocation, no static mutable state. The immutable-source rule
+// is the API contract: reads come only from `src`, writes go only to `dst`.
+
+#ifndef LENGSUO_NATIVE_CANVAS_NOISE_H_
+#define LENGSUO_NATIVE_CANVAS_NOISE_H_
+
+#include <cstdint>
+#include <span>
+
+namespace lengsuo::canvas {
+
+enum class CanvasNoiseStatus : std::uint8_t {
+  kOk,
+  kUnsupportedVersion,
+  kInvalidGeometry,
+  kBufferTooSmall,
+};
+
+struct CanvasNoiseConfig {
+  std::uint32_t algorithm_version{};
+  bool enabled{};
+  std::uint64_t seed{};
+  std::uint32_t slot{};
+};
+
+struct CanvasNoiseResult {
+  CanvasNoiseStatus status{CanvasNoiseStatus::kOk};
+  std::uint64_t changed_pixels{};
+  std::uint64_t preserved_pixels{};
+};
+
+// Applies canvas_noise v1 to an RGBA8 grid. `dst` may alias `src` exactly
+// (in-place, per-pixel read-then-write); any other overlap is undefined
+// input. All validation happens before any write; a failed call leaves
+// `dst` untouched.
+CanvasNoiseResult ApplyCanvasNoiseV1(const CanvasNoiseConfig& config,
+                                     std::span<const std::uint8_t> src,
+                                     std::span<std::uint8_t> dst,
+                                     std::uint32_t width,
+                                     std::uint32_t height,
+                                     std::uint64_t stride,
+                                     std::uint64_t buffer_size);
+
+}  // namespace lengsuo::canvas
+
+#endif  // LENGSUO_NATIVE_CANVAS_NOISE_H_
diff --git a/lengsuo/native/cookie_mirror.cc b/lengsuo/native/cookie_mirror.cc
new file mode 100644
index 0000000..042ebf1
--- /dev/null
+++ b/lengsuo/native/cookie_mirror.cc
@@ -0,0 +1,198 @@
+#include "cookie_mirror.h"
+
+#include <algorithm>
+#include <string_view>
+#include <utility>
+
+namespace lengsuo::fp {
+namespace {
+
+// Two declared domains describe the same cookie when each one covers the
+// other: after the leading dot is dropped and case is folded, that is only
+// true for equal hosts (".example.com" and "example.com" are one domain in
+// RFC 6265 5.3, while "a.example.com" stays distinct from "example.com").
+bool SameDomain(const std::string& left, const std::string& right) {
+  return CookieDomainMatches(left, right) &&
+         CookieDomainMatches(right, left);
+}
+
+// The number of characters of a declared domain, used to rank a match: the
+// most specific domain wins, the way the browser resolves two cookies that
+// share a name. The leading dot is not counted - it is RFC 6265 5.3 syntax
+// for the same domain, not a different one.
+std::size_t EffectiveDomainLength(const std::string& domain) {
+  return !domain.empty() && domain.front() == '.' ? domain.size() - 1
+                                                  : domain.size();
+}
+
+// Splits a Chromium cookie line ("name=value; name2=value2") into its
+// entries. The browser never emits a name containing '=' or ';', but a
+// defensive parse keeps one malformed entry from taking the whole answer
+// down.
+std::vector<std::string_view> SplitCookieLine(std::string_view line) {
+  std::vector<std::string_view> entries;
+  std::size_t start = 0;
+  while (start <= line.size()) {
+    const std::size_t separator = line.find(';', start);
+    const std::size_t end =
+        separator == std::string_view::npos ? line.size() : separator;
+    std::string_view entry = line.substr(start, end - start);
+    // Chromium writes "; " between entries.
+    while (!entry.empty() && (entry.front() == ' ' || entry.front() == '\t')) {
+      entry.remove_prefix(1);
+    }
+    while (!entry.empty() && (entry.back() == ' ' || entry.back() == '\t')) {
+      entry.remove_suffix(1);
+    }
+    if (!entry.empty()) {
+      entries.push_back(entry);
+    }
+    if (separator == std::string_view::npos) {
+      break;
+    }
+    start = separator + 1;
+  }
+  return entries;
+}
+
+// The name part of a "name=value" entry.
+std::string_view EntryName(std::string_view entry) {
+  const std::size_t equals = entry.find('=');
+  return equals == std::string_view::npos ? entry : entry.substr(0, equals);
+}
+
+}  // namespace
+
+void CookieMirror::Init(std::vector<CookieFact> cookies,
+                        std::vector<ConsistencyRule> rules) {
+  // Collapse repeated (domain, name) pairs the way StoragePin collapses
+  // repeated (origin, scope, key): the last value wins, the first position
+  // is kept. Without this the most specific domain could be shadowed by
+  // whichever entry happened to be declared last.
+  std::vector<CookieFact> collapsed;
+  for (CookieFact& fact : cookies) {
+    const auto existing = std::find_if(
+        collapsed.begin(), collapsed.end(),
+        [&fact](const CookieFact& other) {
+          return other.name == fact.name && SameDomain(other.domain, fact.domain);
+        });
+    if (existing == collapsed.end()) {
+      collapsed.push_back(std::move(fact));
+    } else {
+      existing->value = std::move(fact.value);
+    }
+  }
+  cookies_ = std::move(collapsed);
+  rules_ = std::move(rules);
+}
+
+std::optional<std::string> CookieMirror::Lookup(const std::string& host,
+                                                const std::string& name) const {
+  const CookieFact* best = nullptr;
+  for (const CookieFact& fact : cookies_) {
+    if (fact.name != name || !CookieDomainMatches(host, fact.domain)) {
+      continue;
+    }
+    // Most specific domain wins; a tie keeps the earlier declaration.
+    if (best == nullptr ||
+        EffectiveDomainLength(fact.domain) > EffectiveDomainLength(best->domain)) {
+      best = &fact;
+    }
+  }
+  if (best == nullptr) {
+    return std::nullopt;
+  }
+  return best->value;
+}
+
+bool CookieMirror::IsLocked(const std::string& host,
+                            const std::string& name) const {
+  // A pinned cookie is read-only, exactly like a pinned localStorage key.
+  //
+  // A rule on its own does not lock anything: the localStorage side locks a
+  // key only when that key is pinned, so locking a cookie that only a rule
+  // names would make the two halves disagree. The launch consistency gate
+  // (l3_wire) already guarantees that a rule whose storage side is pinned has
+  // its cookie side declared, so a valid snapshot never needs the extra rule.
+  for (const CookieFact& fact : cookies_) {
+    if (fact.name == name && CookieDomainMatches(host, fact.domain)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+std::optional<ConsistencyRule> CookieMirror::PairFor(
+    const std::string& host, const std::string& name) const {
+  for (const ConsistencyRule& rule : rules_) {
+    if (rule.cookie_name == name &&
+        CookieDomainMatches(host, rule.cookie_domain)) {
+      return rule;
+    }
+  }
+  return std::nullopt;
+}
+
+std::string CookieMirror::MergeCookieLine(const std::string& host,
+                                          std::string_view browser_line) const {
+  // The pinned cookies of this host, grouped by name. The representative of a
+  // name is the most specific domain, the same one Lookup returns, so the
+  // merged line and the single-value query never disagree.
+  std::vector<const CookieFact*> pinned;
+  for (const CookieFact& fact : cookies_) {
+    if (!CookieDomainMatches(host, fact.domain)) {
+      continue;
+    }
+    const auto same_name = std::find_if(
+        pinned.begin(), pinned.end(),
+        [&fact](const CookieFact* other) { return other->name == fact.name; });
+    if (same_name == pinned.end()) {
+      pinned.push_back(&fact);
+    } else if (EffectiveDomainLength(fact.domain) > EffectiveDomainLength((*same_name)->domain)) {
+      *same_name = &fact;
+    }
+  }
+  if (pinned.empty()) {
+    return std::string(browser_line);
+  }
+
+  // The browser line carries no domain and no path, so a pinned cookie can
+  // only be matched by name. A matching entry keeps its place in the line but
+  // takes the pinned value: the snapshot is authoritative, and a stale value
+  // sitting next to the pinned one is exactly the drift the platform sees.
+  std::vector<std::string> entries;
+  std::vector<bool> pinned_used(pinned.size(), false);
+  for (const std::string_view entry : SplitCookieLine(browser_line)) {
+    const std::string_view entry_name = EntryName(entry);
+    bool replaced = false;
+    for (std::size_t i = 0; i < pinned.size(); ++i) {
+      if (pinned[i]->name == entry_name) {
+        entries.emplace_back(pinned[i]->name + "=" + pinned[i]->value);
+        pinned_used[i] = true;
+        replaced = true;
+      }
+    }
+    if (!replaced) {
+      entries.emplace_back(entry);
+    }
+  }
+
+  // A pinned cookie the browser does not carry is appended, so the page still
+  // sees the value the environment declared.
+  for (std::size_t i = 0; i < pinned.size(); ++i) {
+    if (!pinned_used[i]) {
+      entries.emplace_back(pinned[i]->name + "=" + pinned[i]->value);
+    }
+  }
+
+  std::string merged;
+  for (const std::string& entry : entries) {
+    if (!merged.empty()) {
+      merged += "; ";
+    }
+    merged += entry;
+  }
+  return merged;
+}
+
+}  // namespace lengsuo::fp
diff --git a/lengsuo/native/cookie_mirror.h b/lengsuo/native/cookie_mirror.h
new file mode 100644
index 0000000..2e64701
--- /dev/null
+++ b/lengsuo/native/cookie_mirror.h
@@ -0,0 +1,105 @@
+// cookie_mirror - the cookie half of the L3 cross-store lock (task M).
+//
+// The L3 document declares two things that have to stay in lockstep:
+//   * the "cookies" section: the cookie values this environment is pinned to,
+//   * the "rules" section: which cookie mirrors which localStorage key.
+//
+// The localStorage half is already enforced (Blink's StorageArea reads and
+// writes through the frozen snapshot, see patches/0015-l3-storage.patch).
+// This class is the cookie half: it answers "what value does this page see
+// for this cookie" and "may this page write this cookie", always from the
+// snapshot, never from the live cookie jar.
+//
+// The renderer cannot see the live jar: Blink's CookieJar talks to the
+// network service over Mojo, so the jar lives in the browser process. The
+// snapshot is the only cookie state a renderer can hold, and it is the very
+// document the renderer already pulled from the browser over Mojo (task O;
+// no fingerprint state rides the command line). The Blink
+// interception points that would consume this class are outside this task's
+// file scope; they are described in docs/l3-reports/task-M.md. This task
+// delivers the policy, not the patch.
+//
+// Contract:
+//   * Domain matching reuses storage_consistency::CookieDomainMatches
+//     (RFC 6265 5.1.3): ASCII case-insensitive, a leading dot is ignored, and
+//     a declared domain covers the host itself and its dot-suffixed
+//     subdomains. `host` is the concrete page host, `domain` is what the
+//     document declared.
+//   * Cookie *names* are compared byte-exactly. RFC 6265 5.4 makes names
+//     case-sensitive, and a case-insensitive match would let a page write
+//     "_BEE" over a pinned "_bee" and drift the environment.
+//   * A pinned cookie is read-only. A cookie that only appears as the cookie
+//     half of a mirror rule is read-only as well, so that a page cannot
+//     create one half of a pair the environment does not carry.
+//   * Nothing here logs, hashes or serializes a value: pinned values are
+//     device identity, not diagnostics (docs/fp-switch-contract.md).
+#ifndef LENGSUO_NATIVE_COOKIE_MIRROR_H_
+#define LENGSUO_NATIVE_COOKIE_MIRROR_H_
+
+#include <cstddef>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "storage_consistency.h"
+
+namespace lengsuo::fp {
+
+// The cookie-side view of a frozen L3 snapshot. No IO, no clock, no browser
+// state: the snapshot is the whole world.
+class CookieMirror {
+ public:
+  CookieMirror() = default;
+
+  // Installs the snapshot. The document was already validated by the L3
+  // decoder (l3_wire), so this only copies - there is no second error path.
+  //
+  // Repeated (domain, name) entries collapse to one: the last value wins and
+  // the first position is kept, the same rule StoragePin uses.
+  void Init(std::vector<CookieFact> cookies,
+            std::vector<ConsistencyRule> rules);
+
+  // The value a page on `host` sees for `name`, or no value when the snapshot
+  // declares no such cookie. An empty string is a valid value and comes back
+  // as a value, not as "absent".
+  //
+  // When several declared cookies match the host and the name, the one with
+  // the longest domain wins - the same precedence the browser applies to
+  // cookies of the same name (RFC 6265 5.1.3).
+  std::optional<std::string> Lookup(const std::string& host,
+                                    const std::string& name) const;
+
+  // True when a write to (host, name) has to be dropped.
+  bool IsLocked(const std::string& host, const std::string& name) const;
+
+  // The mirror rule that names this cookie, when there is one. The first
+  // matching rule wins; a cookie named by several rules is a document
+  // authoring error and is flagged in the task-M report.
+  std::optional<ConsistencyRule> PairFor(const std::string& host,
+                                          const std::string& name) const;
+
+  // The browser's cookie line with the pinned cookies of `host` applied: a
+  // pinned cookie replaces the browser's value in place, a pinned cookie the
+  // browser does not carry is appended. Every other cookie and the browser's
+  // own ordering are preserved.
+  //
+  // The browser line is Chromium's "name=value; name2=value2" form
+  // (net/cookies/canonical_cookie.cc, AppendCookieLineEntry).
+  std::string MergeCookieLine(const std::string& host,
+                              std::string_view browser_line) const;
+
+  // The pinned cookies a page on `host` can see, in declaration order.
+  std::vector<CookieFact> VisibleCookies(const std::string& host) const;
+
+  // Number of distinct pinned cookies.
+  std::size_t size() const { return cookies_.size(); }
+
+ private:
+  std::vector<CookieFact> cookies_;
+  std::vector<ConsistencyRule> rules_;
+};
+
+}  // namespace lengsuo::fp
+
+#endif  // LENGSUO_NATIVE_COOKIE_MIRROR_H_
diff --git a/lengsuo/native/extension_pin.cc b/lengsuo/native/extension_pin.cc
new file mode 100644
index 0000000..92ce928
--- /dev/null
+++ b/lengsuo/native/extension_pin.cc
@@ -0,0 +1,192 @@
+#include "extension_pin.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <utility>
+
+namespace lengsuo::fp {
+namespace {
+
+// Minimal JSON reader for the one shape PinedFile uses: an array of strings.
+// It rejects everything else rather than skipping unknowns, so a malformed or
+// hostile document cannot silently narrow the whitelist.
+class JsonIdArrayReader {
+ public:
+  // The text is held by value. Chromium's chromium-rawref and
+  // chromium-rawptr checks reject both native references and native pointers
+  // as members; raw_ref<> would fix that but drags in a //base dependency,
+  // and this directory is deliberately buildable with a plain C++20
+  // toolchain. The document is a short array of 32-character ids, so one
+  // copy costs nothing.
+  explicit JsonIdArrayReader(const std::string& text) : text_(text) {}
+
+  // Returns true only when the entire input is `[ "id", ... ]` with every
+  // element a valid extension ID. On false, `ids` may be partially filled;
+  // Parse() discards it.
+  bool Read(std::set<std::string>* ids) {
+    SkipWhitespace();
+    if (!Consume('[')) return false;
+    SkipWhitespace();
+    if (Consume(']')) return AtEnd();
+    while (true) {
+      std::string id;
+      if (!ReadString(&id)) return false;
+      if (!ExtensionPin::IsValidId(id)) return false;
+      ids->insert(std::move(id));
+      SkipWhitespace();
+      if (Consume(']')) return AtEnd();
+      if (!Consume(',')) return false;
+      SkipWhitespace();
+      // A trailing comma leaves ']' where a string must begin, so the next
+      // ReadString() rejects it.
+    }
+  }
+
+ private:
+  bool AtEnd() {
+    SkipWhitespace();
+    return pos_ == text_.size();
+  }
+
+  bool Consume(char expected) {
+    if (pos_ >= text_.size() || text_[pos_] != expected) return false;
+    ++pos_;
+    return true;
+  }
+
+  void SkipWhitespace() {
+    while (pos_ < text_.size()) {
+      const char c = text_[pos_];
+      if (c != ' ' && c != '\t' && c != '\n' && c != '\r') return;
+      ++pos_;
+    }
+  }
+
+  bool ReadString(std::string* out) {
+    if (!Consume('"')) return false;
+    while (pos_ < text_.size()) {
+      const unsigned char c = static_cast<unsigned char>(text_[pos_++]);
+      if (c == '"') return true;
+      if (c < 0x20) return false;  // JSON forbids raw control characters.
+      if (c != '\\') {
+        out->push_back(static_cast<char>(c));
+        continue;
+      }
+      if (pos_ >= text_.size()) return false;
+      const char escape = text_[pos_++];
+      switch (escape) {
+        case '"': out->push_back('"'); break;
+        case '\\': out->push_back('\\'); break;
+        case '/': out->push_back('/'); break;
+        case 'b': out->push_back('\b'); break;
+        case 'f': out->push_back('\f'); break;
+        case 'n': out->push_back('\n'); break;
+        case 'r': out->push_back('\r'); break;
+        case 't': out->push_back('\t'); break;
+        case 'u': {
+          std::uint32_t code_point = 0;
+          if (!ReadHex4(&code_point)) return false;
+          if (code_point >= 0xD800 && code_point <= 0xDBFF) {
+            std::uint32_t low = 0;
+            if (!Consume('\\') || !Consume('u') || !ReadHex4(&low)) {
+              return false;
+            }
+            if (low < 0xDC00 || low > 0xDFFF) return false;
+            code_point =
+                0x10000 + ((code_point - 0xD800) << 10) + (low - 0xDC00);
+          } else if (code_point >= 0xDC00 && code_point <= 0xDFFF) {
+            return false;  // Lone low surrogate.
+          }
+          AppendUtf8(code_point, out);
+          break;
+        }
+        default: return false;
+      }
+    }
+    return false;  // Unterminated string.
+  }
+
+  bool ReadHex4(std::uint32_t* out) {
+    if (text_.size() - pos_ < 4) return false;
+    std::uint32_t value = 0;
+    for (int i = 0; i < 4; ++i) {
+      const char c = text_[pos_++];
+      value <<= 4;
+      if (c >= '0' && c <= '9') {
+        value |= static_cast<std::uint32_t>(c - '0');
+      } else if (c >= 'a' && c <= 'f') {
+        value |= static_cast<std::uint32_t>(c - 'a' + 10);
+      } else if (c >= 'A' && c <= 'F') {
+        value |= static_cast<std::uint32_t>(c - 'A' + 10);
+      } else {
+        return false;
+      }
+    }
+    *out = value;
+    return true;
+  }
+
+  static void AppendUtf8(std::uint32_t code_point, std::string* out) {
+    if (code_point <= 0x7F) {
+      out->push_back(static_cast<char>(code_point));
+    } else if (code_point <= 0x7FF) {
+      out->push_back(static_cast<char>(0xC0 | (code_point >> 6)));
+      out->push_back(static_cast<char>(0x80 | (code_point & 0x3F)));
+    } else if (code_point <= 0xFFFF) {
+      out->push_back(static_cast<char>(0xE0 | (code_point >> 12)));
+      out->push_back(static_cast<char>(0x80 | ((code_point >> 6) & 0x3F)));
+      out->push_back(static_cast<char>(0x80 | (code_point & 0x3F)));
+    } else {
+      out->push_back(static_cast<char>(0xF0 | (code_point >> 18)));
+      out->push_back(static_cast<char>(0x80 | ((code_point >> 12) & 0x3F)));
+      out->push_back(static_cast<char>(0x80 | ((code_point >> 6) & 0x3F)));
+      out->push_back(static_cast<char>(0x80 | (code_point & 0x3F)));
+    }
+  }
+
+  std::string text_;
+  std::size_t pos_ = 0;
+};
+
+}  // namespace
+
+bool ExtensionPin::Parse(const std::string& json) {
+  std::set<std::string> parsed;
+  JsonIdArrayReader reader(json);
+  if (!reader.Read(&parsed)) return false;
+  ids_ = std::move(parsed);
+  return true;
+}
+
+std::string ExtensionPin::Serialize() const {
+  std::string out = "[";
+  for (auto it = ids_.begin(); it != ids_.end(); ++it) {
+    if (it != ids_.begin()) out.push_back(',');
+    out.push_back('"');
+    out += *it;  // Valid IDs are [a-p]{32}: no JSON escaping needed.
+    out.push_back('"');
+  }
+  out.push_back(']');
+  return out;
+}
+
+bool ExtensionPin::Contains(const std::string& id) const {
+  return ids_.find(id) != ids_.end();
+}
+
+bool ExtensionPin::Add(const std::string& id) {
+  if (!IsValidId(id)) return false;
+  return ids_.insert(id).second;
+}
+
+// static
+bool ExtensionPin::IsValidId(const std::string& id) {
+  if (id.size() != 32) return false;
+  for (const char c : id) {
+    if (c < 'a' || c > 'p') return false;
+  }
+  return true;
+}
+
+}  // namespace lengsuo::fp
diff --git a/lengsuo/native/extension_pin.h b/lengsuo/native/extension_pin.h
new file mode 100644
index 0000000..0d12f67
--- /dev/null
+++ b/lengsuo/native/extension_pin.h
@@ -0,0 +1,51 @@
+// extension_pin - the PinedFile extension whitelist (L3 任务书 任务 H).
+//
+// 对标端 uses PinedFile to fix "which extensions must travel with the
+// environment": a JSON array of Chromium extension IDs, e.g.
+//   ["fjchbfkopknlodpfoaeogfbclcpppiog",
+//    "fgbbdcdpliimpdmgcnahkcdfhdjegmin",
+//    "hncdafoadpldclaaigooamfbebmaakjj"]
+//
+// Parsing is fail-closed: any invalid ID, non-array document or non-string
+// element rejects the whole document and leaves prior state untouched. IDs
+// use Chromium's alphabet: exactly 32 characters of [a-p].
+#ifndef LENGSUO_NATIVE_EXTENSION_PIN_H_
+#define LENGSUO_NATIVE_EXTENSION_PIN_H_
+
+#include <cstddef>
+#include <set>
+#include <string>
+
+namespace lengsuo::fp {
+
+class ExtensionPin {
+ public:
+  // Parses a PinedFile document. On failure the pin keeps its previous
+  // contents; nothing is half-applied.
+  bool Parse(const std::string& json);
+
+  // Serializes as a JSON string array in stable (sorted) order, so two pins
+  // with the same membership serialize byte-identically.
+  std::string Serialize() const;
+
+  bool Contains(const std::string& id) const;
+
+  // Returns false (and changes nothing) when `id` is already present or is
+  // not a valid Chromium extension ID.
+  bool Add(const std::string& id);
+
+  size_t size() const { return ids_.size(); }
+
+  // Sorted view; used by the L3 document encoder.
+  const std::set<std::string>& Ids() const { return ids_; }
+
+  // 32 characters of [a-p] (Chromium extension ID alphabet).
+  static bool IsValidId(const std::string& id);
+
+ private:
+  std::set<std::string> ids_;
+};
+
+}  // namespace lengsuo::fp
+
+#endif  // LENGSUO_NATIVE_EXTENSION_PIN_H_

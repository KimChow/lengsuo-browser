index 0000000..61e8bbc
--- /dev/null
+++ b/lengsuo/native/kernel_pipe_frame_test.cc
@@ -0,0 +1,195 @@
+// kernel_pipe_frame_test - the frame layer of the kernel side of the
+// runner <-> kernel pipe (task Q).
+//
+// The fixed test vectors are in kernel_pipe_test_util.h; they are copied
+// byte for byte out of docs/kernel-wire-contract.md section 2.
+#include "kernel_pipe_frame.h"
+
+#include <gtest/gtest.h>
+
+#include <cstdint>
+#include <string>
+
+#include "kernel_pipe_test_util.h"
+
+namespace lengsuo::fp {
+namespace {
+
+using test::BytesToHex;
+using test::Fill;
+using test::HexToBytes;
+using test::kIllegalLenOver;
+using test::kIllegalReserved;
+using test::kIllegalTruncHeader;
+using test::kIllegalTruncPayload;
+using test::kIllegalType;
+using test::kLegalHeaderV0;
+using test::kLegalHeaderV1;
+using test::kLegalHeaderV255;
+using test::kLegalHeaderV3;
+using test::kLegalHeaderV65535;
+using test::kLegalHeaderVMax;
+
+TEST(KernelPipeFrame, LegalHeadersDecodeToTheContractBytes) {
+  struct Case {
+    const char* hex;
+    std::uint32_t length;
+  };
+  const Case cases[] = {
+      {kLegalHeaderV0, 0},
+      {kLegalHeaderV1, 1},
+      {kLegalHeaderV3, 3},
+      {kLegalHeaderV255, 255},
+      {kLegalHeaderV65535, 65535},
+      {kLegalHeaderVMax, 8388608},
+  };
+  for (const Case& c : cases) {
+    const std::string header = HexToBytes(c.hex);
+    ASSERT_EQ(header.size(), kKernelPipeHeaderBytes);
+    std::uint32_t length = 0;
+    FrameType type = FrameType::kHello;
+    ASSERT_TRUE(DecodeFrameHeader(header, &length, &type)) << c.hex;
+    EXPECT_EQ(length, c.length) << c.hex;
+    EXPECT_EQ(type, FrameType::kConfigBundle) << c.hex;
+  }
+}
+
+TEST(KernelPipeFrame, EncodedLegalFramesMatchTheContractBytes) {
+  struct Case {
+    const char* hex;
+    std::size_t length;
+  };
+  const Case cases[] = {
+      {kLegalHeaderV0, 0},
+      {kLegalHeaderV1, 1},
+      {kLegalHeaderV3, 3},
+      {kLegalHeaderV255, 255},
+      {kLegalHeaderV65535, 65535},
+      {kLegalHeaderVMax, 8388608},
+  };
+  for (const Case& c : cases) {
+    const std::string expected = HexToBytes(c.hex) + Fill(c.length);
+    std::string frame;
+    ASSERT_TRUE(EncodeFrame(FrameType::kConfigBundle, Fill(c.length), &frame));
+    EXPECT_EQ(BytesToHex(frame), BytesToHex(expected)) << c.hex;
+  }
+}
+
+TEST(KernelPipeFrame, LengthIsBigEndian) {
+  // A little-endian implementation would write 01 00 00 00 here.
+  std::string frame;
+  ASSERT_TRUE(EncodeFrame(FrameType::kConfigBundle, "x", &frame));
+  ASSERT_EQ(frame.size(), kKernelPipeHeaderBytes + 1);
+  EXPECT_EQ(frame[0], '\0');
+  EXPECT_EQ(frame[1], '\0');
+  EXPECT_EQ(frame[2], '\0');
+  EXPECT_EQ(frame[3], '\1');
+  EXPECT_EQ(frame[4], static_cast<char>(0x03));
+  EXPECT_EQ(frame[5], '\0');
+  EXPECT_EQ(frame[6], '\0');
+  EXPECT_EQ(frame[7], '\0');
+}
+
+TEST(KernelPipeFrame, IllegalFramesAreRejected) {
+  const char* const cases[] = {
+      kIllegalLenOver, kIllegalReserved, kIllegalType, kIllegalTruncHeader,
+      kIllegalTruncPayload,
+  };
+  for (const char* hex : cases) {
+    const std::string raw = HexToBytes(hex);
+    Frame frame;
+    EXPECT_FALSE(DecodeFrame(raw, &frame)) << hex;
+    // A rejected frame yields no partial plaintext.
+    EXPECT_TRUE(frame.payload.empty()) << hex;
+    EXPECT_EQ(frame.type, FrameType::kHello) << hex;
+  }
+}
+
+TEST(KernelPipeFrame, LenOverTheLimitIsRejected) {
+  // The contract's limit is exactly 8 MiB; one byte more is illegal.
+  std::string header;
+  header.push_back('\0');
+  header.push_back(static_cast<char>(0x80));
+  header.push_back('\0');
+  header.push_back('\1');
+  header.push_back(static_cast<char>(0x03));
+  header.append(3, '\0');
+  std::uint32_t length = 0;
+  FrameType type = FrameType::kHello;
+  EXPECT_FALSE(DecodeFrameHeader(header, &length, &type));
+  // And the limit itself is legal.
+  std::string at_limit = header;
+  at_limit[3] = '\0';
+  EXPECT_TRUE(DecodeFrameHeader(at_limit, &length, &type));
+  EXPECT_EQ(length, 8388608u);
+}
+
+TEST(KernelPipeFrame, ReservedBytesMustBeZero) {
+  std::string header = HexToBytes(kLegalHeaderV1);
+  for (std::size_t i = 5; i < 8; ++i) {
+    std::string broken = header;
+    broken[i] = '\1';
+    std::uint32_t length = 0;
+    FrameType type = FrameType::kHello;
+    EXPECT_FALSE(DecodeFrameHeader(broken, &length, &type))
+        << "reserved byte " << i << " must be rejected";
+  }
+}
+
+TEST(KernelPipeFrame, UnknownTypeIsRejected) {
+  for (std::uint8_t raw : {std::uint8_t{0x00}, std::uint8_t{0x06},
+                           std::uint8_t{0x07}, std::uint8_t{0x80},
+                           std::uint8_t{0x83}, std::uint8_t{0xFF}}) {
+    EXPECT_FALSE(IsKnownFrameType(raw));
+    std::string header = HexToBytes(kLegalHeaderV1);
+    header[4] = static_cast<char>(raw);
+    std::uint32_t length = 0;
+    FrameType type = FrameType::kHello;
+    EXPECT_FALSE(DecodeFrameHeader(header, &length, &type));
+  }
+}
+
+TEST(KernelPipeFrame, KnownTypesAreAccepted) {
+  EXPECT_TRUE(IsKnownFrameType(0x01));
+  EXPECT_TRUE(IsKnownFrameType(0x02));
+  EXPECT_TRUE(IsKnownFrameType(0x03));
+  EXPECT_TRUE(IsKnownFrameType(0x04));
+  EXPECT_TRUE(IsKnownFrameType(0x05));
+  EXPECT_TRUE(IsKnownFrameType(0x81));
+  EXPECT_TRUE(IsKnownFrameType(0x82));
+}
+
+TEST(KernelPipeFrame, RoundTripsAtEveryContractLength) {
+  const std::size_t lengths[] = {0, 1, 3, 255, 65535};
+  for (const std::size_t length : lengths) {
+    const std::string payload = Fill(length);
+    std::string frame;
+    ASSERT_TRUE(EncodeFrame(FrameType::kConfigBundle, payload, &frame));
+    Frame decoded;
+    ASSERT_TRUE(DecodeFrame(frame, &decoded));
+    EXPECT_EQ(decoded.type, FrameType::kConfigBundle);
+    EXPECT_EQ(decoded.payload, payload);
+    EXPECT_EQ(decoded.header.size(), kKernelPipeHeaderBytes);
+    EXPECT_EQ(decoded.header, frame.substr(0, kKernelPipeHeaderBytes));
+  }
+}
+
+TEST(KernelPipeFrame, EncodeRefusesAnOversizedPayload) {
+  const std::string too_big(kKernelPipeMaxPayloadBytes + 1, '\0');
+  std::string frame;
+  EXPECT_FALSE(EncodeFrame(FrameType::kConfigBundle, too_big, &frame));
+  EXPECT_TRUE(frame.empty());
+}
+
+TEST(KernelPipeFrame, DecodeRefusesAnOversizedDeclaration) {
+  // A header that declares more than the limit must be rejected even when
+  // the bytes are not there: the decoder must not wait for them.
+  const std::string header = HexToBytes(kIllegalLenOver);
+  Frame frame;
+  EXPECT_FALSE(DecodeFrame(header, &frame));
+  // And it must not wait for the missing payload either.
+  EXPECT_FALSE(DecodeFrame(header + Fill(16), &frame));
+}
+
+}  // namespace
+}  // namespace lengsuo::fp
diff --git a/lengsuo/native/kernel_pipe_json.cc b/lengsuo/native/kernel_pipe_json.cc
new file mode 100644
index 0000000..29d966f
--- /dev/null
+++ b/lengsuo/native/kernel_pipe_json.cc
@@ -0,0 +1,380 @@
+#include "kernel_pipe_json.h"
+
+#include <limits>
+#include <utility>
+
+namespace lengsuo::fp {
+namespace {
+
+// --- JSON scanning ------------------------------------------------------
+//
+// A shallow scanner: enough to read the top level of an object. Nested
+// values are skipped and kept as raw text; the action schemas and the
+// config bundle never look inside them.
+
+bool IsJsonSpace(char c) {
+  return c == ' ' || c == '\t' || c == '\n' || c == '\r';
+}
+
+void SkipJsonSpace(std::string_view text, std::size_t* pos) {
+  while (*pos < text.size() && IsJsonSpace(text[*pos])) {
+    ++(*pos);
+  }
+}
+
+void AppendUtf8(std::string* out, std::uint32_t code_point) {
+  if (code_point <= 0x7F) {
+    out->push_back(static_cast<char>(code_point));
+  } else if (code_point <= 0x7FF) {
+    out->push_back(static_cast<char>(0xC0 | (code_point >> 6)));
+    out->push_back(static_cast<char>(0x80 | (code_point & 0x3F)));
+  } else if (code_point <= 0xFFFF) {
+    out->push_back(static_cast<char>(0xE0 | (code_point >> 12)));
+    out->push_back(static_cast<char>(0x80 | ((code_point >> 6) & 0x3F)));
+    out->push_back(static_cast<char>(0x80 | (code_point & 0x3F)));
+  } else {
+    out->push_back(static_cast<char>(0xF0 | (code_point >> 18)));
+    out->push_back(static_cast<char>(0x80 | ((code_point >> 12) & 0x3F)));
+    out->push_back(static_cast<char>(0x80 | ((code_point >> 6) & 0x3F)));
+    out->push_back(static_cast<char>(0x80 | (code_point & 0x3F)));
+  }
+}
+
+bool HexDigit(char c, std::uint8_t* out) {
+  if (c >= '0' && c <= '9') {
+    *out = static_cast<std::uint8_t>(c - '0');
+    return true;
+  }
+  if (c >= 'a' && c <= 'f') {
+    *out = static_cast<std::uint8_t>(c - 'a' + 10);
+    return true;
+  }
+  if (c >= 'A' && c <= 'F') {
+    *out = static_cast<std::uint8_t>(c - 'A' + 10);
+    return true;
+  }
+  return false;
+}
+
+bool ScanHex4(std::string_view text, std::size_t* pos, std::uint32_t* out) {
+  if (*pos + 4 > text.size()) {
+    return false;
+  }
+  std::uint32_t value = 0;
+  for (int i = 0; i < 4; ++i) {
+    std::uint8_t digit = 0;
+    if (!HexDigit(text[*pos + static_cast<std::size_t>(i)], &digit)) {
+      return false;
+    }
+    value = (value << 4) | digit;
+  }
+  *pos += 4;
+  *out = value;
+  return true;
+}
+
+// Reads a JSON string literal, resolving the escapes. `pos` must point at the
+// opening quote. On success `*pos` sits just past the closing quote.
+bool ScanJsonString(std::string_view text, std::size_t* pos, std::string* out) {
+  if (*pos >= text.size() || text[*pos] != '"') {
+    return false;
+  }
+  ++(*pos);
+  out->clear();
+  while (*pos < text.size()) {
+    const char c = text[*pos];
+    if (c == '"') {
+      ++(*pos);
+      return true;
+    }
+    if (c == '\\') {
+      ++(*pos);
+      if (*pos >= text.size()) {
+        return false;
+      }
+      const char escape = text[*pos];
+      ++(*pos);
+      switch (escape) {
+        case '"': out->push_back('"'); break;
+        case '\\': out->push_back('\\'); break;
+        case '/': out->push_back('/'); break;
+        case 'b': out->push_back('\b'); break;
+        case 'f': out->push_back('\f'); break;
+        case 'n': out->push_back('\n'); break;
+        case 'r': out->push_back('\r'); break;
+        case 't': out->push_back('\t'); break;
+        case 'u': {
+          std::uint32_t code = 0;
+          if (!ScanHex4(text, pos, &code)) {
+            return false;
+          }
+          // A surrogate pair is two \u escapes; anything else is written as
+          // the code point it names.
+          if (code >= 0xD800 && code <= 0xDBFF && *pos + 1 < text.size() &&
+              text[*pos] == '\\' && text[*pos + 1] == 'u') {
+            const std::size_t saved = *pos;
+            *pos += 2;
+            std::uint32_t low = 0;
+            if (ScanHex4(text, pos, &low) && low >= 0xDC00 && low <= 0xDFFF) {
+              code = 0x10000 + ((code - 0xD800) << 10) + (low - 0xDC00);
+            } else {
+              *pos = saved;
+            }
+          }
+          AppendUtf8(out, code);
+          break;
+        }
+        default:
+          return false;
+      }
+      continue;
+    }
+    if (static_cast<unsigned char>(c) < 0x20) {
+      // A raw control character is not legal inside a JSON string.
+      return false;
+    }
+    out->push_back(c);
+    ++(*pos);
+  }
+  return false;
+}
+
+bool IsJsonNumberStart(char c) {
+  return c == '-' || (c >= '0' && c <= '9');
+}
+
+bool ScanJsonNumber(std::string_view text, std::size_t* pos, std::string* out) {
+  const std::size_t start = *pos;
+  if (*pos < text.size() && text[*pos] == '-') {
+    ++(*pos);
+  }
+  while (*pos < text.size() && text[*pos] >= '0' && text[*pos] <= '9') {
+    ++(*pos);
+  }
+  if (*pos < text.size() && text[*pos] == '.') {
+    ++(*pos);
+    while (*pos < text.size() && text[*pos] >= '0' && text[*pos] <= '9') {
+      ++(*pos);
+    }
+  }
+  if (*pos < text.size() && (text[*pos] == 'e' || text[*pos] == 'E')) {
+    ++(*pos);
+    if (*pos < text.size() && (text[*pos] == '+' || text[*pos] == '-')) {
+      ++(*pos);
+    }
+    while (*pos < text.size() && text[*pos] >= '0' && text[*pos] <= '9') {
+      ++(*pos);
+    }
+  }
+  if (*pos == start) {
+    return false;
+  }
+  *out = std::string(text.substr(start, *pos - start));
+  return true;
+}
+
+// Skips one JSON value of any kind, leaving `*pos` just past it.
+bool SkipJsonValue(std::string_view text, std::size_t* pos) {
+  SkipJsonSpace(text, pos);
+  if (*pos >= text.size()) {
+    return false;
+  }
+  const char c = text[*pos];
+  if (c == '"') {
+    std::string ignored;
+    return ScanJsonString(text, pos, &ignored);
+  }
+  if (c == '{' || c == '[') {
+    const char closing = (c == '{') ? '}' : ']';
+    ++(*pos);
+    while (true) {
+      SkipJsonSpace(text, pos);
+      if (*pos >= text.size()) {
+        return false;
+      }
+      if (text[*pos] == closing) {
+        ++(*pos);
+        return true;
+      }
+      if (c == '{') {
+        std::string ignored;
+        if (!ScanJsonString(text, pos, &ignored)) {
+          return false;
+        }
+        SkipJsonSpace(text, pos);
+        if (*pos >= text.size() || text[*pos] != ':') {
+          return false;
+        }
+        ++(*pos);
+      }
+      if (!SkipJsonValue(text, pos)) {
+        return false;
+      }
+      SkipJsonSpace(text, pos);
+      if (*pos < text.size() && text[*pos] == ',') {
+        ++(*pos);
+        continue;
+      }
+      SkipJsonSpace(text, pos);
+      if (*pos < text.size() && text[*pos] == closing) {
+        ++(*pos);
+        return true;
+      }
+      return false;
+    }
+  }
+  if (c == 't') {
+    if (text.compare(*pos, 4, "true") != 0) {
+      return false;
+    }
+    *pos += 4;
+    return true;
+  }
+  if (c == 'f') {
+    if (text.compare(*pos, 5, "false") != 0) {
+      return false;
+    }
+    *pos += 5;
+    return true;
+  }
+  if (c == 'n') {
+    if (text.compare(*pos, 4, "null") != 0) {
+      return false;
+    }
+    *pos += 4;
+    return true;
+  }
+  if (IsJsonNumberStart(c)) {
+    std::string ignored;
+    return ScanJsonNumber(text, pos, &ignored);
+  }
+  return false;
+}
+
+// Reads one member value into `*value`. Objects and arrays are kept as raw
+// text; scalars are decoded.
+bool ScanJsonMemberValue(std::string_view text,
+                         std::size_t* pos,
+                         JsonValue* value) {
+  SkipJsonSpace(text, pos);
+  if (*pos >= text.size()) {
+    return false;
+  }
+  const char c = text[*pos];
+  if (c == '"') {
+    value->kind = JsonKind::kString;
+    return ScanJsonString(text, pos, &value->text);
+  }
+  if (c == '{' || c == '[') {
+    const std::size_t start = *pos;
+    if (!SkipJsonValue(text, pos)) {
+      return false;
+    }
+    value->kind = (c == '{') ? JsonKind::kObject : JsonKind::kArray;
+    value->text = std::string(text.substr(start, *pos - start));
+    return true;
+  }
+  if (c == 't' || c == 'f') {
+    const std::size_t start = *pos;
+    if (!SkipJsonValue(text, pos)) {
+      return false;
+    }
+    value->kind = JsonKind::kBoolean;
+    value->text = std::string(text.substr(start, *pos - start));
+    return true;
+  }
+  if (c == 'n') {
+    const std::size_t start = *pos;
+    if (!SkipJsonValue(text, pos)) {
+      return false;
+    }
+    value->kind = JsonKind::kNull;
+    value->text = std::string(text.substr(start, *pos - start));
+    return true;
+  }
+  if (IsJsonNumberStart(c)) {
+    value->kind = JsonKind::kNumber;
+    return ScanJsonNumber(text, pos, &value->text);
+  }
+  return false;
+}
+
+}  // namespace
+
+// ---------------------------------------------------------------------------
+// JsonObject
+// ---------------------------------------------------------------------------
+
+JsonObject::JsonObject() = default;
+
+JsonObject::~JsonObject() = default;
+
+JsonObject::JsonObject(const JsonObject& other) = default;
+
+JsonObject& JsonObject::operator=(const JsonObject& other) = default;
+
+JsonObject::JsonObject(JsonObject&& other) noexcept = default;
+
+JsonObject& JsonObject::operator=(JsonObject&& other) noexcept = default;
+
+bool JsonObject::Parse(std::string_view text, JsonObject* out) {
+  if (out == nullptr) {
+    return false;
+  }
+  std::size_t pos = 0;
+  SkipJsonSpace(text, &pos);
+  if (pos >= text.size() || text[pos] != '{') {
+    return false;
+  }
+  ++pos;
+  JsonObject parsed;
+  SkipJsonSpace(text, &pos);
+  if (pos < text.size() && text[pos] == '}') {
+    ++pos;
+  } else {
+    while (true) {
+      SkipJsonSpace(text, &pos);
+      std::string key;
+      if (!ScanJsonString(text, &pos, &key)) {
+        return false;
+      }
+      SkipJsonSpace(text, &pos);
+      if (pos >= text.size() || text[pos] != ':') {
+        return false;
+      }
+      ++pos;
+      JsonValue value;
+      if (!ScanJsonMemberValue(text, &pos, &value)) {
+        return false;
+      }
+      for (const auto& member : parsed.members_) {
+        if (member.first == key) {
+          // A duplicate key makes the payload's meaning depend on which
+          // member the reader keeps; reject it instead of picking one.
+          return false;
+        }
+      }
+      parsed.members_.emplace_back(std::move(key), std::move(value));
+      SkipJsonSpace(text, &pos);
+      if (pos < text.size() && text[pos] == ',') {
+        ++pos;
+        continue;
+      }
+      SkipJsonSpace(text, &pos);
+      if (pos >= text.size() || text[pos] != '}') {
+        return false;
+      }
+      ++pos;
+      break;
+    }
+  }
+  SkipJsonSpace(text, &pos);
+  if (pos != text.size()) {
+    // Trailing bytes after the top-level object.
+    return false;
+  }
+  *out = std::move(parsed);
+  return true;
+}
+
+}  // namespace lengsuo::fp
diff --git a/lengsuo/native/kernel_pipe_json.h b/lengsuo/native/kernel_pipe_json.h
new file mode 100644
index 0000000..ba3855b
--- /dev/null
+++ b/lengsuo/native/kernel_pipe_json.h
@@ -0,0 +1,161 @@
+// kernel_pipe_json - the JSON reader of the runner <-> kernel pipe (task Q).
+//
+// Every payload on this pipe is JSON text (contract section 5) except the
+// KeyEnvelope, which is binary. The reader below is deliberately shallow: it
+// understands the top level of an object, which is all the action schemas
+// and the config bundle need. Nested values are captured as raw text.
+//
+// The reader is a separate layer from the crypto on purpose: the envelope
+// tests must not have to pull in BoringSSL to check that a payload parses,
+// and the JSON tests must not have to know anything about keys.
+#ifndef LENGSUO_NATIVE_KERNEL_PIPE_JSON_H_
+#define LENGSUO_NATIVE_KERNEL_PIPE_JSON_H_
+
+#include <cstdint>
+#include <limits>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+namespace lengsuo::fp {
+
+enum class JsonKind {
+  kString,
+  kNumber,
+  kBoolean,
+  kNull,
+  kObject,
+  kArray,
+};
+
+// One member of a JSON object.
+struct JsonValue {
+  JsonKind kind = JsonKind::kNull;
+  // For a string: the decoded value (escapes resolved). For a number: the
+  // raw token. For a boolean: "true" or "false". For an object or an
+  // array: the raw slice, including the brackets.
+  std::string text;
+};
+
+// A shallow view over the members of a JSON object.
+//
+// The special members are declared here and defined in the .cc: the class
+// owns a vector, so the constructor and destructor are not trivial and
+// Chromium's style checker wants them out of line.
+class JsonObject {
+ public:
+  JsonObject();
+  ~JsonObject();
+  JsonObject(const JsonObject& other);
+  JsonObject& operator=(const JsonObject& other);
+  JsonObject(JsonObject&& other) noexcept;
+  JsonObject& operator=(JsonObject&& other) noexcept;
+
+  // Parses a top-level JSON object. Returns false on malformed input; the
+  // duplicate-key case is rejected too, because two members with the same
+  // name make the payload's meaning depend on the reader.
+  static bool Parse(std::string_view text, JsonObject* out);
+
+  // The accessors are defined here rather than in the .cc: they are one-line
+  // lookups over the member list, and keeping them in the header is what
+  // lets the reader's implementation stay small enough to read. Only the
+  // special members have to live in the .cc (see the class comment).
+  bool Has(std::string_view key) const {
+    return Find(key) != nullptr;
+  }
+
+  const JsonValue* Find(std::string_view key) const {
+    for (const auto& member : members_) {
+      if (member.first == key) {
+        return &member.second;
+      }
+    }
+    return nullptr;
+  }
+
+  // Typed accessors. Each returns false when the key is absent or holds a
+  // different kind.
+  bool GetString(std::string_view key, std::string* out) const {
+    const JsonValue* value = Find(key);
+    if (value == nullptr || value->kind != JsonKind::kString) {
+      return false;
+    }
+    if (out != nullptr) {
+      *out = value->text;
+    }
+    return true;
+  }
+
+  bool GetBool(std::string_view key, bool* out) const {
+    const JsonValue* value = Find(key);
+    if (value == nullptr || value->kind != JsonKind::kBoolean) {
+      return false;
+    }
+    if (out != nullptr) {
+      *out = (value->text == "true");
+    }
+    return true;
+  }
+
+  bool GetInt64(std::string_view key, std::int64_t* out) const {
+    const JsonValue* value = Find(key);
+    if (value == nullptr || value->kind != JsonKind::kNumber) {
+      return false;
+    }
+    const std::string& token = value->text;
+    if (token.empty()) {
+      return false;
+    }
+    std::size_t index = 0;
+    bool negative = false;
+    if (token[0] == '-') {
+      negative = true;
+      index = 1;
+    }
+    if (index >= token.size()) {
+      return false;
+    }
+    std::uint64_t magnitude = 0;
+    for (; index < token.size(); ++index) {
+      const char c = token[index];
+      if (c < '0' || c > '9') {
+        // A fractional or exponent form is not an integer.
+        return false;
+      }
+      const std::uint64_t digit = static_cast<std::uint64_t>(c - '0');
+      if (magnitude > (std::numeric_limits<std::uint64_t>::max() - digit) / 10) {
+        return false;
+      }
+      magnitude = magnitude * 10 + digit;
+    }
+    if (negative) {
+      if (magnitude > static_cast<std::uint64_t>(
+                          std::numeric_limits<std::int64_t>::max()) + 1) {
+        return false;
+      }
+      if (out != nullptr) {
+        *out = (magnitude == static_cast<std::uint64_t>(
+                             std::numeric_limits<std::int64_t>::max()) + 1)
+                   ? std::numeric_limits<std::int64_t>::min()
+                   : -static_cast<std::int64_t>(magnitude);
+      }
+      return true;
+    }
+    if (magnitude > static_cast<std::uint64_t>(
+                        std::numeric_limits<std::int64_t>::max())) {
+      return false;
+    }
+    if (out != nullptr) {
+      *out = static_cast<std::int64_t>(magnitude);
+    }
+    return true;
+  }
+
+ private:
+  std::vector<std::pair<std::string, JsonValue>> members_;
+};
+
+}  // namespace lengsuo::fp
+
+#endif  // LENGSUO_NATIVE_KERNEL_PIPE_JSON_H_
diff --git a/lengsuo/native/kernel_pipe_json_test.cc b/lengsuo/native/kernel_pipe_json_test.cc
new file mode 100644
index 0000000..650065d
--- /dev/null
+++ b/lengsuo/native/kernel_pipe_json_test.cc
@@ -0,0 +1,80 @@
+// kernel_pipe_json_test - the JSON reader of the kernel side of the
+// runner <-> kernel pipe (task Q).
+//
+// This file deliberately links no crypto: the reader is a layer of its own,
+// and the test proves it.
+#include "kernel_pipe_json.h"
+
+#include <gtest/gtest.h>
+
+#include <cstdint>
+#include <string>
+
+namespace lengsuo::fp {
+namespace {
+
+TEST(KernelPipeJson, ParsesAFlatObject) {
+  JsonObject object;
+  ASSERT_TRUE(JsonObject::Parse(
+      "{\"a\":\"x\",\"b\":12,\"c\":true,\"d\":null}", &object));
+  EXPECT_TRUE(object.Has("a"));
+  EXPECT_FALSE(object.Has("zz"));
+  std::string text;
+  ASSERT_TRUE(object.GetString("a", &text));
+  EXPECT_EQ(text, "x");
+  std::int64_t number = 0;
+  ASSERT_TRUE(object.GetInt64("b", &number));
+  EXPECT_EQ(number, 12);
+  bool flag = false;
+  ASSERT_TRUE(object.GetBool("c", &flag));
+  EXPECT_TRUE(flag);
+  // A string is not a number and a number is not a string.
+  EXPECT_FALSE(object.GetInt64("a", &number));
+  EXPECT_FALSE(object.GetString("b", &text));
+  EXPECT_FALSE(object.GetBool("a", &flag));
+}
+
+TEST(KernelPipeJson, RejectsMalformedInput) {
+  JsonObject object;
+  EXPECT_FALSE(JsonObject::Parse("", &object));
+  EXPECT_FALSE(JsonObject::Parse("{", &object));
+  EXPECT_FALSE(JsonObject::Parse("{\"a\"}", &object));
+  EXPECT_FALSE(JsonObject::Parse("{\"a\":}", &object));
+  EXPECT_FALSE(JsonObject::Parse("{\"a\":1,}", &object));
+  EXPECT_FALSE(JsonObject::Parse("{\"a\":1}trailing", &object));
+  EXPECT_FALSE(JsonObject::Parse("[]", &object));
+  EXPECT_FALSE(JsonObject::Parse("{\"a\":1,\"a\":2}", &object));
+}
+
+TEST(KernelPipeJson, ResolvesEscapes) {
+  JsonObject object;
+  ASSERT_TRUE(JsonObject::Parse("{\"a\":\"x\\ny\\u0041\"}", &object));
+  std::string text;
+  ASSERT_TRUE(object.GetString("a", &text));
+  EXPECT_EQ(text, "x\nyA");
+}
+
+TEST(KernelPipeJson, KeepsNestedValuesAsRawText) {
+  JsonObject object;
+  ASSERT_TRUE(JsonObject::Parse(
+      "{\"a\":{\"b\":1},\"c\":[1,2]}", &object));
+  const JsonValue* nested = object.Find("a");
+  ASSERT_NE(nested, nullptr);
+  EXPECT_EQ(nested->kind, JsonKind::kObject);
+  EXPECT_EQ(nested->text, "{\"b\":1}");
+  const JsonValue* array = object.Find("c");
+  ASSERT_NE(array, nullptr);
+  EXPECT_EQ(array->kind, JsonKind::kArray);
+  EXPECT_EQ(array->text, "[1,2]");
+}
+
+TEST(KernelPipeJson, RejectsNonIntegerNumbers) {
+  JsonObject object;
+  ASSERT_TRUE(JsonObject::Parse("{\"a\":1.5,\"b\":1e3}", &object));
+  std::int64_t number = 0;
+  EXPECT_FALSE(object.GetInt64("a", &number));
+  EXPECT_FALSE(object.GetInt64("b", &number));
+}
+
+}  // namespace
+}  // namespace lengsuo::fp
diff --git a/lengsuo/native/kernel_pipe_keys.cc b/lengsuo/native/kernel_pipe_keys.cc
new file mode 100644
index 0000000..471bb3e
--- /dev/null
+++ b/lengsuo/native/kernel_pipe_keys.cc
@@ -0,0 +1,173 @@
+#include "kernel_pipe_keys.h"
+
+#include <openssl/digest.h>
+#include <openssl/hkdf.h>
+#include <openssl/sha2.h>
+
+#include <array>
+#include <utility>
+
+#include "kernel_pipe_frame.h"
+
+namespace lengsuo::fp {
+namespace {
+
+// SHA-256 over `data`, as raw bytes.
+bool Sha256(std::string_view data, std::string* out) {
+  out->assign(kKernelPipeMachineKeyBytes, '\0');
+  SHA256(reinterpret_cast<const std::uint8_t*>(data.data()), data.size(),
+         reinterpret_cast<std::uint8_t*>(out->data()));
+  return true;
+}
+
+// The machine-code JSON, in the contract's key order, with the contract's
+// escaping rules. The values are JSON strings; a value that needs escaping
+// is escaped the JSON way so the shape stays well-formed.
+std::string MachineCodeJson(const MachineFacts& facts) {
+  // The four facts in the contract's key order. string_view keeps the
+  // compiler able to see the bounds; the views point into `facts`, which
+  // outlives the loop.
+  const std::array<std::string_view, 4> fields = {
+      facts.os, facts.cpuid, facts.hddid, facts.computername};
+  static constexpr std::array<std::string_view, 4> kKeys = {
+      "os", "cpuid", "hddid", "computername"};
+  static constexpr std::string_view kDigits = "0123456789abcdef";
+  std::string json = "{";
+  for (std::size_t i = 0; i < fields.size(); ++i) {
+    if (i != 0) {
+      json += ",";
+    }
+    json += "\"";
+    json += kKeys[i];
+    json += "\":\"";
+    for (const char c : fields[i]) {
+      switch (c) {
+        case '"': json += "\\\""; break;
+        case '\\': json += "\\\\"; break;
+        case '\b': json += "\\b"; break;
+        case '\f': json += "\\f"; break;
+        case '\n': json += "\\n"; break;
+        case '\r': json += "\\r"; break;
+        case '\t': json += "\\t"; break;
+        default:
+          if (static_cast<unsigned char>(c) < 0x20) {
+            json += "\\u00";
+            json += kDigits[(static_cast<unsigned char>(c) >> 4) & 0x0F];
+            json += kDigits[static_cast<unsigned char>(c) & 0x0F];
+          } else {
+            json += c;
+          }
+      }
+    }
+    json += "\"";
+  }
+  json += "}";
+  return json;
+}
+
+// UTF-16LE encoding of a UTF-8 string, without a BOM. The contract pins
+// UTF-16LE for the machine-code input.
+std::string Utf16Le(std::string_view utf8) {
+  std::string out;
+  std::size_t i = 0;
+  while (i < utf8.size()) {
+    const auto c = static_cast<unsigned char>(utf8[i]);
+    std::uint32_t code = 0;
+    std::size_t width = 1;
+    if (c < 0x80) {
+      code = c;
+    } else if ((c & 0xE0) == 0xC0) {
+      code = c & 0x1Fu;
+      width = 2;
+    } else if ((c & 0xF0) == 0xE0) {
+      code = c & 0x0Fu;
+      width = 3;
+    } else if ((c & 0xF8) == 0xF0) {
+      code = c & 0x07u;
+      width = 4;
+    } else {
+      // A stray continuation byte cannot start a sequence; treat it as
+      // latin-1 so the encoding stays total.
+      code = c;
+    }
+    if (i + width > utf8.size()) {
+      code = c;
+      width = 1;
+    } else {
+      for (std::size_t k = 1; k < width; ++k) {
+        code = (code << 6) |
+               (static_cast<unsigned char>(utf8[i + k]) & 0x3Fu);
+      }
+    }
+    i += width;
+    if (code >= 0x10000) {
+      // A non-BMP code point is a surrogate pair in UTF-16.
+      const std::uint32_t adjusted = code - 0x10000;
+      const std::uint32_t high = 0xD800 + (adjusted >> 10);
+      const std::uint32_t low = 0xDC00 + (adjusted & 0x3FF);
+      out += static_cast<char>(high & 0xFF);
+      out += static_cast<char>((high >> 8) & 0xFF);
+      out += static_cast<char>(low & 0xFF);
+      out += static_cast<char>((low >> 8) & 0xFF);
+    } else {
+      out += static_cast<char>(code & 0xFF);
+      out += static_cast<char>((code >> 8) & 0xFF);
+    }
+  }
+  return out;
+}
+
+}  // namespace
+
+std::string DeriveMachineCode(const MachineFacts& facts) {
+  const std::string json = MachineCodeJson(facts);
+  const std::string utf16 = Utf16Le(json);
+  std::string digest;
+  Sha256(utf16, &digest);
+  std::string hex;
+  hex.reserve(kKernelPipeMachineKeyBytes * 2);
+  wire::AppendHex(&hex, digest);
+  return hex;
+}
+
+bool DeriveMachineKey(std::string_view machine_code, std::string* key_out) {
+  if (key_out == nullptr) {
+    return false;
+  }
+  std::string digest;
+  if (!Sha256(machine_code, &digest)) {
+    return false;
+  }
+  *key_out = std::move(digest);
+  return true;
+}
+
+bool DeriveSessionKeyHkdf(std::string_view machine_key,
+                          std::string_view hello_nonce,
+                          std::string* session_key_out) {
+  if (session_key_out == nullptr) {
+    return false;
+  }
+  if (machine_key.size() != kKernelPipeMachineKeyBytes) {
+    return false;
+  }
+  if (hello_nonce.size() != kKernelPipeHelloNonceBytes) {
+    return false;
+  }
+  std::string derived(kKernelPipeSessionKeyBytes, '\0');
+  const int ok = HKDF(
+      reinterpret_cast<std::uint8_t*>(derived.data()), derived.size(),
+      EVP_sha256(), reinterpret_cast<const std::uint8_t*>(machine_key.data()),
+      machine_key.size(),
+      reinterpret_cast<const std::uint8_t*>(hello_nonce.data()),
+      hello_nonce.size(),
+      reinterpret_cast<const std::uint8_t*>(kKernelPipeSessionInfo),
+      sizeof(kKernelPipeSessionInfo) - 1);
+  if (ok != 1) {
+    return false;
+  }
+  *session_key_out = std::move(derived);
+  return true;
+}
+
+}  // namespace lengsuo::fp
diff --git a/lengsuo/native/kernel_pipe_keys.h b/lengsuo/native/kernel_pipe_keys.h
new file mode 100644
index 0000000..c673fc3
--- /dev/null
+++ b/lengsuo/native/kernel_pipe_keys.h
@@ -0,0 +1,63 @@
+// kernel_pipe_keys - the machine-code derivation of the runner <-> kernel
+// pipe (task Q).
+//
+// Contract section 1: the kernel proves which machine it is by hashing four
+// facts about itself into a machine code, and the runner seals the session
+// key with the key derived from that code. This layer is the kernel's half
+// of that exchange.
+//
+// It is a layer of its own because the derivation is not the envelope:
+//   * the derivation is what the kernel computes for itself, and it is
+//     checked against the contract's fixed vector;
+//   * the envelope is what the runner sends, and it is opened with a key.
+//
+// The envelope lives in kernel_pipe_envelope.{h,cc}.
+#ifndef LENGSUO_NATIVE_KERNEL_PIPE_KEYS_H_
+#define LENGSUO_NATIVE_KERNEL_PIPE_KEYS_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <string_view>
+
+namespace lengsuo::fp {
+
+// The four machine facts the contract fixes, in the contract's key order.
+struct MachineFacts {
+  std::string os;
+  std::string cpuid;
+  std::string hddid;
+  std::string computername;
+};
+
+// Length of the session key and of the machine-code derived key.
+inline constexpr std::size_t kKernelPipeSessionKeyBytes = 32;
+inline constexpr std::size_t kKernelPipeMachineKeyBytes = 32;
+
+// The Hello nonce size, and the size of the AAD that binds the envelope to
+// the handshake that asked for it (frame header + hello nonce).
+inline constexpr std::size_t kKernelPipeHelloNonceBytes = 8;
+
+// The HKDF info string the contract pins.
+inline constexpr char kKernelPipeSessionInfo[] =
+    "lengsuo-kernel-session-v1";
+
+// machine_code = SHA-256(UTF-16LE(fixed-shape JSON)) as lowercase hex.
+// The JSON shape is the contract's: the four fields in the order os, cpuid,
+// hddid, computername.
+std::string DeriveMachineCode(const MachineFacts& facts);
+
+// k_machine = SHA-256(machine_code's ASCII bytes), 32 bytes.
+bool DeriveMachineKey(std::string_view machine_code, std::string* key_out);
+
+// session_key = HKDF-SHA256(ikm=k_machine, salt=hello_nonce, info,
+// L=32). The contract pins this derivation as candidate B; the kernel does
+// not require it (the envelope always carries the key), so this is a
+// cross-check helper, not a mandatory step of the handshake.
+bool DeriveSessionKeyHkdf(std::string_view machine_key,
+                          std::string_view hello_nonce,
+                          std::string* session_key_out);
+
+}  // namespace lengsuo::fp
+
+#endif  // LENGSUO_NATIVE_KERNEL_PIPE_KEYS_H_

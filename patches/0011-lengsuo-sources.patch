+++ b/lengsuo/native/BUILD.gn
@@ -0,0 +1,172 @@
+# Decoder source sets. Chromium integration evidence lives in VERIFICATION.md.
+source_set("profile_wire") {
+  sources = [
+    "profile_wire.cc",
+    "profile_wire.h",
+    "wire_reader.h",
+  ]
+}
+
+source_set("profile_catalog") {
+  sources = [
+    "profile_catalog.cc",
+    "profile_catalog.h",
+  ]
+  public_deps = [ ":profile_wire" ]
+}
+
+source_set("canvas_noise") {
+  sources = [
+    "canvas_apply.cc",
+    "canvas_apply.h",
+    "canvas_noise.cc",
+    "fp_overrides.cc",
+    "fp_overrides.h",
+    "font_family_traits.cc",
+    "font_family_traits.h",
+    "font_metrics.cc",
+    "font_metrics.h",
+    "canvas_noise.h",
+    "product_brand.h",
+  ]
+}
+
+# L3 storage layer. Split into four source sets so each can be pulled in
+# independently by the integration patches; see docs/cc-task-brief-l3.md.
+source_set("storage_pin") {
+  sources = [
+    "storage_pin.cc",
+    "storage_pin.h",
+  ]
+}
+
+source_set("storage_consistency") {
+  sources = [
+    "storage_consistency.cc",
+    "storage_consistency.h",
+  ]
+}
+
+source_set("cache_record") {
+  sources = [
+    "cache_record.cc",
+    "cache_record.h",
+  ]
+}
+
+source_set("extension_pin") {
+  sources = [
+    "extension_pin.cc",
+    "extension_pin.h",
+  ]
+}
+
+# Cookie side of the cross-store lock. It answers three questions from a
+# frozen snapshot: what value a page reads, whether a write must be refused,
+# and how a browser cookie line merges with the snapshot. The Blink wiring
+# is a separate patch; this target is the decision logic on its own.
+source_set("cookie_mirror") {
+  sources = [
+    "cookie_mirror.cc",
+    "cookie_mirror.h",
+  ]
+  public_deps = [ ":storage_consistency" ]
+}
+
+# L3W1 document decoder: the single configuration entry point for the storage
+# layer. It pulls the four primitives above into one target because the
+# decoder's public header exposes all of them in L3Config; consumers only need
+# this label.
+source_set("l3_wire") {
+  sources = [
+    "l3_wire.cc",
+    "l3_wire.h",
+  ]
+  public_deps = [
+    ":cache_record",
+    ":extension_pin",
+    ":storage_consistency",
+    ":storage_pin",
+  ]
+}
+
+# Renderer-side query surface over a frozen snapshot. Blink calls this instead
+# of parsing documents itself.
+source_set("l3_runtime") {
+  sources = [
+    "l3_runtime.cc",
+    "l3_runtime.h",
+  ]
+  public_deps = [ ":l3_wire" ]
+}
+
+# The kernel side of the runner <-> kernel pipe, in four layers. The split is
+# by dependency, not by convenience: the frame codec and the JSON reader must
+# be testable without a crypto library, so they are separate source sets.
+#
+#   kernel_pipe_frame      the 8-byte header and the frame codec
+#   kernel_pipe_json       the shallow JSON reader
+#   kernel_pipe_keys       the machine-code derivation (BoringSSL)
+#   kernel_pipe_envelope   the KeyEnvelope (BoringSSL)
+#   kernel_pipe            the handshake and the frozen config bundle
+#
+# All of them are pure logic - no Chromium types - so they compile standalone
+# for the gtest targets as well.
+source_set("kernel_pipe_frame") {
+  sources = [
+    "kernel_pipe_frame.cc",
+    "kernel_pipe_frame.h",
+  ]
+}
+
+source_set("kernel_pipe_json") {
+  sources = [
+    "kernel_pipe_json.cc",
+    "kernel_pipe_json.h",
+  ]
+}
+
+source_set("kernel_pipe_keys") {
+  sources = [
+    "kernel_pipe_keys.cc",
+    "kernel_pipe_keys.h",
+  ]
+  public_deps = [ ":kernel_pipe_frame" ]
+  deps = [ "//third_party/boringssl" ]
+}
+
+source_set("kernel_pipe_envelope") {
+  sources = [
+    "kernel_pipe_envelope.cc",
+    "kernel_pipe_envelope.h",
+  ]
+  public_deps = [
+    ":kernel_pipe_frame",
+    ":kernel_pipe_keys",
+  ]
+  deps = [ "//third_party/boringssl" ]
+}
+
+source_set("kernel_pipe") {
+  sources = [
+    "kernel_pipe.cc",
+    "kernel_pipe.h",
+  ]
+  public_deps = [
+    ":kernel_pipe_envelope",
+    ":kernel_pipe_frame",
+    ":kernel_pipe_json",
+    ":kernel_pipe_keys",
+  ]
+  deps = [ "//third_party/boringssl" ]
+}
+
+# The uplink action table: an action name and the structural validator for its
+# payload. One table, no new interface per action.
+source_set("action_table") {
+  sources = [
+    "action_table.cc",
+    "action_table.h",
+  ]
+  public_deps = [ ":kernel_pipe_json" ]
+}
diff --git a/lengsuo/native/action_table.cc b/lengsuo/native/action_table.cc
new file mode 100644
index 0000000..1670ba3
--- /dev/null
+++ b/lengsuo/native/action_table.cc
@@ -0,0 +1,191 @@
+#include "action_table.h"
+
+#include <utility>
+
+namespace lengsuo::fp {
+namespace {
+
+// The table's rows (contract section 4).
+//
+// The field names are copied from the contract's schema table; the types are
+// the ones the reference implementation's payloads actually use. `drew_text`
+// is optional for CanvasSample and absent for WebGLSample - the contract
+// draws that distinction on purpose.
+//
+// `data_url` is listed as a required field because the reference payload
+// carries it, but the collector policy has the last word: with the policy
+// off, a payload that carries the field is rejected rather than trimmed.
+
+ActionField String(std::string name, bool optional = false) {
+  ActionField field;
+  field.name = std::move(name);
+  field.kind = FieldKind::kString;
+  field.optional = optional;
+  return field;
+}
+
+ActionField Integer(std::string name, bool optional = false) {
+  ActionField field;
+  field.name = std::move(name);
+  field.kind = FieldKind::kInteger;
+  field.optional = optional;
+  return field;
+}
+
+ActionField Boolean(std::string name, bool optional = false) {
+  ActionField field;
+  field.name = std::move(name);
+  field.kind = FieldKind::kBoolean;
+  field.optional = optional;
+  return field;
+}
+
+}  // namespace
+
+ActionTable::~ActionTable() = default;
+
+ActionTable::ActionTable() {
+  schemas_.push_back(ActionSchema{
+      kActionCanvasSample,
+      {String("from"), String("action"), String("profile"),
+       Integer("width"), Integer("length"), String("url"),
+       Boolean("drew_text", /*optional=*/true), String("hash"),
+       String(kActionDataUrlField)}});
+  schemas_.push_back(ActionSchema{
+      kActionWebGLSample,
+      {String("from"), String("action"), String("profile"),
+       Integer("width"), Integer("length"), String("url"), String("hash"),
+       String(kActionDataUrlField)}});
+  schemas_.push_back(ActionSchema{
+      kActionPageEvent, {String("from"), String("action"), String("url")}});
+  schemas_.push_back(ActionSchema{
+      kActionHeartbeat,
+      {String("from"), String("action"), Integer("ts_unix")}});
+}
+
+const ActionTable& ActionTable::Get() {
+  static const ActionTable* table = new ActionTable();
+  return *table;
+}
+
+bool ActionTable::Knows(std::string_view action) const {
+  return Find(action) != nullptr;
+}
+
+const ActionSchema* ActionTable::Find(std::string_view action) const {
+  for (const ActionSchema& schema : schemas_) {
+    if (schema.action == action) {
+      return &schema;
+    }
+  }
+  return nullptr;
+}
+
+std::vector<std::string> ActionTable::Names() const {
+  std::vector<std::string> names;
+  names.reserve(schemas_.size());
+  for (const ActionSchema& schema : schemas_) {
+    names.push_back(schema.action);
+  }
+  return names;
+}
+
+ActionValidation ValidateActionPayload(const ActionTable& table,
+                                       std::string_view action,
+                                       std::string_view payload,
+                                       const ActionCollectorPolicy& policy,
+                                       std::string* action_out) {
+  ActionValidation result;
+  if (payload.size() > kActionMaxPayloadBytes) {
+    result.reason = ActionRejectReason::kPayloadTooLarge;
+    return result;
+  }
+  const ActionSchema* schema = table.Find(action);
+  if (schema == nullptr) {
+    result.reason = ActionRejectReason::kUnknownAction;
+    return result;
+  }
+  JsonObject object;
+  if (!JsonObject::Parse(payload, &object)) {
+    result.reason = ActionRejectReason::kMalformedJson;
+    return result;
+  }
+  // The payload must name the action it is filed under. Without this a
+  // CanvasSample's bytes could be filed as a PageEvent and pass the looser
+  // schema.
+  std::string named;
+  if (!object.GetString("action", &named)) {
+    result.reason = ActionRejectReason::kMissingField;
+    result.field = "action";
+    return result;
+  }
+  if (named != schema->action) {
+    result.reason = ActionRejectReason::kActionMismatch;
+    result.field = "action";
+    return result;
+  }
+  for (const ActionField& field : schema->fields) {
+    if (field.name == kActionDataUrlField && !policy.data_url_allowed()) {
+      // The bitmap is not collected by default. A payload that carries one
+      // is rejected, not trimmed: a trimmed sample would say something the
+      // collector did not measure.
+      if (object.Has(field.name)) {
+        result.reason = ActionRejectReason::kDataUrlNotAllowed;
+        result.field = field.name;
+        return result;
+      }
+      continue;
+    }
+    const JsonValue* value = object.Find(field.name);
+    if (value == nullptr) {
+      if (field.optional) {
+        continue;
+      }
+      result.reason = ActionRejectReason::kMissingField;
+      result.field = field.name;
+      return result;
+    }
+    switch (field.kind) {
+      case FieldKind::kString:
+        if (value->kind != JsonKind::kString) {
+          result.reason = ActionRejectReason::kWrongType;
+          result.field = field.name;
+          return result;
+        }
+        break;
+      case FieldKind::kInteger: {
+        if (value->kind != JsonKind::kNumber) {
+          result.reason = ActionRejectReason::kWrongType;
+          result.field = field.name;
+          return result;
+        }
+        std::int64_t number = 0;
+        if (!object.GetInt64(field.name, &number)) {
+          result.reason = ActionRejectReason::kWrongType;
+          result.field = field.name;
+          return result;
+        }
+        break;
+      }
+      case FieldKind::kBoolean:
+        if (value->kind != JsonKind::kBoolean) {
+          result.reason = ActionRejectReason::kWrongType;
+          result.field = field.name;
+          return result;
+        }
+        break;
+    }
+  }
+  result.ok = true;
+  result.reason = ActionRejectReason::kNone;
+  if (action_out != nullptr) {
+    *action_out = named;
+  }
+  return result;
+}
+
+std::size_t ActionEventLogBytes(std::string_view payload) {
+  return payload.size();
+}
+
+}  // namespace lengsuo::fp
diff --git a/lengsuo/native/action_table.h b/lengsuo/native/action_table.h
new file mode 100644
index 0000000..244b119
--- /dev/null
+++ b/lengsuo/native/action_table.h
@@ -0,0 +1,171 @@
+// action_table - the uplink action table (task Q).
+//
+// The uplink carries events to the runner over the same pipe as the
+// downlink. The contract (docs/kernel-wire-contract.md section 4) fixes the
+// shape: every event is an `Event` frame whose JSON payload names an
+// `action`, and the action's name selects a schema. There is no new
+// interface per action - one frame type, one table, a growing list of names.
+//
+// The table's job is structural: is this payload the shape the action
+// declares? It does not decide whether the values make sense (a canvas
+// sample of width 0 is structurally fine and is not this table's business).
+//
+// Two rules are not negotiable:
+//
+//   * `data_url` is a canvas bitmap. It is NOT collected by default - the
+//     privacy cost and the bandwidth cost are both real. A payload that
+//     carries one is rejected unless collection was explicitly turned on.
+//   * A payload that fails validation is dropped and counted. It is never
+//     sent, and it never becomes an error the browser has to care about.
+#ifndef LENGSUO_NATIVE_ACTION_TABLE_H_
+#define LENGSUO_NATIVE_ACTION_TABLE_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "kernel_pipe_json.h"
+
+namespace lengsuo::fp {
+
+// The action names the table knows (contract section 4).
+inline constexpr char kActionCanvasSample[] = "CanvasSample";
+inline constexpr char kActionWebGLSample[] = "WebGLSample";
+inline constexpr char kActionPageEvent[] = "PageEvent";
+inline constexpr char kActionHeartbeat[] = "Heartbeat";
+
+// The field that carries the bitmap. The table checks for it by name so a
+// payload cannot smuggle one past the check under a different spelling.
+inline constexpr char kActionDataUrlField[] = "data_url";
+
+// The largest payload the table will look at. A payload beyond this is
+// dropped and counted rather than parsed: an unbounded payload is a way to
+// make the browser allocate.
+inline constexpr std::size_t kActionMaxPayloadBytes = 1024 * 1024;
+
+// How one field is constrained.
+enum class FieldKind {
+  kString,   // a JSON string
+  kInteger,  // a JSON integer
+  kBoolean,  // a JSON boolean
+};
+
+// One field of an action's schema.
+struct ActionField {
+  std::string name;
+  FieldKind kind = FieldKind::kString;
+  // When true the field may be absent. A required field that is missing
+  // fails the payload.
+  bool optional = false;
+};
+
+// One row of the table: an action's name and the schema of its payload.
+struct ActionSchema {
+  std::string action;
+  std::vector<ActionField> fields;
+};
+
+// The table of known actions.
+class ActionTable {
+ public:
+  // The destructor is defined in the .cc: the class owns a vector, so it is
+  // not a trivial type and Chromium's style checker wants the special
+  // members out of line.
+  ~ActionTable();
+  ActionTable(const ActionTable&) = delete;
+  ActionTable& operator=(const ActionTable&) = delete;
+  ActionTable(ActionTable&&) = delete;
+  ActionTable& operator=(ActionTable&&) = delete;
+
+  // The singleton table: the action list is fixed by the contract, so
+  // there is exactly one of it.
+  static const ActionTable& Get();
+
+  // True when `action` is a name the table knows.
+  bool Knows(std::string_view action) const;
+
+  // The schema for `action`, or nullptr when the name is unknown.
+  const ActionSchema* Find(std::string_view action) const;
+
+  // Every known action's name, in table order.
+  std::vector<std::string> Names() const;
+
+ private:
+  ActionTable();
+  std::vector<ActionSchema> schemas_;
+};
+
+// Why a payload was rejected. The reasons are structural; none of them
+// carries a byte of the payload.
+enum class ActionRejectReason {
+  kNone,
+  kPayloadTooLarge,
+  kMalformedJson,
+  kUnknownAction,
+  kActionMismatch,   // the payload's action field is not the action asked for
+  kMissingField,
+  kWrongType,
+  kDataUrlNotAllowed,
+};
+
+// The outcome of validating one uplink payload.
+struct ActionValidation {
+  bool ok = false;
+  ActionRejectReason reason = ActionRejectReason::kNone;
+  // The offending field's name, when the reason is about a field. Empty
+  // otherwise. A field *name* is not payload content.
+  std::string field;
+};
+
+// Whether the canvas bitmap may be collected. Off by default.
+//
+// The bitmap is the most sensitive thing on this channel and the most
+// expensive: a full-page canvas is megabytes of base64 per sample. It is
+// only collected when the caller explicitly says so.
+class ActionCollectorPolicy {
+ public:
+  ActionCollectorPolicy() = default;
+  ~ActionCollectorPolicy() = default;
+  ActionCollectorPolicy(const ActionCollectorPolicy&) = default;
+  ActionCollectorPolicy& operator=(const ActionCollectorPolicy&) = default;
+  ActionCollectorPolicy(ActionCollectorPolicy&&) = default;
+  ActionCollectorPolicy& operator=(ActionCollectorPolicy&&) = default;
+
+  bool data_url_allowed() const { return data_url_allowed_; }
+  // Turns the collection of `data_url` on or off. Turning it on is the
+  // caller's decision and must be explicit.
+  void set_data_url_allowed(bool allowed) { data_url_allowed_ = allowed; }
+
+ private:
+  bool data_url_allowed_ = false;
+};
+
+// Validates one uplink payload against the table.
+//
+// `action` is the action the caller believes it is sending; the payload
+// must name the same action in its `action` field. That check is what keeps
+// a payload from being filed under the wrong schema.
+//
+// `policy` decides whether `data_url` may be carried. A payload that has
+// the field while the policy forbids it is rejected as kDataUrlNotAllowed -
+// it is not quietly stripped, because a stripped payload would make the
+// sample mean something different from what was collected.
+//
+// Returns a validation result. On success the payload's action name is
+// written to `*action_out` when it is non-null.
+ActionValidation ValidateActionPayload(const ActionTable& table,
+                                       std::string_view action,
+                                       std::string_view payload,
+                                       const ActionCollectorPolicy& policy,
+                                       std::string* action_out = nullptr);
+
+// The number of bytes an event's log line should carry. The contract says
+// the log records the action name and the byte count and nothing else, so
+// this is the only size the caller is allowed to report.
+std::size_t ActionEventLogBytes(std::string_view payload);
+
+}  // namespace lengsuo::fp
+
+#endif  // LENGSUO_NATIVE_ACTION_TABLE_H_
diff --git a/lengsuo/native/action_table_test.cc b/lengsuo/native/action_table_test.cc
new file mode 100644
index 0000000..f501647
--- /dev/null
+++ b/lengsuo/native/action_table_test.cc
@@ -0,0 +1,311 @@
+// action_table_test - the uplink action table (task Q).
+//
+// The table is structural, so the tests are structural too: a payload that
+// has the declared fields with the declared kinds passes, and everything else
+// is rejected with a reason. The two rules the contract makes non-negotiable
+// get their own tests: `data_url` is not collected by default, and a
+// rejected payload is dropped rather than repaired.
+#include "action_table.h"
+
+#include <gtest/gtest.h>
+
+#include <string>
+#include <vector>
+
+namespace lengsuo::fp {
+namespace {
+
+// A payload that satisfies the CanvasSample schema, minus the bitmap.
+const char kCanvas[] =
+    R"({"from":"renderer","action":"CanvasSample","profile":"p1",)"
+    R"("width":300,"length":150,"url":"https://example.test/a",)"
+    R"("drew_text":true,"hash":"deadbeef"})";
+
+const char kWebGL[] =
+    R"({"from":"renderer","action":"WebGLSample","profile":"p1",)"
+    R"("width":64,"length":64,"url":"https://example.test/b",)"
+    R"("hash":"cafe"})";
+
+const char kPageEvent[] =
+    R"({"from":"browser","action":"PageEvent","url":"https://example.test/"})";
+
+const char kHeartbeat[] =
+    R"({"from":"kernel","action":"Heartbeat","ts_unix":1700000000})";
+
+// The action name a payload declares.
+std::string ActionOf(const char* payload) {
+  JsonObject object;
+  if (!JsonObject::Parse(payload, &object)) {
+    return "";
+  }
+  std::string action;
+  if (!object.GetString("action", &action)) {
+    return "";
+  }
+  return action;
+}
+
+TEST(ActionTable, KnowsTheFourContractActions) {
+  const ActionTable& table = ActionTable::Get();
+  EXPECT_TRUE(table.Knows(kActionCanvasSample));
+  EXPECT_TRUE(table.Knows(kActionWebGLSample));
+  EXPECT_TRUE(table.Knows(kActionPageEvent));
+  EXPECT_TRUE(table.Knows(kActionHeartbeat));
+  EXPECT_FALSE(table.Knows("NoSuchAction"));
+  EXPECT_FALSE(table.Knows(""));
+  // A name is matched whole: a prefix is not a name.
+  EXPECT_FALSE(table.Knows("Canvas"));
+  EXPECT_FALSE(table.Knows("canvassample"));
+}
+
+TEST(ActionTable, NamesListsEveryActionInOrder) {
+  const std::vector<std::string> names = ActionTable::Get().Names();
+  ASSERT_EQ(names.size(), 4u);
+  for (const std::string& name : names) {
+    EXPECT_TRUE(ActionTable::Get().Knows(name));
+  }
+  // The order is fixed so the client's mirror can compare lists.
+  EXPECT_EQ(names[0], kActionCanvasSample);
+  EXPECT_EQ(names[1], kActionWebGLSample);
+  EXPECT_EQ(names[2], kActionPageEvent);
+  EXPECT_EQ(names[3], kActionHeartbeat);
+}
+
+TEST(ActionTable, FindReturnsNullForAnUnknownName) {
+  EXPECT_EQ(ActionTable::Get().Find("NoSuchAction"), nullptr);
+  const ActionSchema* schema = ActionTable::Get().Find(kActionPageEvent);
+  ASSERT_NE(schema, nullptr);
+  EXPECT_EQ(schema->action, kActionPageEvent);
+}
+
+TEST(ActionTable, CanvasSchemaHasDrewTextAndDataUrl) {
+  const ActionSchema* schema = ActionTable::Get().Find(kActionCanvasSample);
+  ASSERT_NE(schema, nullptr);
+  const ActionField* drew_text = nullptr;
+  const ActionField* data_url = nullptr;
+  for (const ActionField& field : schema->fields) {
+    if (field.name == "drew_text") {
+      drew_text = &field;
+    }
+    if (field.name == kActionDataUrlField) {
+      data_url = &field;
+    }
+  }
+  ASSERT_NE(drew_text, nullptr);
+  EXPECT_EQ(drew_text->kind, FieldKind::kBoolean);
+  EXPECT_TRUE(drew_text->optional);
+  ASSERT_NE(data_url, nullptr);
+  EXPECT_EQ(data_url->kind, FieldKind::kString);
+}
+
+TEST(ActionTable, WebGlSchemaHasNoDrewText) {
+  const ActionSchema* schema = ActionTable::Get().Find(kActionWebGLSample);
+  ASSERT_NE(schema, nullptr);
+  for (const ActionField& field : schema->fields) {
+    EXPECT_NE(field.name, "drew_text");
+  }
+}
+
+TEST(ActionTable, PageEventSchemaIsFromActionUrl) {
+  const ActionSchema* schema = ActionTable::Get().Find(kActionPageEvent);
+  ASSERT_NE(schema, nullptr);
+  ASSERT_EQ(schema->fields.size(), 3u);
+  EXPECT_EQ(schema->fields[0].name, "from");
+  EXPECT_EQ(schema->fields[1].name, "action");
+  EXPECT_EQ(schema->fields[2].name, "url");
+}
+
+TEST(ActionTable, HeartbeatSchemaCarriesATimestamp) {
+  const ActionSchema* schema = ActionTable::Get().Find(kActionHeartbeat);
+  ASSERT_NE(schema, nullptr);
+  const ActionField* ts = nullptr;
+  for (const ActionField& field : schema->fields) {
+    if (field.name == "ts_unix") {
+      ts = &field;
+    }
+  }
+  ASSERT_NE(ts, nullptr);
+  EXPECT_EQ(ts->kind, FieldKind::kInteger);
+  EXPECT_FALSE(ts->optional);
+}
+
+TEST(ActionValidate, AcceptsTheFourContractPayloads) {
+  const ActionTable& table = ActionTable::Get();
+  const ActionCollectorPolicy policy;
+  for (const char* payload : {kCanvas, kWebGL, kPageEvent, kHeartbeat}) {
+    const std::string action = ActionOf(payload);
+    std::string reported;
+    const ActionValidation result =
+        ValidateActionPayload(table, action, payload, policy, &reported);
+    EXPECT_TRUE(result.ok) << payload;
+    EXPECT_EQ(result.reason, ActionRejectReason::kNone) << payload;
+    EXPECT_EQ(reported, action);
+  }
+}
+
+TEST(ActionValidate, RejectsAnUnknownAction) {
+  const ActionTable& table = ActionTable::Get();
+  const ActionCollectorPolicy policy;
+  const ActionValidation result =
+      ValidateActionPayload(table, "NoSuchAction", kPageEvent, policy);
+  EXPECT_FALSE(result.ok);
+  EXPECT_EQ(result.reason, ActionRejectReason::kUnknownAction);
+}
+
+TEST(ActionValidate, RejectsAPayloadFiledUnderTheWrongAction) {
+  const ActionTable& table = ActionTable::Get();
+  const ActionCollectorPolicy policy;
+  // A CanvasSample filed as a PageEvent must not slip through the looser
+  // PageEvent schema.
+  const ActionValidation result =
+      ValidateActionPayload(table, kActionPageEvent, kCanvas, policy);
+  EXPECT_FALSE(result.ok);
+  EXPECT_EQ(result.reason, ActionRejectReason::kActionMismatch);
+  EXPECT_EQ(result.field, "action");
+}
+
+TEST(ActionValidate, RejectsMalformedJson) {
+  const ActionTable& table = ActionTable::Get();
+  const ActionCollectorPolicy policy;
+  for (const char* payload : {"", "{", "not json", "{\"a\":}"}) {
+    const ActionValidation result =
+        ValidateActionPayload(table, kActionPageEvent, payload, policy);
+    EXPECT_FALSE(result.ok) << payload;
+    EXPECT_EQ(result.reason, ActionRejectReason::kMalformedJson) << payload;
+  }
+}
+
+TEST(ActionValidate, RejectsAMissingRequiredField) {
+  const ActionTable& table = ActionTable::Get();
+  const ActionCollectorPolicy policy;
+  // "url" is required on PageEvent.
+  const char kNoUrl[] = R"({"from":"browser","action":"PageEvent"})";
+  const ActionValidation result =
+      ValidateActionPayload(table, kActionPageEvent, kNoUrl, policy);
+  EXPECT_FALSE(result.ok);
+  EXPECT_EQ(result.reason, ActionRejectReason::kMissingField);
+  EXPECT_EQ(result.field, "url");
+}
+
+TEST(ActionValidate, RejectsAWrongType) {
+  const ActionTable& table = ActionTable::Get();
+  const ActionCollectorPolicy policy;
+  // "ts_unix" must be an integer.
+  const char kStringTs[] =
+      R"({"from":"kernel","action":"Heartbeat","ts_unix":"1700000000"})";
+  ActionValidation result =
+      ValidateActionPayload(table, kActionHeartbeat, kStringTs, policy);
+  EXPECT_FALSE(result.ok);
+  EXPECT_EQ(result.reason, ActionRejectReason::kWrongType);
+  EXPECT_EQ(result.field, "ts_unix");
+
+  // "from" must be a string.
+  const char kNumberFrom[] =
+      R"({"from":7,"action":"PageEvent","url":"https://example.test/"})";
+  result = ValidateActionPayload(table, kActionPageEvent, kNumberFrom, policy);
+  EXPECT_FALSE(result.ok);
+  EXPECT_EQ(result.reason, ActionRejectReason::kWrongType);
+  EXPECT_EQ(result.field, "from");
+}
+
+TEST(ActionValidate, RejectsAFractionalInteger) {
+  const ActionTable& table = ActionTable::Get();
+  const ActionCollectorPolicy policy;
+  const char kFractionalTs[] =
+      R"({"from":"kernel","action":"Heartbeat","ts_unix":1.5})";
+  const ActionValidation result =
+      ValidateActionPayload(table, kActionHeartbeat, kFractionalTs, policy);
+  EXPECT_FALSE(result.ok);
+  EXPECT_EQ(result.reason, ActionRejectReason::kWrongType);
+  EXPECT_EQ(result.field, "ts_unix");
+}
+
+TEST(ActionValidate, DrewTextIsOptional) {
+  const ActionTable& table = ActionTable::Get();
+  const ActionCollectorPolicy policy;
+  const char kNoDrewText[] =
+      R"({"from":"renderer","action":"CanvasSample","profile":"p1",)"
+      R"("width":300,"length":150,"url":"https://example.test/a",)"
+      R"("hash":"deadbeef"})";
+  const ActionValidation result =
+      ValidateActionPayload(table, kActionCanvasSample, kNoDrewText, policy);
+  EXPECT_TRUE(result.ok);
+  EXPECT_EQ(result.reason, ActionRejectReason::kNone);
+}
+
+TEST(ActionValidate, DataUrlIsNotCollectedByDefault) {
+  const ActionTable& table = ActionTable::Get();
+  const ActionCollectorPolicy policy;
+  EXPECT_FALSE(policy.data_url_allowed());
+  const char kWithBitmap[] =
+      R"({"from":"renderer","action":"CanvasSample","profile":"p1",)"
+      R"("width":300,"length":150,"url":"https://example.test/a",)"
+      R"("hash":"deadbeef","data_url":"data:image/png;base64,AAAA"})";
+  const ActionValidation result =
+      ValidateActionPayload(table, kActionCanvasSample, kWithBitmap, policy);
+  EXPECT_FALSE(result.ok);
+  EXPECT_EQ(result.reason, ActionRejectReason::kDataUrlNotAllowed);
+  EXPECT_EQ(result.field, kActionDataUrlField);
+}
+
+TEST(ActionValidate, DataUrlIsAcceptedWhenExplicitlyEnabled) {
+  const ActionTable& table = ActionTable::Get();
+  ActionCollectorPolicy policy;
+  policy.set_data_url_allowed(true);
+  EXPECT_TRUE(policy.data_url_allowed());
+  const char kWithBitmap[] =
+      R"({"from":"renderer","action":"CanvasSample","profile":"p1",)"
+      R"("width":300,"length":150,"url":"https://example.test/a",)"
+      R"("hash":"deadbeef","data_url":"data:image/png;base64,AAAA"})";
+  const ActionValidation result =
+      ValidateActionPayload(table, kActionCanvasSample, kWithBitmap, policy);
+  EXPECT_TRUE(result.ok);
+  EXPECT_EQ(result.reason, ActionRejectReason::kNone);
+}
+
+TEST(ActionValidate, TheBitmapIsRejectedNotTrimmed) {
+  const ActionTable& table = ActionTable::Get();
+  const ActionCollectorPolicy policy;
+  // With collection off, the payload is rejected outright. It is not
+  // stripped down to a bitmap-less sample: a trimmed payload would claim a
+  // measurement that was never taken.
+  const char kWithBitmap[] =
+      R"({"from":"renderer","action":"WebGLSample","profile":"p1",)"
+      R"("width":64,"length":64,"url":"https://example.test/b",)"
+      R"("hash":"cafe","data_url":"data:image/png;base64,AAAA"})";
+  const ActionValidation result =
+      ValidateActionPayload(table, kActionWebGLSample, kWithBitmap, policy);
+  EXPECT_FALSE(result.ok);
+  EXPECT_EQ(result.reason, ActionRejectReason::kDataUrlNotAllowed);
+}
+
+TEST(ActionValidate, RejectsAnOversizedPayload) {
+  const ActionTable& table = ActionTable::Get();
+  const ActionCollectorPolicy policy;
+  const std::string huge(kActionMaxPayloadBytes + 1, 'x');
+  const ActionValidation result =
+      ValidateActionPayload(table, kActionPageEvent, huge, policy);
+  EXPECT_FALSE(result.ok);
+  EXPECT_EQ(result.reason, ActionRejectReason::kPayloadTooLarge);
+}
+
+TEST(ActionValidate, TheActionOutParameterIsOnlyWrittenOnSuccess) {
+  const ActionTable& table = ActionTable::Get();
+  const ActionCollectorPolicy policy;
+  std::string reported = "untouched";
+  const ActionValidation result =
+      ValidateActionPayload(table, kActionPageEvent, kCanvas, policy, &reported);
+  EXPECT_FALSE(result.ok);
+  EXPECT_EQ(reported, "untouched");
+}
+
+TEST(ActionEventLog, CountsThePayloadBytes) {
+  EXPECT_EQ(ActionEventLogBytes(kPageEvent), std::string(kPageEvent).size());
+  EXPECT_EQ(ActionEventLogBytes(""), 0u);
+  // The log carries a size, not the payload: the helper returns a count and
+  // nothing else, so there is no way to leak the bytes through it.
+  EXPECT_EQ(ActionEventLogBytes(kCanvas), std::string(kCanvas).size());
+}

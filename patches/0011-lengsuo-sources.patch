@@ -0,0 +1,5 @@
+// The traits decoder is header-only (native/font_family_traits.h). This
+// translation unit exists so the CMake and GN targets have a stable source and
+// the header is compiled and -Werror-checked even when only the library, not
+// the test, is built.
+#include "font_family_traits.h"
diff --git a/lengsuo/native/font_family_traits.h b/lengsuo/native/font_family_traits.h
new file mode 100644
index 0000000..3c13a76
--- /dev/null
+++ b/lengsuo/native/font_family_traits.h
@@ -0,0 +1,156 @@
+// font_family_traits - the fonts dimension's {switcher, value, mask} shape.
+//
+// docs/cc-task-rulings.md §C: 对标端 gives every overridable dimension the same
+// shape -- {switcher, value, default_value} -- and for fonts the value is a
+// semicolon-separated family string ("Arial;Arial Black"), not a structured
+// list. Our profile encodes the fonts dimension as one slot number, which is
+// why nothing consumed it; this header is the missing decoder from that slot
+// plus the switch's value/mask fields into the shape the mechanism needs.
+//
+// It does NOT carry a font inventory. 对标端's full family pool lives on its
+// server and was never captured, so no list is invented here: an empty value
+// is a legitimate statement ("use the mask"), and the family names are only
+// ever the ones the profile actually sent.
+//
+// Header-only: three small operations over caller-owned strings, compiled both
+// into the standalone native tests and into Blink (no platform headers).
+//
+// Contract doc: docs/font-dimension.md.
+#ifndef LENGSUO_NATIVE_FONT_FAMILY_TRAITS_H_
+#define LENGSUO_NATIVE_FONT_FAMILY_TRAITS_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace lengsuo::fonts {
+
+// Upper bounds are what the profile wire accepts for the same fields
+// (profile_wire.cc), so a hostile payload cannot make the switch accept what
+// the wire rejects.
+inline constexpr std::size_t kMaxFamilyName = 128;
+inline constexpr std::size_t kMaxFamilyValue = 4096;
+inline constexpr std::size_t kMaxFamilyCount = 64;
+
+struct FamilyTraits {
+  // False when the profile said nothing about fonts (slot 0) or the payload was
+  // malformed; the caller must then leave measurement byte-identical to native.
+  bool installed{false};
+  // The profile's raw font slot, kept for diagnostics/tests.
+  std::uint32_t slot{};
+  // The family names the profile declared, in wire order. May be empty: a mask
+  // can ask for metric perturbation without naming families.
+  std::vector<std::string> families;
+  // Whether the font metric perturbation is active. True iff installed and the
+  // profile made a statement: a non-empty value, or a non-zero family mask.
+  bool perturbs_metrics{false};
+};
+
+// Splits 对标端's semicolon-separated value. Blank elements and duplicates are
+// dropped; interior spaces are preserved (family names may contain them). A
+// malformed element rejects the whole value (returns empty).
+std::vector<std::string> ParseSemicolonFamilies(std::string_view value);
+
+// Decodes (slot, value, mask) into the mechanism's input.
+//
+//   * slot == 0              -> not installed: "the profile said nothing",
+//                               identical to the GPU dimension's slot 0.
+//   * value non-empty        -> installed; a non-empty family list is itself
+//                               the statement, so metrics are perturbed even
+//                               when mask is 0 (the service default).
+//   * value empty, mask != 0 -> installed; the mask is the only statement.
+//   * value empty, mask == 0 -> installed but dormant: nothing declares a
+//                               change, so measurement stays native.
+//
+// A malformed value (oversize, too many or oversized names, control bytes)
+// yields a not-installed result rather than a half-parsed one.
+FamilyTraits ParseFamilyTraits(std::uint32_t slot, std::string_view value,
+                               std::uint32_t mask);
+
+// ---------------------------------------------------------------------------
+// Implementation (header-only).
+// ---------------------------------------------------------------------------
+namespace internal {
+
+inline bool ValidFamily(std::string_view family) {
+  if (family.empty() || family.size() > kMaxFamilyName) {
+    return false;
+  }
+  for (const char character : family) {
+    const auto byte = static_cast<unsigned char>(character);
+    if (byte < 32 || byte > 126) {
+      return false;
+    }
+  }
+  return true;
+}
+
+}  // namespace internal
+
+inline std::vector<std::string> ParseSemicolonFamilies(std::string_view value) {
+  std::vector<std::string> families;
+  std::size_t start = 0;
+  while (start < value.size()) {
+    const std::size_t semicolon = value.find(';', start);
+    const std::size_t end =
+        semicolon == std::string_view::npos ? value.size() : semicolon;
+    const std::string_view element = value.substr(start, end - start);
+    const bool blank = element.find_first_not_of(' ') == std::string_view::npos;
+    if (!blank) {
+      if (!internal::ValidFamily(element) ||
+          families.size() >= kMaxFamilyCount) {
+        return {};  // malformed: reject the whole value, not one element
+      }
+      bool duplicate = false;
+      for (const auto& existing : families) {
+        if (existing == element) {
+          duplicate = true;
+          break;
+        }
+      }
+      if (!duplicate) {
+        families.emplace_back(element);
+      }
+    }
+    if (semicolon == std::string_view::npos) {
+      break;
+    }
+    start = semicolon + 1;
+  }
+  return families;
+}
+
+inline FamilyTraits ParseFamilyTraits(std::uint32_t slot,
+                                      std::string_view value,
+                                      std::uint32_t mask) {
+  FamilyTraits traits;
+  traits.slot = slot;
+  if (slot == 0) {
+    return traits;  // the profile said nothing about fonts
+  }
+  if (value.size() > kMaxFamilyValue) {
+    return traits;  // too large: not installed, never half-parsed
+  }
+  for (const char character : value) {
+    const auto byte = static_cast<unsigned char>(character);
+    if (byte < 32 || byte > 126) {
+      return traits;  // control bytes are never a valid family list
+    }
+  }
+  traits.families = ParseSemicolonFamilies(value);
+  // ParseSemicolonFamilies returns {} both for "empty" and for "malformed"; a
+  // non-empty value that parsed to nothing is the malformed case.
+  const bool blank = value.find_first_not_of("; ") == std::string_view::npos;
+  if (!blank && traits.families.empty()) {
+    return traits;  // malformed (oversize/too many names): stay native
+  }
+  traits.installed = true;
+  traits.perturbs_metrics = !traits.families.empty() || mask != 0;
+  return traits;
+}
+
+}  // namespace lengsuo::fonts
+
+#endif  // LENGSUO_NATIVE_FONT_FAMILY_TRAITS_H_
diff --git a/lengsuo/native/font_metrics.cc b/lengsuo/native/font_metrics.cc
new file mode 100644
index 0000000..ae59b33
--- /dev/null
+++ b/lengsuo/native/font_metrics.cc
@@ -0,0 +1,60 @@
+// font_metrics v1 - implementation. See font_metrics.h for the contract.
+//
+// The arithmetic mirrors tests/font_metrics_ref.py line for line: a single
+// SplitMix64 finalizer (the same Mix() fp_overrides.cc uses for canvas/audio,
+// so every dimension shares one seed-derivation discipline) over the seed
+// salted with the quantized native advance. The salt makes two glyphs in one
+// string independent while keeping a given glyph fixed for a given profile.
+
+#include "font_metrics.h"
+
+#include <cmath>
+
+namespace lengsuo::fonts {
+namespace {
+
+constexpr std::uint64_t kConstMixAdd = 0x9E3779B97F4A7C15ULL;
+constexpr std::uint64_t kConstMixMul1 = 0xBF58476D1CE4E5B9ULL;
+constexpr std::uint64_t kConstMixMul2 = 0x94D049BB133111EBULL;
+constexpr std::uint64_t kConstSalt = 0x9E3779B97F4A7C15ULL;
+
+}  // namespace
+
+std::uint64_t MixForTest(std::uint64_t x) {
+  x += kConstMixAdd;
+  x = (x ^ (x >> 30)) * kConstMixMul1;
+  x = (x ^ (x >> 27)) * kConstMixMul2;
+  return x ^ (x >> 31);
+}
+
+FontNoiseResult PerturbAdvance(const FontNoiseConfig& config) {
+  FontNoiseResult result;
+  result.advance = config.advance;
+  // Off conditions: no dimension, no stream, or nothing to perturb.
+  if (!config.enabled || config.seed == 0 || !(config.advance > 0.0f)) {
+    result.status = FontNoiseStatus::kDisabled;
+    return result;
+  }
+  // Quantize the native advance to the layout quantum, then salt the seed with
+  // it. round() (not truncation) so 7.99999 and 8.00001 land on one bucket.
+  const std::int64_t quantized =
+      static_cast<std::int64_t>(std::llround(config.advance / kAdvanceQuantum));
+  const std::uint64_t stream =
+      MixForTest(config.seed ^ (static_cast<std::uint64_t>(quantized) *
+                                kConstSalt));
+  // steps in [-kMaxAdvanceSteps, kMaxAdvanceSteps].
+  const int steps =
+      static_cast<int>(stream % (2 * kMaxAdvanceSteps + 1)) - kMaxAdvanceSteps;
+  if (steps == 0) {
+    // A zero draw leaves the advance native. Reporting kDisabled here would be
+    // wrong -- the dimension is on -- so it stays kPerturbed with a zero shift.
+    result.status = FontNoiseStatus::kPerturbed;
+    return result;
+  }
+  result.status = FontNoiseStatus::kPerturbed;
+  result.advance =
+      config.advance + static_cast<float>(steps) * kAdvanceQuantum;
+  return result;
+}
+
+}  // namespace lengsuo::fonts
diff --git a/lengsuo/native/font_metrics.h b/lengsuo/native/font_metrics.h
new file mode 100644
index 0000000..94b9b84
--- /dev/null
+++ b/lengsuo/native/font_metrics.h
@@ -0,0 +1,75 @@
+// font_metrics v1 - deterministic perturbation of the measured glyph advance.
+//
+// This is the accepted mechanism for the font dimension
+// (docs/cc-task-rulings.md §C, docs/font-dimension-reference-approach.md). The
+// earlier proposals -- filter the availability set, or alias declared families
+// -- were both withdrawn: upstream `FontFaceSet::check()` only judges the
+// page's own @font-face registrations and returns true for every system family,
+// so "make check() answer false for an absent family" is not a state upstream
+// has, and faking it would fabricate a font registry the page can enumerate.
+//
+// What 对标端 does instead is overlay a deterministic mask on the *real* value:
+// its font_fingerprint_mask sits alongside canvas/webgl/audio masks, and the
+// open-source base it is built on applies it inside font_cache.cc. The
+// observable face of the dimension is therefore not availability but the
+// measured advance -- and that is exactly what a canvas `measureText()` reads.
+//
+// Contract:
+//   * Off (enabled == false, or seed == 0, or a non-positive advance) returns
+//     the native advance unchanged, bit for bit. A build with no font switch
+//     therefore measures identically to upstream.
+//   * On, the result is a pure function of (seed, native advance): the same
+//     profile yields the same widths in every renderer/worker process, and two
+//     profiles yield different widths.
+//   * The shift is a whole number of 1/64 px steps (the layout quantum) with
+//     |shift| < kMaxAdvanceDelta (1/4 px), so text can never move by a whole
+//     pixel: the perturbation is measurable but not visible.
+//
+// Pure: no Blink, no IPC, no allocation, no static mutable state -- so it is
+// unit-testable, and reproducible from tests/font_metrics_ref.py.
+//
+// Contract doc: docs/font-dimension.md.
+#ifndef LENGSUO_NATIVE_FONT_METRICS_H_
+#define LENGSUO_NATIVE_FONT_METRICS_H_
+
+#include <cstdint>
+
+namespace lengsuo::fonts {
+
+enum class FontNoiseStatus : std::uint8_t {
+  kDisabled,   // native advance returned unchanged
+  kPerturbed,  // advance moved by a non-zero number of 1/64 px steps
+};
+
+struct FontNoiseConfig {
+  bool enabled{};
+  std::uint64_t seed{};
+  float advance{};
+};
+
+struct FontNoiseResult {
+  FontNoiseStatus status{FontNoiseStatus::kDisabled};
+  float advance{};
+};
+
+// 1/64 px: the quantum the native measurement itself uses, so the result is
+// exactly representable after Blink's own rounding.
+//
+// The step bound is chosen from measurement (native/font_probe.py, report §3):
+// native widths land only on 1/8 px fractions, i.e. the largest native
+// fractional jitter is 0.5 units. +/-4 units is 8x that, so a perturbed width
+// is unambiguously separable from native jitter, while 4/64 = 1/16 px per glyph
+// is far below one device pixel, so no glyph can visibly move.
+constexpr float kAdvanceQuantum = 1.0f / 64.0f;
+constexpr int kMaxAdvanceSteps = 4;
+constexpr float kMaxAdvanceDelta = kAdvanceQuantum * kMaxAdvanceSteps;
+
+// Perturbs one glyph advance. See the contract above for the off conditions.
+FontNoiseResult PerturbAdvance(const FontNoiseConfig& config);
+
+// Exposed for the frozen-vector test only (mirrors tests/font_metrics_ref.py).
+std::uint64_t MixForTest(std::uint64_t x);
+
+}  // namespace lengsuo::fonts
+
+#endif  // LENGSUO_NATIVE_FONT_METRICS_H_
diff --git a/lengsuo/native/fp_overrides.cc b/lengsuo/native/fp_overrides.cc
new file mode 100644
index 0000000..29fe2f3
--- /dev/null
+++ b/lengsuo/native/fp_overrides.cc
@@ -0,0 +1,400 @@
+// fp_overrides - renderer-side fingerprint override state.
+//
+// --lengsuo-managed-fp=<seed>:<canvas>:<audio>:<rects>:<fonts>:<gpu>:<ua>:
+//   <webgl>:<vendor>:<renderer>:<hwc>:<mem>; 0/empty keeps that dimension native.
+// The font dimension is the exception: its {switcher, value, mask} content rides
+// its own --lengsuo-managed-fonts switch (docs/fp-switch-contract.md). Absent
+// switches => everything disabled and upstream behavior stays byte-identical.
+#include "fp_overrides.h"
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <span>
+#include <string_view>
+#include <utility>
+
+#include "font_family_traits.h"
+#include "font_metrics.h"
+
+namespace lengsuo::fp {
+namespace {
+
+// SplitMix64 finalizer: cheap, well distributed, bit-identical everywhere.
+std::uint64_t Mix(std::uint64_t x) {
+  x += 0x9E3779B97F4A7C15ULL;
+  x = (x ^ (x >> 30)) * 0xBF58476D1CE4E5B9ULL;
+  x = (x ^ (x >> 27)) * 0x94D049BB133111EBULL;
+  return x ^ (x >> 31);
+}
+
+// Field indices of the switch payload.
+enum Field : std::size_t {
+  kSeed = 0,
+  kCanvas,
+  kAudio,
+  kRects,
+  kFonts,
+  kGpu,
+  kUa,
+  kWebglParams,
+  kVendor,
+  kRenderer,
+  kHwc,
+  kMem,
+  kFieldCount,
+};
+
+bool g_enabled = false;
+std::uint64_t g_seed = 0;
+std::uint64_t g_canvas = 0;
+std::uint64_t g_audio = 0;
+std::uint32_t g_rects = 0;
+std::uint32_t g_gpu = 0;
+std::uint32_t g_ua = 0;
+std::uint32_t g_webgl_params = 0;
+// Fixed-capacity owned copies. The switch payload is a temporary in the
+// caller, so views into it would dangle; std::string globals are disallowed
+// (exit-time destructor), hence plain buffers + std::span for indexing.
+constexpr std::size_t kMaxFaceLen = 128;
+std::array<char, kMaxFaceLen + 1> g_vendor_storage{};
+std::array<char, kMaxFaceLen + 1> g_renderer_storage{};
+std::uint32_t g_hw_concurrency = 0;
+std::uint32_t g_device_memory = 0;
+
+// Font dimension traits -- the {switcher, value, mask} shape, not a seed.
+// Function-local static so it has no exit-time destructor.
+lengsuo::fonts::FamilyTraits& FontTraitsStorage() {
+  static lengsuo::fonts::FamilyTraits traits;
+  return traits;
+}
+bool g_fonts_installed = false;
+
+// Copies at most kMaxFaceLen chars and NUL-terminates. Returns a view of the
+// copied prefix (empty when the source was empty).
+std::string_view StoreFace(std::string_view text,
+                           std::array<char, kMaxFaceLen + 1>& storage) {
+  const std::size_t n = text.size() < kMaxFaceLen ? text.size() : kMaxFaceLen;
+  std::span<char> dst(storage);
+  for (std::size_t i = 0; i < n; ++i) {
+    dst[i] = text.at(i);
+  }
+  dst[n] = '\0';
+  return std::string_view(storage.data(), n);
+}
+
+// Returns false when the field is not a plain decimal integer (empty, too long,
+// or carrying a non-digit). Distinguishing "0" from "x" matters for the font
+// switch: "x" must be rejected, not silently read as 0.
+bool ParseDecimalStrict(std::string_view text, std::uint32_t* out) {
+  if (text.empty() || text.size() > 9) {
+    return false;
+  }
+  std::uint32_t value = 0;
+  for (const char c : text) {
+    if (c < '0' || c > '9') {
+      return false;
+    }
+    value = value * 10u + static_cast<std::uint32_t>(c - '0');
+  }
+  *out = value;
+  return true;
+}
+
+// Lenient form: any malformed field reads as 0 (i.e. "keep native").
+std::uint32_t ParseDecimal(std::string_view text) {
+  std::uint32_t value = 0;
+  return ParseDecimalStrict(text, &value) ? value : 0;
+}
+
+bool ParseHex(std::string_view text, std::uint64_t* out) {
+  if (text.empty() || text.size() > 16) {
+    return false;
+  }
+  std::uint64_t value = 0;
+  for (const char c : text) {
+    std::uint64_t digit = 0;
+    if (c >= '0' && c <= '9') {
+      digit = static_cast<std::uint64_t>(c - '0');
+    } else if (c >= 'a' && c <= 'f') {
+      digit = static_cast<std::uint64_t>(c - 'a' + 10);
+    } else if (c >= 'A' && c <= 'F') {
+      digit = static_cast<std::uint64_t>(c - 'A' + 10);
+    } else {
+      return false;
+    }
+    value = (value << 4) | digit;
+  }
+  *out = value;
+  return true;
+}
+
+// A non-zero slot enables the dimension; the slot byte and the process seed
+// both feed the mixer so two profiles never collide on one dimension.
+std::uint64_t DeriveSlotSeed(std::uint32_t slot, std::uint64_t salt) {
+  return slot != 0 ? Mix(g_seed ^ salt ^ static_cast<std::uint64_t>(slot)) : 0;
+}
+
+// Largest power of two <= value; value must be positive.
+std::int64_t PowerOfTwoAtMost(std::int64_t value) {
+  std::int64_t result = 1;
+  while (result <= value / 2) {
+    result *= 2;
+  }
+  return result;
+}
+}  // namespace
+
+void InitFromSwitch(std::string_view value) {
+  // Reset first so a malformed payload can never leave stale state behind.
+  g_enabled = false;
+  g_seed = 0;
+  g_canvas = 0;
+  g_audio = 0;
+  g_rects = 0;
+  g_gpu = 0;
+  g_ua = 0;
+  g_webgl_params = 0;
+  g_vendor_storage.fill(0);
+  g_renderer_storage.fill(0);
+  g_hw_concurrency = 0;
+  g_device_memory = 0;
+
+  std::array<std::string_view, kFieldCount> fields{};
+  std::size_t count = 0;
+  std::size_t start = 0;
+  for (std::size_t i = 0; i <= value.size() && count < kFieldCount; ++i) {
+    if (i == value.size() || value[i] == ':') {
+      fields.at(count) = value.substr(start, i - start);
+      ++count;
+      start = i + 1;
+    }
+  }
+  // The two face strings may legitimately be empty, so only the numeric prefix
+  // is mandatory.
+  if (count < kFieldCount - 2 || fields.at(kSeed).empty()) {
+    return;
+  }
+
+  std::uint64_t seed = 0;
+  if (!ParseHex(fields.at(kSeed), &seed) || seed == 0) {
+    return;
+  }
+  g_seed = seed;
+
+  const std::uint32_t canvas_slot = ParseDecimal(fields.at(kCanvas));
+  const std::uint32_t audio_slot = ParseDecimal(fields.at(kAudio));
+  g_rects = ParseDecimal(fields.at(kRects));
+  // kFonts is a contract position only; the font content rides its own switch.
+  (void)ParseDecimal(fields.at(kFonts));
+  g_gpu = ParseDecimal(fields.at(kGpu));
+  g_ua = ParseDecimal(fields.at(kUa));
+  g_webgl_params = ParseDecimal(fields.at(kWebglParams));
+  const std::string_view vendor = StoreFace(fields.at(kVendor),
+                                            g_vendor_storage);
+  const std::string_view renderer = StoreFace(fields.at(kRenderer),
+                                              g_renderer_storage);
+  g_hw_concurrency = ParseDecimal(fields.at(kHwc));
+  g_device_memory = ParseDecimal(fields.at(kMem));
+
+  g_canvas = DeriveSlotSeed(canvas_slot, 0xC4C0FFEEULL);
+  g_audio = DeriveSlotSeed(audio_slot, 0x0DEADBEEFULL);
+  g_enabled = true;
+  // Keep the stored views reachable for the accessors below.
+  (void)vendor;
+  (void)renderer;
+}
+
+bool InitFontsFromSwitch(std::string_view value) {
+  g_fonts_installed = false;
+  FontTraitsStorage() = lengsuo::fonts::FamilyTraits();
+  // Payload: <slot>:<mask>:<Family;Family;...>. The value may be empty (its
+  // own statement: the mask then decides), so only the two numeric fields are
+  // mandatory. A missing second colon is malformed, not "empty value".
+  const std::size_t first = value.find(':');
+  if (first == std::string_view::npos) {
+    return false;
+  }
+  const std::size_t second = value.find(':', first + 1);
+  if (second == std::string_view::npos) {
+    return false;
+  }
+  std::uint32_t slot = 0;
+  std::uint32_t mask = 0;
+  if (!ParseDecimalStrict(value.substr(0, first), &slot) ||
+      !ParseDecimalStrict(value.substr(first + 1, second - first - 1), &mask)) {
+    return false;
+  }
+  const std::string_view families = value.substr(second + 1);
+  lengsuo::fonts::FamilyTraits traits =
+      lengsuo::fonts::ParseFamilyTraits(slot, families, mask);
+  if (slot != 0 && !traits.installed) {
+    return false;  // malformed value: install nothing
+  }
+  FontTraitsStorage() = std::move(traits);
+  g_fonts_installed = true;
+  return true;
+}
+
+bool Enabled() {
+  return g_enabled;
+}
+
+std::string_view WebGLVendor() {
+  if (g_gpu == 0) {
+    return std::string_view();
+  }
+  return std::string_view(g_vendor_storage.data(),
+                          std::strlen(g_vendor_storage.data()));
+}
+
+std::string_view WebGLRenderer() {
+  if (g_gpu == 0) {
+    return std::string_view();
+  }
+  return std::string_view(g_renderer_storage.data(),
+                          std::strlen(g_renderer_storage.data()));
+}
+
+std::uint32_t HardwareConcurrency() {
+  return g_hw_concurrency;
+}
+
+std::uint32_t DeviceMemoryGB() {
+  return g_device_memory;
+}
+
+double RectsJitterPx() {
+  // Must exceed LayoutUnit quantization (1/64 px) to be observable, yet stay
+  // sub-pixel so rendering is visually unchanged: 0.101..0.400 px.
+  return g_rects != 0 ? 0.101 + static_cast<double>(g_seed % 300u) * 0.001
+                      : 0.0;
+}
+
+std::uint64_t AudioSeed() {
+  return g_audio;
+}
+
+const lengsuo::fonts::FamilyTraits& FontTraits() {
+  return FontTraitsStorage();
+}
+
+float PerturbGlyphAdvance(float advance) {
+  if (!g_fonts_installed) {
+    return advance;  // no profile statement: byte-identical to upstream
+  }
+  const lengsuo::fonts::FamilyTraits& traits = FontTraitsStorage();
+  // Needs both a relevant statement (installed and active) and a stream.
+  if (!traits.installed || !traits.perturbs_metrics) {
+    return advance;
+  }
+  lengsuo::fonts::FontNoiseConfig config;
+  config.enabled = true;
+  config.seed = g_seed ^ (static_cast<std::uint64_t>(traits.slot) << 32);
+  config.advance = advance;
+  return lengsuo::fonts::PerturbAdvance(config).advance;
+}
+
+std::uint64_t WebGLParamsSeed() {
+  return DeriveSlotSeed(g_webgl_params, 0xA5A5A5A5ULL);
+}
+
+std::int32_t WebGLParamBias(std::uint32_t pname, std::int32_t original) {
+  if (g_webgl_params == 0) {
+    return original;
+  }
+  // Allow-list: only informational MAX_* capability caps form the WebGL
+  // fingerprint surface. State params (ACTIVE_TEXTURE, DEPTH_FUNC,
+  // CURRENT_PROGRAM, VIEWPORT, SCISSOR_BOX, ...) must pass through untouched
+  // or pages break. Values are Khronos GL enums; this translation unit does
+  // not include the GL headers.
+  switch (pname) {
+    case 0x0D33:  // GL_MAX_TEXTURE_SIZE
+    case 0x8073:  // GL_MAX_3D_TEXTURE_SIZE (WebGL2)
+    case 0x84E8:  // GL_MAX_RENDERBUFFER_SIZE
+    case 0x851C:  // GL_MAX_CUBE_MAP_TEXTURE_SIZE
+    case 0x8869:  // GL_MAX_VERTEX_ATTRIBS
+    case 0x8872:  // GL_MAX_TEXTURE_IMAGE_UNITS
+    case 0x88FF:  // GL_MAX_ARRAY_TEXTURE_LAYERS (WebGL2)
+    case 0x8B4C:  // GL_MAX_VERTEX_TEXTURE_IMAGE_UNITS
+    case 0x8B4D:  // GL_MAX_COMBINED_TEXTURE_IMAGE_UNITS
+    case 0x8D57:  // GL_MAX_SAMPLES
+    case 0x8D6B:  // GL_MAX_ELEMENT_INDEX (WebGL2)
+    case 0x8DFB:  // GL_MAX_VERTEX_UNIFORM_VECTORS
+    case 0x8DFC:  // GL_MAX_VARYING_VECTORS
+    case 0x8DFD:  // GL_MAX_FRAGMENT_UNIFORM_VECTORS
+      break;
+    default:
+      return original;
+  }
+  if (original <= 0) {
+    return original;
+  }
+  // Mix the cap value in so two profiles can share one dimension while still
+  // advertising different limits.
+  const std::uint64_t mixed =
+      Mix(WebGLParamsSeed() ^ (static_cast<std::uint64_t>(pname) << 24) ^
+          static_cast<std::uint64_t>(original));
+  // Report a value a real driver could actually report.
+  //
+  // Drivers do not hand back arbitrary integers here; the caps people look at
+  // (texture size, renderbuffer size, uniform/varying counts) come from a small
+  // set of shapes: powers of two, the *_BITS fields stepping by 1, and a handful
+  // of architecture constants. 6364 is not one of them — a randomised number in
+  // that range is more distinctive than the unmodified driver value, which is
+  // the opposite of what this override is for.
+  //
+  // Never advertise more than the driver supports: a page that trusts a higher
+  // cap would allocate a texture/shader that cannot exist and fail at run time.
+  // So the candidate set is filtered to <= original, and the step count is
+  // measured on that filtered set to keep the distribution uniform.
+  //
+  // The driver's own value stays a candidate. That is deliberate and it is the
+  // honest outcome: on a machine with a real GPU the driver value is already a
+  // true measurement, and lowering it only makes sense as "this profile is the
+  // next tier down" - which also has to change the renderer string. Until the
+  // server sends per-tier parameter tables, most profiles therefore keep the
+  // driver value, and this dimension carries almost no entropy. That is the
+  // correct trade: a plausible value beats a perturbed one.
+  std::int32_t candidates[16];
+  std::size_t count = 0;
+  const auto add_candidate = [&](std::int64_t value) {
+    if (value <= 0 || value > original || count >= 16) {
+      return;
+    }
+    for (std::size_t i = 0; i < count; ++i) {
+      if (candidates[i] == value) {
+        return;
+      }
+    }
+    candidates[count++] = static_cast<std::int32_t>(value);
+  };
+  // The driver's own value is always a candidate: leaving a cap untouched is
+  // the most plausible outcome of all.
+  add_candidate(original);
+  // Powers of two at and below the driver value, down to three steps.
+  for (int shift = 0; shift <= 3; ++shift) {
+    const std::int64_t step = PowerOfTwoAtMost(original) >> shift;
+    if (step > 0) {
+      add_candidate(step);
+    }
+  }
+  // Real cards commonly report these exact values.
+  for (std::int64_t common : {16, 24, 30, 31, 32, 48, 60, 64, 96, 128, 256}) {
+    add_candidate(common);
+  }
+  // Stay within half the driver value: one real tier down at most. A larger
+  // drop would contradict the renderer string the profile advertises (a card
+  // claiming 32K textures does not report 4K).
+  const std::int64_t bound = original > 8 ? original / 2 : 1;
+  const std::int64_t floor_value = original - bound;
+  if (count == 0) {
+    return original;
+  }
+  const std::int32_t pick =
+      candidates[static_cast<std::size_t>(mixed % count)];
+  return pick >= floor_value ? pick : original;
+}
+
+}  // namespace lengsuo::fp
diff --git a/lengsuo/native/fp_overrides.h b/lengsuo/native/fp_overrides.h
new file mode 100644
index 0000000..40b59d2
--- /dev/null
+++ b/lengsuo/native/fp_overrides.h
@@ -0,0 +1,56 @@
+// fp_overrides - renderer-side fingerprint override state.
+// One switch carries everything: --lengsuo-managed-fp=<seed-hex>:<a>:<c>:<r>:<f>:<g>:<u>:<w>
+// (slots: audio, canvas, rects, fonts, gpu, ua, webgl). Absent => all disabled,
+// upstream behavior byte-identical. Face resolution lives here (built-in tables).
+#ifndef LENGSUO_NATIVE_FP_OVERRIDES_H_
+#define LENGSUO_NATIVE_FP_OVERRIDES_H_
+#include <cstdint>
+#include <string_view>
+
+#include "font_family_traits.h"
+#include "font_metrics.h"
+namespace lengsuo::fp {
+// Two switches, both optional and both absent by default:
+//   --lengsuo-managed-fp=<seed-hex>:<a>:<c>:<r>:<f>:<g>:<u>:<w>:<vendor>:
+//                        <renderer>:<hwc>:<mem>
+//   --lengsuo-managed-fonts=<slot>:<mask>:<Family;Family;...>
+// The fonts dimension is {switcher, value, mask} (docs/cc-task-rulings.md §C):
+// its value is a semicolon-separated family string that can be large, so it
+// does not ride a colon field of the fp switch (see docs/fp-switch-contract.md).
+// Both absent => upstream behavior byte-identical.
+void InitFromSwitch(std::string_view value);
+// Parses --lengsuo-managed-fonts and installs the font-metric perturbation.
+// Returns false on a malformed payload, in which case nothing is installed and
+// every measurement keeps its native value.
+bool InitFontsFromSwitch(std::string_view value);
+bool Enabled();
+// WebGL faces resolved from seed+slot (deterministic).
+std::string_view WebGLVendor();
+std::string_view WebGLRenderer();
+std::uint32_t HardwareConcurrency();  // 0 = disabled
+std::uint32_t DeviceMemoryGB();       // 0 = disabled
+double RectsJitterPx();               // 0 = disabled
+std::uint64_t AudioSeed();
+
+// Slot 7: deterministic seed for WebGL MAX_* parameter perturbation.
+// Returns 0 when the webgl slot is off.
+std::uint64_t WebGLParamsSeed();
+// Deterministic bias for GLenum-typed int parameters (MAX_*, *_BITS...);
+// returns 0 when the webgl slot is off. Applied inside GetIntParameter.
+std::int32_t WebGLParamBias(std::uint32_t pname, std::int32_t original);
+
+// Font dimension: the parsed traits, or a default (not-installed) value until a
+// valid payload arrives. Callers must treat !installed as "this profile says
+// nothing about fonts" and keep the native measurement. The seed used for the
+// perturbation is the global noise seed, so the font dimension shares the
+// canvas/audio derivation discipline (docs/font-dimension.md).
+const lengsuo::fonts::FamilyTraits& FontTraits();
+
+// Perturbs one measured glyph advance per the installed font dimension. This is
+// the browser-side entry point for the accepted mechanism (docs/cc-task-rulings
+// §C): the advance is perturbed deterministically, `FontFaceSet::check()` is
+// never touched. Returns the native advance unchanged when the dimension is off,
+// not installed, or dormant.
+float PerturbGlyphAdvance(float advance);
+}  // namespace lengsuo::fp
+#endif

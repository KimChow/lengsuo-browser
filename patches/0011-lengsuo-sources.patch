+  const base::CPU& cpu = base::CPU::GetInstanceNoAllocation();
+  facts.cpuid = base::StrCat({cpu.vendor_name(), "/",
+                               base::NumberToString(cpu.family()), "/",
+                               base::NumberToString(cpu.model()), "/",
+                               base::NumberToString(cpu.stepping())});

+// Renderer-side canvas noise application state and entry point.
+//
+// The browser passes seed/slot via the --lengsuo-managed-canvas switch
+// (hex seed + decimal slot). No profile file or secrets reach the renderer.
+// When the switch is absent the state is disabled and ApplyProfileCanvasNoise
+// is a no-op — upstream readback stays byte-identical.
+#ifndef LENGSUO_NATIVE_CANVAS_APPLY_H_
+#define LENGSUO_NATIVE_CANVAS_APPLY_H_
+#include <cstdint>
+namespace lengsuo {
+// Parses --lengsuo-managed-canvas=<hex-seed>:<slot>. Empty/invalid -> disabled.
+void InitCanvasNoiseFromSwitch(const char* switch_value);
+bool CanvasNoiseEnabled();
+// Applies noise in place to an RGBA8 buffer. No-op when disabled or on any
+// validation failure (never throws, never allocates).
+void ApplyProfileCanvasNoise(void* data, std::uint32_t width,
+                             std::uint32_t height, std::uint64_t stride);
+}  // namespace lengsuo
+#endif
diff --git a/lengsuo/native/canvas_noise.cc b/lengsuo/native/canvas_noise.cc
new file mode 100644
index 0000000..aab4672
--- /dev/null
+++ b/lengsuo/native/canvas_noise.cc
@@ -0,0 +1,163 @@
+// canvas_noise v1 — implementation. See canvas_noise.h for the contract.
+//
+// The arithmetic mirrors tests/canvas_ref/gen_canvas_ref.py line for line:
+// all state is uint64 with wrapping (unsigned overflow IS the specified
+// modular arithmetic), the stream advances exactly two mixes per pixel in
+// row-major order regardless of transparency, and padding bytes are never
+// read or written.
+
+#include "canvas_noise.h"
+
+namespace lengsuo::canvas {
+namespace {
+
+constexpr std::uint64_t kConstA = 0x9E3779B97F4A7C15ULL;
+constexpr std::uint64_t kConstB = 0xC2B2AE3D27D4EB4FULL;
+constexpr std::uint64_t kConstMixSeed = 0xA24BAED5ULL;
+constexpr std::uint64_t kConstHi = 0x517CC1B727220A95ULL;
+constexpr std::uint64_t kConstLo = 0x4CF8E355ULL;
+
+struct MixPair {
+  std::uint64_t a;
+  std::uint64_t b;
+};
+
+std::uint64_t Rotl64(std::uint64_t x, int k) {
+  return (x << k) | (x >> (64 - k));
+}
+
+MixPair Mix(std::uint64_t a, std::uint64_t b) {
+  a += b;
+  a = Rotl64(a, 23);
+  a += b + kConstA;
+  b += a;
+  b = Rotl64(b, 45);
+  b += a + kConstB;
+  a += Rotl64(b, 31);
+  return {a, b};
+}
+
+bool ValidateGeometry(std::uint32_t width, std::uint32_t height,
+                      std::uint64_t stride, std::uint64_t buffer_size,
+                      std::size_t src_size, std::size_t dst_size,
+                      CanvasNoiseStatus& status) {
+  const std::uint64_t pixels =
+      static_cast<std::uint64_t>(width) * static_cast<std::uint64_t>(height);
+  if (width == 0 || height == 0 || width > 65535 || height > 65535 ||
+      pixels > (1ULL << 28)) {
+    status = CanvasNoiseStatus::kInvalidGeometry;
+    return false;
+  }
+  const std::uint64_t min_stride =
+      static_cast<std::uint64_t>(width) * 4ULL;
+  if (stride < min_stride || stride > (1ULL << 27) - 4ULL) {
+    status = CanvasNoiseStatus::kInvalidGeometry;
+    return false;
+  }
+  if (stride * height > buffer_size || buffer_size > src_size ||
+      buffer_size > dst_size) {
+    status = CanvasNoiseStatus::kBufferTooSmall;
+    return false;
+  }
+  if (buffer_size == 0 || src_size == 0 || dst_size == 0) {
+    status = CanvasNoiseStatus::kBufferTooSmall;
+    return false;
+  }
+  return true;
+}
+
+}  // namespace
+
+CanvasNoiseResult ApplyCanvasNoiseV1(const CanvasNoiseConfig& config,
+                                     std::span<const std::uint8_t> src,
+                                     std::span<std::uint8_t> dst,
+                                     std::uint32_t width,
+                                     std::uint32_t height,
+                                     std::uint64_t stride,
+                                     std::uint64_t buffer_size) {
+  CanvasNoiseResult result;
+  if (config.algorithm_version != 1) {
+    result.status = CanvasNoiseStatus::kUnsupportedVersion;
+    return result;
+  }
+  if (!ValidateGeometry(width, height, stride, buffer_size, src.size(),
+                        dst.size(), result.status)) {
+    return result;
+  }
+  if (!config.enabled) {
+    // Explicit off path: validated but never writes; whether to copy is the
+    // caller's decision (contract: no hidden copy side effect).
+    return result;
+  }
+
+  MixPair init = Mix(config.seed,
+                     (static_cast<std::uint64_t>(config.slot) << 32) ^
+                         kConstMixSeed);
+  std::uint64_t hi = init.a ^ config.seed ^ kConstHi ^
+                     (static_cast<std::uint64_t>(width) << 16) ^
+                     static_cast<std::uint64_t>(height);
+  std::uint64_t lo = (init.b + config.seed + (stride << 3)) ^ kConstLo ^
+                     (static_cast<std::uint64_t>(config.slot) * 0x9E3779B9ULL);
+  // The reference's derive() returns mix(hi, lo) — one extra mix that is part
+  // of derivation itself (see gen_canvas_ref.py::derive). The per-pixel loop
+  // then consumes two more mixes per pixel, row-major.
+  MixPair derived = Mix(hi, lo);
+  hi = derived.a;
+  lo = derived.b;
+
+  for (std::uint32_t row = 0; row < height; ++row) {
+    const std::size_t base = static_cast<std::size_t>(row) *
+                             static_cast<std::size_t>(stride);
+    for (std::uint32_t col = 0; col < width; ++col) {
+      const std::size_t p = base + static_cast<std::size_t>(col) * 4ULL;
+      MixPair s = Mix(hi, lo);
+      const std::uint64_t v1 = s.a ^ s.b;
+      // Second mix advances the stream only; the mild variant never scales
+      // the delta by v2 (that was the rejected plan-B formula).
+      s = Mix(s.a, s.b);
+      hi = s.a;
+      lo = s.b;
+
+      const std::uint8_t alpha = src[p + 3];
+      if (alpha == 0) {
+        // Fully transparent: all four bytes preserved byte-for-byte. When
+        // dst aliases src this is naturally a no-op; when it does not, the
+        // copy is still required by the contract.
+        dst[p + 0] = src[p + 0];
+        dst[p + 1] = src[p + 1];
+        dst[p + 2] = src[p + 2];
+        dst[p + 3] = src[p + 3];
+        ++result.preserved_pixels;
+        continue;
+      }
+
+      const std::int64_t d =
+          static_cast<std::int64_t>(v1 % 27ULL) - 13;  // [-13, 13]
+      // The reference uses Python floor division (`d * alpha // 255`), which
+      // rounds toward negative infinity; C++ `/` truncates toward zero. The
+      // difference only shows for negative numerators (e.g. -1152/255 is -5
+      // floored but -4 truncated), so division is implemented explicitly.
+      const std::int64_t numerator = d * static_cast<std::int64_t>(alpha);
+      const std::int64_t delta =
+          numerator >= 0 ? numerator / 255
+                         : -((-numerator + 254) / 255);
+      bool changed = false;
+      for (int c = 0; c < 3; ++c) {
+        const std::int64_t value =
+            static_cast<std::int64_t>(src[p + c]) + delta;
+        const std::uint8_t clamped = value < 0   ? 0
+                                     : value > 255 ? 255
+                                                   : static_cast<std::uint8_t>(value);
+        changed = changed || clamped != src[p + c];
+        dst[p + c] = clamped;
+      }
+      dst[p + 3] = alpha;  // alpha strictly preserved
+      if (changed) {
+        ++result.changed_pixels;
+      }
+    }
+  }
+  return result;
+}
+
+}  // namespace lengsuo::canvas
diff --git a/lengsuo/native/canvas_noise.h b/lengsuo/native/canvas_noise.h
new file mode 100644
index 0000000..b6cced4
--- /dev/null
+++ b/lengsuo/native/canvas_noise.h
@@ -0,0 +1,53 @@
+// canvas_noise v1 — deterministic RGBA8 pixel perturbation (pure algorithm).
+//
+// Contract: docs/canvas-component-contract.md (frozen 2026-10-18, plan A).
+// Independent reference: tests/canvas_ref/gen_canvas_ref.py (Python).
+// Frozen bytes: tests/canvas_ref/golden_fixture.inc.
+//
+// This component is a pure algorithm library: no Chromium injection, no IPC,
+// no dynamic allocation, no static mutable state. The immutable-source rule
+// is the API contract: reads come only from `src`, writes go only to `dst`.
+
+#ifndef LENGSUO_NATIVE_CANVAS_NOISE_H_
+#define LENGSUO_NATIVE_CANVAS_NOISE_H_
+
+#include <cstdint>
+#include <span>
+
+namespace lengsuo::canvas {
+
+enum class CanvasNoiseStatus : std::uint8_t {
+  kOk,
+  kUnsupportedVersion,
+  kInvalidGeometry,
+  kBufferTooSmall,
+};
+
+struct CanvasNoiseConfig {
+  std::uint32_t algorithm_version{};
+  bool enabled{};
+  std::uint64_t seed{};
+  std::uint32_t slot{};
+};
+
+struct CanvasNoiseResult {
+  CanvasNoiseStatus status{CanvasNoiseStatus::kOk};
+  std::uint64_t changed_pixels{};
+  std::uint64_t preserved_pixels{};
+};
+
+// Applies canvas_noise v1 to an RGBA8 grid. `dst` may alias `src` exactly
+// (in-place, per-pixel read-then-write); any other overlap is undefined
+// input. All validation happens before any write; a failed call leaves
+// `dst` untouched.
+CanvasNoiseResult ApplyCanvasNoiseV1(const CanvasNoiseConfig& config,
+                                     std::span<const std::uint8_t> src,
+                                     std::span<std::uint8_t> dst,
+                                     std::uint32_t width,
+                                     std::uint32_t height,
+                                     std::uint64_t stride,
+                                     std::uint64_t buffer_size);
+
+}  // namespace lengsuo::canvas
+
+#endif  // LENGSUO_NATIVE_CANVAS_NOISE_H_
diff --git a/lengsuo/native/extension_pin.cc b/lengsuo/native/extension_pin.cc
new file mode 100644
index 0000000..92ce928
--- /dev/null
+++ b/lengsuo/native/extension_pin.cc
@@ -0,0 +1,192 @@
+#include "extension_pin.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <utility>
+
+namespace lengsuo::fp {
+namespace {
+
+// Minimal JSON reader for the one shape PinedFile uses: an array of strings.
+// It rejects everything else rather than skipping unknowns, so a malformed or
+// hostile document cannot silently narrow the whitelist.
+class JsonIdArrayReader {
+ public:
+  // The text is held by value. Chromium's chromium-rawref and
+  // chromium-rawptr checks reject both native references and native pointers
+  // as members; raw_ref<> would fix that but drags in a //base dependency,
+  // and this directory is deliberately buildable with a plain C++20
+  // toolchain. The document is a short array of 32-character ids, so one
+  // copy costs nothing.
+  explicit JsonIdArrayReader(const std::string& text) : text_(text) {}
+
+  // Returns true only when the entire input is `[ "id", ... ]` with every
+  // element a valid extension ID. On false, `ids` may be partially filled;
+  // Parse() discards it.
+  bool Read(std::set<std::string>* ids) {
+    SkipWhitespace();
+    if (!Consume('[')) return false;
+    SkipWhitespace();
+    if (Consume(']')) return AtEnd();
+    while (true) {
+      std::string id;
+      if (!ReadString(&id)) return false;
+      if (!ExtensionPin::IsValidId(id)) return false;
+      ids->insert(std::move(id));
+      SkipWhitespace();
+      if (Consume(']')) return AtEnd();
+      if (!Consume(',')) return false;
+      SkipWhitespace();
+      // A trailing comma leaves ']' where a string must begin, so the next
+      // ReadString() rejects it.
+    }
+  }
+
+ private:
+  bool AtEnd() {
+    SkipWhitespace();
+    return pos_ == text_.size();
+  }
+
+  bool Consume(char expected) {
+    if (pos_ >= text_.size() || text_[pos_] != expected) return false;
+    ++pos_;
+    return true;
+  }
+
+  void SkipWhitespace() {
+    while (pos_ < text_.size()) {
+      const char c = text_[pos_];
+      if (c != ' ' && c != '\t' && c != '\n' && c != '\r') return;
+      ++pos_;
+    }
+  }
+
+  bool ReadString(std::string* out) {
+    if (!Consume('"')) return false;
+    while (pos_ < text_.size()) {
+      const unsigned char c = static_cast<unsigned char>(text_[pos_++]);
+      if (c == '"') return true;
+      if (c < 0x20) return false;  // JSON forbids raw control characters.
+      if (c != '\\') {
+        out->push_back(static_cast<char>(c));
+        continue;
+      }
+      if (pos_ >= text_.size()) return false;
+      const char escape = text_[pos_++];
+      switch (escape) {
+        case '"': out->push_back('"'); break;
+        case '\\': out->push_back('\\'); break;
+        case '/': out->push_back('/'); break;
+        case 'b': out->push_back('\b'); break;
+        case 'f': out->push_back('\f'); break;
+        case 'n': out->push_back('\n'); break;
+        case 'r': out->push_back('\r'); break;
+        case 't': out->push_back('\t'); break;
+        case 'u': {
+          std::uint32_t code_point = 0;
+          if (!ReadHex4(&code_point)) return false;
+          if (code_point >= 0xD800 && code_point <= 0xDBFF) {
+            std::uint32_t low = 0;
+            if (!Consume('\\') || !Consume('u') || !ReadHex4(&low)) {
+              return false;
+            }
+            if (low < 0xDC00 || low > 0xDFFF) return false;
+            code_point =
+                0x10000 + ((code_point - 0xD800) << 10) + (low - 0xDC00);
+          } else if (code_point >= 0xDC00 && code_point <= 0xDFFF) {
+            return false;  // Lone low surrogate.
+          }
+          AppendUtf8(code_point, out);
+          break;
+        }
+        default: return false;
+      }
+    }
+    return false;  // Unterminated string.
+  }
+
+  bool ReadHex4(std::uint32_t* out) {
+    if (text_.size() - pos_ < 4) return false;
+    std::uint32_t value = 0;
+    for (int i = 0; i < 4; ++i) {
+      const char c = text_[pos_++];
+      value <<= 4;
+      if (c >= '0' && c <= '9') {
+        value |= static_cast<std::uint32_t>(c - '0');
+      } else if (c >= 'a' && c <= 'f') {
+        value |= static_cast<std::uint32_t>(c - 'a' + 10);
+      } else if (c >= 'A' && c <= 'F') {
+        value |= static_cast<std::uint32_t>(c - 'A' + 10);
+      } else {
+        return false;
+      }
+    }
+    *out = value;
+    return true;
+  }
+
+  static void AppendUtf8(std::uint32_t code_point, std::string* out) {
+    if (code_point <= 0x7F) {
+      out->push_back(static_cast<char>(code_point));
+    } else if (code_point <= 0x7FF) {
+      out->push_back(static_cast<char>(0xC0 | (code_point >> 6)));
+      out->push_back(static_cast<char>(0x80 | (code_point & 0x3F)));
+    } else if (code_point <= 0xFFFF) {
+      out->push_back(static_cast<char>(0xE0 | (code_point >> 12)));
+      out->push_back(static_cast<char>(0x80 | ((code_point >> 6) & 0x3F)));
+      out->push_back(static_cast<char>(0x80 | (code_point & 0x3F)));
+    } else {
+      out->push_back(static_cast<char>(0xF0 | (code_point >> 18)));
+      out->push_back(static_cast<char>(0x80 | ((code_point >> 12) & 0x3F)));
+      out->push_back(static_cast<char>(0x80 | ((code_point >> 6) & 0x3F)));
+      out->push_back(static_cast<char>(0x80 | (code_point & 0x3F)));
+    }
+  }
+
+  std::string text_;
+  std::size_t pos_ = 0;
+};
+
+}  // namespace
+
+bool ExtensionPin::Parse(const std::string& json) {
+  std::set<std::string> parsed;
+  JsonIdArrayReader reader(json);
+  if (!reader.Read(&parsed)) return false;
+  ids_ = std::move(parsed);
+  return true;
+}
+
+std::string ExtensionPin::Serialize() const {
+  std::string out = "[";
+  for (auto it = ids_.begin(); it != ids_.end(); ++it) {
+    if (it != ids_.begin()) out.push_back(',');
+    out.push_back('"');
+    out += *it;  // Valid IDs are [a-p]{32}: no JSON escaping needed.
+    out.push_back('"');
+  }
+  out.push_back(']');
+  return out;
+}
+
+bool ExtensionPin::Contains(const std::string& id) const {
+  return ids_.find(id) != ids_.end();
+}
+
+bool ExtensionPin::Add(const std::string& id) {
+  if (!IsValidId(id)) return false;
+  return ids_.insert(id).second;
+}
+
+// static
+bool ExtensionPin::IsValidId(const std::string& id) {
+  if (id.size() != 32) return false;
+  for (const char c : id) {
+    if (c < 'a' || c > 'p') return false;
+  }
+  return true;
+}
+
+}  // namespace lengsuo::fp
diff --git a/lengsuo/native/extension_pin.h b/lengsuo/native/extension_pin.h
new file mode 100644
index 0000000..0d12f67
--- /dev/null
+++ b/lengsuo/native/extension_pin.h
@@ -0,0 +1,51 @@
+// extension_pin - the PinedFile extension whitelist (L3 任务书 任务 H).
+//
+// 对标端 uses PinedFile to fix "which extensions must travel with the
+// environment": a JSON array of Chromium extension IDs, e.g.
+//   ["fjchbfkopknlodpfoaeogfbclcpppiog",
+//    "fgbbdcdpliimpdmgcnahkcdfhdjegmin",
+//    "hncdafoadpldclaaigooamfbebmaakjj"]
+//
+// Parsing is fail-closed: any invalid ID, non-array document or non-string
+// element rejects the whole document and leaves prior state untouched. IDs
+// use Chromium's alphabet: exactly 32 characters of [a-p].
+#ifndef LENGSUO_NATIVE_EXTENSION_PIN_H_
+#define LENGSUO_NATIVE_EXTENSION_PIN_H_
+
+#include <cstddef>
+#include <set>
+#include <string>
+
+namespace lengsuo::fp {
+
+class ExtensionPin {
+ public:
+  // Parses a PinedFile document. On failure the pin keeps its previous
+  // contents; nothing is half-applied.
+  bool Parse(const std::string& json);
+
+  // Serializes as a JSON string array in stable (sorted) order, so two pins
+  // with the same membership serialize byte-identically.
+  std::string Serialize() const;
+
+  bool Contains(const std::string& id) const;
+
+  // Returns false (and changes nothing) when `id` is already present or is
+  // not a valid Chromium extension ID.
+  bool Add(const std::string& id);
+
+  size_t size() const { return ids_.size(); }
+
+  // Sorted view; used by the L3 document encoder.
+  const std::set<std::string>& Ids() const { return ids_; }
+
+  // 32 characters of [a-p] (Chromium extension ID alphabet).
+  static bool IsValidId(const std::string& id);
+
+ private:
+  std::set<std::string> ids_;
+};
+
+}  // namespace lengsuo::fp
+
+#endif  // LENGSUO_NATIVE_EXTENSION_PIN_H_

@@ -0,0 +1,47 @@
+#include "lengsuo/integration/l3_provisioning_impl.h"
+
+#include <cstdint>
+#include <memory>
+#include <utility>
+#include <vector>
+
+#include "lengsuo/integration/browser_bootstrap.h"
+#include "lengsuo/public/mojom/l3_provisioning.mojom.h"
+#include "mojo/public/cpp/bindings/generic_pending_receiver.h"
+#include "mojo/public/cpp/bindings/pending_receiver.h"
+#include "mojo/public/cpp/bindings/self_owned_receiver.h"
+
+namespace lengsuo {
+namespace {
+
+class L3ProvisioningImpl : public mojom::L3Provisioning {
+ public:
+  L3ProvisioningImpl() = default;
+
+  // The answer is rebuilt from the snapshot frozen before this renderer was
+  // launched; nothing is cached per renderer, so two renderers started from
+  // the same browser always see the same bytes.
+  void GetDocument(GetDocumentCallback callback) override {
+    const std::string document = GetL3Document([] { return BrowserL3Config(); });
+    auto reply = mojom::L3Document::New();
+    reply->bytes = std::vector<uint8_t>(document.begin(), document.end());
+    std::move(callback).Run(std::move(reply));
+  }
+};
+
+}  // namespace
+
+bool BindL3Provisioning(mojo::GenericPendingReceiver& receiver) {
+  mojo::PendingReceiver<mojom::L3Provisioning> pending =
+      receiver.As<mojom::L3Provisioning>();
+  if (!pending.is_valid()) {
+    return false;
+  }
+  // Self-owned: the browser has no per-renderer bookkeeping for this
+  // interface, and the endpoint closes with the renderer's pipe.
+  mojo::MakeSelfOwnedReceiver(std::make_unique<L3ProvisioningImpl>(),
+                              std::move(pending));
+  return true;
+}
+
+}  // namespace lengsuo
diff --git a/lengsuo/integration/l3_provisioning_impl.h b/lengsuo/integration/l3_provisioning_impl.h
new file mode 100644
index 0000000..656b891
--- /dev/null
+++ b/lengsuo/integration/l3_provisioning_impl.h
@@ -0,0 +1,55 @@
+// l3_provisioning_impl - browser side of the L3 Mojo channel (task O).
+//
+// Before this file the frozen document travelled to every renderer as base64
+// on the command line, which made it readable from /proc/<pid>/cmdline,
+// chrome://version and crash dumps. It now leaves the browser only as the
+// answer to a renderer's Mojo request.
+//
+// The pure part below has no Mojo dependency and is compiled standalone by
+// tools/rebuild/run_l3_gtest.sh, so "frozen snapshot -> bytes" is covered by a
+// unit test. The binding adapter at the bottom of the .cc needs generated
+// bindings, so it is covered by the real build and the end-to-end acceptance
+// run instead (see docs/l3-reports/task-O.md).
+#ifndef LENGSUO_INTEGRATION_L3_PROVISIONING_IMPL_H_
+#define LENGSUO_INTEGRATION_L3_PROVISIONING_IMPL_H_
+
+#include <functional>
+#include <string>
+#include <utility>
+
+#include "lengsuo/native/l3_wire.h"
+
+namespace mojo {
+class GenericPendingReceiver;
+}
+
+namespace lengsuo {
+
+// Re-serializes a frozen snapshot in exactly the form the browser verified.
+// The signed timestamp is preserved: substituting "now" would hand the
+// renderer a different document than the one the browser checked.
+inline std::string EncodeL3Document(const fp::L3Config& config) {
+  return fp::EncodeL3Wire(config, config.signed_unix);
+}
+
+// What the browser answers a renderer's GetDocument() with. Empty means
+// "this session has no L3 statement" and the renderer keeps upstream storage
+// behaviour.
+//
+// |reader| returns the frozen snapshot, or nullptr when none was loaded. It is
+// called on every request, so all renderers of one session receive identical
+// bytes.
+inline std::string GetL3Document(
+    const std::function<const fp::L3Config*()>& reader) {
+  const fp::L3Config* config = reader();
+  return config ? EncodeL3Document(*config) : std::string();
+}
+
+// Binds |receiver| when it names L3Provisioning and returns true. Returns
+// false for any other interface, leaving the receiver untouched, so the
+// chrome-layer dispatcher can keep looking.
+bool BindL3Provisioning(mojo::GenericPendingReceiver& receiver);
+
+}  // namespace lengsuo
+
+#endif  // LENGSUO_INTEGRATION_L3_PROVISIONING_IMPL_H_
diff --git a/lengsuo/integration/l3_provisioning_impl_test.cc b/lengsuo/integration/l3_provisioning_impl_test.cc
new file mode 100644
index 0000000..af80612
--- /dev/null
+++ b/lengsuo/integration/l3_provisioning_impl_test.cc
@@ -0,0 +1,96 @@
+// l3_provisioning_impl_test - what the browser answers on the L3 Mojo channel
+// (task O).
+//
+// The interesting failure is not "serialization runs": it is that the bytes
+// handed to a renderer are the document the browser verified (same signature
+// timestamp, same pin table), in the raw wire form the renderer accepts - not
+// base64, not a re-encoded variant. Documents are built with EncodeL3Wire,
+// the same encoder the acceptance run uses.
+#include "lengsuo/integration/l3_provisioning_impl.h"
+
+#include <gtest/gtest.h>
+
+#include <string>
+#include <utility>
+
+#include "lengsuo/native/l3_runtime.h"
+
+namespace lengsuo {
+namespace {
+
+constexpr int64_t kSignedAt = 1700000000;
+constexpr int64_t kMaxAge = 7 * 24 * 60 * 60;
+constexpr char kOrigin[] = "https://mms.pinduoduo.com";
+constexpr char kKey[] = "finger-key_0.1.5";
+constexpr char kValue[] = "7FcROXwfKGAKuwlRwwlBCEUPeZXjwrH5";
+
+fp::L3Config MakeConfig(int64_t signed_unix) {
+  fp::L3Config config;
+  const std::string pin_wire =
+      std::string(kOrigin) + "|local|" + kKey + "|" + kValue + "\n";
+  EXPECT_TRUE(config.pins.Parse(pin_wire));
+  config.signed_unix = signed_unix;
+  return config;
+}
+
+TEST(L3ProvisioningTest, NoSnapshotAnswersEmpty) {
+  EXPECT_TRUE(GetL3Document([] { return nullptr; }).empty());
+}
+
+TEST(L3ProvisioningTest, SnapshotIsAnsweredInRawWireForm) {
+  const fp::L3Config config = MakeConfig(kSignedAt);
+
+  const std::string document = GetL3Document([&config] { return &config; });
+  // Raw L3W1, not base64: a regression to the old transport would start with
+  // an alphabet character and carry no newline.
+  EXPECT_EQ(document.rfind("L3W1\n", 0), 0u);
+  EXPECT_NE(document.find('\n'), std::string::npos);
+  EXPECT_EQ(document, fp::EncodeL3Wire(config, kSignedAt));
+}
+
+TEST(L3ProvisioningTest, RendererAcceptsTheAnswer) {
+  const fp::L3Config config = MakeConfig(kSignedAt);
+
+  // What renderer_main.cc does with a non-empty answer: now_unix = 0 because
+  // the browser already judged freshness.
+  fp::L3Runtime runtime;
+  ASSERT_TRUE(runtime.Init(GetL3Document([&config] { return &config; }),
+                           /*now_unix=*/0, /*max_age_seconds=*/0));
+  const std::string* pinned = runtime.PinnedValue(kOrigin, kKey);
+  ASSERT_NE(pinned, nullptr);
+  EXPECT_EQ(*pinned, kValue);
+  EXPECT_TRUE(runtime.IsLocked(kOrigin, kKey));
+}
+
+TEST(L3ProvisioningTest, SignatureTimestampIsPreserved) {
+  const fp::L3Config config = MakeConfig(kSignedAt);
+  const std::string document = GetL3Document([&config] { return &config; });
+
+  fp::L3Config decoded;
+  std::string error;
+  // Fresh at the timestamp the document was signed with ...
+  EXPECT_TRUE(fp::DecodeL3Wire(document, kSignedAt, kMaxAge, &decoded, &error))
+      << error;
+  EXPECT_EQ(decoded.signed_unix, kSignedAt);
+  // ... and stale one second past the window. If EncodeL3Document stamped
+  // "now" instead, this decode would fail as "too new" rather than "too old".
+  EXPECT_FALSE(fp::DecodeL3Wire(document, kSignedAt + kMaxAge + 1, kMaxAge,
+                                &decoded, &error));
+}
+
+TEST(L3ProvisioningTest, EveryRequestReReadsTheSnapshot) {
+  const fp::L3Config config = MakeConfig(kSignedAt);
+  int reads = 0;
+  const auto reader = [&config, &reads]() -> const fp::L3Config* {
+    ++reads;
+    return &config;
+  };
+
+  const std::string first = GetL3Document(reader);
+  const std::string second = GetL3Document(reader);
+  EXPECT_EQ(first, second);
+  EXPECT_EQ(reads, 2);
+}
+
+}  // namespace
+}  // namespace lengsuo
diff --git a/lengsuo/integration/official_defaults.cc b/lengsuo/integration/official_defaults.cc
new file mode 100644
index 0000000..fa2a132
--- /dev/null
+++ b/lengsuo/integration/official_defaults.cc
@@ -0,0 +1,72 @@
+#include "lengsuo/integration/official_defaults.h"
+
+#include <array>
+#include <vector>
+
+#include "base/command_line.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+
+namespace lengsuo {
+namespace {
+
+constexpr char kDisableFeaturesSwitch[] = "disable-features";
+
+// Blink reads this from the renderer's own command line to decide whether to
+// keep navigator.languages at full length. It has to be appended here *and*
+// allow-listed in RenderProcessHostImpl's kSwitchNames; the renderer does not
+// rebuild its feature list from the browser's --disable-features.
+constexpr char kDisableReduceAcceptLanguageSwitch[] =
+    "disable-reduce-accept-language";
+
+// Keeps the merge order deterministic and preserves the user's own ordering,
+// so an operator-supplied flag list still reads the way they wrote it.
+std::string JoinUnique(const std::vector<std::string>& ordered) {
+  std::vector<std::string> unique;
+  for (const std::string& item : ordered) {
+    if (item.empty()) {
+      continue;
+    }
+    bool seen = false;
+    for (const std::string& kept : unique) {
+      if (kept == item) {
+        seen = true;
+        break;
+      }
+    }
+    if (!seen) {
+      unique.push_back(item);
+    }
+  }
+  return base::JoinString(unique, ",");
+}
+
+}  // namespace
+
+std::string MergeDisabledFeatures(std::string_view existing) {
+  const std::string current(existing);
+  std::vector<std::string> parts = base::SplitString(
+      current, ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  for (const std::string_view feature : kFeaturesChromeDisables) {
+    parts.emplace_back(feature);
+  }
+  return JoinUnique(parts);
+}
+
+void ApplyOfficialFeatureDefaults(base::CommandLine* command) {
+  if (command == nullptr) {
+    return;
+  }
+  const std::string current = command->GetSwitchValueASCII(kDisableFeaturesSwitch);
+  const std::string merged = MergeDisabledFeatures(current);
+  if (merged != current) {
+    command->AppendSwitchASCII(kDisableFeaturesSwitch, merged);
+  }
+  // The renderer ignores the browser's feature list; Blink exposes a dedicated
+  // switch for the one behaviour we need to match. Appending it is idempotent.
+  if (!command->HasSwitch(kDisableReduceAcceptLanguageSwitch)) {
+    command->AppendSwitch(kDisableReduceAcceptLanguageSwitch);
+  }
+}
+
+}  // namespace lengsuo
diff --git a/lengsuo/integration/official_defaults.h b/lengsuo/integration/official_defaults.h
new file mode 100644
index 0000000..6792c06
--- /dev/null
+++ b/lengsuo/integration/official_defaults.h
@@ -0,0 +1,52 @@
+// official_defaults - keep feature defaults aligned with shipped Chrome.
+//
+// Our engine is Chromium, but the product is meant to be indistinguishable from
+// a real Chrome install. Chromium's own feature defaults legitimately differ
+// from Chrome's: a feature can be disabled in the published browser while the
+// open-source default (or the local build configuration) leaves it on. When
+// that happens the difference is invisible in the UI and shows up only in a
+// fingerprint field, which is exactly the class of problem that is expensive to
+// find later.
+//
+// `ReduceAcceptLanguage` is the worked example. Chromium truncates
+// `navigator.languages` to the first entry when it is enabled, so a page sees
+// ["en-US"] instead of ["en-US","en"]. Official Chrome leaves it off, so the
+// two disagree on identical hardware and locale. Measured on the research host:
+// our build reported ["en-US"] while Chrome 144 reported ["en-US","en"], and
+// passing --disable-features=ReduceAcceptLanguage made the two identical.
+//
+// The browser process is the right place to fix this: the renderer inherits
+// --disable-features through its own command line, so one correction here
+// covers the main thread, dedicated workers and service workers at once.
+#ifndef LENGSUO_INTEGRATION_OFFICIAL_DEFAULTS_H_
+#define LENGSUO_INTEGRATION_OFFICIAL_DEFAULTS_H_
+
+#include <string>
+#include <string_view>
+
+namespace base {
+class CommandLine;
+}
+
+namespace lengsuo {
+
+// Features that must be off to match shipped Chrome. Each entry is a comment
+// explaining the observable difference, because a bare name here is not
+// reviewable later.
+inline constexpr std::string_view kFeaturesChromeDisables[] = {
+    // Truncates navigator.languages to one entry.
+    "ReduceAcceptLanguage",
+};
+
+// Merges the list above into the process command line's --disable-features.
+// Idempotent: re-running adds nothing, and an existing user-supplied value is
+// preserved rather than replaced.
+void ApplyOfficialFeatureDefaults(base::CommandLine* command);
+
+// Exposed for tests: the comma-separated value that should end up in
+// --disable-features given the value already present on the command line.
+std::string MergeDisabledFeatures(std::string_view existing);
+
+}  // namespace lengsuo
+
+#endif  // LENGSUO_INTEGRATION_OFFICIAL_DEFAULTS_H_
diff --git a/lengsuo/integration/official_defaults_unittest.cc b/lengsuo/integration/official_defaults_unittest.cc
new file mode 100644
index 0000000..226c891
--- /dev/null
+++ b/lengsuo/integration/official_defaults_unittest.cc
@@ -0,0 +1,83 @@
+// Unit tests for the feature-default alignment helper.
+//
+// The merge must be idempotent and must never discard an operator's own
+// --disable-features value: this runs on every startup, and clobbering a
+// debugging flag would be a silent regression in the field.
+//
+// This file used to carry its own main() and hand-rolled pass counter, which
+// silently replaced the gtest runner of the bootstrap_unittests binary: every
+// TEST() in the other files compiled into it never executed. It is a gtest
+// TEST now, like the rest of the binary.
+#include "lengsuo/integration/official_defaults.h"
+
+#include <string>
+
+#include "base/command_line.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace {
+
+bool Has(std::string_view haystack, std::string_view needle) {
+  return haystack.find(needle) != std::string_view::npos;
+}
+}  // namespace
+
+TEST(OfficialDefaults, MergeAndApply) {
+  using lengsuo::MergeDisabledFeatures;
+
+  // 1. Empty input still gets the required feature.
+  const std::string from_empty = MergeDisabledFeatures("");
+  EXPECT_TRUE(Has(from_empty, "ReduceAcceptLanguage"));
+
+  // 2. An operator value is preserved, not replaced.
+  const std::string merged = MergeDisabledFeatures("MyFeature,OtherThing");
+  EXPECT_TRUE(Has(merged, "MyFeature"));
+  EXPECT_TRUE(Has(merged, "OtherThing"));
+  EXPECT_TRUE(Has(merged, "ReduceAcceptLanguage"));
+
+  // 3. Idempotent: merging the result again changes nothing.
+  EXPECT_TRUE(MergeDisabledFeatures(merged) == merged);
+
+  // 4. No duplicates when the feature is already present.
+  const std::string twice = MergeDisabledFeatures("ReduceAcceptLanguage");
+  std::size_t occurrences = 0;
+  for (std::size_t pos = twice.find("ReduceAcceptLanguage"); pos != std::string::npos;
+       pos = twice.find("ReduceAcceptLanguage", pos + 1)) {
+    ++occurrences;
+  }
+  EXPECT_TRUE(occurrences == 1);
+
+  // 5. Whitespace and empty segments do not produce stray commas.
+  const std::string messy = MergeDisabledFeatures(" A , , B ");
+  EXPECT_TRUE(Has(messy, "A"));
+  EXPECT_TRUE(Has(messy, "B"));
+  EXPECT_TRUE(messy.find(",,") == std::string::npos);
+  EXPECT_TRUE(!messy.empty() && messy.front() != ',' && messy.back() != ',');
+
+  // 6. Applying onto a command line that has no switch sets it.
+  base::CommandLine cmd(base::CommandLine::NO_PROGRAM);
+  lengsuo::ApplyOfficialFeatureDefaults(&cmd);
+  EXPECT_TRUE(cmd.HasSwitch("disable-features"));
+  EXPECT_TRUE(Has(cmd.GetSwitchValueASCII("disable-features"),
+                  "ReduceAcceptLanguage"));
+  // The renderer-side switch is separate and also required: the renderer never
+  // rebuilds its feature list from the browser's --disable-features.
+  EXPECT_TRUE(cmd.HasSwitch("disable-reduce-accept-language"));
+
+  // 7. Applying twice is stable (startup may call it more than once).
+  const std::string once = cmd.GetSwitchValueASCII("disable-features");
+  lengsuo::ApplyOfficialFeatureDefaults(&cmd);
+  EXPECT_TRUE(cmd.GetSwitchValueASCII("disable-features") == once);
+  EXPECT_TRUE(cmd.HasSwitch("disable-reduce-accept-language"));
+
+  // 8. A pre-existing switch keeps its own entries.
+  base::CommandLine existing(base::CommandLine::NO_PROGRAM);
+  existing.AppendSwitchASCII("disable-features", "KeepMe");
+  lengsuo::ApplyOfficialFeatureDefaults(&existing);
+  const std::string value = existing.GetSwitchValueASCII("disable-features");
+  EXPECT_TRUE(Has(value, "KeepMe"));
+  EXPECT_TRUE(Has(value, "ReduceAcceptLanguage"));
+
+  // 9. Null-safe: callers may pass nothing in tests.
+  lengsuo::ApplyOfficialFeatureDefaults(nullptr);
+}
diff --git a/lengsuo/integration/profile_bootstrap_state.cc b/lengsuo/integration/profile_bootstrap_state.cc
new file mode 100644
index 0000000..a144dcb
--- /dev/null
+++ b/lengsuo/integration/profile_bootstrap_state.cc
@@ -0,0 +1,46 @@
+#include "lengsuo/integration/profile_bootstrap_state.h"
+#include <cstdint>
+#include <span>
+namespace lengsuo {
+ProfileBootstrapState::ProfileBootstrapState() = default;
+ProfileBootstrapState::~ProfileBootstrapState() = default;
+bool ProfileBootstrapState::Initialize(bool requested, bool safe_local_path,
+                                       const Reader& read) {
+  if (attempted_) return false;
+  attempted_ = true;
+  if (!requested) return true;
+  if (!safe_local_path) return false;
+  auto wire = read();
+  if (!wire || wire->empty() || wire->size() > 4096) return false;
+  auto parsed = DecodeProfile(std::span<const std::uint8_t>(
+      reinterpret_cast<const std::uint8_t*>(wire->data()), wire->size()));
+  // The standalone decoder supports schema 2, but browser-side WebRTC policy
+  // injection is not accepted yet. Never silently ignore an explicit policy.
+  if (!parsed || parsed->schema_version != 1) return false;
+  profile_ = std::move(parsed);
+  return true;
+}
+bool ProfileBootstrapState::InitializeCatalog(bool requested,
+                                             bool safe_local_path,
+                                             const Reader& read) {
+  if (catalog_attempted_) return false;
+  catalog_attempted_ = true;
+  if (!attempted_) return false;
+  if (!requested) return true;
+  if (!profile_ || !safe_local_path) return false;
+  auto wire = read();
+  if (!wire || wire->empty() || wire->size() > 4096) return false;
+  auto parsed = DecodeCatalog(std::span<const std::uint8_t>(
+      reinterpret_cast<const std::uint8_t*>(wire->data()), wire->size()));
+  if (!parsed || !ResolveCatalogUa(*parsed, *profile_)) return false;
+  catalog_ = std::move(parsed);
+  return true;
+}
+const CatalogUaEntry* ProfileBootstrapState::ua() const {
+  return catalog_ && profile_ ? ResolveCatalogUa(*catalog_, *profile_) : nullptr;
+}
+const CatalogGpuEntry* ProfileBootstrapState::gpu() const {
+  return catalog_ && profile_ ? ResolveCatalogGpu(*catalog_, *profile_)
+                             : nullptr;
+}
+}  // namespace lengsuo
diff --git a/lengsuo/integration/profile_bootstrap_state.h b/lengsuo/integration/profile_bootstrap_state.h
new file mode 100644
index 0000000..3bd62d6
--- /dev/null
+++ b/lengsuo/integration/profile_bootstrap_state.h
@@ -0,0 +1,30 @@
+#ifndef LENGSUO_INTEGRATION_PROFILE_BOOTSTRAP_STATE_H_
+#define LENGSUO_INTEGRATION_PROFILE_BOOTSTRAP_STATE_H_
+#include <functional>
+#include <optional>
+#include <string>
+#include "lengsuo/native/profile_wire.h"
+#include "lengsuo/native/profile_catalog.h"
+namespace lengsuo {
+// Browser startup only. No credentials, entitlement or network decisions.
+class ProfileBootstrapState {
+ public:
+  using Reader = std::function<std::optional<std::string>()>;
+  // Out-of-line: Chromium style requires it for complex members.
+  ProfileBootstrapState();
+  ~ProfileBootstrapState();
+  ProfileBootstrapState(const ProfileBootstrapState&) = delete;
+  ProfileBootstrapState& operator=(const ProfileBootstrapState&) = delete;
+  bool Initialize(bool requested, bool safe_local_path, const Reader& read);
+  bool InitializeCatalog(bool requested, bool safe_local_path, const Reader& read);
+  const ParsedProfile* profile() const { return profile_ ? &*profile_ : nullptr; }
+  const CatalogUaEntry* ua() const;
+  const CatalogGpuEntry* gpu() const;
+ private:
+  bool attempted_ = false;
+  std::optional<ParsedProfile> profile_;
+  bool catalog_attempted_ = false;
+  std::optional<ParsedCatalog> catalog_;
+};
+}  // namespace lengsuo
+#endif
diff --git a/lengsuo/native/BUILD.gn b/lengsuo/native/BUILD.gn
new file mode 100644
index 0000000..d063ff9

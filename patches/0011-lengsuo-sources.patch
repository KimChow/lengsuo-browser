+++ b/lengsuo/native/kernel_pipe.cc
@@ -0,0 +1,145 @@
+#include "kernel_pipe.h"
+
+#include <openssl/mem.h>
+
+#include <utility>
+
+namespace lengsuo::fp {
+namespace {
+
+void SetError(std::string* error, const char* message) {
+  if (error != nullptr) {
+    *error = message;
+  }
+}
+
+}  // namespace
+
+// ---------------------------------------------------------------------------
+// Handshake
+// ---------------------------------------------------------------------------
+
+KernelPipeHandshake::KernelPipeHandshake() = default;
+
+KernelPipeHandshake::~KernelPipeHandshake() {
+  // The session key never outlives the object: it is wiped here rather than
+  // left for the allocator to recycle.
+  OPENSSL_cleanse(session_key_.data(), session_key_.size());
+}
+
+bool KernelPipeHandshake::SendHello(std::string_view hello_nonce,
+                                    std::string* frame_out) {
+  if (state_ != KernelPipeState::kWaitHello) {
+    return false;
+  }
+  if (hello_nonce.size() != kKernelPipeHelloNonceBytes) {
+    state_ = KernelPipeState::kFailed;
+    return false;
+  }
+  std::string hex;
+  hex.reserve(kKernelPipeHelloNonceBytes * 2);
+  wire::AppendHex(&hex, hello_nonce);
+  // The Hello payload is JSON {version, nonce}; the nonce is the 8 random
+  // bytes in hex, which is what the contract's Hello frame carries.
+  std::string payload = "{\"version\":";
+  payload += std::to_string(kKernelPipeProtocolVersion);
+  payload += ",\"nonce\":\"";
+  payload += hex;
+  payload += "\"}";
+  std::string frame;
+  if (!EncodeFrame(FrameType::kHello, payload, &frame)) {
+    state_ = KernelPipeState::kFailed;
+    return false;
+  }
+  hello_nonce_ = std::string(hello_nonce);
+  state_ = KernelPipeState::kHandshake;
+  if (frame_out != nullptr) {
+    *frame_out = std::move(frame);
+  }
+  return true;
+}
+
+bool KernelPipeHandshake::AcceptKeyEnvelope(const Frame& frame,
+                                            std::string_view machine_key,
+                                            std::int64_t now_unix,
+                                            std::string* error) {
+  if (state_ != KernelPipeState::kHandshake) {
+    // An envelope that arrives before the Hello, or a second one after the
+    // session is up, means the peer is not speaking the protocol. Fail
+    // closed: the session is dead rather than half-alive.
+    SetError(error, "handshake: unexpected envelope");
+    state_ = KernelPipeState::kFailed;
+    return false;
+  }
+  if (frame.type != FrameType::kKeyEnvelope) {
+    SetError(error, "handshake: wrong frame type");
+    state_ = KernelPipeState::kFailed;
+    return false;
+  }
+  // The AAD is the envelope frame's own header followed by the Hello nonce.
+  std::string aad = frame.header;
+  aad += hello_nonce_;
+  KeyEnvelope envelope;
+  if (!OpenKeyEnvelope(frame.payload, machine_key, aad, &envelope, error)) {
+    state_ = KernelPipeState::kFailed;
+    return false;
+  }
+  if (envelope.session_key.size() != kKernelPipeSessionKeyBytes) {
+    SetError(error, "handshake: bad session key length");
+    state_ = KernelPipeState::kFailed;
+    return false;
+  }
+  if (now_unix >= 0 &&
+      static_cast<std::uint64_t>(now_unix) > envelope.expires_unix) {
+    SetError(error, "handshake: envelope already expired");
+    state_ = KernelPipeState::kFailed;
+    return false;
+  }
+  OPENSSL_cleanse(session_key_.data(), session_key_.size());
+  session_key_ = std::move(envelope.session_key);
+  container_id_ = std::move(envelope.container_id);
+  expires_unix_ = envelope.expires_unix;
+  state_ = KernelPipeState::kReady;
+  return true;
+}
+
+bool KernelPipeHandshake::Expired(std::int64_t now_unix) const {
+  if (state_ != KernelPipeState::kReady) {
+    return true;
+  }
+  if (now_unix < 0) {
+    return false;
+  }
+  return static_cast<std::uint64_t>(now_unix) > expires_unix_;
+}
+
+void KernelPipeHandshake::Reset() {
+  OPENSSL_cleanse(session_key_.data(), session_key_.size());
+  session_key_.clear();
+  container_id_.clear();
+  hello_nonce_.clear();
+  expires_unix_ = 0;
+  state_ = KernelPipeState::kWaitHello;
+}
+
+// ---------------------------------------------------------------------------
+// Config bundle
+// ---------------------------------------------------------------------------
+
+bool KernelPipeConfig::Freeze(std::string_view json, std::string* error) {
+  if (frozen_) {
+    // One-shot: the configuration cannot change after the browser started.
+    SetError(error, "config: already frozen");
+    return false;
+  }
+  JsonObject parsed;
+  if (!JsonObject::Parse(json, &parsed)) {
+    SetError(error, "config: malformed bundle");
+    return false;
+  }
+  json_ = std::string(json);
+  frozen_ = true;
+  return true;
+}
+
+}  // namespace lengsuo::fp
diff --git a/lengsuo/native/kernel_pipe.h b/lengsuo/native/kernel_pipe.h
new file mode 100644
index 0000000..f309e7c
--- /dev/null
+++ b/lengsuo/native/kernel_pipe.h
@@ -0,0 +1,136 @@
+// kernel_pipe - the kernel side of the runner <-> kernel pipe (task Q).
+//
+// docs/kernel-wire-contract.md is the single source of truth for the bytes
+// that travel on this pipe. This file is its kernel-side implementation; the
+// client repo (task P) implements the mirror image. The two sides align on
+// the fixed test vectors the contract pins, not on a verbal convention.
+//
+// The pipe is built from four layers, each in its own file:
+//
+//   kernel_pipe_frame.{h,cc}      frames, the 8-byte header, the byte helpers
+//   kernel_pipe_json.{h,cc}       the shallow JSON reader
+//   kernel_pipe_keys.{h,cc}       the machine-code derivation
+//   kernel_pipe_envelope.{h,cc}   the KeyEnvelope
+//   kernel_pipe.{h,cc}            this file: the handshake and the config
+//
+// The split is by dependency, not by convenience: the JSON reader must be
+// testable without a crypto library, and the frame codec without either.
+// The layers below are pulled in through the headers.
+//
+// Everything here is pure: no Chromium, no base/, no threads, no sockets.
+// The transport that carries these bytes lives in the browser-side wiring
+// (patches/0016-browser-wiring.patch) and is deliberately kept out of this
+// translation unit, so the whole file still compiles standalone for the
+// gtest target.
+//
+// Fail-closed is the rule everywhere: a frame that does not decode, an
+// envelope that does not authenticate, a config that does not parse - all of
+// them are errors. Nothing here ever degrades into "no configuration".
+#ifndef LENGSUO_NATIVE_KERNEL_PIPE_H_
+#define LENGSUO_NATIVE_KERNEL_PIPE_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <string_view>
+
+#include "kernel_pipe_envelope.h"
+#include "kernel_pipe_frame.h"
+#include "kernel_pipe_json.h"
+#include "kernel_pipe_keys.h"
+
+namespace lengsuo::fp {
+
+// ---------------------------------------------------------------------------
+// Handshake (contract section 1)
+// ---------------------------------------------------------------------------
+
+enum class KernelPipeState : std::uint8_t {
+  kWaitHello,   // nothing sent yet
+  kHandshake,   // Hello sent, waiting for the KeyEnvelope
+  kReady,       // the session key is in hand
+  kFailed,      // fail-closed: the session is dead
+};
+
+// The kernel's half of the handshake.
+//
+// The kernel sends the Hello, receives the KeyEnvelope, opens it and only
+// then reaches kReady. Every rejection ends in kFailed: the session is never
+// downgraded to "no session key".
+class KernelPipeHandshake {
+ public:
+  KernelPipeHandshake();
+  ~KernelPipeHandshake();
+  KernelPipeHandshake(const KernelPipeHandshake&) = delete;
+  KernelPipeHandshake& operator=(const KernelPipeHandshake&) = delete;
+
+  KernelPipeState state() const { return state_; }
+  bool ready() const { return state_ == KernelPipeState::kReady; }
+  bool failed() const { return state_ == KernelPipeState::kFailed; }
+
+  // Builds the Hello frame and moves kWaitHello -> kHandshake. `hello_nonce`
+  // must be exactly 8 bytes. Returns false and moves to kFailed otherwise.
+  bool SendHello(std::string_view hello_nonce, std::string* frame_out);
+
+  // Consumes the KeyEnvelope frame and moves kHandshake -> kReady.
+  //
+  // `machine_key` is k_machine; `now_unix` is the current Unix time in
+  // seconds. An envelope that does not authenticate, or one whose expiry has
+  // passed, fails the session. `*error` never carries payload bytes.
+  bool AcceptKeyEnvelope(const Frame& frame,
+                          std::string_view machine_key,
+                          std::int64_t now_unix,
+                          std::string* error);
+
+  // The session key. Only meaningful once ready() is true.
+  const std::string& session_key() const { return session_key_; }
+  const std::string& container_id() const { return container_id_; }
+  std::uint64_t expires_unix() const { return expires_unix_; }
+
+  // True when the session key has outlived its expiry. A caller that uses
+  // the key after this point is using an expired key.
+  bool Expired(std::int64_t now_unix) const;
+
+  // Wipes the session key and returns the session to kWaitHello.
+  void Reset();
+
+ private:
+  KernelPipeState state_ = KernelPipeState::kWaitHello;
+  std::string hello_nonce_;
+  std::string session_key_;
+  std::string container_id_;
+  std::uint64_t expires_unix_ = 0;
+};
+
+// ---------------------------------------------------------------------------
+// Config bundle (contract section 3, type 0x03)
+// ---------------------------------------------------------------------------
+
+// The configuration bundle the runner sends after the handshake.
+//
+// The bundle is JSON. The kernel parses it once, freezes it, and never reads
+// it again - the same one-shot rule the L3 document follows.
+class KernelPipeConfig {
+ public:
+  KernelPipeConfig() = default;
+  ~KernelPipeConfig() = default;
+  KernelPipeConfig(const KernelPipeConfig&) = delete;
+  KernelPipeConfig& operator=(const KernelPipeConfig&) = delete;
+
+  // Parses and freezes the bundle. A second call fails: the configuration
+  // cannot change after the browser has started. Returns false and sets
+  // `*error` (when non-null) on a malformed bundle.
+  bool Freeze(std::string_view json, std::string* error);
+
+  bool frozen() const { return frozen_; }
+  // The frozen bundle's text. Empty when nothing was frozen.
+  const std::string& json() const { return json_; }
+
+ private:
+  bool frozen_ = false;
+  std::string json_;
+};
+
+}  // namespace lengsuo::fp
+
+#endif  // LENGSUO_NATIVE_KERNEL_PIPE_H_
diff --git a/lengsuo/native/kernel_pipe_envelope.cc b/lengsuo/native/kernel_pipe_envelope.cc
new file mode 100644
index 0000000..97277e5
--- /dev/null
+++ b/lengsuo/native/kernel_pipe_envelope.cc
@@ -0,0 +1,261 @@
+#include "kernel_pipe_envelope.h"
+
+#include <openssl/aead.h>
+#include <openssl/mem.h>
+
+#include <utility>
+
+namespace lengsuo::fp {
+namespace {
+
+void SetError(std::string* error, const char* message) {
+  if (error != nullptr) {
+    *error = message;
+  }
+}
+
+}  // namespace
+
+// ---------------------------------------------------------------------------
+// The envelope
+// ---------------------------------------------------------------------------
+
+bool OpenKeyEnvelope(std::string_view payload,
+                     std::string_view machine_key,
+                     std::string_view aad,
+                     KeyEnvelope* out,
+                     std::string* error) {
+  if (out == nullptr) {
+    SetError(error, "envelope: no output");
+    return false;
+  }
+  if (machine_key.size() != kKernelPipeMachineKeyBytes) {
+    SetError(error, "envelope: bad machine key length");
+    return false;
+  }
+  if (aad.size() != kKernelPipeAadBytes) {
+    SetError(error, "envelope: bad aad length");
+    return false;
+  }
+  // Layout (contract section 3.1, as fixed by the contract's own published
+  // payload vector and by docs/task-briefs/client-p1-kernel-pipe-core.txt):
+  //   nonce_len(4) nonce(12) ciphertext_len(4) ciphertext(M) tag_len(4)
+  //   tag(16).
+  //
+  // The container id and the expiry are NOT carried in the clear: they live
+  // only inside the ciphertext's plaintext, so a middleman cannot rewrite
+  // them without breaking the authentication. That also fixes the payload
+  // length at 40 + M, which is what the vector's frame length (85) and the
+  // AAD's length field describe.
+  //
+  // Every integer is big-endian.
+  std::size_t pos = 0;
+  auto need = [&](std::size_t count) { return payload.size() - pos >= count; };
+  if (!need(4)) {
+    SetError(error, "envelope: truncated");
+    return false;
+  }
+  const std::uint32_t nonce_len = wire::ReadU32BE(payload, pos);
+  pos += 4;
+  if (nonce_len != kKernelPipeGcmNonceBytes || !need(nonce_len)) {
+    SetError(error, "envelope: bad nonce");
+    return false;
+  }
+  // The nonce is carried as a view into the payload: no pointer arithmetic
+  // and no copy. The AEAD only reads it.
+  const std::string_view nonce = payload.substr(pos, nonce_len);
+  pos += nonce_len;
+
+  if (!need(4)) {
+    SetError(error, "envelope: truncated");
+    return false;
+  }
+  const std::uint32_t ciphertext_len = wire::ReadU32BE(payload, pos);
+  pos += 4;
+  if (!need(ciphertext_len)) {
+    SetError(error, "envelope: truncated");
+    return false;
+  }
+  const std::string ciphertext(payload.substr(pos, ciphertext_len));
+  pos += ciphertext_len;
+
+  if (!need(4)) {
+    SetError(error, "envelope: truncated");
+    return false;
+  }
+  const std::uint32_t tag_len = wire::ReadU32BE(payload, pos);
+  pos += 4;
+  if (tag_len != kKernelPipeGcmTagBytes || !need(tag_len)) {
+    SetError(error, "envelope: bad tag");
+    return false;
+  }
+  const std::string tag(payload.substr(pos, tag_len));
+  pos += tag_len;
+  if (pos != payload.size()) {
+    SetError(error, "envelope: trailing bytes");
+    return false;
+  }
+
+  // The plaintext is session_key(32) || container_id || expires_unix(8).
+  if (ciphertext_len < kKernelPipeSessionKeyBytes + 8) {
+    SetError(error, "envelope: short ciphertext");
+    return false;
+  }
+  std::string plaintext(ciphertext_len, '\0');
+  std::size_t plaintext_len = 0;
+  const EVP_AEAD* aead = EVP_aead_aes_256_gcm();
+  if (aead == nullptr) {
+    SetError(error, "envelope: no aead");
+    return false;
+  }
+  EVP_AEAD_CTX* ctx = EVP_AEAD_CTX_new(
+      aead, reinterpret_cast<const std::uint8_t*>(machine_key.data()),
+      machine_key.size(), kKernelPipeGcmTagBytes);
+  if (ctx == nullptr) {
+    SetError(error, "envelope: no aead context");
+    return false;
+  }
+  // The wire keeps the tag in its own field, but the AEAD wants the
+  // ciphertext and the tag concatenated.
+  std::string sealed = ciphertext;
+  sealed += tag;
+  const int opened = EVP_AEAD_CTX_open(
+      ctx, reinterpret_cast<std::uint8_t*>(plaintext.data()), &plaintext_len,
+      plaintext.size(),
+      reinterpret_cast<const std::uint8_t*>(nonce.data()), nonce.size(),
+      reinterpret_cast<const std::uint8_t*>(sealed.data()), sealed.size(),
+      reinterpret_cast<const std::uint8_t*>(aad.data()), aad.size());
+  EVP_AEAD_CTX_free(ctx);
+  if (opened != 1 || plaintext_len != ciphertext_len) {
+    // A failed authentication yields nothing: no partial plaintext escapes.
+    OPENSSL_cleanse(plaintext.data(), plaintext.size());
+    SetError(error, "envelope: authentication failed");
+    return false;
+  }
+
+  KeyEnvelope envelope;
+  envelope.session_key = plaintext.substr(0, kKernelPipeSessionKeyBytes);
+  // The rest is container_id || expires_unix(u64 BE). The expiry is the last
+  // eight bytes; everything before it is the container id.
+  const std::string tail =
+      plaintext.substr(kKernelPipeSessionKeyBytes,
+                       plaintext_len - kKernelPipeSessionKeyBytes);
+  if (tail.size() < 8) {
+    OPENSSL_cleanse(plaintext.data(), plaintext.size());
+    SetError(error, "envelope: short plaintext");
+    return false;
+  }
+  envelope.container_id = tail.substr(0, tail.size() - 8);
+  if (envelope.container_id.size() > kKernelPipeMaxContainerIdBytes) {
+    OPENSSL_cleanse(plaintext.data(), plaintext.size());
+    SetError(error, "envelope: container id too long");
+    return false;
+  }
+  envelope.expires_unix = wire::ReadU64BE(tail, tail.size() - 8);
+  OPENSSL_cleanse(plaintext.data(), plaintext.size());
+  *out = std::move(envelope);
+  return true;
+}
+
+bool BuildKeyEnvelope(std::string_view session_key,
+                      std::string_view container_id,
+                      std::uint64_t expires_unix,
+                      std::string_view machine_key,
+                      std::string_view gcm_nonce,
+                      std::string_view hello_nonce,
+                      std::string* out,
+                      std::string* error) {
+  if (out == nullptr) {
+    SetError(error, "envelope: no output");
+    return false;
+  }
+  if (session_key.size() != kKernelPipeSessionKeyBytes) {
+    SetError(error, "envelope: bad session key length");
+    return false;
+  }
+  if (machine_key.size() != kKernelPipeMachineKeyBytes) {
+    SetError(error, "envelope: bad machine key length");
+    return false;
+  }
+  if (gcm_nonce.size() != kKernelPipeGcmNonceBytes) {
+    SetError(error, "envelope: bad nonce length");
+    return false;
+  }
+  if (hello_nonce.size() != kKernelPipeHelloNonceBytes) {
+    SetError(error, "envelope: bad hello nonce length");
+    return false;
+  }
+  if (container_id.size() > kKernelPipeMaxContainerIdBytes) {
+    SetError(error, "envelope: container id too long");
+    return false;
+  }
+
+  // The plaintext: session_key || container_id || expires_unix(u64 BE).
+  std::string plaintext(session_key);
+  plaintext.append(container_id);
+  wire::PutU64BE(&plaintext, expires_unix);
+
+  // The wire keeps the tag in its own field, so the ciphertext field holds
+  // exactly the plaintext's length and the tag field holds the 16 bytes the
+  // AEAD appends. The payload length is 40 + the ciphertext length, and the
+  // frame header's length field is part of the AAD, so it has to be known
+  // before sealing.
+  const std::size_t ciphertext_len = plaintext.size();
+  const std::size_t payload_len = 4 + kKernelPipeGcmNonceBytes + 4 +
+                                  ciphertext_len + 4 + kKernelPipeGcmTagBytes;
+
+  std::string header;
+  wire::PutU32BE(&header, static_cast<std::uint32_t>(payload_len));
+  header.push_back(static_cast<char>(static_cast<std::uint8_t>(
+      FrameType::kKeyEnvelope)));
+  header.push_back('\0');
+  header.push_back('\0');
+  header.push_back('\0');
+  std::string aad = header;
+  aad.append(hello_nonce);
+
+  std::string sealed(ciphertext_len + kKernelPipeGcmTagBytes, '\0');
+  std::size_t sealed_len = 0;
+  const EVP_AEAD* aead = EVP_aead_aes_256_gcm();
+  if (aead == nullptr) {
+    SetError(error, "envelope: no aead");
+    return false;
+  }
+  EVP_AEAD_CTX* ctx = EVP_AEAD_CTX_new(
+      aead, reinterpret_cast<const std::uint8_t*>(machine_key.data()),
+      machine_key.size(), kKernelPipeGcmTagBytes);
+  if (ctx == nullptr) {
+    SetError(error, "envelope: no aead context");
+    return false;
+  }
+  const int sealed_ok = EVP_AEAD_CTX_seal(
+      ctx, reinterpret_cast<std::uint8_t*>(sealed.data()), &sealed_len,
+      sealed.size(), reinterpret_cast<const std::uint8_t*>(gcm_nonce.data()),
+      gcm_nonce.size(),
+      reinterpret_cast<const std::uint8_t*>(plaintext.data()), plaintext.size(),
+      reinterpret_cast<const std::uint8_t*>(aad.data()), aad.size());
+  EVP_AEAD_CTX_free(ctx);
+  if (sealed_ok != 1 || sealed_len != sealed.size()) {
+    SetError(error, "envelope: seal failed");
+    return false;
+  }
+
+  // The payload: nonce_len | nonce | ciphertext_len | ciphertext | tag_len |
+  // tag. The tag is the last 16 bytes of the sealed output.
+  std::string payload;
+  payload.reserve(payload_len);
+  wire::PutU32BE(&payload, kKernelPipeGcmNonceBytes);
+  payload.append(gcm_nonce);
+  wire::PutU32BE(&payload, static_cast<std::uint32_t>(ciphertext_len));
+  payload.append(sealed.substr(0, ciphertext_len));
+  wire::PutU32BE(&payload, kKernelPipeGcmTagBytes);
+  payload.append(sealed.substr(ciphertext_len));
+  if (payload.size() != payload_len) {
+    SetError(error, "envelope: bad payload length");
+    return false;
+  }
+  *out = std::move(payload);
+  return true;
+}
+
+}  // namespace lengsuo::fp
diff --git a/lengsuo/native/kernel_pipe_envelope.h b/lengsuo/native/kernel_pipe_envelope.h
new file mode 100644
index 0000000..d8e78ae
--- /dev/null
+++ b/lengsuo/native/kernel_pipe_envelope.h
@@ -0,0 +1,86 @@
+// kernel_pipe_envelope - the KeyEnvelope of the runner <-> kernel pipe
+// (task Q).
+//
+// The runner seals the session key into a KeyEnvelope; the kernel opens it.
+// The payload layout is pinned by docs/kernel-wire-contract.md section 3.1,
+// field by field, and the contract publishes a fixed vector for it. The
+// client repo (task P) hardcodes the same bytes.
+//
+// Fail-closed is the rule: an envelope that does not authenticate yields no
+// plaintext at all, not a partial one.
+//
+// The machine-code derivation the envelope is keyed with lives in
+// kernel_pipe_keys.{h,cc}.
+#ifndef LENGSUO_NATIVE_KERNEL_PIPE_ENVELOPE_H_
+#define LENGSUO_NATIVE_KERNEL_PIPE_ENVELOPE_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <string_view>
+
+#include "kernel_pipe_frame.h"
+#include "kernel_pipe_keys.h"
+
+namespace lengsuo::fp {
+
+// The GCM nonce and tag sizes. Both are the GCM standard sizes; an 8-byte
+// nonce is a legal GCM form but is not what the contract pins.
+inline constexpr std::size_t kKernelPipeGcmNonceBytes = 12;
+inline constexpr std::size_t kKernelPipeGcmTagBytes = 16;
+
+// The size of the AAD that binds the envelope to the handshake that asked
+// for it (frame header + hello nonce).
+inline constexpr std::size_t kKernelPipeAadBytes =
+    kKernelPipeHeaderBytes + kKernelPipeHelloNonceBytes;
+
+// The container id carried by the envelope, bounded so a hostile peer
+// cannot make the kernel allocate without limit.
+inline constexpr std::size_t kKernelPipeMaxContainerIdBytes = 256;
+
+// The contents of a KeyEnvelope once it has been opened.
+struct KeyEnvelope {
+  std::string session_key;  // exactly 32 bytes
+  std::string container_id;
+  std::uint64_t expires_unix = 0;
+};
+
+// Opens a KeyEnvelope payload (contract section 3.1).
+//
+// `aad` must be the 16 bytes the contract pins: the envelope frame's own
+// 8-byte header followed by the 8-byte Hello nonce. Opening with any other
+// AAD fails, which is what makes a captured envelope useless in another
+// handshake.
+//
+// Returns false and sets `*error` (when non-null) on any failure. `*out` is
+// left untouched, so a wrong key or a tampered envelope yields no partial
+// plaintext. The error text never carries payload bytes.
+bool OpenKeyEnvelope(std::string_view payload,
+                     std::string_view machine_key,
+                     std::string_view aad,
+                     KeyEnvelope* out,
+                     std::string* error);
+
+// Builds the KeyEnvelope payload for a session key (contract section 3.1).
+//
+// The kernel never sends an envelope - the runner does - but the builder is
+// here so the contract's fixed vector can be produced and checked by the
+// same code that reads it, and so the client side has a reference to mirror.
+//
+// The AAD is the envelope frame's own 8-byte header (whose length field is
+// this payload's length) followed by the 8-byte Hello nonce; the caller
+// passes the hello nonce and the builder derives the header.
+//
+// Returns false and sets `*error` (when non-null) on any failure.
+bool BuildKeyEnvelope(std::string_view session_key,
+                      std::string_view container_id,
+                      std::uint64_t expires_unix,
+                      std::string_view machine_key,
+                      std::string_view gcm_nonce,
+                      std::string_view hello_nonce,
+                      std::string* out,
+                      std::string* error);
+
+}  // namespace lengsuo::fp
+
+#endif  // LENGSUO_NATIVE_KERNEL_PIPE_ENVELOPE_H_
diff --git a/lengsuo/native/kernel_pipe_envelope_test.cc b/lengsuo/native/kernel_pipe_envelope_test.cc
new file mode 100644
index 0000000..77495d0
--- /dev/null
+++ b/lengsuo/native/kernel_pipe_envelope_test.cc
@@ -0,0 +1,222 @@
+// kernel_pipe_envelope_test - the key layer of the kernel side of the
+// runner <-> kernel pipe (task Q).
+//
+// The KeyEnvelope vectors are copied byte for byte out of
+// docs/kernel-wire-contract.md sections 2 and 3.1. The client repo (task P)
+// hardcodes the same bytes; that is the cross-repo agreement.
+//
+// The roundtrip alone is not the cross-repo check: this file opens the
+// contract's own bytes with the contract's own key, and separately rebuilds
+// them and compares byte for byte. A pair of implementations that are wrong
+// in the same way would still pass a roundtrip, and would still fail these.
+#include "kernel_pipe_envelope.h"
+
+#include <gtest/gtest.h>
+
+#include <cstdint>
+#include <string>
+
+#include "kernel_pipe_test_util.h"
+
+namespace lengsuo::fp {
+namespace {
+
+using test::BytesToHex;
+using test::HexToBytes;
+using test::kEnvelopeContainerId;
+using test::kEnvelopeCiphertext;
+using test::kEnvelopeExpires;
+using test::kEnvelopeFrameHeader;
+using test::kEnvelopeGcmNonce;
+using test::kEnvelopeHelloNonce;
+using test::kEnvelopePayload;
+using test::kEnvelopeTag;
+using test::kMachineCode;
+using test::kMachineKeyHex;
+using test::kSessionKeyHex;
+
+// The AAD the contract pins: the envelope frame's own header (whose length
+// field is the payload length) followed by the hello nonce.
+std::string ContractAad() {
+  return HexToBytes(kEnvelopeFrameHeader) + HexToBytes(kEnvelopeHelloNonce);
+}
+
+TEST(KernelPipeEnvelope, TheContractVectorOpens) {
+  const std::string payload = HexToBytes(kEnvelopePayload);
+  // The payload's length is what the contract's AAD names: 85 bytes, so the
+  // frame header's length field is 0x00000055.
+  ASSERT_EQ(payload.size(), 85u);
+  const std::string machine_key = HexToBytes(kMachineKeyHex);
+  KeyEnvelope envelope;
+  std::string error;
+  ASSERT_TRUE(
+      OpenKeyEnvelope(payload, machine_key, ContractAad(), &envelope, &error))
+      << error;
+  EXPECT_EQ(BytesToHex(envelope.session_key), std::string(kSessionKeyHex));
+  EXPECT_EQ(envelope.container_id, std::string(kEnvelopeContainerId));
+  EXPECT_EQ(envelope.expires_unix, kEnvelopeExpires);
+}
+
+TEST(KernelPipeEnvelope, TheContractVectorHasThePinnedFieldLayout) {
+  // The payload's six fields, in the contract's order. A layout that drifts
+  // here fails the open above anyway, but this names the drift.
+  const std::string payload = HexToBytes(kEnvelopePayload);
+  ASSERT_EQ(payload.size(), 85u);
+  // nonce_len = 12
+  EXPECT_EQ(payload[0], '\0');
+  EXPECT_EQ(payload[1], '\0');
+  EXPECT_EQ(payload[2], '\0');
+  EXPECT_EQ(payload[3], '\x0c');
+  // the nonce itself
+  EXPECT_EQ(BytesToHex(payload.substr(4, 12)),
+            BytesToHex(HexToBytes(kEnvelopeGcmNonce)));
+  // ciphertext_len = 45
+  EXPECT_EQ(BytesToHex(payload.substr(16, 4)), "0000002d");
+  // the ciphertext
+  EXPECT_EQ(BytesToHex(payload.substr(20, 45)),
+            BytesToHex(HexToBytes(kEnvelopeCiphertext)));
+  // tag_len = 16
+  EXPECT_EQ(BytesToHex(payload.substr(65, 4)), "00000010");
+  // the tag
+  EXPECT_EQ(BytesToHex(payload.substr(69, 16)),
+            BytesToHex(HexToBytes(kEnvelopeTag)));
+}
+
+TEST(KernelPipeEnvelope, TheContractVectorIsReproducible) {
+  // Building the envelope from the same inputs must reproduce the contract's
+  // bytes exactly. This is the check that the reader and the writer agree.
+  std::string machine_key;
+  ASSERT_TRUE(DeriveMachineKey(kMachineCode, &machine_key));
+  std::string payload;
+  std::string error;
+  ASSERT_TRUE(BuildKeyEnvelope(
+      HexToBytes(kSessionKeyHex), kEnvelopeContainerId, kEnvelopeExpires,
+      machine_key, HexToBytes(kEnvelopeGcmNonce),
+      HexToBytes(kEnvelopeHelloNonce), &payload, &error))
+      << error;
+  EXPECT_EQ(BytesToHex(payload), BytesToHex(HexToBytes(kEnvelopePayload)));
+  EXPECT_EQ(payload.size(), 85u);
+}
+
+TEST(KernelPipeEnvelope, AWrongKeyFails) {
+  const std::string payload = HexToBytes(kEnvelopePayload);
+  KeyEnvelope envelope;
+  std::string error;
+  // One bit flipped in the key.
+  std::string wrong_key = HexToBytes(kMachineKeyHex);
+  wrong_key[0] = static_cast<char>(wrong_key[0] ^ '\1');
+  EXPECT_FALSE(
+      OpenKeyEnvelope(payload, wrong_key, ContractAad(), &envelope, &error));
+  // The failure must not leak the plaintext.
+  EXPECT_TRUE(envelope.session_key.empty());
+  EXPECT_TRUE(envelope.container_id.empty());
+}
+
+TEST(KernelPipeEnvelope, ATamperedCiphertextFails) {
+  const std::string payload = HexToBytes(kEnvelopePayload);
+  const std::string machine_key = HexToBytes(kMachineKeyHex);
+  // Flip one bit of the ciphertext.
+  std::string tampered = payload;
+  const std::size_t ciphertext_start = 4 + 12 + 4;
+  tampered[ciphertext_start] =
+      static_cast<char>(tampered[ciphertext_start] ^ '\1');
+  KeyEnvelope envelope;
+  std::string error;
+  EXPECT_FALSE(OpenKeyEnvelope(tampered, machine_key, ContractAad(), &envelope,
+                               &error));
+  EXPECT_TRUE(envelope.session_key.empty());
+}
+
+TEST(KernelPipeEnvelope, ATamperedTagFails) {
+  const std::string payload = HexToBytes(kEnvelopePayload);
+  const std::string machine_key = HexToBytes(kMachineKeyHex);
+  std::string tampered = payload;
+  tampered[tampered.size() - 1] =
+      static_cast<char>(tampered[tampered.size() - 1] ^ '\1');
+  KeyEnvelope envelope;
+  std::string error;
+  EXPECT_FALSE(OpenKeyEnvelope(tampered, machine_key, ContractAad(), &envelope,
+                               &error));
+}
+
+TEST(KernelPipeEnvelope, ATruncatedPayloadFails) {
+  const std::string payload = HexToBytes(kEnvelopePayload);
+  const std::string machine_key = HexToBytes(kMachineKeyHex);
+  for (std::size_t cut : {std::size_t{0}, std::size_t{1}, std::size_t{4},
+                          std::size_t{16}, std::size_t{40}, std::size_t{84}}) {
+    KeyEnvelope envelope;
+    std::string error;
+    EXPECT_FALSE(OpenKeyEnvelope(payload.substr(0, cut), machine_key,
+                                 ContractAad(), &envelope, &error))
+        << "cut at " << cut;
+  }
+}
+
+TEST(KernelPipeEnvelope, TrailingBytesAreRejected) {
+  const std::string machine_key = HexToBytes(kMachineKeyHex);
+  KeyEnvelope envelope;
+  std::string error;
+
+  // A byte past the end of the tag: the payload is longer than its own
+  // fields describe, so it must not be accepted.
+  const std::string payload = HexToBytes(kEnvelopePayload);
+  EXPECT_FALSE(OpenKeyEnvelope(payload + std::string(1, '\0'), machine_key,
+                               ContractAad(), &envelope, &error));
+
+  // A byte past the end of the ciphertext, with the length field adjusted to
+  // match: the extra byte is then part of the ciphertext, so the tag no
+  // longer authenticates.
+  std::string stretched = payload;
+  stretched[19] = static_cast<char>(0x2e);  // ciphertext_len 45 -> 46
+  stretched.insert(stretched.begin() + 65, 1, '\x00');
+  EXPECT_FALSE(
+      OpenKeyEnvelope(stretched, machine_key, ContractAad(), &envelope, &error));
+  EXPECT_TRUE(envelope.session_key.empty());
+}
+
+TEST(KernelPipeEnvelope, TheWrongAadFails) {
+  // The AAD binds the envelope to the handshake that asked for it. An
+  // envelope replayed into another handshake must fail to authenticate.
+  const std::string payload = HexToBytes(kEnvelopePayload);
+  const std::string machine_key = HexToBytes(kMachineKeyHex);
+  const std::string other_hello_nonce = HexToBytes("11 22 33 44 55 66 77 88");
+  const std::string wrong_aad = HexToBytes(kEnvelopeFrameHeader) +
+                                other_hello_nonce;
+  KeyEnvelope envelope;
+  std::string error;
+  EXPECT_FALSE(
+      OpenKeyEnvelope(payload, machine_key, wrong_aad, &envelope, &error));
+  // And so must a frame-header-only AAD: that is the replay hole the
+  // contract closes by adding the hello nonce.
+  const std::string header_only = HexToBytes(kEnvelopeFrameHeader);
+  EXPECT_FALSE(
+      OpenKeyEnvelope(payload, machine_key, header_only, &envelope, &error));
+}
+
+TEST(KernelPipeEnvelope, AWrongSizedAadFails) {
+  const std::string payload = HexToBytes(kEnvelopePayload);
+  const std::string machine_key = HexToBytes(kMachineKeyHex);
+  KeyEnvelope envelope;
+  std::string error;
+  EXPECT_FALSE(
+      OpenKeyEnvelope(payload, machine_key, "", &envelope, &error));
+  EXPECT_FALSE(OpenKeyEnvelope(payload, machine_key, "short", &envelope,
+                               &error));
+  EXPECT_FALSE(OpenKeyEnvelope(payload, machine_key,
+                               std::string(17, '\0'), &envelope, &error));
+}
+
+TEST(KernelPipeEnvelope, ANonTwelveByteNonceIsRejected) {
+  const std::string payload = HexToBytes(kEnvelopePayload);
+  const std::string machine_key = HexToBytes(kMachineKeyHex);
+  // Rewrite the nonce length to 8: the contract pins 12.
+  std::string broken = payload;
+  broken[3] = '\x08';
+  KeyEnvelope envelope;
+  std::string error;
+  EXPECT_FALSE(
+      OpenKeyEnvelope(broken, machine_key, ContractAad(), &envelope, &error));
+}
+
+}  // namespace
+}  // namespace lengsuo::fp
diff --git a/lengsuo/native/kernel_pipe_frame.cc b/lengsuo/native/kernel_pipe_frame.cc
new file mode 100644
index 0000000..0886dfb
--- /dev/null
+++ b/lengsuo/native/kernel_pipe_frame.cc
@@ -0,0 +1,90 @@
+#include "kernel_pipe_frame.h"
+
+#include <utility>
+
+namespace lengsuo::fp {
+
+bool IsKnownFrameType(std::uint8_t raw) {
+  switch (raw) {
+    case 0x01:
+    case 0x02:
+    case 0x03:
+    case 0x04:
+    case 0x05:
+    case 0x81:
+    case 0x82:
+      return true;
+    default:
+      return false;
+  }
+}
+
+bool EncodeFrame(FrameType type,
+                 std::string_view payload,
+                 std::string* out) {
+  if (out == nullptr) {
+    return false;
+  }
+  if (payload.size() > kKernelPipeMaxPayloadBytes) {
+    return false;
+  }
+  std::string frame;
+  frame.reserve(kKernelPipeHeaderBytes + payload.size());
+  wire::PutU32BE(&frame, static_cast<std::uint32_t>(payload.size()));
+  frame.push_back(static_cast<char>(static_cast<std::uint8_t>(type)));
+  frame.push_back('\0');
+  frame.push_back('\0');
+  frame.push_back('\0');
+  frame.append(payload);
+  *out = std::move(frame);
+  return true;
+}
+
+bool DecodeFrameHeader(std::string_view header,
+                       std::uint32_t* payload_len,
+                       FrameType* type) {
+  if (header.size() < kKernelPipeHeaderBytes) {
+    return false;
+  }
+  const std::uint32_t length = wire::ReadU32BE(header, 0);
+  if (length > kKernelPipeMaxPayloadBytes) {
+    return false;
+  }
+  if (header[5] != '\0' || header[6] != '\0' || header[7] != '\0') {
+    return false;
+  }
+  const auto raw = static_cast<std::uint8_t>(header[4]);
+  if (!IsKnownFrameType(raw)) {
+    return false;
+  }
+  if (payload_len != nullptr) {
+    *payload_len = length;
+  }
+  if (type != nullptr) {
+    *type = static_cast<FrameType>(raw);
+  }
+  return true;
+}
+
+bool DecodeFrame(std::string_view frame, Frame* out) {
+  if (out == nullptr) {
+    return false;
+  }
+  std::uint32_t length = 0;
+  FrameType type = FrameType::kHello;
+  if (!DecodeFrameHeader(frame.substr(0, kKernelPipeHeaderBytes), &length,
+                         &type)) {
+    return false;
+  }
+  if (frame.size() != kKernelPipeHeaderBytes + length) {
+    return false;
+  }
+  Frame decoded;
+  decoded.type = type;
+  decoded.header = std::string(frame.substr(0, kKernelPipeHeaderBytes));
+  decoded.payload = std::string(frame.substr(kKernelPipeHeaderBytes, length));
+  *out = std::move(decoded);
+  return true;
+}
+
+}  // namespace lengsuo::fp
diff --git a/lengsuo/native/kernel_pipe_frame.h b/lengsuo/native/kernel_pipe_frame.h
new file mode 100644
index 0000000..34dfd44
--- /dev/null
+++ b/lengsuo/native/kernel_pipe_frame.h
@@ -0,0 +1,141 @@
+// kernel_pipe_frame - the frame layer of the runner <-> kernel pipe (task Q).
+//
+// docs/kernel-wire-contract.md section 2 is the single source of truth for
+// these bytes: [u32 len BE][u8 type][u8 reserved x3][payload]. The client
+// repo (task P) implements the mirror image, and the two sides align on the
+// fixed test vectors the contract pins - not on a verbal convention.
+//
+// This layer is the bottom of the stack. It depends on nothing: not on the
+// JSON reader, not on the crypto, not on Chromium. The layers above it (the
+// JSON reader, the key envelope, the handshake) all sit on top of it, which
+// is why the byte helpers live here rather than in each of them.
+#ifndef LENGSUO_NATIVE_KERNEL_PIPE_FRAME_H_
+#define LENGSUO_NATIVE_KERNEL_PIPE_FRAME_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <string_view>
+
+namespace lengsuo::fp {
+
+// ---------------------------------------------------------------------------
+// Byte helpers
+//
+// Every integer on this wire is big-endian (contract section 5). Writing the
+// bytes by hand keeps the encoding independent of the host's byte order and
+// independent of any struct packing.
+// ---------------------------------------------------------------------------
+
+namespace wire {
+
+// Appends `value` to `out` as four big-endian bytes.
+inline void PutU32BE(std::string* out, std::uint32_t value) {
+  out->push_back(static_cast<char>((value >> 24) & 0xFF));
+  out->push_back(static_cast<char>((value >> 16) & 0xFF));
+  out->push_back(static_cast<char>((value >> 8) & 0xFF));
+  out->push_back(static_cast<char>(value & 0xFF));
+}
+
+// Appends `value` to `out` as eight big-endian bytes.
+inline void PutU64BE(std::string* out, std::uint64_t value) {
+  for (int shift = 56; shift >= 0; shift -= 8) {
+    out->push_back(static_cast<char>((value >> shift) & 0xFF));
+  }
+}
+
+// Reads the four big-endian bytes at `offset`. The caller must have checked
+// the bounds.
+inline std::uint32_t ReadU32BE(std::string_view text, std::size_t offset) {
+  return (static_cast<std::uint32_t>(static_cast<std::uint8_t>(text[offset])) <<
+          24) |
+         (static_cast<std::uint32_t>(static_cast<std::uint8_t>(text[offset + 1]))
+          << 16) |
+         (static_cast<std::uint32_t>(static_cast<std::uint8_t>(text[offset + 2]))
+          << 8) |
+         static_cast<std::uint32_t>(static_cast<std::uint8_t>(text[offset + 3]));
+}
+
+// Reads the eight big-endian bytes at `offset`.
+inline std::uint64_t ReadU64BE(std::string_view text, std::size_t offset) {
+  std::uint64_t value = 0;
+  for (std::size_t i = 0; i < 8; ++i) {
+    value = (value << 8) |
+            static_cast<std::uint64_t>(static_cast<std::uint8_t>(text[offset + i]));
+  }
+  return value;
+}
+
+// Appends the lowercase hex of `bytes` to `out`.
+//
+// The bytes are taken as a string_view so the caller never has to build a
+// pointer + length pair, and so the compiler can see the bounds. Lowercase
+// is what the contract pins for the Hello nonce and the machine code.
+inline void AppendHex(std::string* out, std::string_view bytes) {
+  static constexpr std::string_view kDigits = "0123456789abcdef";
+  for (const char byte : bytes) {
+    const auto value = static_cast<std::uint8_t>(byte);
+    out->push_back(kDigits[value >> 4]);
+    out->push_back(kDigits[value & 0x0F]);
+  }
+}
+
+}  // namespace wire
+
+// ---------------------------------------------------------------------------
+// Frames (contract section 2)
+// ---------------------------------------------------------------------------
+
+// Frame types (contract section 3). The values are the wire values.
+enum class FrameType : std::uint8_t {
+  kHello = 0x01,
+  kKeyEnvelope = 0x02,
+  kConfigBundle = 0x03,
+  kActionRequest = 0x04,
+  kActionResult = 0x05,
+  kEvent = 0x81,
+  kEventAck = 0x82,
+};
+
+// The 8-byte frame header: a big-endian payload length, a type byte and
+// three reserved bytes that must be zero.
+inline constexpr std::size_t kKernelPipeHeaderBytes = 8;
+
+// The payload length ceiling. A frame that declares more is rejected; the
+// decoder never waits for the extra bytes and never truncates.
+inline constexpr std::size_t kKernelPipeMaxPayloadBytes = 8 * 1024 * 1024;
+
+// Protocol version carried by the Hello frame.
+inline constexpr std::uint32_t kKernelPipeProtocolVersion = 1;
+
+// True when `raw` is a frame type this build knows. Unknown types are
+// rejected by the decoder.
+bool IsKnownFrameType(std::uint8_t raw);
+
+// A decoded frame. `header` holds the 8 raw header bytes because the
+// KeyEnvelope's AAD is built from the frame header (contract section 3.1).
+struct Frame {
+  FrameType type = FrameType::kHello;
+  std::string header;
+  std::string payload;
+};
+
+// Encodes one frame. The payload must not exceed kKernelPipeMaxPayloadBytes.
+// Returns false and leaves `*out` untouched on failure.
+bool EncodeFrame(FrameType type,
+                 std::string_view payload,
+                 std::string* out);
+
+// Decodes the 8-byte header. Returns false when the declared length exceeds
+// the ceiling, the reserved bytes are not zero, or the type is unknown.
+bool DecodeFrameHeader(std::string_view header,
+                       std::uint32_t* payload_len,
+                       FrameType* type);
+
+// Decodes a complete frame (header plus payload). Returns false on any
+// violation; `*out` is left untouched so no partial plaintext escapes.
+bool DecodeFrame(std::string_view frame, Frame* out);
+
+}  // namespace lengsuo::fp
+
+#endif  // LENGSUO_NATIVE_KERNEL_PIPE_FRAME_H_

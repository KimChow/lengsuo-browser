+// Reads exactly `count` bytes off a blocking socket.
+//
+// The loop is here because a pipe is a stream: a read can return fewer bytes
+// than asked for even when the peer has more to give. The buffer is a span,
+// so the compiler can see the bounds of every read.
+bool ReadExactBytes(int fd, size_t count, std::string* out) {
+  out->clear();
+  out->resize(count);
+  base::span<char> buffer(*out);
+  while (!buffer.empty()) {
+#if BUILDFLAG(IS_WIN)
+    DWORD got = 0;
+    if (!::ReadFile(reinterpret_cast<HANDLE>(fd), buffer.data(),
+                    static_cast<DWORD>(buffer.size()), &got, nullptr)) {
+      return false;
+    }
+    if (got == 0) {
+      return false;
+    }
+    buffer = buffer.subspan(static_cast<size_t>(got));
+#else
+    const ssize_t got = read(fd, buffer.data(), buffer.size());
+    if (got < 0) {
+      if (errno == EINTR) {
+        continue;
+      }
+      return false;
+    }
+    if (got == 0) {
+      return false;
+    }
+    buffer = buffer.subspan(static_cast<size_t>(got));
+#endif
+  }
+  return true;
+}
+
+// Reads a whole frame off a blocking socket.
+bool ReadFrameBytes(int fd, std::string* out) {
+  std::string header;
+  if (!ReadExactBytes(fd, fp::kKernelPipeHeaderBytes, &header)) {
+    return false;
+  }
+  uint32_t payload_len = 0;
+  fp::FrameType type = fp::FrameType::kHello;
+  if (!fp::DecodeFrameHeader(header, &payload_len, &type)) {
+    return false;
+  }
+  std::string payload;
+  if (!ReadExactBytes(fd, payload_len, &payload)) {
+    return false;
+  }
+  out->assign(std::move(header));
+  out->append(payload);
+  return true;
+}
+
+// Writes every byte of `data` to the pipe.
+bool WriteAllBytes(int fd, std::string_view data) {
+  base::span<const char> buffer(data);
+  while (!buffer.empty()) {
+#if BUILDFLAG(IS_WIN)
+    DWORD put = 0;
+    if (!::WriteFile(reinterpret_cast<HANDLE>(fd), buffer.data(),
+                     static_cast<DWORD>(buffer.size()), &put, nullptr)) {
+      return false;
+    }
+    if (put == 0) {
+      return false;
+    }
+    buffer = buffer.subspan(static_cast<size_t>(put));
+#else
+    const ssize_t put = write(fd, buffer.data(), buffer.size());
+    if (put < 0) {
+      if (errno == EINTR) {
+        continue;
+      }
+      return false;
+    }
+    if (put == 0) {
+      return false;
+    }
+    buffer = buffer.subspan(static_cast<size_t>(put));
+#endif
+  }
+  return true;
+}
+
+
+}  // namespace
+
+// static
+base::ScopedFD KernelPipeClient::OpenEndpoint(std::string_view pipe_name) {
+  const std::string endpoint = std::string(kKernelPipeEndpointPrefix) +
+                               std::string(pipe_name);
+#if BUILDFLAG(IS_WIN)
+  // \\.\pipe\lengsuo-kernel-<name>
+  const std::wstring path = L"\\\\.\\pipe\\" +
+                            base::UTF8ToWide(endpoint);
+  HANDLE handle = ::CreateFileW(path.c_str(), GENERIC_READ | GENERIC_WRITE,
+                                0 /* no sharing: the pipe is ours */, nullptr,
+                                OPEN_EXISTING, 0, nullptr);
+  if (handle == INVALID_HANDLE_VALUE) {
+    return base::ScopedFD();
+  }
+  return base::ScopedFD(reinterpret_cast<int>(handle));
+#else
+  // An abstract-namespace unix socket: "\0lengsuo-kernel-<name>".
+  const int fd = socket(AF_UNIX, SOCK_STREAM, 0);
+  if (fd < 0) {
+    return base::ScopedFD();
+  }
+  struct sockaddr_un addr;
+  memset(&addr, 0, sizeof(addr));
+  addr.sun_family = AF_UNIX;
+  // The abstract namespace is entered by a leading NUL. The path is not in
+  // the filesystem, so nothing is left behind when the socket closes.
+  base::span<char> path(addr.sun_path);
+  if (endpoint.size() + 1 > path.size()) {
+    close(fd);
+    return base::ScopedFD();
+  }
+  path[0] = '\0';
+  std::copy(endpoint.begin(), endpoint.end(), path.begin() + 1);
+  socklen_t len = static_cast<socklen_t>(
+      offsetof(struct sockaddr_un, sun_path) + 1 + endpoint.size());
+  if (connect(fd, reinterpret_cast<struct sockaddr*>(&addr), len) != 0) {
+    close(fd);
+    return base::ScopedFD();
+  }
+  return base::ScopedFD(fd);
+#endif
+}
+
+KernelPipeClient::KernelPipeClient() = default;
+
+KernelPipeClient::~KernelPipeClient() {
+  {
+    base::AutoLock guard(queue_lock_);
+    stop_ = true;
+  }
+  queue_cv_.Signal();
+  if (sender_) {
+    sender_->Join();
+  }
+}
+
+// The sender thread: a plain OS thread that drains the queue and writes the
+// frames. It holds a pointer to the client, which outlives it because the
+// client's destructor joins the thread before the client is destroyed.
+KernelPipeClient::SenderThread::SenderThread(base::raw_ptr<KernelPipeClient> client)
+    : base::SimpleThread("lengsuo-kernel-pipe"), client_(client) {}
+
+KernelPipeClient::SenderThread::~SenderThread() = default;
+
+void KernelPipeClient::SenderThread::Run() {
+  client_->RunSender();
+}
+
+namespace {
+
+// The process's pipe client. A raw pointer, not a unique_ptr: the client
+// outlives every static destructor that might still want to queue an event,
+// and the browser exits the process anyway.
+KernelPipeClient* g_client = nullptr;
+
+}  // namespace
+
+// static
+KernelPipeClient* KernelPipeClient::Get() {
+  return g_client;
+}
+
+// static
+std::string KernelPipeClient::PipeNameFromCommandLine(
+    const base::CommandLine& command_line) {
+  return command_line.GetSwitchValueASCII(kKernelPipeSwitch);
+}
+
+// static
+bool KernelPipeClient::Initialize(std::string_view pipe_name,
+                                  const fp::MachineFacts& machine_facts,
+                                  int64_t now_unix) {
+  if (g_client != nullptr) {
+    // Already set up. Initializing twice would open a second pipe and start
+    // a second sender thread.
+    return true;
+  }
+  if (pipe_name.empty()) {
+    // Not requested. The browser runs with its normal configuration; this is
+    // not a failure.
+    return true;
+  }
+
+  std::unique_ptr<KernelPipeClient> client(new KernelPipeClient());
+  client->fd_ = OpenEndpoint(pipe_name);
+  if (!client->fd_.is_valid()) {
+    LOG(ERROR) << "Lengsuo kernel pipe: cannot open the endpoint";
+    return false;
+  }
+
+  // The Hello nonce is 8 random bytes. It goes into the AAD of the
+  // envelope, which is what stops an envelope from being replayed into
+  // another handshake.
+  const std::string hello_nonce = base::RandBytesAsString(
+      fp::kKernelPipeHelloNonceBytes);
+  std::string hello_frame;
+  if (!client->handshake_.SendHello(hello_nonce, &hello_frame)) {
+    LOG(ERROR) << "Lengsuo kernel pipe: cannot build the Hello frame";
+    return false;
+  }
+  if (!WriteAllBytes(client->fd_.get(), hello_frame)) {
+    LOG(ERROR) << "Lengsuo kernel pipe: cannot send the Hello frame";
+    return false;
+  }
+
+  // The runner answers with the KeyEnvelope. Anything else is a broken
+  // protocol, and a broken protocol is a startup failure.
+  fp::Frame frame;
+  if (!client->ReadFrame(&frame)) {
+    LOG(ERROR) << "Lengsuo kernel pipe: cannot read the KeyEnvelope";
+    return false;
+  }
+  if (frame.type != fp::FrameType::kKeyEnvelope) {
+    LOG(ERROR) << "Lengsuo kernel pipe: expected a KeyEnvelope";
+    return false;
+  }
+
+  // k_machine = SHA-256(machine_code). The machine code is this machine's
+  // own facts, hashed; it is never a constant and never leaves the process
+  // in clear.
+  const std::string machine_code = fp::DeriveMachineCode(machine_facts);
+  std::string machine_key;
+  if (!fp::DeriveMachineKey(machine_code, &machine_key)) {
+    LOG(ERROR) << "Lengsuo kernel pipe: cannot derive the machine key";
+    return false;
+  }
+
+  // The AAD is the envelope frame's own header followed by the Hello nonce.
+  std::string error;
+  if (!client->handshake_.AcceptKeyEnvelope(frame, machine_key, now_unix,
+                                            &error)) {
+    // The error text carries no payload bytes and no key. It is logged
+    // because a startup failure with no reason is a support problem.
+    LOG(ERROR) << "Lengsuo kernel pipe: handshake rejected: " << error;
+    return false;
+  }
+
+  // The config bundle arrives next and is frozen once.
+  fp::Frame config_frame;
+  if (!client->ReadFrame(&config_frame)) {
+    LOG(ERROR) << "Lengsuo kernel pipe: cannot read the ConfigBundle";
+    return false;
+  }
+  if (config_frame.type != fp::FrameType::kConfigBundle) {
+    LOG(ERROR) << "Lengsuo kernel pipe: expected a ConfigBundle";
+    return false;
+  }
+  if (!client->config_.Freeze(config_frame.payload, &error)) {
+    LOG(ERROR) << "Lengsuo kernel pipe: the ConfigBundle is malformed";
+    return false;
+  }
+
+  // Only now does the sender thread start. There is never a thread writing
+  // to a pipe whose session key is missing.
+  client->sender_ = std::make_unique<KernelPipeClient::SenderThread>(client.get());
+  client->sender_->Start();
+
+  g_client = client.release();
+  return true;
+}
+
+bool KernelPipeClient::ReadFrame(fp::Frame* out) {
+  std::string bytes;
+  if (!ReadFrameBytes(fd_.get(), &bytes)) {
+    return false;
+  }
+  if (!fp::DecodeFrame(bytes, out)) {
+    stats_.decode_failures.fetch_add(1);
+    return false;
+  }
+  return true;
+}
+
+bool KernelPipeClient::EnqueueEvent(std::string_view action,
+                                    std::string_view payload) {
+  // The payload is checked against the action's schema before it is queued.
+  // A payload that does not fit is dropped and counted, never sent.
+  const fp::ActionCollectorPolicy policy;
+  std::string named;
+  const fp::ActionValidation validation = fp::ValidateActionPayload(
+      fp::ActionTable::Get(), action, payload, policy, &named);
+  if (!validation.ok) {
+    stats_.rejected_events.fetch_add(1);
+    return false;
+  }
+  {
+    base::AutoLock guard(queue_lock_);
+    if (stop_ || queue_.size() >= kMaxQueuedEvents) {
+      stats_.send_failures.fetch_add(1);
+      return false;
+    }
+    queue_.emplace_back(named, std::string(payload));
+  }
+  queue_cv_.Signal();
+  return true;
+}
+
+void KernelPipeClient::RunSender() {
+  while (true) {
+    std::vector<std::pair<std::string, std::string>> batch;
+    {
+      base::AutoLock guard(queue_lock_);
+      // base's ConditionVariable takes the lock it is used with, so the
+      // guard is held across the wait and released inside it.
+      while (!stop_ && queue_.empty()) {
+        queue_cv_.Wait();
+      }
+      if (stop_ && queue_.empty()) {
+        return;
+      }
+      batch.swap(queue_);
+    }
+    for (const auto& event : batch) {
+      std::string frame;
+      if (!fp::EncodeFrame(fp::FrameType::kEvent, event.second, &frame)) {
+        stats_.send_failures.fetch_add(1);
+        continue;
+      }
+      if (!WriteAllBytes(fd_.get(), frame)) {
+        // The pipe is gone. The events are lost and counted; the browser
+        // carries on. The uplink is lossy by design.
+        stats_.send_failures.fetch_add(1);
+        return;
+      }
+    }
+  }
+}
+
+}  // namespace lengsuo
diff --git a/lengsuo/integration/kernel_pipe_client.h b/lengsuo/integration/kernel_pipe_client.h
new file mode 100644
index 0000000..b169f3d
--- /dev/null
+++ b/lengsuo/integration/kernel_pipe_client.h
@@ -0,0 +1,216 @@
+// kernel_pipe_client - the browser side of the runner <-> kernel pipe
+// (task Q).
+//
+// The pure half of the pipe lives in lengsuo/native/kernel_pipe.{h,cc}: the
+// frame codec, the fail-closed handshake and the frozen config bundle. This
+// file is the half that needs the operating system: it opens the endpoint,
+// runs the handshake, and owns the uplink queue and its sender thread.
+//
+// Why the split: the pure half must compile standalone (plain g++, no
+// Chromium headers) so the gtest target can check the bytes. The half here
+// cannot: it needs sockets, threads and platform facts.
+//
+// Two rules shape everything below.
+//
+//   * Fail closed. A pipe that does not open, a Hello the runner rejects, an
+//     envelope that does not authenticate - each of them is a startup failure,
+//     never a silent "no configuration". A browser that keeps running with
+//     the wrong fingerprint is worse than a browser that refuses to start.
+//
+//   * The uplink never blocks the browser. Events go into a queue; a
+//     dedicated thread drains the queue and writes. If the pipe is dead the
+//     events are dropped and counted. Nothing on the browser's own threads
+//     ever waits for the runner.
+#ifndef LENGSUO_INTEGRATION_KERNEL_PIPE_CLIENT_H_
+#define LENGSUO_INTEGRATION_KERNEL_PIPE_CLIENT_H_
+
+#include <atomic>
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/command_line.h"
+#include "base/files/scoped_file.h"
+#include "base/memory/raw_ptr.h"
+#include "base/synchronization/condition_variable.h"
+#include "base/synchronization/lock.h"
+#include "base/threading/simple_thread.h"
+#include "lengsuo/native/kernel_pipe.h"
+
+namespace lengsuo {
+
+// The command-line switch that carries the pipe name. The name only - never
+// a key, never a configuration payload (wire contract section 1).
+inline constexpr char kKernelPipeSwitch[] = "lengsuo-kernel-pipe";
+
+// The prefix the runner and the kernel agree on for the OS endpoint.
+//
+// Pinned by docs/kernel-wire-contract.md section 1:
+//
+//   Windows: \\.\pipe\lengsuo-kernel-<name>
+//   POSIX:   an abstract-namespace unix socket, "\0lengsuo-kernel-<name>"
+//
+// The abstract namespace is used on POSIX because it leaves no socket file
+// behind: nothing to clean up, and no directory permission to get wrong.
+// A filesystem path is explicitly forbidden by the contract - the two sides
+// would disagree about it whenever their working directories differ.
+inline constexpr char kKernelPipeEndpointPrefix[] = "lengsuo-kernel-";
+
+// Collects this machine's four facts: {os, cpuid, hddid, computername}.
+//
+// The wire contract fixes the shape and the key order, not the values: the
+// values have to be this machine's real ones (wire contract section 1).
+// The machine code is the hash of these four, so a wrong value means the
+// runner's envelope does not open, which means the handshake fails.
+//
+//   os            the operating system's name and version
+//   cpuid         the processor's vendor, family, model and stepping
+//   hddid         a stable identifier of the boot volume
+//   computername  the machine's name
+//
+// The facts are hashed and never leave the process in clear. They are not
+// fingerprint values in the sense of docs/fp-switch-contract.md, so they do
+// not go through the switch contract; they are a machine binding for the
+// session key.
+fp::MachineFacts CollectMachineFacts();
+
+// The statistics the pipe keeps. Failures are counted, never logged with
+// their payload, and never turned into an error the browser has to care
+// about (wire contract section 4).
+struct KernelPipeStats {
+  // Events that were queued but could not be written to the pipe.
+  std::atomic<uint64_t> send_failures{0};
+  // Events dropped before they reached the pipe, because their payload did
+  // not satisfy the action's schema.
+  std::atomic<uint64_t> rejected_events{0};
+  // Frames received that did not decode.
+  std::atomic<uint64_t> decode_failures{0};
+};
+
+// The browser's half of the pipe.
+//
+// Lifecycle: Initialize() opens the endpoint and runs the handshake on the
+// calling thread (the browser's main thread, during early startup). The
+// uplink sender thread starts only after the handshake has succeeded, so
+// there is never a thread writing to a pipe whose session key is missing.
+//
+// The pipe is one per browser process, so the client is a process-level
+// singleton: `GetKernelPipeClient()` returns it, and `Initialize()` sets it
+// up. The singleton lives here rather than in chrome_browser_main.h because
+// that header is upstream code this task does not own.
+class KernelPipeClient {
+ public:
+  // Opens the pipe named by `pipe_name` and runs the handshake, then makes
+  // the client the process's pipe.
+  //
+  // `machine_facts` are this machine's real values: they are the input to
+  // the machine code, which is the key the session envelope is sealed with.
+  // A wrong machine code means the envelope does not open, which means the
+  // handshake fails, which means startup fails. There is no fallback.
+  //
+  // `now_unix` is the current Unix time in seconds; the envelope carries an
+  // expiry and an expired one is refused.
+  //
+  // Returns true when the pipe is ready, or when it was not requested at
+  // all (no switch on the command line - that is not a failure). Returns
+  // false when the pipe was requested but the handshake failed.
+  static bool Initialize(std::string_view pipe_name,
+                         const fp::MachineFacts& machine_facts,
+                         int64_t now_unix);
+
+  // The process's pipe client, or nullptr when the pipe was not requested.
+  //
+  // The pointer is not const: the uplink is the only way out of the browser
+  // and it is the caller's job to use it. The client itself is a process
+  // singleton, so there is one of it and everybody gets the same one.
+  static KernelPipeClient* Get();
+
+  // Reads the pipe name off a command line. Returns an empty string when
+  // the switch is absent.
+  static std::string PipeNameFromCommandLine(const base::CommandLine& command_line);
+
+  ~KernelPipeClient();
+
+  KernelPipeClient(const KernelPipeClient&) = delete;
+  KernelPipeClient& operator=(const KernelPipeClient&) = delete;
+
+  // The frozen configuration bundle. Empty when the pipe was not requested.
+  //
+  // The bundle is frozen once (the L3 "one-shot" rule) and never re-read.
+  const std::string& config() const { return config_.json(); }
+  bool config_frozen() const { return config_.frozen(); }
+
+  // Queues one uplink event. The payload must already satisfy the action's
+  // schema - see lengsuo/native/action_table.h.
+  //
+  // Returns false when the payload was rejected (and counted) or the queue
+  // is full (and counted). It never blocks and never fails the caller.
+  bool EnqueueEvent(std::string_view action, std::string_view payload);
+
+  // The counters.
+  const KernelPipeStats& stats() const { return stats_; }
+
+  // The container id the runner named in the envelope. Empty when the pipe
+  // was not requested.
+  const std::string& container_id() const { return handshake_.container_id(); }
+
+ private:
+  KernelPipeClient();
+
+  // Opens the endpoint. Returns an invalid handle on failure.
+  static base::ScopedFD OpenEndpoint(std::string_view pipe_name);
+
+  // Reads one frame off the pipe. Returns false when the frame does not
+  // decode (and counts the failure).
+  bool ReadFrame(fp::Frame* out);
+
+  // The sender thread's body: drains the queue and writes the frames.
+  void RunSender();
+
+  fp::KernelPipeHandshake handshake_;
+  fp::KernelPipeConfig config_;
+
+  // The connection. Closed on destruction; the sender thread holds a
+  // reference to the object, so the object outlives the thread.
+  base::ScopedFD fd_;
+
+  // The uplink queue. Bounded on purpose: an unbounded queue turns a dead
+  // runner into a memory leak in the browser.
+  static constexpr size_t kMaxQueuedEvents = 1024;
+  std::vector<std::pair<std::string, std::string>> queue_;
+  base::Lock queue_lock_;
+  // The condition variable is bound to the queue's lock: base's
+  // ConditionVariable takes the lock it is used with.
+  base::ConditionVariable queue_cv_{&queue_lock_};
+
+  // Set when the sender thread should stop.
+  bool stop_ = false;
+
+  KernelPipeStats stats_;
+
+  // The sender thread. Started only after the handshake succeeded.
+  //
+  // It is a plain OS thread with no message loop: it does blocking writes
+  // and nothing else, and a message loop would only give it tasks to run
+  // that it does not want.
+  //
+  // The thread type is defined here, not in the .cc, because the
+  // unique_ptr needs a complete type where it is destroyed.
+  class SenderThread : public base::SimpleThread {
+   public:
+    explicit SenderThread(base::raw_ptr<KernelPipeClient> client);
+    ~SenderThread() override;
+
+    void Run() override;
+
+   private:
+    base::raw_ptr<KernelPipeClient> client_;
+  };
+  std::unique_ptr<SenderThread> sender_;
+};
+
+}  // namespace lengsuo
+
+#endif  // LENGSUO_INTEGRATION_KERNEL_PIPE_CLIENT_H_
diff --git a/lengsuo/integration/l3_bootstrap.cc b/lengsuo/integration/l3_bootstrap.cc
new file mode 100644
index 0000000..57cfdf9
--- /dev/null
+++ b/lengsuo/integration/l3_bootstrap.cc
@@ -0,0 +1,56 @@
+#include "lengsuo/integration/l3_bootstrap.h"
+
+#include <string_view>
+
+namespace lengsuo {
+namespace {
+
+bool ExceedsLimit(const std::string& wire) {
+  return wire.empty() || wire.size() > fp::kMaxL3WireBytes;
+}
+
+}  // namespace
+
+L3BootstrapState::L3BootstrapState() = default;
+L3BootstrapState::~L3BootstrapState() = default;
+
+bool L3BootstrapState::Initialize(bool requested,
+                                 bool safe_local_path,
+                                 const Reader& read,
+                                 int64_t now_unix,
+                                 int64_t max_age_seconds) {
+  // Single-shot: a second call never re-reads, so a swapped file on disk
+  // cannot change the snapshot after the browser has started.
+  if (attempted_) {
+    return false;
+  }
+  attempted_ = true;
+  if (!requested) {
+    return true;
+  }
+  // An unusable path or clock window is a configuration error, not "absent".
+  if (!safe_local_path || now_unix <= 0 || max_age_seconds <= 0) {
+    load_failed_ = true;
+    return false;
+  }
+  const std::optional<std::string> wire = read();
+  if (!wire || ExceedsLimit(*wire)) {
+    load_failed_ = true;
+    return false;
+  }
+
+  fp::L3Config decoded;
+  const bool ok = fp::DecodeL3Wire(std::string_view(*wire), now_unix,
+                                   max_age_seconds, &decoded, nullptr);
+  // The local copy of the wire is dropped here: the decoded snapshot is what
+  // lives on, so the path and raw bytes (which carry pinned secrets) do not
+  // stay resident.
+  if (!ok) {
+    load_failed_ = true;
+    return false;
+  }
+  config_ = std::move(decoded);
+  return true;
+}
+
+}  // namespace lengsuo
diff --git a/lengsuo/integration/l3_bootstrap.h b/lengsuo/integration/l3_bootstrap.h
new file mode 100644
index 0000000..c2f0b62
--- /dev/null
+++ b/lengsuo/integration/l3_bootstrap.h
@@ -0,0 +1,71 @@
+// l3_bootstrap - browser-side L3 configuration load, frozen at startup.
+//
+// The browser reads one managed L3W1 document before any renderer exists and
+// keeps it immutable afterwards. Three outcomes are deliberately distinct:
+//
+//   * not requested        -> Initialize returns true, config() is nullptr.
+//     No L3 statement, upstream behavior is untouched.
+//   * requested but broken -> Initialize returns false. The caller must abort
+//     startup: a half-valid snapshot is never downgraded to "no L3", because
+//     that would silently unpin values the platform already observed.
+//   * requested and valid  -> Initialize returns true, config() is non-null.
+//
+// Clock injection: the signature carries a unix timestamp and VerifySign
+// needs "now", so `now_unix` is an explicit argument rather than a call to
+// base::Time inside the decoder. Tests therefore never depend on wall time.
+//
+// Size limit: the profile wire caps at 4096 bytes, but an L3 document holds
+// pin/cookie/rule tables and is legitimately larger, so this reader accepts up
+// to fp::kMaxL3WireBytes (64 KiB) and nothing beyond it.
+#ifndef LENGSUO_INTEGRATION_L3_BOOTSTRAP_H_
+#define LENGSUO_INTEGRATION_L3_BOOTSTRAP_H_
+
+#include <cstdint>
+#include <functional>
+#include <optional>
+#include <string>
+
+#include "lengsuo/native/l3_wire.h"
+
+namespace lengsuo {
+
+// The command-line switch naming the managed L3 document lives in
+// browser_bootstrap.h (kL3WireSwitch) so that there is exactly one definition
+// of the switch name; a second one would be a redefinition error in any
+// translation unit that includes both headers.
+
+// Default anti-rollback window for the document signature.
+inline constexpr int64_t kL3MaxAgeSeconds = 7 * 24 * 60 * 60;
+
+class L3BootstrapState {
+ public:
+  using Reader = std::function<std::optional<std::string>()>;
+
+  L3BootstrapState();
+  ~L3BootstrapState();
+  L3BootstrapState(const L3BootstrapState&) = delete;
+  L3BootstrapState& operator=(const L3BootstrapState&) = delete;
+
+  // Single-shot. `requested` false succeeds without loading. A load or
+  // verification failure returns false and leaves config() untouched.
+  bool Initialize(bool requested,
+                  bool safe_local_path,
+                  const Reader& read,
+                  int64_t now_unix,
+                  int64_t max_age_seconds);
+
+  const fp::L3Config* config() const { return config_ ? &*config_ : nullptr; }
+
+  // True when a document was requested but failed to load; callers use this to
+  // distinguish "absent" from "broken" when reporting startup failure.
+  bool load_failed() const { return load_failed_; }
+
+ private:
+  bool attempted_ = false;
+  bool load_failed_ = false;
+  std::optional<fp::L3Config> config_;
+};
+
+}  // namespace lengsuo
+
+#endif  // LENGSUO_INTEGRATION_L3_BOOTSTRAP_H_

+// kernel_pipe_test_util - the shared helpers and fixed vectors of the pipe
+// tests (task Q).
+//
+// The fixed test vectors below are copied byte for byte out of
+// docs/kernel-wire-contract.md (sections 2 and 3.1). They are the cross-repo
+// agreement: the client repo (task P) hardcodes the same bytes, and the two
+// implementations are compared by diffing their hex output.
+//
+// They are hardcoded constants on purpose. A test that called a script to
+// produce the expected values would agree with a broken implementation, and
+// "both sides are wrong" would look like "both sides match".
+//
+// This is a header rather than a .cc because each test file links on its own:
+// the frame tests must not have to link the crypto.
+#ifndef LENGSUO_NATIVE_KERNEL_PIPE_TEST_UTIL_H_
+#define LENGSUO_NATIVE_KERNEL_PIPE_TEST_UTIL_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+
+#include "gtest/gtest.h"
+
+namespace lengsuo::fp::test {
+
+// --- the contract's fixed vectors ---------------------------------------
+//
+// Frame headers for the legal frames (contract section 2). The payload of
+// every legal frame is the fill byte 0x5A repeated to the declared length.
+
+inline constexpr std::uint8_t kFill = 0x5A;
+
+inline constexpr char kLegalHeaderV0[] = "00 00 00 00 03 00 00 00";
+inline constexpr char kLegalHeaderV1[] = "00 00 00 01 03 00 00 00";
+inline constexpr char kLegalHeaderV3[] = "00 00 00 03 03 00 00 00";
+inline constexpr char kLegalHeaderV255[] = "00 00 00 ff 03 00 00 00";
+inline constexpr char kLegalHeaderV65535[] = "00 00 ff ff 03 00 00 00";
+inline constexpr char kLegalHeaderVMax[] = "00 80 00 00 03 00 00 00";
+
+inline constexpr char kIllegalLenOver[] = "00 80 00 01 03 00 00 00";
+inline constexpr char kIllegalReserved[] = "00 00 00 01 03 00 00 01 5a";
+inline constexpr char kIllegalType[] = "00 00 00 01 07 00 00 00 5a";
+inline constexpr char kIllegalTruncHeader[] = "00 00 00 01 03 00 00";
+inline constexpr char kIllegalTruncPayload[] = "00 00 00 03 03 00 00 00 5a";
+
+// Key derivation (contract section 2).
+inline constexpr char kMachineCode[] =
+    "216feaf8875b0e55d32682bef617480d57c842fc3db57018f0715e17cc199033";
+inline constexpr char kMachineKeyHex[] =
+    "64fa1b15ef6856fb97cfb29aa397500a3003e8c40568c684cb55fa96438c0d7f";
+inline constexpr char kSessionKeyHex[] =
+    "b102b38300fa770def96bbd421f83c9858c86401d5905c4e6e4fb97900627ff1";
+
+// The KeyEnvelope vector (contract section 3.1).
+inline constexpr char kEnvelopeGcmNonce[] = "00 01 02 03 04 05 06 07 08 09 0a 0b";
+inline constexpr char kEnvelopeHelloNonce[] = "01 02 03 04 05 06 07 08";
+inline constexpr char kEnvelopeContainerId[] = "ct-01";
+inline constexpr std::uint64_t kEnvelopeExpires = 1700000000;
+inline constexpr char kEnvelopeCiphertext[] =
+    "88 3b 15 2f 81 0f c5 d4 "
+    "87 0a 13 99 e7 c2 6b 42 "
+    "5e 51 20 47 49 37 0b 39 "
+    "ee 25 cb 05 d5 f8 59 86 "
+    "a4 91 70 c6 c9 b1 bb 32 "
+    "72 a4 67 7e dc ";
+inline constexpr char kEnvelopeTag[] =
+    "c5 2e 71 8c be 62 81 f0 "
+    "b8 bb b4 0c 15 37 57 ad ";
+
+// The envelope payload, exactly as the contract's fixed vector describes it:
+//   nonce_len(4) | nonce(12) | ciphertext_len(4) | ciphertext(45) |
+//   tag_len(4) | tag(16)
+// The container id and the expiry are inside the ciphertext's plaintext, not
+// in the clear region: the payload length is 40 + the ciphertext length,
+// which is the 85 bytes the contract's AAD length field (0x00000055) names.
+//
+// The contract document's printed payload block used to splice the 8-byte
+// expires_unix into the clear region as well, which made the payload 93
+// bytes and the AAD's length field wrong. The document was corrected on
+// 2026-10-21 (commit "消除第四处矛盾") and now states the six-field layout
+// throughout; tests/test_key_envelope_layout.py keeps the field table, the
+// byte listing and the AAD length in agreement, so the constant below can
+// not silently drift away from the contract again.
+inline constexpr char kEnvelopePayload[] =
+    "00 00 00 0c 00 01 02 03 "
+    "04 05 06 07 08 09 0a 0b "
+    "00 00 00 2d 88 3b 15 2f "
+    "81 0f c5 d4 87 0a 13 99 "
+    "e7 c2 6b 42 5e 51 20 47 "
+    "49 37 0b 39 ee 25 cb 05 "
+    "d5 f8 59 86 a4 91 70 c6 "
+    "c9 b1 bb 32 72 a4 67 7e "
+    "dc 00 00 00 10 c5 2e 71 "
+    "8c be 62 81 f0 b8 bb b4 "
+    "0c 15 37 57 ad ";
+
+// The envelope frame's header, whose length field (0x00000055 = 85) is part
+// of the AAD.
+inline constexpr char kEnvelopeFrameHeader[] = "00 00 00 55 02 00 00 00";
+
+// Parses a spaced hex string into bytes. Throws on a malformed literal, so
+// a typo in a constant fails the test loudly instead of silently comparing
+// nothing.
+inline std::string HexToBytes(const char* text) {
+  std::string out;
+  std::uint8_t high = 0;
+  bool have_high = false;
+  for (const char* p = text; *p != '\0'; ++p) {
+    if (*p == ' ') {
+      continue;
+    }
+    std::uint8_t digit = 0;
+    if (*p >= '0' && *p <= '9') {
+      digit = static_cast<std::uint8_t>(*p - '0');
+    } else if (*p >= 'a' && *p <= 'f') {
+      digit = static_cast<std::uint8_t>(*p - 'a' + 10);
+    } else if (*p >= 'A' && *p <= 'F') {
+      digit = static_cast<std::uint8_t>(*p - 'A' + 10);
+    } else {
+      ADD_FAILURE() << "bad hex literal: " << text;
+      return out;
+    }
+    if (!have_high) {
+      high = digit;
+      have_high = true;
+    } else {
+      out.push_back(static_cast<char>((high << 4) | digit));
+      have_high = false;
+    }
+  }
+  if (have_high) {
+    ADD_FAILURE() << "odd number of hex digits: " << text;
+  }
+  return out;
+}
+
+inline std::string BytesToHex(const std::string& bytes) {
+  static constexpr char kDigits[] = "0123456789abcdef";
+  std::string out;
+  out.reserve(bytes.size() * 2);
+  for (const char c : bytes) {
+    const auto byte = static_cast<std::uint8_t>(c);
+    out.push_back(kDigits[byte >> 4]);
+    out.push_back(kDigits[byte & 0x0F]);
+  }
+  return out;
+}
+
+inline std::string Fill(std::size_t count) {
+  return std::string(count, static_cast<char>(kFill));
+}
+
+}  // namespace lengsuo::fp::test
+
+#endif  // LENGSUO_NATIVE_KERNEL_PIPE_TEST_UTIL_H_
diff --git a/lengsuo/native/l3_envelope.cc b/lengsuo/native/l3_envelope.cc
new file mode 100644
index 0000000..07a539b
--- /dev/null
+++ b/lengsuo/native/l3_envelope.cc
@@ -0,0 +1,290 @@
+#include "l3_envelope.h"
+
+#include <openssl/aead.h>
+#include <openssl/evp.h>
+#include <openssl/mem.h>
+#include <openssl/rand.h>
+
+#include <cstring>
+#include <utility>
+
+namespace lengsuo::fp {
+namespace {
+
+constexpr char kMagic[4] = {'L', '3', 'E', '1'};
+constexpr std::uint8_t kFormatVersion = 1;
+constexpr std::uint8_t kKdfPbkdf2HmacSha256 = 1;
+constexpr std::uint8_t kCipherAes256Gcm = 1;
+
+// Little-endian 32-bit load/store. The envelope is a byte-exact on-disk
+// format, so the encoding must not depend on the host's endianness.
+void StoreU32(char* out, std::uint32_t value) {
+  out[0] = static_cast<char>(value & 0xff);
+  out[1] = static_cast<char>((value >> 8) & 0xff);
+  out[2] = static_cast<char>((value >> 16) & 0xff);
+  out[3] = static_cast<char>((value >> 24) & 0xff);
+}
+
+std::uint32_t LoadU32(const char* in) {
+  return static_cast<std::uint32_t>(static_cast<unsigned char>(in[0])) |
+         (static_cast<std::uint32_t>(static_cast<unsigned char>(in[1])) << 8) |
+         (static_cast<std::uint32_t>(static_cast<unsigned char>(in[2])) << 16) |
+         (static_cast<std::uint32_t>(static_cast<unsigned char>(in[3])) << 24);
+}
+
+// Derives the 32-byte AEAD key from the master key, the salt and the
+// iteration count.  Returns false when the KDF fails (e.g. an iteration
+// count of 0, which BoringSSL rejects).
+bool DeriveKey(const L3EnvelopeKey& master,
+               const std::uint8_t* salt,
+               std::size_t salt_len,
+               std::uint32_t iterations,
+               std::uint8_t* out) {
+  if (iterations == 0) return false;
+  return PKCS5_PBKDF2_HMAC(master.bytes().data(), master.bytes().size(), salt,
+                            salt_len, iterations, EVP_sha256(),
+                            kL3EnvelopeKeyBytes, out) == 1;
+}
+
+// Wipes a buffer that held key material.
+void Wipe(void* buffer, std::size_t size) {
+  if (buffer != nullptr && size > 0) {
+    OPENSSL_cleanse(buffer, size);
+  }
+}
+
+}  // namespace
+
+L3EnvelopeKey::L3EnvelopeKey(const std::string& bytes) {
+  // A wrong-length key is rejected outright.  Padding a short key up would
+  // silently weaken the KDF, and truncating a long one would ignore bits the
+  // caller believed were protecting the document.
+  if (bytes.size() != kL3EnvelopeKeyBytes) {
+    return;
+  }
+  bytes_ = bytes;
+  valid_ = true;
+}
+
+L3EnvelopeKey::~L3EnvelopeKey() {
+  Wipe(bytes_.data(), bytes_.size());
+}
+
+L3EnvelopeKey::L3EnvelopeKey(L3EnvelopeKey&& other) noexcept
+    : bytes_(std::move(other.bytes_)), valid_(other.valid_) {
+  other.bytes_.clear();
+  other.valid_ = false;
+}
+
+L3EnvelopeKey& L3EnvelopeKey::operator=(L3EnvelopeKey&& other) noexcept {
+  if (this != &other) {
+    Wipe(bytes_.data(), bytes_.size());
+    bytes_ = std::move(other.bytes_);
+    valid_ = other.valid_;
+    other.bytes_.clear();
+    other.valid_ = false;
+  }
+  return *this;
+}
+
+bool SealL3Envelope(std::string_view plaintext,
+                    const L3EnvelopeKey& key,
+                    std::uint32_t iterations,
+                    std::string* out,
+                    std::string* error) {
+  const auto fail = [error](const char* message) {
+    if (error) *error = message;
+    return false;
+  };
+  if (out == nullptr) return fail("l3envelope: null output");
+  if (!key.valid()) return fail("l3envelope: invalid key");
+  if (plaintext.empty()) return fail("l3envelope: empty document");
+  if (plaintext.size() > kMaxL3EnvelopePlaintextBytes) {
+    return fail("l3envelope: oversized document");
+  }
+  if (iterations == 0) iterations = kDefaultL3EnvelopeIterations;
+
+  std::uint8_t salt[kL3EnvelopeSaltBytes] = {};
+  std::uint8_t nonce[kL3EnvelopeNonceBytes] = {};
+  if (RAND_bytes(salt, sizeof(salt)) != 1 ||
+      RAND_bytes(nonce, sizeof(nonce)) != 1) {
+    return fail("l3envelope: no randomness");
+  }
+
+  std::uint8_t derived[kL3EnvelopeKeyBytes] = {};
+  if (!DeriveKey(key, salt, sizeof(salt), iterations, derived)) {
+    Wipe(derived, sizeof(derived));
+    return fail("l3envelope: key derivation failed");
+  }
+
+  EVP_AEAD_CTX* ctx = EVP_AEAD_CTX_new(EVP_aead_aes_256_gcm(), derived,
+                                        sizeof(derived),
+                                        kL3EnvelopeTagBytes);
+  if (ctx == nullptr) {
+    Wipe(derived, sizeof(derived));
+    return fail("l3envelope: aead init failed");
+  }
+
+  // The ciphertext is the plaintext followed by the GCM tag.
+  const std::size_t ciphertext_len = plaintext.size() + kL3EnvelopeTagBytes;
+
+  // The header is additional data: it is authenticated but not encrypted, so
+  // a flipped length or iteration count fails the open instead of changing
+  // how the payload is interpreted.
+  char header[kL3EnvelopeHeaderBytes] = {};
+  std::memcpy(header, kMagic, sizeof(kMagic));
+  header[4] = static_cast<char>(kFormatVersion);
+  header[5] = static_cast<char>(kKdfPbkdf2HmacSha256);
+  header[6] = static_cast<char>(kCipherAes256Gcm);
+  header[7] = 0;
+  StoreU32(header + 8, kL3EnvelopeHeaderBytes);
+  StoreU32(header + 12, iterations);
+  StoreU32(header + 16, static_cast<std::uint32_t>(sizeof(salt)));
+  StoreU32(header + 20, static_cast<std::uint32_t>(sizeof(nonce)));
+  StoreU32(header + 24, static_cast<std::uint32_t>(kL3EnvelopeTagBytes));
+  StoreU32(header + 28, static_cast<std::uint32_t>(ciphertext_len));
+
+  std::string buffer;
+  buffer.reserve(kL3EnvelopeHeaderBytes + sizeof(salt) + sizeof(nonce) +
+                 ciphertext_len);
+  buffer.append(header, sizeof(header));
+  buffer.append(reinterpret_cast<const char*>(salt), sizeof(salt));
+  buffer.append(reinterpret_cast<const char*>(nonce), sizeof(nonce));
+  // The buffer is grown to its final size before sealing, so the AEAD
+  // writes into the string's own storage rather than past its end.
+  buffer.resize(kL3EnvelopeHeaderBytes + sizeof(salt) + sizeof(nonce) +
+                ciphertext_len);
+
+  std::size_t sealed_len = 0;
+  const bool sealed = EVP_AEAD_CTX_seal(
+      ctx, reinterpret_cast<std::uint8_t*>(&buffer[kL3EnvelopeHeaderBytes +
+                                                    sizeof(salt) +
+                                                    sizeof(nonce)]),
+      &sealed_len, ciphertext_len, nonce, sizeof(nonce),
+      reinterpret_cast<const std::uint8_t*>(plaintext.data()),
+      plaintext.size(), reinterpret_cast<const std::uint8_t*>(header),
+      sizeof(header)) == 1;
+  EVP_AEAD_CTX_free(ctx);
+  Wipe(derived, sizeof(derived));
+  if (!sealed || sealed_len != ciphertext_len) {
+    return fail("l3envelope: seal failed");
+  }
+  buffer.resize(kL3EnvelopeHeaderBytes + sizeof(salt) + sizeof(nonce) +
+                sealed_len);
+
+  *out = std::move(buffer);
+  if (error) error->clear();
+  return true;
+}
+
+bool OpenL3Envelope(std::string_view envelope,
+                    const L3EnvelopeKey& key,
+                    std::string* out,
+                    std::string* error) {
+  const auto fail = [error](const char* message) {
+    if (error) *error = message;
+    return false;
+  };
+  if (out == nullptr) return fail("l3envelope: null output");
+  if (!key.valid()) return fail("l3envelope: invalid key");
+  if (envelope.empty()) return fail("l3envelope: empty envelope");
+  if (envelope.size() > kMaxL3EnvelopeBytes) {
+    return fail("l3envelope: oversized envelope");
+  }
+  // The envelope must carry at least a header, a salt, a nonce and a tag.
+  if (envelope.size() < kL3EnvelopeOverheadBytes) {
+    return fail("l3envelope: truncated envelope");
+  }
+  if (envelope.size() < kL3EnvelopeHeaderBytes) {
+    return fail("l3envelope: truncated header");
+  }
+  if (std::memcmp(envelope.data(), kMagic, sizeof(kMagic)) != 0) {
+    return fail("l3envelope: bad magic");
+  }
+  if (static_cast<std::uint8_t>(envelope[4]) != kFormatVersion) {
+    return fail("l3envelope: unsupported version");
+  }
+  if (static_cast<std::uint8_t>(envelope[5]) != kKdfPbkdf2HmacSha256 ||
+      static_cast<std::uint8_t>(envelope[6]) != kCipherAes256Gcm) {
+    return fail("l3envelope: unsupported algorithm");
+  }
+  if (static_cast<std::uint8_t>(envelope[7]) != 0) {
+    return fail("l3envelope: reserved bits set");
+  }
+
+  const std::uint32_t header_len = LoadU32(envelope.data() + 8);
+  const std::uint32_t iterations = LoadU32(envelope.data() + 12);
+  const std::uint32_t salt_len = LoadU32(envelope.data() + 16);
+  const std::uint32_t nonce_len = LoadU32(envelope.data() + 20);
+  const std::uint32_t tag_len = LoadU32(envelope.data() + 24);
+  const std::uint32_t ciphertext_len = LoadU32(envelope.data() + 28);
+
+  // Every length must be exactly what this format defines. Accepting a
+  // different salt or nonce size would mean interpreting bytes the writer
+  // never meant, and a header length other than the fixed one would move
+  // the payload boundary.
+  if (header_len != kL3EnvelopeHeaderBytes ||
+      salt_len != kL3EnvelopeSaltBytes ||
+      nonce_len != kL3EnvelopeNonceBytes ||
+      tag_len != kL3EnvelopeTagBytes) {
+    return fail("l3envelope: bad header lengths");
+  }
+  if (iterations == 0) return fail("l3envelope: bad iteration count");
+  if (ciphertext_len < tag_len) return fail("l3envelope: bad ciphertext length");
+  const std::size_t plaintext_len = ciphertext_len - tag_len;
+  if (plaintext_len == 0) return fail("l3envelope: empty document");
+
+  const std::size_t expected =
+      kL3EnvelopeHeaderBytes + salt_len + nonce_len + ciphertext_len;
+  if (envelope.size() != expected) {
+    return fail("l3envelope: truncated or oversized envelope");
+  }
+
+  const char* salt = envelope.data() + kL3EnvelopeHeaderBytes;
+  const char* nonce = salt + salt_len;
+  const char* ciphertext = nonce + nonce_len;
+
+  std::uint8_t derived[kL3EnvelopeKeyBytes] = {};
+  if (!DeriveKey(key, reinterpret_cast<const std::uint8_t*>(salt), salt_len,
+                 iterations, derived)) {
+    Wipe(derived, sizeof(derived));
+    return fail("l3envelope: key derivation failed");
+  }
+
+  EVP_AEAD_CTX* ctx = EVP_AEAD_CTX_new(EVP_aead_aes_256_gcm(), derived,
+                                        sizeof(derived), tag_len);
+  if (ctx == nullptr) {
+    Wipe(derived, sizeof(derived));
+    return fail("l3envelope: aead init failed");
+  }
+
+  std::string plaintext;
+  plaintext.resize(plaintext_len);
+  std::size_t opened_len = 0;
+  // A wrong key, a flipped ciphertext byte or a tampered header all make
+  // EVP_AEAD_CTX_open fail, and the plaintext buffer is zeroed by then, so
+  // nothing partial escapes.
+  const bool opened = EVP_AEAD_CTX_open(
+      ctx, reinterpret_cast<std::uint8_t*>(&plaintext[0]), &opened_len,
+      plaintext_len, reinterpret_cast<const std::uint8_t*>(nonce), nonce_len,
+      reinterpret_cast<const std::uint8_t*>(ciphertext), ciphertext_len,
+      reinterpret_cast<const std::uint8_t*>(envelope.data()), header_len) == 1;
+  EVP_AEAD_CTX_free(ctx);
+  Wipe(derived, sizeof(derived));
+  if (!opened || opened_len != plaintext_len) {
+    Wipe(plaintext.data(), plaintext.size());
+    return fail("l3envelope: authentication failed");
+  }
+
+  *out = std::move(plaintext);
+  if (error) error->clear();
+  return true;
+}
+
+bool IsL3Envelope(std::string_view envelope) {
+  return envelope.size() >= kL3EnvelopeHeaderBytes &&
+         std::memcmp(envelope.data(), kMagic, sizeof(kMagic)) == 0 &&
+         static_cast<std::uint8_t>(envelope[4]) == kFormatVersion;
+}
+
+}  // namespace lengsuo::fp
diff --git a/lengsuo/native/l3_envelope.h b/lengsuo/native/l3_envelope.h
new file mode 100644
index 0000000..11d5374
--- /dev/null
+++ b/lengsuo/native/l3_envelope.h
@@ -0,0 +1,145 @@
+// l3_envelope - the encrypted envelope around an L3W1 document (task N).
+//
+// Why this exists: the managed L3 document used to travel as plaintext
+// base64 on the command line. Base64 is an encoding, not encryption, so
+// anyone who can read the process command line recovers every pinned
+// fingerprint value. The 对标端's own measurement agrees: its `init_bak.json`
+// payload is 724,160 B, i.e. 16-byte aligned, which is an AES block size.
+//
+// This module is the "中期方案" (mid-term plan) half of the fix:
+//
+//   * the on-disk managed file (`--lengsuo-l3-wire=<path>`) holds an
+//     *envelope*, not a plaintext L3W1 document;
+//   * the command line carries only a path, never the document.
+//
+// The switch that used to carry the document as plaintext base64 on the
+// command line is gone: the document reaches the renderer over Mojo
+// (lengsuo.mojom.L3Provisioning) instead. Nothing on this path encodes the
+// document as base64 any more.
+//
+// Envelope layout (all integers little-endian, all offsets byte counts):
+//
+//   offset  size  field
+//   0       4     magic "L3E1"
+//   4       1     format version (1)
+//   5       1     KDF id (1 = PBKDF2-HMAC-SHA256)
+//   6       1     cipher id (1 = AES-256-GCM)
+//   7       1     reserved, must be 0
+//   8       4     header length (bytes, from offset 0 to the ciphertext)
+//   12      4     KDF iteration count
+//   16      4     salt length
+//   20      4     nonce length
+//   24      4     tag length
+//   28      4     ciphertext length
+//   32      ...   salt bytes
+//   ...     ...   nonce bytes
+//   ...     ...   ciphertext bytes
+//   ...     16    GCM authentication tag
+//
+// The header is authenticated as additional data, so flipping a byte in the
+// iteration count, the salt or the lengths is a decryption failure and not a
+// silent re-interpretation.
+//
+// Key handling: the master key is NEVER hardcoded and never derived from a
+// constant in this file.  It is supplied by the caller (see
+// L3EnvelopeKey).  A caller that has no secure key source must fail
+// closed rather than fall back to a weak key - see the task-N report.
+//
+// Every failure mode is fail-closed: a wrong key, a tampered ciphertext, a
+// truncated envelope, an empty payload or an oversized payload all produce
+// failure with no partial plaintext escaping.
+#ifndef LENGSUO_NATIVE_L3_ENVELOPE_H_
+#define LENGSUO_NATIVE_L3_ENVELOPE_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <string_view>
+
+namespace lengsuo::fp {
+
+// The managed L3 document is bounded by kMaxL3WireBytes (64 KiB). An
+// envelope adds a bounded header, a salt, a nonce and a tag, so the envelope
+// bound is the document bound plus that overhead.
+inline constexpr std::size_t kMaxL3EnvelopeBytes = 64 * 1024 + 1024;
+
+inline constexpr std::size_t kL3EnvelopeSaltBytes = 16;
+inline constexpr std::size_t kL3EnvelopeNonceBytes = 12;
+inline constexpr std::size_t kL3EnvelopeTagBytes = 16;
+inline constexpr std::size_t kL3EnvelopeKeyBytes = 32;
+inline constexpr std::size_t kL3EnvelopeHeaderBytes = 32;
+
+// Bytes an envelope adds around the plaintext: the 32-byte header, the
+// 16-byte salt, the 12-byte nonce and the 16-byte tag.
+inline constexpr std::size_t kL3EnvelopeOverheadBytes =
+    kL3EnvelopeHeaderBytes + kL3EnvelopeSaltBytes + kL3EnvelopeNonceBytes +
+    kL3EnvelopeTagBytes;
+
+// The largest plaintext that still fits inside kMaxL3EnvelopeBytes.
+inline constexpr std::size_t kMaxL3EnvelopePlaintextBytes =
+    kMaxL3EnvelopeBytes - kL3EnvelopeOverheadBytes;
+
+// PBKDF2-HMAC-SHA256 iteration count used when the caller does not pick one.
+// Chosen so a single derivation costs ~20 ms on the build host: slow enough
+// to make offline guessing of a weak master key expensive, fast enough that
+// startup is not noticeable.  BoringSSL does ~270k iterations/second here.
+inline constexpr std::uint32_t kDefaultL3EnvelopeIterations = 100000;
+
+// The master key for the envelope.  `bytes` must be exactly
+// kL3EnvelopeKeyBytes long; a shorter or longer key is rejected rather
+// than padded or truncated, because silently accepting a weak key is how a
+// "protected" document turns out to be readable.
+//
+// The key is held by value and wiped on destruction: the plaintext
+// fingerprint values this protects are exactly the ones that must not
+// linger in memory longer than needed.
+class L3EnvelopeKey {
+ public:
+  L3EnvelopeKey() = default;
+  explicit L3EnvelopeKey(const std::string& bytes);
+  ~L3EnvelopeKey();
+  L3EnvelopeKey(const L3EnvelopeKey&) = delete;
+  L3EnvelopeKey& operator=(const L3EnvelopeKey&) = delete;
+  L3EnvelopeKey(L3EnvelopeKey&& other) noexcept;
+  L3EnvelopeKey& operator=(L3EnvelopeKey&& other) noexcept;
+
+  // True when a key of the right length is held.
+  bool valid() const { return valid_; }
+  std::size_t size() const { return bytes_.size(); }
+  const std::string& bytes() const { return bytes_; }
+
+ private:
+  std::string bytes_;
+  bool valid_ = false;
+};
+
+// Seals `plaintext` (the exact bytes of an L3W1 document) into an
+// envelope.  `key` must be valid; an invalid key fails rather than falling
+// back to a default.  `iterations` of 0 means kDefaultL3EnvelopeIterations.
+//
+// Returns false and sets `*error` (when non-null) on failure.  On success
+// `*out` holds a complete envelope.
+bool SealL3Envelope(std::string_view plaintext,
+                    const L3EnvelopeKey& key,
+                    std::uint32_t iterations,
+                    std::string* out,
+                    std::string* error);
+
+// Opens an envelope and returns the plaintext bytes.
+//
+// `*out` is left untouched on every failure, so a wrong key or a tampered
+// envelope can never yield partial plaintext.  Returns false and sets
+// `*error` (when non-null) on failure.
+bool OpenL3Envelope(std::string_view envelope,
+                    const L3EnvelopeKey& key,
+                    std::string* out,
+                    std::string* error);
+
+// True when `envelope` starts with the L3E1 magic and the format version.
+// This is a cheap structural check, not a validation: use OpenL3Envelope
+// for the real thing.
+bool IsL3Envelope(std::string_view envelope);
+
+}  // namespace lengsuo::fp
+
+#endif  // LENGSUO_NATIVE_L3_ENVELOPE_H_
diff --git a/lengsuo/native/l3_envelope_session.cc b/lengsuo/native/l3_envelope_session.cc
new file mode 100644
index 0000000..7dbabc2
--- /dev/null
+++ b/lengsuo/native/l3_envelope_session.cc
@@ -0,0 +1,79 @@
+#include "l3_envelope_session.h"
+
+#include <utility>
+
+namespace lengsuo::fp {
+namespace {
+
+void SetError(std::string* error, const char* message) {
+  if (error != nullptr) {
+    *error = message;
+  }
+}
+
+}  // namespace
+
+bool MakeL3EnvelopeKey(std::string_view session_key,
+                       L3EnvelopeKey* out,
+                       std::string* error) {
+  if (out == nullptr) {
+    SetError(error, "l3session: no output");
+    return false;
+  }
+  // The key is the caller's, and the caller's is the only source there is.
+  // There is no default, no derivation and no fallback: a caller that has no
+  // key has no envelope.
+  //
+  // The length is checked here and nowhere else, because the envelope's own
+  // key constructor checks it too. A key of the wrong length is refused
+  // rather than padded or truncated.
+  if (session_key.size() != kL3EnvelopeSessionKeyBytes) {
+    // The message says how long the key was, never what it was.
+    SetError(error, "l3session: bad session key length");
+    return false;
+  }
+  *out = L3EnvelopeKey(std::string(session_key));
+  if (!out->valid()) {
+    // Unreachable while the two length checks agree; kept so a future change
+    // to either one fails closed instead of sealing under a bad key.
+    SetError(error, "l3session: bad session key length");
+    return false;
+  }
+  if (error != nullptr) {
+    error->clear();
+  }
+  return true;
+}
+
+bool SealL3Document(std::string_view document,
+                    std::string_view session_key,
+                    std::uint32_t iterations,
+                    std::string* out,
+                    std::string* error) {
+  if (out == nullptr) {
+    SetError(error, "l3session: no output");
+    return false;
+  }
+  L3EnvelopeKey key;
+  if (!MakeL3EnvelopeKey(session_key, &key, error)) {
+    return false;
+  }
+  return SealL3Envelope(document, key, iterations, out, error);
+}
+
+bool OpenL3Document(std::string_view envelope,
+                    std::string_view session_key,
+                    std::string* out,
+                    std::string* error) {
+  if (out == nullptr) {
+    SetError(error, "l3session: no output");
+    return false;
+  }
+  L3EnvelopeKey key;
+  if (!MakeL3EnvelopeKey(session_key, &key, error)) {
+    return false;
+  }
+  return OpenL3Envelope(envelope, key, out, error);
+}
+
+}  // namespace lengsuo::fp
diff --git a/lengsuo/native/l3_envelope_session.h b/lengsuo/native/l3_envelope_session.h
new file mode 100644
index 0000000..9815060
--- /dev/null
+++ b/lengsuo/native/l3_envelope_session.h
@@ -0,0 +1,102 @@
+// l3_envelope_session - the seam between the pipe's session key and the L3E1
+// document envelope (task N).
+//
+// Two envelopes live in this tree and they are two different layers:
+//
+//   native/l3_envelope.{h,cc}          the L3E1 envelope: the L3W1 document
+//                                      in its on-disk form, sealed under a
+//                                      32-byte master key. Little-endian
+//                                      header, PBKDF2-HMAC-SHA256, 76 bytes
+//                                      of overhead.
+//   native/kernel_pipe_envelope.{h,cc} the KeyEnvelope of the runner <-> kernel
+//                                      pipe: the session key handed down at
+//                                      handshake time. Big-endian, no KDF, an
+//                                      85-byte payload.
+//
+// Their only meeting point is this one: **the key is supplied by the caller**.
+// This file is that meeting point, and it is deliberately thin.
+//
+// Where the key comes from (and it is not from here):
+//
+//   The runner seals the session key into the pipe's KeyEnvelope; the kernel
+//   opens it in the handshake (task Q, native/kernel_pipe.{h,cc}). The
+//   handshake holds the key in memory only, and hands it out as
+//   KernelPipeHandshake::session_key(). **That is the caller**:
+//
+//       L3EnvelopeKey key;
+//       if (!MakeL3EnvelopeKey(handshake.session_key(), &key, &error)) { ... }
+//       SealL3Envelope(document, key, iterations, &envelope, &error);
+//
+// This module never derives a key, never defaults one, never reads one from
+// the environment, a file or a constant. A caller with no key has no
+// envelope: the failure is "unavailable", not "a weak key".
+//
+// The layer boundary is deliberate: this file does not include
+// kernel_pipe*.h, because a disk-format module must not depend on the
+// transport that happens to carry its key today. The one thing both layers
+// must agree on - the session key's length - is pinned here and checked
+// against the pipe's own constant by the test, not by a header include.
+//
+// The lifetime of the key is the caller's business too: the pipe's session
+// key expires, and the contract says an expired key must be refused. The
+// envelope layer imposes no lifetime of its own, because the key's source
+// may stop being a per-session key later. See docs/l3-reports/task-N.md
+// section 4 for the open questions.
+#ifndef LENGSUO_NATIVE_L3_ENVELOPE_SESSION_H_
+#define LENGSUO_NATIVE_L3_ENVELOPE_SESSION_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <string_view>
+
+#include "l3_envelope.h"
+
+namespace lengsuo::fp {
+
+// The length the caller's key must have. It is the envelope's own key length
+// (32 bytes) and also the length the pipe contract pins for the session key
+// (contract section 1), so the pipe's session key fits the envelope without
+// padding or truncation.
+inline constexpr std::size_t kL3EnvelopeSessionKeyBytes = kL3EnvelopeKeyBytes;
+
+// Builds the envelope's master key from the caller's key.
+//
+// `session_key` must be exactly kL3EnvelopeSessionKeyBytes long. A shorter
+// or longer key is refused rather than padded or truncated: padding would
+// silently weaken the KDF, truncating would ignore bits the caller believed
+// were protecting the document.
+//
+// Returns false and sets `*error` (when non-null) on failure. `*out` is left
+// untouched on failure, so a rejected key cannot leave a half-built key
+// behind.
+bool MakeL3EnvelopeKey(std::string_view session_key,
+                       L3EnvelopeKey* out,
+                       std::string* error);
+
+// Seals an L3W1 document under the caller's key.
+//
+// `iterations` of 0 means kDefaultL3EnvelopeIterations. This is
+// SealL3Envelope with the key taken from the caller in one step, so a caller
+// cannot accidentally seal under a key it never validated.
+//
+// Returns false and sets `*error` (when non-null) on failure. `*out` is left
+// untouched on failure.
+bool SealL3Document(std::string_view document,
+                    std::string_view session_key,
+                    std::uint32_t iterations,
+                    std::string* out,
+                    std::string* error);
+
+// Opens an envelope with the caller's key.
+//
+// Returns false and sets `*error` (when non-null) on failure. `*out` is left
+// untouched on failure, so no partial plaintext escapes.
+bool OpenL3Document(std::string_view envelope,
+                    std::string_view session_key,
+                    std::string* out,
+                    std::string* error);
+
+}  // namespace lengsuo::fp
+
+#endif  // LENGSUO_NATIVE_L3_ENVELOPE_SESSION_H_
diff --git a/lengsuo/native/l3_envelope_session_test.cc b/lengsuo/native/l3_envelope_session_test.cc
new file mode 100644
index 0000000..a58305a
--- /dev/null
+++ b/lengsuo/native/l3_envelope_session_test.cc
@@ -0,0 +1,217 @@
+// l3_envelope_session_test - the seam between the pipe's session key and the
+// L3E1 document envelope (task N).
+//
+// Two envelopes live in this tree and they are NOT the same thing:
+//
+//   native/l3_envelope.{h,cc}          the L3E1 envelope: an L3W1 document on
+//                                      disk, sealed under a master key the
+//                                      caller supplies. Little-endian,
+//                                      PBKDF2, 76 bytes of overhead.
+//   native/kernel_pipe_envelope.{h,cc} the KeyEnvelope of the runner <-> kernel
+//                                      pipe: the session key handed down at
+//                                      handshake time. Big-endian, no KDF, an
+//                                      85-byte payload.
+//
+// This file's subject is the seam between them, and it is the only one: the
+// pipe's session key becomes the L3E1 master key, unchanged.
+//
+// The tests below pin the three properties that matter:
+//   * the key comes from the caller and from nowhere else;
+//   * no key means "unavailable", never "a weak key";
+//   * the seam does not weaken the authentication the envelope already had.
+#include "l3_envelope_session.h"
+
+#include <gtest/gtest.h>
+
+#include <string>
+
+#include "kernel_pipe_keys.h"
+
+namespace lengsuo::fp {
+namespace {
+
+// The session key length the pipe contract pins (contract section 1): the
+// runner sends 32 bytes of session key inside the KeyEnvelope. The L3E1
+// master key is exactly that many bytes, so the two agree by construction
+// rather than by coincidence.
+//
+// The check is against the pipe's own constant, not against a number
+// written here: if the pipe ever changes the length, this file fails to
+// compile instead of silently padding or truncating.
+static_assert(kKernelPipeSessionKeyBytes == kL3EnvelopeSessionKeyBytes,
+              "the pipe's session key and the envelope's master key must "
+              "have the same length");
+static_assert(kL3EnvelopeSessionKeyBytes == kL3EnvelopeKeyBytes,
+              "the seam's key length and the envelope's key length must "
+              "have the same length");
+
+constexpr std::size_t kSessionKeyBytes = kKernelPipeSessionKeyBytes;
+
+// A session key. It is a test fixture, not a secret.
+std::string SessionKey(char fill) {
+  return std::string(kSessionKeyBytes, fill);
+}
+
+// An L3W1 document: the body plus its sign line, the same shape
+// l3_envelope_test.cc seals.
+std::string ReferenceDocument() {
+  return "L3W1\n"
+         "pins 1\n"
+         "https://mms.pinduoduo.com|local|finger-key_0.1.5|"
+         "7FcROXwfKGAKuwlRwwlBCEUPeZXjwrH5\n"
+         "sign 0123456789abcdef0123456789abcdef_v1_t1700000000\n";
+}
+
+// --- the mapping -----------------------------------------------------------
+
+TEST(L3EnvelopeSessionTest, TheSessionKeyLengthIsThePipeContractLength) {
+  // The pipe's session key (contract section 1) and the L3E1 master key
+  // must be the same size, otherwise the seam could not hand one to the
+  // other without padding or truncating. The static_asserts above make the
+  // compile fail if the two ever drift apart; this test is the runtime
+  // half of the same statement.
+  EXPECT_EQ(kSessionKeyBytes, kL3EnvelopeSessionKeyBytes);
+  EXPECT_EQ(kL3EnvelopeSessionKeyBytes, kL3EnvelopeKeyBytes);
+}
+
+TEST(L3EnvelopeSessionTest, ASessionKeyBecomesAValidEnvelopeKey) {
+  L3EnvelopeKey key;
+  std::string error = "unset";
+  ASSERT_TRUE(MakeL3EnvelopeKey(SessionKey('S'), &key, &error)) << error;
+  EXPECT_TRUE(error.empty());
+  EXPECT_TRUE(key.valid());
+  EXPECT_EQ(key.size(), kL3EnvelopeSessionKeyBytes);
+  EXPECT_EQ(key.bytes(), SessionKey('S'));
+}
+
+TEST(L3EnvelopeSessionTest, ASessionKeyOfTheWrongLengthIsRejected) {
+  // Padding a short key up would weaken the KDF; truncating a long one
+  // would drop entropy the sender believed was protecting the document.
+  // Both are refused.
+  for (const std::size_t size : {std::size_t{0}, std::size_t{16},
+                                 std::size_t{31}, std::size_t{33},
+                                 std::size_t{64}}) {
+    L3EnvelopeKey key;
+    std::string error;
+    EXPECT_FALSE(MakeL3EnvelopeKey(std::string(size, 'S'), &key, &error))
+        << "a session key of " << size << " bytes was accepted";
+    EXPECT_FALSE(error.empty());
+    EXPECT_FALSE(key.valid());
+  }
+}
+
+TEST(L3EnvelopeSessionTest, ARejectedSessionKeyLeavesTheOutputUntouched) {
+  L3EnvelopeKey key;
+  std::string error;
+  ASSERT_TRUE(MakeL3EnvelopeKey(SessionKey('S'), &key, &error)) << error;
+  const std::string before = key.bytes();
+
+  EXPECT_FALSE(MakeL3EnvelopeKey("too short", &key, &error));
+  EXPECT_EQ(key.bytes(), before);
+  EXPECT_TRUE(key.valid());
+}
+
+TEST(L3EnvelopeSessionTest, NoSessionKeyMeansUnavailableNotAWeakKey) {
+  // There is no default key and no derivation from a constant: a caller
+  // without a session key simply has no envelope.
+  L3EnvelopeKey key;
+  std::string error;
+  EXPECT_FALSE(MakeL3EnvelopeKey("", &key, &error));
+  EXPECT_FALSE(key.valid());
+  EXPECT_EQ(key.size(), 0u);
+  EXPECT_TRUE(key.bytes().empty());
+}
+
+TEST(L3EnvelopeSessionTest, DifferentSessionKeysGiveDifferentEnvelopeKeys) {
+  L3EnvelopeKey first;
+  L3EnvelopeKey second;
+  std::string error;
+  ASSERT_TRUE(MakeL3EnvelopeKey(SessionKey('A'), &first, &error)) << error;
+  ASSERT_TRUE(MakeL3EnvelopeKey(SessionKey('B'), &second, &error)) << error;
+  EXPECT_NE(first.bytes(), second.bytes());
+}
+
+// --- seal and open through the seam ---------------------------------------
+
+TEST(L3EnvelopeSessionTest, ADocumentRoundTripsThroughTheSessionKey) {
+  const std::string document = ReferenceDocument();
+  std::string envelope;
+  std::string error;
+  ASSERT_TRUE(SealL3Document(document, SessionKey('S'), 1000, &envelope,
+                             &error))
+      << error;
+  EXPECT_TRUE(error.empty());
+  EXPECT_TRUE(IsL3Envelope(envelope));
+
+  std::string opened;
+  ASSERT_TRUE(OpenL3Document(envelope, SessionKey('S'), &opened, &error))
+      << error;
+  EXPECT_EQ(opened, document);
+}
+
+TEST(L3EnvelopeSessionTest, TheWrongSessionKeyCannotOpenTheDocument) {
+  std::string envelope;
+  std::string error;
+  ASSERT_TRUE(SealL3Document(ReferenceDocument(), SessionKey('S'), 1000,
+                             &envelope, &error))
+      << error;
+
+  std::string opened = "sentinel";
+  EXPECT_FALSE(OpenL3Document(envelope, SessionKey('T'), &opened, &error));
+  EXPECT_EQ(opened, "sentinel");
+}
+
+TEST(L3EnvelopeSessionTest, TheSessionKeyIsNotInTheEnvelope) {
+  // The session key must not survive in the envelope as readable bytes.
+  std::string envelope;
+  std::string error;
+  ASSERT_TRUE(SealL3Document(ReferenceDocument(), SessionKey('S'), 1000,
+                             &envelope, &error))
+      << error;
+  EXPECT_EQ(envelope.find(SessionKey('S')), std::string::npos);
+  EXPECT_EQ(envelope.find("L3W1"), std::string::npos);
+  EXPECT_EQ(envelope.find("finger-key_0.1.5"), std::string::npos);
+}
+
+TEST(L3EnvelopeSessionTest, SealingWithoutASessionKeyFails) {
+  std::string envelope = "sentinel";
+  std::string error;
+  EXPECT_FALSE(SealL3Document(ReferenceDocument(), "", 1000, &envelope,
+                              &error));
+  EXPECT_EQ(envelope, "sentinel");
+  EXPECT_FALSE(error.empty());
+}
+
+TEST(L3EnvelopeSessionTest, OpeningWithoutASessionKeyFails) {
+  // An envelope sealed under one session key must not open under no key at
+  // all: there is no "empty key" to fall back to.
+  std::string envelope;
+  std::string error;
+  ASSERT_TRUE(SealL3Document(ReferenceDocument(), SessionKey('S'), 1000,
+                             &envelope, &error))
+      << error;
+
+  std::string opened = "sentinel";
+  EXPECT_FALSE(OpenL3Document(envelope, "", &opened, &error));
+  EXPECT_EQ(opened, "sentinel");
+}
+
+TEST(L3EnvelopeSessionTest, TheSeamDoesNotWeakenAuthentication) {
+  std::string envelope;
+  std::string error;
+  ASSERT_TRUE(SealL3Document(ReferenceDocument(), SessionKey('S'), 1000,
+                             &envelope, &error))
+      << error;
+
+  // One flipped byte in the ciphertext body still fails to open.
+  std::string tampered = envelope;
+  tampered[kL3EnvelopeHeaderBytes + kL3EnvelopeSaltBytes +
+            kL3EnvelopeNonceBytes + 3] ^= 0x01;
+
+  std::string opened = "sentinel";
+  EXPECT_FALSE(OpenL3Document(tampered, SessionKey('S'), &opened, &error));
+  EXPECT_EQ(opened, "sentinel");
+}
+
+}  // namespace
+}  // namespace lengsuo::fp
diff --git a/lengsuo/native/l3_envelope_test.cc b/lengsuo/native/l3_envelope_test.cc
new file mode 100644
index 0000000..2174395
--- /dev/null
+++ b/lengsuo/native/l3_envelope_test.cc
@@ -0,0 +1,379 @@
+// l3_envelope_test - the encrypted envelope around an L3W1 document.
+//
+// The scenario is the one the task brief describes: a managed L3 document
+// (pins / cookie facts / extension whitelist / mirror rules) that used to
+// travel as plaintext base64 on the command line, and that must now be
+// sealed into an envelope whose only on-disk form is ciphertext.
+//
+// The reference document is the pinduoduo pin set from the 对标端 cache,
+// the same fixture l3_wire_test.cc uses, so a sealed envelope and a parsed
+// L3Config describe the same environment.
+#include "l3_envelope.h"
+
+#include <gtest/gtest.h>
+
+#include <string>
+
+namespace lengsuo::fp {
+namespace {
+
+// A real L3W1 document: the body plus its sign line. The bytes matter -
+// the envelope must recover them exactly, not an equivalent document.
+std::string ReferenceDocument() {
+  const std::string body =
+      "L3W1\n"
+      "pins 2\n"
+      "https://mms.pinduoduo.com|local|finger-key_0.1.5|"
+      "7FcROXwfKGAKuwlRwwlBCEUPeZXjwrH5\n"
+      "https://mms.pinduoduo.com|local|finger-uuid1_0.1.5|"
+      "9df4fd33-43dc-4432-b6aa-67c80d64545d\n"
+      "cookies 1\n"
+      ".pinduoduo.com|_bee|7FcROXwfKGAKuwlRwwlBCEUPeZXjwrH5\n"
+      "ext 1\n"
+      "fjchbfkopknlodpfoaeogfbclcpppiog\n"
+      "rules 1\n"
+      ".pinduoduo.com|_bee|https://mms.pinduoduo.com|finger-key_0.1.5\n";
+  // The sign line is part of the document bytes, so it is sealed too.
+  return body + "sign 0123456789abcdef0123456789abcdef_v1_t1700000000\n";
+}
+
+// A 32-byte master key. It is a test fixture, not a secret: the point of
+// the tests is that the key comes from the caller and never from a
+// constant baked into the implementation.
+L3EnvelopeKey TestKey() {
+  return L3EnvelopeKey(std::string(32, 'K'));
+}
+
+L3EnvelopeKey OtherKey() {
+  return L3EnvelopeKey(std::string(32, 'X'));
+}
+
+// A key of the wrong length must be rejected, not padded or truncated.
+L3EnvelopeKey ShortKey() {
+  return L3EnvelopeKey(std::string(16, 'K'));
+}
+
+TEST(L3EnvelopeTest, RoundTripReproducesDocumentByteForByte) {
+  const std::string document = ReferenceDocument();
+  const L3EnvelopeKey key = TestKey();
+
+  std::string envelope;
+  std::string error = "unset";
+  ASSERT_TRUE(SealL3Envelope(document, key, 1000, &envelope, &error)) << error;
+  EXPECT_TRUE(error.empty());
+  EXPECT_TRUE(IsL3Envelope(envelope));
+
+  std::string opened;
+  ASSERT_TRUE(OpenL3Envelope(envelope, key, &opened, &error)) << error;
+  EXPECT_EQ(opened, document);
+}
+
+TEST(L3EnvelopeTest, EnvelopeDoesNotContainThePlaintext) {
+  const std::string document = ReferenceDocument();
+  const L3EnvelopeKey key = TestKey();
+
+  std::string envelope;
+  std::string error;
+  ASSERT_TRUE(SealL3Envelope(document, key, 1000, &envelope, &error)) << error;
+
+  // The pinned value must not survive in the envelope as readable bytes.
+  EXPECT_EQ(envelope.find("7FcROXwfKGAKuwlRwwlBCEUPeZXjwrH5"), std::string::npos);
+  EXPECT_EQ(envelope.find("finger-key_0.1.5"), std::string::npos);
+  EXPECT_EQ(envelope.find("L3W1"), std::string::npos);
+}
+
+TEST(L3EnvelopeTest, TwoEnvelopesOfTheSameDocumentDiffer) {
+  // A fresh salt and nonce per seal, so the same document never produces
+  // the same bytes twice on disk.
+  const std::string document = ReferenceDocument();
+  const L3EnvelopeKey key = TestKey();
+
+  std::string first;
+  std::string second;
+  std::string error;
+  ASSERT_TRUE(SealL3Envelope(document, key, 1000, &first, &error)) << error;
+  ASSERT_TRUE(SealL3Envelope(document, key, 1000, &second, &error)) << error;
+  EXPECT_NE(first, second);
+
+  std::string opened_first;
+  std::string opened_second;
+  ASSERT_TRUE(OpenL3Envelope(first, key, &opened_first, &error)) << error;
+  ASSERT_TRUE(OpenL3Envelope(second, key, &opened_second, &error)) << error;
+  EXPECT_EQ(opened_first, document);
+  EXPECT_EQ(opened_second, document);
+}
+
+TEST(L3EnvelopeTest, WrongKeyFailsAndReturnsNoPlaintext) {
+  const std::string document = ReferenceDocument();
+  const L3EnvelopeKey key = TestKey();
+  const L3EnvelopeKey wrong = OtherKey();
+
+  std::string envelope;
+  std::string error;
+  ASSERT_TRUE(SealL3Envelope(document, key, 1000, &envelope, &error)) << error;
+
+  std::string opened = "sentinel";
+  std::string failure;
+  EXPECT_FALSE(OpenL3Envelope(envelope, wrong, &opened, &failure));
+  EXPECT_FALSE(failure.empty());
+  // Not even a prefix of the plaintext may escape.
+  EXPECT_EQ(opened, "sentinel");
+  EXPECT_EQ(opened.find("L3W1"), std::string::npos);
+}
+
+TEST(L3EnvelopeTest, TamperedCiphertextFailsAuthentication) {
+  const std::string document = ReferenceDocument();
+  const L3EnvelopeKey key = TestKey();
+
+  std::string envelope;
+  std::string error;
+  ASSERT_TRUE(SealL3Envelope(document, key, 1000, &envelope, &error)) << error;
+
+  // Flip one bit in the ciphertext body. The GCM tag covers it, so the
+  // open must fail rather than return modified plaintext.
+  std::string tampered = envelope;
+  const std::size_t offset = kL3EnvelopeHeaderBytes + kL3EnvelopeSaltBytes +
+                             kL3EnvelopeNonceBytes + 3;
+  ASSERT_LT(offset, tampered.size());
+  tampered[offset] = static_cast<char>(tampered[offset] ^ 0x01);
+
+  std::string opened = "sentinel";
+  std::string failure;
+  EXPECT_FALSE(OpenL3Envelope(tampered, key, &opened, &failure));
+  EXPECT_EQ(opened, "sentinel");
+}
+
+TEST(L3EnvelopeTest, TamperedAuthenticationTagFails) {
+  const std::string document = ReferenceDocument();
+  const L3EnvelopeKey key = TestKey();
+
+  std::string envelope;
+  std::string error;
+  ASSERT_TRUE(SealL3Envelope(document, key, 1000, &envelope, &error)) << error;
+
+  std::string tampered = envelope;
+  tampered[tampered.size() - 1] =
+      static_cast<char>(tampered[tampered.size() - 1] ^ 0x80);
+
+  std::string opened = "sentinel";
+  std::string failure;
+  EXPECT_FALSE(OpenL3Envelope(tampered, key, &opened, &failure));
+  EXPECT_EQ(opened, "sentinel");
+}
+
+TEST(L3EnvelopeTest, TamperedHeaderFailsAuthentication) {
+  // The header is additional data: changing the iteration count must fail
+  // the open, not silently re-derive a different key.
+  const std::string document = ReferenceDocument();
+  const L3EnvelopeKey key = TestKey();
+
+  std::string envelope;
+  std::string error;
+  ASSERT_TRUE(SealL3Envelope(document, key, 1000, &envelope, &error)) << error;
+
+  std::string tampered = envelope;
+  tampered[12] = static_cast<char>(tampered[12] ^ 0x01);
+
+  std::string opened = "sentinel";
+  std::string failure;
+  EXPECT_FALSE(OpenL3Envelope(tampered, key, &opened, &failure));
+  EXPECT_EQ(opened, "sentinel");
+}
+
+TEST(L3EnvelopeTest, TruncatedEnvelopeFails) {
+  const std::string document = ReferenceDocument();
+  const L3EnvelopeKey key = TestKey();
+
+  std::string envelope;
+  std::string error;
+  ASSERT_TRUE(SealL3Envelope(document, key, 1000, &envelope, &error)) << error;
+
+  // Every truncation must fail: the length in the header no longer matches
+  // the bytes present.
+  for (std::size_t cut : {std::size_t{0}, std::size_t{1}, std::size_t{16},
+                          kL3EnvelopeHeaderBytes, envelope.size() / 2,
+                          envelope.size() - 1}) {
+    std::string truncated = envelope.substr(0, cut);
+    std::string opened = "sentinel";
+    std::string failure;
+    EXPECT_FALSE(OpenL3Envelope(truncated, key, &opened, &failure))
+        << "truncation to " << cut << " bytes was accepted";
+    EXPECT_EQ(opened, "sentinel");
+  }
+}
+
+TEST(L3EnvelopeTest, EmptyInputFails) {
+  const L3EnvelopeKey key = TestKey();
+  std::string error;
+
+  // Sealing an empty document is refused: an envelope with no payload
+  // carries no L3 statement, and accepting it would let a truncated file
+  // look like a valid one.
+  std::string envelope = "sentinel";
+  EXPECT_FALSE(SealL3Envelope("", key, 1000, &envelope, &error));
+  EXPECT_EQ(envelope, "sentinel");
+
+  // Opening an empty envelope is refused too.
+  std::string opened = "sentinel";
+  EXPECT_FALSE(OpenL3Envelope("", key, &opened, &error));
+  EXPECT_EQ(opened, "sentinel");
+}
+
+TEST(L3EnvelopeTest, OversizedInputFails) {
+  const L3EnvelopeKey key = TestKey();
+  std::string error;
+  const std::string huge(kMaxL3EnvelopeBytes + 1, 'x');
+
+  std::string envelope = "sentinel";
+  EXPECT_FALSE(SealL3Envelope(huge, key, 1000, &envelope, &error));
+  EXPECT_EQ(envelope, "sentinel");
+
+  std::string opened = "sentinel";
+  EXPECT_FALSE(OpenL3Envelope(huge, key, &opened, &error));
+  EXPECT_EQ(opened, "sentinel");
+}
+
+TEST(L3EnvelopeTest, DocumentSizeBoundaryIsRespected) {
+  const L3EnvelopeKey key = TestKey();
+  std::string error;
+
+  // The largest plaintext that still fits in an envelope must seal and
+  // open; one byte more must be refused.
+  const std::string at_limit(kMaxL3EnvelopePlaintextBytes, 'd');
+  std::string envelope;
+  ASSERT_TRUE(SealL3Envelope(at_limit, key, 1000, &envelope, &error)) << error;
+  EXPECT_LE(envelope.size(), kMaxL3EnvelopeBytes);
+
+  std::string opened;
+  ASSERT_TRUE(OpenL3Envelope(envelope, key, &opened, &error)) << error;
+  EXPECT_EQ(opened.size(), at_limit.size());
+
+  const std::string over_limit(kMaxL3EnvelopePlaintextBytes + 1, 'd');
+  std::string rejected = "sentinel";
+  EXPECT_FALSE(SealL3Envelope(over_limit, key, 1000, &rejected, &error));
+  EXPECT_EQ(rejected, "sentinel");
+}
+
+TEST(L3EnvelopeTest, InvalidKeyLengthIsRejected) {
+  // A wrong-length master key is refused rather than padded or truncated:
+  // silently accepting it is how a "protected" document stays readable.
+  const L3EnvelopeKey short_key = ShortKey();
+  EXPECT_FALSE(short_key.valid());
+  EXPECT_EQ(short_key.size(), 0u);
+
+  std::string envelope = "sentinel";
+  std::string error;
+  EXPECT_FALSE(SealL3Envelope(ReferenceDocument(), short_key, 1000, &envelope,
+                              &error));
+  EXPECT_EQ(envelope, "sentinel");
+
+  // An open with a rejected key fails as well.
+  std::string opened = "sentinel";
+  EXPECT_FALSE(OpenL3Envelope("L3E1garbage", short_key, &opened, &error));
+  EXPECT_EQ(opened, "sentinel");
+}
+
+TEST(L3EnvelopeTest, ForeignDataIsNotAnEnvelope) {
+  const L3EnvelopeKey key = TestKey();
+  std::string opened = "sentinel";
+  std::string error;
+
+  // A plaintext L3W1 document is not an envelope: the reader must not
+  // mistake the transitional base64 payload for a sealed one.
+  EXPECT_FALSE(OpenL3Envelope(ReferenceDocument(), key, &opened, &error));
+  EXPECT_EQ(opened, "sentinel");
+  EXPECT_FALSE(IsL3Envelope(ReferenceDocument()));
+}
+
+TEST(L3EnvelopeTest, UnknownVersionIsRejected) {
+  const L3EnvelopeKey key = TestKey();
+  std::string envelope;
+  std::string error;
+  ASSERT_TRUE(SealL3Envelope(ReferenceDocument(), key, 1000, &envelope, &error))
+      << error;
+
+  std::string bumped = envelope;
+  bumped[4] = static_cast<char>(99);
+
+  std::string opened = "sentinel";
+  std::string failure;
+  EXPECT_FALSE(OpenL3Envelope(bumped, key, &opened, &failure));
+  EXPECT_EQ(opened, "sentinel");
+  EXPECT_FALSE(IsL3Envelope(bumped));
+}
+
+TEST(L3EnvelopeTest, BadMagicIsRejected) {
+  const L3EnvelopeKey key = TestKey();
+  std::string opened = "sentinel";
+  std::string error;
+  EXPECT_FALSE(OpenL3Envelope("XXXXnot-an-envelope-at-all", key, &opened, &error));
+  EXPECT_EQ(opened, "sentinel");
+}
+
+TEST(L3EnvelopeTest, InconsistentLengthsAreRejected) {
+  // A header whose ciphertext length does not match the bytes present must
+  // fail before any decryption is attempted.
+  const L3EnvelopeKey key = TestKey();
+  std::string envelope;
+  std::string error;
+  ASSERT_TRUE(SealL3Envelope(ReferenceDocument(), key, 1000, &envelope, &error))
+      << error;
+
+  std::string stretched = envelope;
+  stretched[28] = static_cast<char>(stretched[28] + 1);
+
+  std::string opened = "sentinel";
+  std::string failure;
+  EXPECT_FALSE(OpenL3Envelope(stretched, key, &opened, &failure));
+  EXPECT_EQ(opened, "sentinel");
+}
+
+TEST(L3EnvelopeTest, IterationCountIsHonoured) {
+  // The iteration count travels in the header, so a caller can pick a
+  // different cost and the reader must use the one that was written.
+  const std::string document = ReferenceDocument();
+  const L3EnvelopeKey key = TestKey();
+
+  std::string envelope;
+  std::string error;
+  ASSERT_TRUE(SealL3Envelope(document, key, 2000, &envelope, &error)) << error;
+
+  const std::uint32_t iterations =
+      static_cast<std::uint32_t>(static_cast<unsigned char>(envelope[12])) |
+      (static_cast<std::uint32_t>(static_cast<unsigned char>(envelope[13]))
+       << 8) |
+      (static_cast<std::uint32_t>(static_cast<unsigned char>(envelope[14]))
+       << 16) |
+      (static_cast<std::uint32_t>(static_cast<unsigned char>(envelope[15]))
+       << 24);
+  EXPECT_EQ(iterations, 2000u);
+
+  std::string opened;
+  ASSERT_TRUE(OpenL3Envelope(envelope, key, &opened, &error)) << error;
+  EXPECT_EQ(opened, document);
+}
+
+TEST(L3EnvelopeTest, DefaultIterationCountIsUsedWhenUnspecified) {
+  const L3EnvelopeKey key = TestKey();
+  std::string envelope;
+  std::string error;
+  ASSERT_TRUE(SealL3Envelope(ReferenceDocument(), key, 0, &envelope, &error))
+      << error;
+
+  const std::uint32_t iterations =
+      static_cast<std::uint32_t>(static_cast<unsigned char>(envelope[12])) |
+      (static_cast<std::uint32_t>(static_cast<unsigned char>(envelope[13]))
+       << 8) |
+      (static_cast<std::uint32_t>(static_cast<unsigned char>(envelope[14]))
+       << 16) |
+      (static_cast<std::uint32_t>(static_cast<unsigned char>(envelope[15]))
+       << 24);
+  EXPECT_EQ(iterations, kDefaultL3EnvelopeIterations);
+
+  std::string opened;
+  ASSERT_TRUE(OpenL3Envelope(envelope, key, &opened, &error)) << error;
+  EXPECT_EQ(opened, ReferenceDocument());
+}
+
+}  // namespace
+}  // namespace lengsuo::fp
diff --git a/lengsuo/native/l3_runtime.cc b/lengsuo/native/l3_runtime.cc
new file mode 100644
index 0000000..d6e40f7
--- /dev/null
+++ b/lengsuo/native/l3_runtime.cc
@@ -0,0 +1,105 @@
+#include "l3_runtime.h"
+
+#include <algorithm>
+
+#include "l3_wire.h"
+
+namespace lengsuo::fp {
+namespace {
+
+// ExtensionPin keeps a std::set, but L3Config is move-only through Parse();
+// copying the ids out keeps L3Runtime trivially queryable afterwards.
+std::vector<std::string> IdsOf(const ExtensionPin& extensions) {
+  return std::vector<std::string>(extensions.Ids().begin(),
+                                  extensions.Ids().end());
+}
+
+const PinnedEntry* FindIn(const std::vector<PinnedEntry>& entries,
+                          const std::string& key) {
+  const auto found = std::find_if(
+      entries.begin(), entries.end(),
+      [&key](const PinnedEntry& entry) { return entry.key == key; });
+  return found == entries.end() ? nullptr : &*found;
+}
+
+}  // namespace
+
+bool L3Runtime::Init(std::string_view wire, int64_t now_unix,
+                     int64_t max_age_seconds) {
+  // Single-shot: a renderer keeps the snapshot it started with so that a
+  // later document can never silently change what the page already read.
+  if (ready_) {
+    return false;
+  }
+  L3Config config;
+  // now_unix <= 0 means "the caller judged freshness elsewhere"; the decoder
+  // still verifies the digest and the launch consistency gate.
+  if (!DecodeL3Wire(wire, now_unix, max_age_seconds, &config, nullptr)) {
+    return false;
+  }
+  pins_ = std::move(config.pins);
+  extensions_ = IdsOf(config.extensions);
+  ready_ = true;
+  return true;
+}
+
+const std::vector<PinnedEntry>* L3Runtime::LocalPins(
+    const std::string& origin) const {
+  if (!ready_) {
+    return nullptr;
+  }
+  const DomainPin* domain = pins_.Find(origin);
+  if (domain == nullptr || domain->local_storage.empty()) {
+    return nullptr;
+  }
+  return &domain->local_storage;
+}
+
+const std::vector<PinnedEntry>* L3Runtime::SessionPins(
+    const std::string& origin) const {
+  if (!ready_) {
+    return nullptr;
+  }
+  const DomainPin* domain = pins_.Find(origin);
+  if (domain == nullptr || domain->session_storage.empty()) {
+    return nullptr;
+  }
+  return &domain->session_storage;
+}
+
+bool L3Runtime::IsLocked(const std::string& origin,
+                         const std::string& key) const {
+  return ready_ && pins_.IsLocked(origin, key);
+}
+
+const std::string* L3Runtime::PinnedValue(const std::string& origin,
+                                          const std::string& key) const {
+  if (!ready_) {
+    return nullptr;
+  }
+  const DomainPin* domain = pins_.Find(origin);
+  if (domain == nullptr) {
+    return nullptr;
+  }
+  // Local scope wins when a key is pinned in both: local storage is the scope
+  // platforms read first, and the browser writes both from the same document.
+  if (const PinnedEntry* entry = FindIn(domain->local_storage, key)) {
+    return &entry->value;
+  }
+  if (const PinnedEntry* entry = FindIn(domain->session_storage, key)) {
+    return &entry->value;
+  }
+  return nullptr;
+}
+
+bool L3Runtime::ExtensionAllowed(const std::string& id) const {
+  return ready_ && std::find(extensions_.begin(), extensions_.end(), id) !=
+                       extensions_.end();
+}
+
+L3Runtime& GetL3Runtime() {
+  static L3Runtime runtime;
+  return runtime;
+}
+
+}  // namespace lengsuo::fp
diff --git a/lengsuo/native/l3_runtime.h b/lengsuo/native/l3_runtime.h
new file mode 100644
index 0000000..3c2f38c
--- /dev/null
+++ b/lengsuo/native/l3_runtime.h
@@ -0,0 +1,82 @@
+// l3_runtime - renderer-side L3 snapshot singleton (wiring task I).
+//
+// The renderer never parses profile files itself; the browser hands it one
+// frozen L3W1 document and this object answers every later query:
+//
+//   * which key/value pairs are pinned for an origin (localStorage and
+//     sessionStorage separately),
+//   * whether a key is locked (pinned in either scope),
+//   * the pinned value for a key (nullptr when absent - empty string is a
+//     valid value, so nullptr must stay distinguishable),
+//   * whether an extension id is on the environment whitelist.
+//
+// Init() is transactional and single-shot: the first call wins, later calls
+// are rejected. A renderer therefore cannot be re-armed with a different
+// snapshot mid-life, matching the browser's freeze-at-startup design.
+#ifndef LENGSUO_NATIVE_L3_RUNTIME_H_
+#define LENGSUO_NATIVE_L3_RUNTIME_H_
+
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "storage_pin.h"
+
+namespace lengsuo::fp {
+
+class L3Runtime {
+ public:
+  L3Runtime() = default;
+  ~L3Runtime() = default;
+  L3Runtime(const L3Runtime&) = delete;
+  L3Runtime& operator=(const L3Runtime&) = delete;
+
+  // Accepts a full L3W1 document. Returns false (leaving the previous state
+  // untouched) when the document is malformed, fails its signature gate or
+  // violates the launch consistency gate, or when the runtime was already
+  // initialized.
+  //
+  // now_unix <= 0 skips the freshness window (the digest and the consistency
+  // gate still apply). A renderer passes 0 because the browser already judged
+  // freshness against its own clock before forwarding the document.
+  bool Init(std::string_view wire, int64_t now_unix, int64_t max_age_seconds);
+
+  bool ready() const { return ready_; }
+
+  // Pinned localStorage entries for the origin, in parse order; nullptr when
+  // the origin has none.
+  const std::vector<PinnedEntry>* LocalPins(
+      const std::string& origin) const;
+
+  // Pinned sessionStorage entries; nullptr when none.
+  const std::vector<PinnedEntry>* SessionPins(
+      const std::string& origin) const;
+
+  // True when the key is pinned for the origin in either scope.
+  bool IsLocked(const std::string& origin, const std::string& key) const;
+
+  // The pinned value; nullptr when the key is not pinned. An empty string is
+  // a valid pinned value and returns a non-null pointer.
+  const std::string* PinnedValue(const std::string& origin,
+                                 const std::string& key) const;
+
+  // Extension whitelist membership; always false before Init().
+  bool ExtensionAllowed(const std::string& id) const;
+
+ private:
+  bool ready_ = false;
+  StoragePin pins_;
+  // Kept as parallel simple containers: ExtensionPin is not copy-visible and
+  // the whitelist is tiny; ids_ mirrors config.extensions for lookups.
+  std::vector<std::string> extensions_;
+};
+
+// Process-wide access point. The renderer is single-threaded for Blink; Mojo
+// replies land on the same sequence, so no lock is taken (matches how
+// canvas_apply stores its noise seed).
+L3Runtime& GetL3Runtime();
+
+}  // namespace lengsuo::fp
+
+#endif  // LENGSUO_NATIVE_L3_RUNTIME_H_
diff --git a/lengsuo/native/l3_wire.cc b/lengsuo/native/l3_wire.cc
new file mode 100644
index 0000000..865c664
--- /dev/null
+++ b/lengsuo/native/l3_wire.cc
@@ -0,0 +1,298 @@
+#include "l3_wire.h"
+
+#include <string>
+#include <utility>
+
+namespace lengsuo::fp {
+namespace {
+
+// Sequential '\n' reader over the signed body. Every accessor returns false
+// once the body is exhausted, so a short document can never read stale data.
+class BodyReader {
+ public:
+  explicit BodyReader(std::string_view body) : body_(body) {}
+
+  bool Next(std::string_view* line) {
+    if (pos_ >= body_.size()) return false;
+    const std::size_t newline = body_.find('\n', pos_);
+    if (newline == std::string_view::npos) return false;
+    std::string_view text = body_.substr(pos_, newline - pos_);
+    pos_ = newline + 1;
+    if (!text.empty() && text.back() == '\r') text.remove_suffix(1);
+    *line = text;
+    return true;
+  }
+
+  bool AtEnd() const { return pos_ == body_.size(); }
+
+ private:
+  std::string_view body_;
+  std::size_t pos_ = 0;
+};
+
+// "<keyword> <decimal>" with no other content. Zero is accepted: a document
+// may legitimately declare no cookies/extensions/rules, and the encoder emits
+// "cookies 0" / "rules 0" for exactly that case. The pins section is the one
+// exception and is checked by the caller.
+bool ParseCountLine(std::string_view line, std::string_view keyword,
+                    std::size_t* value) {
+  if (line.size() <= keyword.size() + 1 ||
+      line.substr(0, keyword.size()) != keyword ||
+      line[keyword.size()] != ' ') {
+    return false;
+  }
+  std::size_t total = 0;
+  for (const char c : line.substr(keyword.size() + 1)) {
+    if (c < '0' || c > '9') return false;
+    total = total * 10 + static_cast<std::size_t>(c - '0');
+    if (total > 4096) return false;
+  }
+  *value = total;
+  return true;
+}
+
+// Splits on '|' into exactly `count` fields.
+bool SplitFields(std::string_view line, std::size_t count,
+                 std::string* fields) {
+  std::size_t start = 0;
+  for (std::size_t i = 0; i < count; ++i) {
+    const std::size_t bar = line.find('|', start);
+    if (i + 1 == count) {
+      if (bar != std::string_view::npos) return false;
+      fields[i] = std::string(line.substr(start));
+      return true;
+    }
+    if (bar == std::string_view::npos) return false;
+    fields[i] = std::string(line.substr(start, bar - start));
+    start = bar + 1;
+  }
+  return false;
+}
+
+bool SplitSign(std::string_view sign, std::string_view* md5, int64_t* unix) {
+  const std::size_t sep = sign.find("_v1_t");
+  if (sep != 32) return false;
+  const std::string_view digits = sign.substr(37);
+  if (digits.empty()) return false;
+  int64_t value = 0;
+  for (const char c : digits) {
+    if (c < '0' || c > '9') return false;
+    value = value * 10 + (c - '0');
+    if (value > 9007199254740992LL) return false;
+  }
+  *md5 = sign.substr(0, sep);
+  *unix = value;
+  return true;
+}
+
+}  // namespace
+
+bool DecodeL3Wire(std::string_view wire, int64_t now_unix,
+                  int64_t max_age_seconds, L3Config* out, std::string* error) {
+  const auto fail = [error](const char* message) {
+    if (error) *error = message;
+    return false;
+  };
+  if (out == nullptr) return fail("l3: null output");
+  if (wire.empty() || wire.size() > kMaxL3WireBytes) {
+    return fail("l3: empty or oversized document");
+  }
+
+  // The sign line closes the document, so its position also delimits the
+  // signed bytes. A document with no sign line is rejected: integrity is not
+  // optional.
+  const std::size_t sign_start = wire.rfind("\nsign ");
+  if (sign_start == std::string_view::npos) {
+    return fail("l3: missing sign line");
+  }
+  const std::string body(wire.substr(0, sign_start + 1));
+  std::string_view sign_line = wire.substr(sign_start + 1);
+  if (sign_line.size() < 6 || sign_line.back() != '\n') {
+    return fail("l3: sign line must end with a newline");
+  }
+  sign_line.remove_suffix(1);
+  if (!sign_line.empty() && sign_line.back() == '\r') sign_line.remove_suffix(1);
+  const std::string sign_text(sign_line.substr(5));
+
+  BodyReader reader(body);
+  std::string_view line;
+  if (!reader.Next(&line) || line != "L3W1") {
+    return fail("l3: bad magic");
+  }
+
+  L3Config config;
+
+  std::size_t count = 0;
+  if (!reader.Next(&line) || !ParseCountLine(line, "pins", &count) ||
+      count == 0) {
+    // A snapshot with no pins carries no L3 statement at all; treat it as
+    // malformed rather than as a no-op so a truncated document cannot pass.
+    return fail("l3: bad pins header");
+  }
+  std::string pin_wire;
+  for (std::size_t i = 0; i < count; ++i) {
+    if (!reader.Next(&line) || line.empty()) {
+      return fail("l3: truncated pins section");
+    }
+    pin_wire.append(line);
+    pin_wire.push_back('\n');
+  }
+  if (!config.pins.Parse(pin_wire)) {
+    return fail("l3: invalid pin entry");
+  }
+
+  if (!reader.Next(&line) || !ParseCountLine(line, "cookies", &count)) {
+    return fail("l3: bad cookies header");
+  }
+  for (std::size_t i = 0; i < count; ++i) {
+    if (!reader.Next(&line)) return fail("l3: truncated cookies section");
+    std::string fields[3];
+    if (!SplitFields(line, 3, fields) || fields[1].empty()) {
+      return fail("l3: invalid cookie entry");
+    }
+    config.cookies.push_back(
+        CookieFact{fields[0], fields[1], fields[2]});
+  }
+
+  if (!reader.Next(&line) || !ParseCountLine(line, "ext", &count)) {
+    return fail("l3: bad ext header");
+  }
+  for (std::size_t i = 0; i < count; ++i) {
+    if (!reader.Next(&line)) return fail("l3: truncated ext section");
+    if (!config.extensions.Add(std::string(line))) {
+      return fail("l3: invalid extension id");
+    }
+  }
+
+  if (!reader.Next(&line) || !ParseCountLine(line, "rules", &count)) {
+    return fail("l3: bad rules header");
+  }
+  for (std::size_t i = 0; i < count; ++i) {
+    if (!reader.Next(&line)) return fail("l3: truncated rules section");
+    std::string fields[4];
+    if (!SplitFields(line, 4, fields) || fields[1].empty() ||
+        fields[3].empty()) {
+      return fail("l3: invalid rule entry");
+    }
+    config.rules.push_back(ConsistencyRule{fields[0], fields[1], fields[2],
+                                           fields[3]});
+  }
+
+  if (!reader.AtEnd()) {
+    return fail("l3: unexpected content before sign");
+  }
+
+  // Integrity before freshness (cache_record order). now_unix <= 0 means the
+  // caller has already judged freshness elsewhere (the renderer path): the
+  // digest is still verified, only the age window is skipped.
+  const bool check_freshness = now_unix > 0;
+  if (check_freshness) {
+    if (VerifySign(sign_text, body, now_unix, max_age_seconds) !=
+        SignVerdict::kOk) {
+      return fail("l3: sign verification failed");
+    }
+  } else {
+    // Digest-only check. Verifying against the timestamp the document itself
+    // carries makes the age window vacuous (max_age covers the gap to now)
+    // while the MD5 still has to match the body byte for byte.
+    std::string digest;
+    int64_t timestamp = 0;
+    if (!ParseSignFields(sign_text, &digest, &timestamp)) {
+      return fail("l3: bad sign fields");
+    }
+    if (VerifySign(sign_text, body, timestamp,
+                   /*max_age_seconds=*/0) != SignVerdict::kOk) {
+      return fail("l3: sign verification failed");
+    }
+  }
+  std::string_view md5;
+  if (!SplitSign(sign_text, &md5, &config.signed_unix)) {
+    return fail("l3: bad sign fields");
+  }
+  config.sign = sign_text;
+
+  // Launch gate: a snapshot that would fail the platform's own cross-check
+  // must never be applied, otherwise the first navigation disagrees with
+  // itself.
+  if (!L3SnapshotConsistent(config)) {
+    return fail("l3: pinned snapshot is internally inconsistent");
+  }
+
+  *out = std::move(config);
+  if (error) error->clear();
+  return true;
+}
+
+bool L3SnapshotConsistent(const L3Config& config) {
+  return CheckConsistency(config.cookies, CollectStorageFacts(config.pins),
+                          config.rules)
+      .empty();
+}
+
+std::vector<StorageFact> CollectStorageFacts(const StoragePin& pins) {
+  std::vector<StorageFact> facts;
+  for (const DomainPin& domain : pins.Domains()) {
+    for (const PinnedEntry& entry : domain.local_storage) {
+      facts.push_back(StorageFact{domain.origin, entry.key, entry.value});
+    }
+    for (const PinnedEntry& entry : domain.session_storage) {
+      facts.push_back(StorageFact{domain.origin, entry.key, entry.value});
+    }
+  }
+  return facts;
+}
+
+std::string EncodePinWire(const StoragePin& pins) {
+  std::string wire;
+  for (const DomainPin& domain : pins.Domains()) {
+    for (const std::vector<PinnedEntry>* area :
+         {&domain.local_storage, &domain.session_storage}) {
+      const char* scope = area == &domain.local_storage ? "local" : "session";
+      for (const PinnedEntry& entry : *area) {
+        wire += domain.origin;
+        wire += '|';
+        wire += scope;
+        wire += '|';
+        wire += entry.key;
+        wire += '|';
+        wire += entry.value;
+        wire += '\n';
+      }
+    }
+  }
+  return wire;
+}
+
+std::string EncodeL3Wire(const L3Config& config, int64_t unix_seconds) {
+  const std::string pin_wire = EncodePinWire(config.pins);
+  std::size_t pin_count = 0;
+  if (!pin_wire.empty()) {
+    pin_count = 1;
+    for (const char c : pin_wire) {
+      if (c == '\n') ++pin_count;
+    }
+    --pin_count;
+  }
+
+  std::string body = "L3W1\n";
+  body += "pins " + std::to_string(pin_count) + "\n";
+  body += pin_wire;
+  body += "cookies " + std::to_string(config.cookies.size()) + "\n";
+  for (const CookieFact& fact : config.cookies) {
+    body += fact.domain + '|' + fact.name + '|' + fact.value + '\n';
+  }
+  body += "ext " + std::to_string(config.extensions.size()) + "\n";
+  // Parse() keeps a std::set, so iteration is already sorted.
+  for (const std::string& id : config.extensions.Ids()) {
+    body += id + '\n';
+  }
+  body += "rules " + std::to_string(config.rules.size()) + "\n";
+  for (const ConsistencyRule& rule : config.rules) {
+    body += rule.cookie_domain + '|' + rule.cookie_name + '|' +
+            rule.storage_origin + '|' + rule.storage_key + '\n';
+  }
+  const std::string sign = MakeSign(body, unix_seconds);
+  return body + "sign " + sign + "\n";
+}
+
+}  // namespace lengsuo::fp
diff --git a/lengsuo/native/l3_wire.h b/lengsuo/native/l3_wire.h
new file mode 100644
index 0000000..9ef1197
--- /dev/null
+++ b/lengsuo/native/l3_wire.h
@@ -0,0 +1,96 @@
+// l3_wire - the managed L3 configuration document (L3W1).
+//
+// This is the single input that drives the whole storage layer: which
+// key/value pairs are pinned per origin, which extensions must travel with the
+// environment, and which cookie/localStorage pairs are declared to be mirrors
+// of each other. It is decoded in the browser process and never in a renderer
+// that could also read arbitrary profile files.
+//
+// Grammar (ASCII, '\n' separated, bounded to kMaxWireBytes):
+//
+//   L3W1
+//   pins <n>
+//   <origin>|<scope>|<key>|<value>          exactly n lines
+//   cookies <n>
+//   <domain>|<name>|<value>                 exactly n lines
+//   ext <n>
+//   <32 x [a-p]>                            exactly n lines
+//   rules <n>
+//   <cookie_domain>|<cookie_name>|<storage_origin>|<storage_key>
+//                                           exactly n lines
+//   sign <md5hex>_v1_t<unix>
+//
+// A final "\r\n" or "\n" is accepted; nothing may follow the sign line.
+//
+// The sign covers the exact bytes of the document *before* the "sign " line,
+// so field content can never be re-ordered or re-encoded without detection.
+// Freshness uses cache_record::VerifySign semantics: integrity before age.
+//
+// Decoding is fail-closed and transactional: on any error `*out` is untouched.
+// In addition the decoded snapshot must be internally consistent - every
+// declared rule linking a cookie to a pinned storage key has to agree with the
+// pinned value or the whole document is rejected. This is what stops a
+// half-updated environment from being launched.
+#ifndef LENGSUO_NATIVE_L3_WIRE_H_
+#define LENGSUO_NATIVE_L3_WIRE_H_
+
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "cache_record.h"
+#include "extension_pin.h"
+#include "storage_consistency.h"
+#include "storage_pin.h"
+
+namespace lengsuo::fp {
+
+inline constexpr std::size_t kMaxL3WireBytes = 64 * 1024;
+
+struct L3Config {
+  StoragePin pins;
+  ExtensionPin extensions;
+  std::vector<ConsistencyRule> rules;
+  // Cookie facts declared by the document; they are consistency *inputs*
+  // (what the environment's cookie jar is expected to contain), not live
+  // cookie-jar state.
+  std::vector<CookieFact> cookies;
+  std::string sign;
+  int64_t signed_unix = 0;
+};
+
+// True when every rule agrees with the pinned values and declared cookies.
+bool L3SnapshotConsistent(const L3Config& config);
+
+// Flattens the pin table into storage facts (consistency check input).
+std::vector<StorageFact> CollectStorageFacts(const StoragePin& pins);
+
+// Serializes the document back to the canonical wire form. Field order is
+// pins, cookies, ext, rules; counts are re-derived, and the sign is
+// recomputed over the produced body. Round-trips: decoding the output yields
+// an equal L3Config (extensions sorted, pin/rule order preserved).
+std::string EncodeL3Wire(const L3Config& config, int64_t unix_seconds);
+
+// `now_unix` / `max_age_seconds` drive the anti-rollback check on the sign.
+// Returns false and sets `*error` (when non-null) on any failure.
+//
+// Passing now_unix <= 0 skips the freshness window: the signature digest and
+// the launch consistency gate still apply, but the timestamp is accepted
+// whatever it is. A renderer uses that, because the browser already judged
+// freshness against its own clock before forwarding the document and a
+// renderer must not re-judge it against a clock it does not control.
+bool DecodeL3Wire(std::string_view wire,
+                  int64_t now_unix,
+                  int64_t max_age_seconds,
+                  L3Config* out,
+                  std::string* error);
+
+// Normalizes a decoded pin table back to the renderer-facing
+// "<origin>|<scope>|<key>|<value>\n" wire. Entries are emitted in parse order,
+// so EncodePinWire followed by StoragePin::Parse round-trips byte for byte.
+std::string EncodePinWire(const StoragePin& pins);
+
+}  // namespace lengsuo::fp
+
+#endif  // LENGSUO_NATIVE_L3_WIRE_H_
diff --git a/lengsuo/native/machine_facts.cc b/lengsuo/native/machine_facts.cc
new file mode 100644
index 0000000..263a268
--- /dev/null
+++ b/lengsuo/native/machine_facts.cc
@@ -0,0 +1,103 @@
+#include "machine_facts.h"
+
+#include <algorithm>
+#include <utility>
+
+namespace lengsuo::fp {
+namespace {
+
+bool IsAsciiSpace(char c) {
+  return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\v' ||
+         c == '\f';
+}
+
+// Little endian, the byte order of the Windows structures this reads.
+std::uint32_t ReadU32Le(const std::uint8_t* buffer) {
+  return static_cast<std::uint32_t>(buffer[0]) |
+         (static_cast<std::uint32_t>(buffer[1]) << 8) |
+         (static_cast<std::uint32_t>(buffer[2]) << 16) |
+         (static_cast<std::uint32_t>(buffer[3]) << 24);
+}
+
+}  // namespace
+
+std::string TrimAscii(std::string_view text) {
+  std::size_t begin = 0;
+  std::size_t end = text.size();
+  while (begin < end && IsAsciiSpace(text[begin])) {
+    ++begin;
+  }
+  while (end > begin && IsAsciiSpace(text[end - 1])) {
+    --end;
+  }
+  return std::string(text.substr(begin, end - begin));
+}
+
+std::string PlatformOsTag(Platform platform) {
+  switch (platform) {
+    case Platform::kWindows:
+      return "windows";
+    case Platform::kMacos:
+      return "macos";
+    case Platform::kLinux:
+      return "linux";
+    case Platform::kOther:
+      // A platform neither side supports: the empty tag makes the two
+      // machine codes differ, which is the fail-closed outcome.
+      return std::string();
+  }
+  return std::string();
+}
+
+std::string SelectStorageSerial(const std::vector<std::string>& candidates) {
+  std::vector<std::string> usable;
+  usable.reserve(candidates.size());
+  for (const std::string& candidate : candidates) {
+    std::string trimmed = TrimAscii(candidate);
+    if (!trimmed.empty()) {
+      usable.push_back(std::move(trimmed));
+    }
+  }
+  if (usable.empty()) {
+    return std::string();
+  }
+  std::sort(usable.begin(), usable.end());
+  return usable.front();
+}
+
+bool ParseStorageDescriptorSize(const std::uint8_t* buffer,
+                                std::size_t size,
+                                std::uint32_t* size_out) {
+  if (buffer == nullptr || size_out == nullptr ||
+      size < kStorageDescriptorSizeOffset + sizeof(std::uint32_t)) {
+    return false;
+  }
+  *size_out = ReadU32Le(buffer + kStorageDescriptorSizeOffset);
+  return true;
+}
+
+std::string ParseStorageDescriptorSerial(const std::uint8_t* buffer,
+                                         std::size_t size) {
+  if (buffer == nullptr ||
+      size < kStorageDescriptorSerialNumberFieldOffset + sizeof(std::uint32_t)) {
+    return std::string();
+  }
+  // The field is a DWORD byte offset into the descriptor, not a pointer.
+  const std::uint32_t offset =
+      ReadU32Le(buffer + kStorageDescriptorSerialNumberFieldOffset);
+  if (offset == 0 || offset >= size) {
+    // 0 means the driver has no serial to report; an offset past the end
+    // means the descriptor was cut short.
+    return std::string();
+  }
+  const char* text =
+      reinterpret_cast<const char*>(buffer + offset);
+  const std::size_t available = size - offset;
+  std::size_t length = 0;
+  while (length < available && text[length] != '\0') {
+    ++length;
+  }
+  return TrimAscii(std::string_view(text, length));
+}
+
+}  // namespace lengsuo::fp
diff --git a/lengsuo/native/machine_facts.h b/lengsuo/native/machine_facts.h
new file mode 100644
index 0000000..a5beb6e
--- /dev/null
+++ b/lengsuo/native/machine_facts.h
@@ -0,0 +1,120 @@
+// machine_facts - the collection rules for the kernel's four machine facts
+// (task M0).
+//
+// The wire contract fixes the *shape* of the machine code (four fields, one
+// key order) but not what each field holds. Task M0 pins the values: the
+// kernel side and the client side must collect the same four values on the
+// same machine, or the two sides derive different machine keys and the
+// handshake fails closed.
+//
+// The rules live here, apart from the Chromium-bound collector in
+// integration/kernel_pipe_client.cc, because they are pure: given a set of
+// candidates they say which one wins. That is what makes them testable
+// without a machine - the tests feed them fake data.
+//
+// The rule table (four fields, two platforms). Both repos implement this
+// table word for word; a cell that cannot be filled stays empty, and an
+// empty cell makes the two sides' machine codes differ, which is the
+// fail-closed outcome.
+//
+//   field          Windows                          POSIX
+//   -------------  ------------------------------  ------------------------------
+//   os             "windows"                        "linux" / "macos"
+//   cpuid          base::CPU vendor/family/model/    the same
+//                  stepping                         base::CPU shape
+//   hddid          the serial number of             scan
+//                  \\.\PhysicalDrive0               /sys/block/*/device/serial,
+//                  (trimmed)                        trimmed, sorted, first
+//   computername   GetComputerNameW                 gethostname()
+#ifndef LENGSUO_NATIVE_MACHINE_FACTS_H_
+#define LENGSUO_NATIVE_MACHINE_FACTS_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace lengsuo::fp {
+
+// The platforms the two repositories support.
+//
+// The platform is an argument rather than a compile-time constant so the
+// mapping of every cell is testable from any host: the test asks for each
+// platform and gets the tag the rule table names.
+enum class Platform {
+  kWindows,
+  kMacos,
+  kLinux,
+  // A platform neither side supports.
+  kOther,
+};
+
+// The platform tag: "windows", "macos" or "linux".
+//
+// Lower case, no version: the tag says which *kind* of machine this is, so
+// every machine of a kind agrees on it. A version would change the machine
+// code when the browser is patched, and every key already bound would stop
+// opening.
+//
+// kOther returns the empty string: the machine code then differs from the
+// runner's expectation and the handshake fails, which is the fail-closed
+// outcome. (The client side uses the same three-value mapping; it is not
+// Rust's OS name, which would differ on a platform the two repos do not
+// support.)
+std::string PlatformOsTag(Platform platform);
+
+// Picks the storage serial number out of the candidates.
+//
+// The rule is the client's, copied word for word: trim each candidate, drop
+// the empty ones, sort what is left byte by byte, take the first.
+//
+// The sort is what makes the choice the same on a multi-disk machine. The
+// directory order is not the same on both sides, so "the first one that
+// answers" would pick two different disks.
+std::string SelectStorageSerial(const std::vector<std::string>& candidates);
+
+// The offset of the Size field inside STORAGE_DEVICE_DESCRIPTOR. It is a
+// DWORD (STORAGE_DEVICE_DESCRIPTOR: Version, Size, DeviceType, ...).
+inline constexpr std::size_t kStorageDescriptorSizeOffset = 4;
+
+// The offset of the SerialNumberOffset field inside
+// STORAGE_DEVICE_DESCRIPTOR. It is a DWORD, not a byte: the header is
+// Version, Size, DeviceType, DeviceTypeModifier, RemovableMedia,
+// CommandQueueing, VendorIdOffset, ProductIdOffset, ProductRevisionOffset,
+// SerialNumberOffset, BusType, RawPropertiesLength.
+//
+// integration/kernel_pipe_client.cc static_asserts both offsets against
+// the real Windows struct, so a platform whose header disagrees fails the
+// build instead of reading the wrong four bytes.
+inline constexpr std::size_t kStorageDescriptorSerialNumberFieldOffset = 24;
+
+// Reads the Size field of a storage descriptor header.
+//
+// The Windows driver answers a storage-property query with success even when
+// the buffer is too small: it writes the real size into the header instead
+// of failing with ERROR_INSUFFICIENT_BUFFER. So the collector asks with a
+// small buffer, reads the size here, and asks again with a buffer of that
+// size.
+bool ParseStorageDescriptorSize(const std::uint8_t* buffer,
+                                std::size_t size,
+                                std::uint32_t* size_out);
+
+// Reads the serial number out of a storage descriptor.
+//
+// The descriptor carries the serial as a NUL terminated string at the offset
+// the header names; the offset is a position in the buffer, not an address.
+// The driver pads the serial with leading spaces, so the value is trimmed
+// before it is used.
+//
+// A descriptor with no serial, an offset that points outside the buffer, and
+// a truncated buffer all yield the empty string.
+std::string ParseStorageDescriptorSerial(const std::uint8_t* buffer,
+                                         std::size_t size);
+
+// Trims ASCII whitespace off both ends.
+std::string TrimAscii(std::string_view text);
+
+}  // namespace lengsuo::fp
+
+#endif  // LENGSUO_NATIVE_MACHINE_FACTS_H_
diff --git a/lengsuo/native/machine_facts_test.cc b/lengsuo/native/machine_facts_test.cc
new file mode 100644
index 0000000..9aeaae6
--- /dev/null
+++ b/lengsuo/native/machine_facts_test.cc
@@ -0,0 +1,317 @@
+// machine_facts_test - the machine-fact collection rules (task M0).
+//
+// The point of this file is that it runs on Linux CI while testing the
+// Windows path too: the collector in integration/kernel_pipe_client.cc is
+// split into "ask the device" (compiled only on Windows) and "parse the
+// answer" (here, pure). The Windows descriptor below is a synthetic
+// 396-byte buffer shaped like the one the driver actually returns on the
+// research machine, so the three defects task M0 lists are each pinned by a
+// case that fails if the defect comes back.
+//
+// The rule vectors at the bottom are the cross-repo agreement: the client
+// repo hardcodes the same seven values per row, and
+// tools/cross_repo_machine.py refuses to pass unless both sides agree and
+// the digests recompute from the four fields.
+#include "machine_facts.h"
+
+#include <gtest/gtest.h>
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <string>
+
+#include "kernel_pipe_keys.h"
+#include "kernel_pipe_test_util.h"
+
+namespace lengsuo::fp {
+namespace {
+namespace test_util = ::lengsuo::fp::test;
+
+void WriteU32Le(std::uint8_t* out, std::uint32_t value) {
+  out[0] = static_cast<std::uint8_t>(value & 0xFF);
+  out[1] = static_cast<std::uint8_t>((value >> 8) & 0xFF);
+  out[2] = static_cast<std::uint8_t>((value >> 16) & 0xFF);
+  out[3] = static_cast<std::uint8_t>((value >> 24) & 0xFF);
+}
+
+// --- the os cell ---------------------------------------------------------
+//
+// The tag is the platform *kind*, not the platform version: a patch release
+// must not change the machine code, or every key already bound stops
+// opening (R2).
+
+TEST(MachineFacts, OsTagIsTheLowerCasePlatformWithoutVersion) {
+  EXPECT_EQ(PlatformOsTag(Platform::kWindows), "windows");
+  EXPECT_EQ(PlatformOsTag(Platform::kMacos), "macos");
+  EXPECT_EQ(PlatformOsTag(Platform::kLinux), "linux");
+  // A platform neither side supports gets no tag: the two sides then
+  // disagree, which is the fail-closed outcome.
+  EXPECT_EQ(PlatformOsTag(Platform::kOther), "");
+}
+
+TEST(MachineFacts, OsTagCarriesNoSpaceAndNoVersion) {
+  for (const Platform platform : {Platform::kWindows, Platform::kMacos,
+                                 Platform::kLinux}) {
+    const std::string tag = PlatformOsTag(platform);
+    EXPECT_EQ(tag.find(' '), std::string::npos) << tag;
+    EXPECT_EQ(tag.find('.'), std::string::npos) << tag;
+    for (const char c : tag) {
+      EXPECT_TRUE(c >= 'a' && c <= 'z') << "not lower case: " << tag;
+    }
+  }
+}
+
+// --- the hddid cell, POSIX side -----------------------------------------
+//
+// The rule is the client's, word for word: trim, drop the empty ones, sort,
+// take the first. The sort is the part that matters on a multi-disk
+// machine: the directory order differs between the two sides, so "the first
+// one that answers" would pick two different disks (R1).
+
+TEST(MachineFacts, StorageSerialSortsAndTakesTheFirst) {
+  EXPECT_EQ(SelectStorageSerial({"SERIAL-B", "SERIAL-A", "SERIAL-C"}),
+            "SERIAL-A");
+  // The order the candidates arrive in does not matter.
+  EXPECT_EQ(SelectStorageSerial({"SERIAL-C", "SERIAL-A", "SERIAL-B"}),
+            "SERIAL-A");
+}
+
+TEST(MachineFacts, StorageSerialTrimsBeforeChoosing) {
+  // "/sys/block/*/device/serial" files end in a newline.
+  EXPECT_EQ(SelectStorageSerial({"  SERIAL-A\n"}), "SERIAL-A");
+  EXPECT_EQ(SelectStorageSerial({" \tSERIAL-A \r\n"}), "SERIAL-A");
+  // Trimming happens before the sort, so the space does not decide it.
+  EXPECT_EQ(SelectStorageSerial({" SERIAL-B", "SERIAL-A"}), "SERIAL-A");
+}
+
+TEST(MachineFacts, StorageSerialDropsEmptyCandidates) {
+  EXPECT_EQ(SelectStorageSerial({"", "   ", "\n", "SERIAL-A"}), "SERIAL-A");
+}
+
+TEST(MachineFacts, StorageSerialIsEmptyWhenNothingUsable) {
+  // Constraint 5: a value that cannot be obtained is the empty string, not
+  // an invented one. Empty makes the two sides disagree, which is the
+  // fail-closed outcome.
+  EXPECT_EQ(SelectStorageSerial({}), "");
+  EXPECT_EQ(SelectStorageSerial({"", " ", "\t\r\n"}), "");
+}
+
+TEST(MachineFacts, StorageSerialComparesBytesNotCase) {
+  // Sorting is byte-wise, as the client's `Vec<String>::sort` is. This is
+  // not a locale-aware comparison.
+  EXPECT_EQ(SelectStorageSerial({"a", "B", "A"}), "A");
+}
+
+// --- the hddid cell, Windows side ---------------------------------------
+//
+// A descriptor shaped like the one the driver returns on the research
+// machine: 396 bytes, the serial at offset 90, and the driver's leading
+// spaces. The header fields are at the offsets the Windows struct pins.
+
+constexpr std::size_t kRealDescriptorSize = 396;
+constexpr std::uint32_t kRealSerialOffset = 90;
+// Exactly what the research machine's driver returned, spaces included.
+constexpr char kRealSerialWithPadding[] = "        154310E1E661";
+
+std::array<std::uint8_t, kRealDescriptorSize> RealShapedDescriptor() {
+  std::array<std::uint8_t, kRealDescriptorSize> buffer{};
+  WriteU32Le(buffer.data() + kStorageDescriptorSizeOffset,
+             static_cast<std::uint32_t>(kRealDescriptorSize));
+  WriteU32Le(buffer.data() + kStorageDescriptorSerialNumberFieldOffset,
+             kRealSerialOffset);
+  const std::size_t length = sizeof(kRealSerialWithPadding) - 1;
+  for (std::size_t i = 0; i < length; ++i) {
+    buffer[kRealSerialOffset + i] =
+        static_cast<std::uint8_t>(kRealSerialWithPadding[i]);
+  }
+  return buffer;
+}
+
+TEST(MachineFacts, DescriptorOffsetsMatchTheWindowsStruct) {
+  // These are the two offsets the reader depends on. If a Windows SDK puts
+  // the fields elsewhere, this fails here as well as in the static_assert in
+  // integration/kernel_pipe_client.cc.
+  EXPECT_EQ(kStorageDescriptorSizeOffset, 4u);
+  EXPECT_EQ(kStorageDescriptorSerialNumberFieldOffset, 24u);
+}
+
+TEST(MachineFacts, DescriptorSizeIsReadBack) {
+  const auto buffer = RealShapedDescriptor();
+  std::uint32_t size = 0;
+  ASSERT_TRUE(ParseStorageDescriptorSize(buffer.data(), buffer.size(), &size));
+  EXPECT_EQ(size, kRealDescriptorSize);
+}
+
+TEST(MachineFacts, DescriptorSizeRejectsATruncatedHeader) {
+  std::array<std::uint8_t, 7> buffer{};
+  std::uint32_t size = 0;
+  EXPECT_FALSE(ParseStorageDescriptorSize(buffer.data(), buffer.size(), &size));
+  EXPECT_FALSE(ParseStorageDescriptorSize(nullptr, 16, &size));
+  EXPECT_FALSE(
+      ParseStorageDescriptorSize(buffer.data(), buffer.size(), nullptr));
+}
+
+TEST(MachineFacts, DescriptorSerialIsReadAtTheOffsetAndTrimmed) {
+  // Defects 2 and 3 together: the serial is at byte offset 90, which is
+  // outside the 36-byte header, and the field names an offset, not an
+  // address. The driver's leading spaces are trimmed.
+  const auto buffer = RealShapedDescriptor();
+  EXPECT_EQ(ParseStorageDescriptorSerial(buffer.data(), buffer.size()),
+            "154310E1E661");
+}
+
+TEST(MachineFacts, DescriptorSerialOffsetIsA32BitValue) {
+  // The offset field is a DWORD. An offset past 255 would be read as a
+  // different value if the field were read as a byte, so this descriptor
+  // uses one that does not fit in a byte.
+  std::array<std::uint8_t, 512> buffer{};
+  constexpr std::uint32_t kOffset = 300;
+  WriteU32Le(buffer.data() + kStorageDescriptorSizeOffset, 512);
+  WriteU32Le(buffer.data() + kStorageDescriptorSerialNumberFieldOffset,
+             kOffset);
+  const std::string serial = "SERIAL-PAST-255";
+  for (std::size_t i = 0; i < serial.size(); ++i) {
+    buffer[kOffset + i] = static_cast<std::uint8_t>(serial[i]);
+  }
+  EXPECT_EQ(ParseStorageDescriptorSerial(buffer.data(), buffer.size()),
+            "SERIAL-PAST-255");
+}
+
+TEST(MachineFacts, DescriptorSerialTrailingSpaceIsTrimmedToo) {
+  auto buffer = RealShapedDescriptor();
+  std::fill(buffer.begin() + kRealSerialOffset, buffer.end(), 0);
+  const std::string padded = "154310E1E661   ";
+  for (std::size_t i = 0; i < padded.size(); ++i) {
+    buffer[kRealSerialOffset + i] =
+        static_cast<std::uint8_t>(padded[i]);
+  }
+  EXPECT_EQ(ParseStorageDescriptorSerial(buffer.data(), buffer.size()),
+            "154310E1E661");
+}
+
+TEST(MachineFacts, DescriptorSerialIsEmptyWhenTheDriverHasNone) {
+  auto buffer = RealShapedDescriptor();
+  WriteU32Le(buffer.data() + kStorageDescriptorSerialNumberFieldOffset, 0);
+  EXPECT_EQ(ParseStorageDescriptorSerial(buffer.data(), buffer.size()), "");
+}
+
+TEST(MachineFacts, DescriptorSerialIsEmptyWhenTheOffsetFallsOutside) {
+  auto buffer = RealShapedDescriptor();
+  WriteU32Le(buffer.data() + kStorageDescriptorSerialNumberFieldOffset,
+             static_cast<std::uint32_t>(kRealDescriptorSize));
+  EXPECT_EQ(ParseStorageDescriptorSerial(buffer.data(), buffer.size()), "");
+  WriteU32Le(buffer.data() + kStorageDescriptorSerialNumberFieldOffset, 0xFFFF);
+  EXPECT_EQ(ParseStorageDescriptorSerial(buffer.data(), buffer.size()), "");
+}
+
+TEST(MachineFacts, DescriptorSerialIsEmptyWhenTheHeaderIsTruncated) {
+  std::array<std::uint8_t, 16> buffer{};
+  WriteU32Le(buffer.data() + kStorageDescriptorSizeOffset, 16);
+  EXPECT_EQ(ParseStorageDescriptorSerial(buffer.data(), buffer.size()), "");
+  EXPECT_EQ(ParseStorageDescriptorSerial(nullptr, 396), "");
+}
+
+TEST(MachineFacts, DescriptorSerialMayRunToTheEndWithoutANul) {
+  // The driver does not always NUL terminate inside the buffer.
+  std::array<std::uint8_t, 128> buffer{};
+  WriteU32Le(buffer.data() + kStorageDescriptorSerialNumberFieldOffset, 100);
+  const std::string serial = "SERIAL-NO-NUL";
+  for (std::size_t i = 0; i < serial.size(); ++i) {
+    buffer[100 + i] = static_cast<std::uint8_t>(serial[i]);
+  }
+  EXPECT_EQ(ParseStorageDescriptorSerial(buffer.data(), buffer.size()),
+            "SERIAL-NO-NUL");
+}
+
+TEST(MachineFacts, DescriptorSerialOfOnlySpacesIsEmpty) {
+  std::array<std::uint8_t, 128> buffer{};
+  WriteU32Le(buffer.data() + kStorageDescriptorSerialNumberFieldOffset, 100);
+  for (std::size_t i = 100; i < buffer.size(); ++i) {
+    buffer[i] = ' ';
+  }
+  EXPECT_EQ(ParseStorageDescriptorSerial(buffer.data(), buffer.size()), "");
+}
+
+// --- the cross-repo rule vectors ----------------------------------------
+//
+// Each row is a machine the two repositories must agree on, expressed as
+// the four facts plus the two digests derived from them. The values are
+// fake (constraint 7: never commit a real serial number or host name), and
+// the digests are computed, not copied from a live machine.
+//
+// The same seven values per row live in the client repo's rule-vector
+// table; tools/cross_repo_machine.py compares the two and refuses to pass
+// if they disagree. Keeping these in the test is what makes the agreement
+// checkable rather than a matter of someone reading two files side by side.
+
+struct RuleVector {
+  const char* label;
+  const char* os;
+  const char* cpuid;
+  const char* hddid;
+  const char* computername;
+  const char* machine_code;
+  const char* k_machine;
+};
+
+// @@begin machine-facts-vectors
+inline constexpr RuleVector kRuleVectors[] = {
+    {"linux-demo", "linux", "GenuineIntel/6/183/1", "DEMO-SERIAL-0001",
+     "demo-host",
+     "a64a48e92bef5ce24a4c3982bf33ea210a2dd5d0ad4fa5f23dc0172e7ee1409c",
+     "a917d3ac761be29fcea63dc80fadd30586ee21250ea3ea56e31f5b39f47f04ec"},
+    {"windows-demo", "windows", "AuthenticAMD/25/33/0", "DEMO-SERIAL-0002",
+     "demo-win",
+     "550635314afdee4c9b6b07370c2f6b0760b5dd6bc39cae6741645a46e8fa0891",
+     "d401aa6686460d0cd36059fa0a1a05afd876414a8b4c632694e9d829e4ce5f95"},
+    // macOS has no portable serial source, so the cell is empty on both
+    // sides. Empty is the rule, not a bug: see report.md.
+    {"macos-demo", "macos", "Apple/0/0/0", "", "demo-mac",
+     "38ac35734aedf6623c2c30c4513dbffd08f54e3442af7a51a75a5b8ad68024de",
+     "cde8543cfbfde4028579b96b39ee34cdd7bc2ca612c3c3b7eb67388014ceab3f"},
+    // Every cell empty: the shape is still the four keys in order, and the
+    // digests are still defined.
+    {"empty-demo", "", "", "", "",
+     "c93a0514938359dddef7414908ff15348d058d8fed1cd0a238bd2e72357d065c",
+     "0aea56c49b250fecbfe6c5cb4099987572519e5da82620eaf743be882815e684"},
+};
+// @@end machine-facts-vectors
+
+TEST(MachineFacts, RuleVectorMachineCodesRecompute) {
+  for (const RuleVector& vector : kRuleVectors) {
+    MachineFacts facts;
+    facts.os = vector.os;
+    facts.cpuid = vector.cpuid;
+    facts.hddid = vector.hddid;
+    facts.computername = vector.computername;
+    EXPECT_EQ(DeriveMachineCode(facts), vector.machine_code)
+        << "rule vector " << vector.label;
+  }
+}
+
+TEST(MachineFacts, RuleVectorMachineKeysRecompute) {
+  for (const RuleVector& vector : kRuleVectors) {
+    std::string key;
+    ASSERT_TRUE(DeriveMachineKey(vector.machine_code, &key))
+        << "rule vector " << vector.label;
+    EXPECT_EQ(test_util::BytesToHex(key), vector.k_machine)
+        << "rule vector " << vector.label;
+  }
+}
+
+TEST(MachineFacts, RuleVectorsCoverEveryPlatformTag) {
+  // The eight-cell table has one `os` cell per platform save the ones the
+  // client cannot produce; the vector group must exercise all three tags
+  // plus the empty row, or a platform's cell could drift unnoticed.
+  for (const char* tag : {"linux", "windows", "macos", ""}) {
+    bool found = false;
+    for (const RuleVector& vector : kRuleVectors) {
+      found = found || std::string(vector.os) == tag;
+    }
+    EXPECT_TRUE(found) << "no rule vector for os=\"" << tag << "\"";
+  }
+}
+
+}  // namespace
+}  // namespace lengsuo::fp
diff --git a/lengsuo/native/policy_block.cc b/lengsuo/native/policy_block.cc
new file mode 100644
index 0000000..f4a37fb
--- /dev/null
+++ b/lengsuo/native/policy_block.cc
@@ -0,0 +1,187 @@
+#include "policy_block.h"
+
+#include <cctype>
+#include <vector>
+
+namespace lengsuo::fp {
+namespace {
+
+// Compares two strings without regard to case. A scheme is case-insensitive
+// and the caller may hand it in either case.
+bool EqualsIgnoreCase(std::string_view a, std::string_view b) {
+  if (a.size() != b.size()) {
+    return false;
+  }
+  for (std::size_t i = 0; i < a.size(); ++i) {
+    const int left = std::tolower(static_cast<unsigned char>(a[i]));
+    const int right = std::tolower(static_cast<unsigned char>(b[i]));
+    if (left != right) {
+      return false;
+    }
+  }
+  return true;
+}
+
+// The first pattern of the list that matches the URL, or nullptr.
+const std::string* FirstUrlMatch(const std::vector<std::string>& patterns,
+                                 std::string_view url) {
+  for (const std::string& pattern : patterns) {
+    if (MatchUrlPattern(pattern, url)) {
+      return &pattern;
+    }
+  }
+  return nullptr;
+}
+
+// The first pattern of the list that matches the host, or nullptr.
+const std::string* FirstHostMatch(const std::vector<std::string>& patterns,
+                                   std::string_view host) {
+  for (const std::string& pattern : patterns) {
+    if (MatchDomainPattern(pattern, host)) {
+      return &pattern;
+    }
+  }
+  return nullptr;
+}
+
+}  // namespace
+
+PolicyDecision EvaluatePolicy(const AccessPolicy& policy,
+                               const PolicyRequest& request) {
+  PolicyDecision decision;
+
+  // 1. The scheme list stands on its own: a refused scheme is refused
+  //    whatever the URL lists say.
+  for (const std::string& scheme : policy.black_schemes) {
+    if (EqualsIgnoreCase(scheme, request.scheme)) {
+      decision.action = PolicyAction::kCancelRequest;
+      decision.reason = PolicyReason::kSchemeBlocked;
+      decision.matched_rule = &scheme;
+      return decision;
+    }
+  }
+
+  // 2. The exception list overrides the white list and the black list.
+  if (const std::string* hit =
+          FirstUrlMatch(policy.exception_list, request.url)) {
+    decision.reason = PolicyReason::kExceptionMatch;
+    decision.matched_rule = hit;
+    return decision;
+  }
+
+  // 3. The white list allows.
+  if (const std::string* hit = FirstUrlMatch(policy.white_list, request.url)) {
+    decision.reason = PolicyReason::kWhiteListMatch;
+    decision.matched_rule = hit;
+    return decision;
+  }
+
+  // 4. The frame's own lists. The frame kind decides which ones apply.
+  const std::vector<std::string>* frame_black = nullptr;
+  const FramePolicyLists* frame_rules = nullptr;
+  switch (request.frame) {
+    case PolicyFrame::kMainFrame:
+      frame_black = &policy.main_frame_list;
+      frame_rules = &policy.main_frame_rules;
+      break;
+    case PolicyFrame::kSubFrame:
+      frame_black = &policy.sub_frame_black_list;
+      frame_rules = &policy.sub_frame_rules;
+      break;
+  }
+
+  // 5. The frame's white list allows.
+  if (frame_rules != nullptr) {
+    if (const std::string* hit =
+            FirstUrlMatch(frame_rules->white, request.url)) {
+      decision.reason = PolicyReason::kFrameWhiteMatch;
+      decision.matched_rule = hit;
+      return decision;
+    }
+  }
+
+  // 6. The frame's black list refuses. There are two of them: the frame
+  //    kind's own list, and the black list of the frame_black_white_list
+  //    section.
+  if (frame_black != nullptr) {
+    if (const std::string* hit = FirstUrlMatch(*frame_black, request.url)) {
+      decision.action = PolicyAction::kCancelRequest;
+      decision.reason = PolicyReason::kFrameBlackMatch;
+      decision.matched_rule = hit;
+      return decision;
+    }
+  }
+  if (frame_rules != nullptr) {
+    if (const std::string* hit = FirstUrlMatch(frame_rules->black, request.url)) {
+      decision.action = PolicyAction::kCancelRequest;
+      decision.reason = PolicyReason::kFrameBlackMatch;
+      decision.matched_rule = hit;
+      return decision;
+    }
+  }
+
+  // 7. The global black list refuses.
+  if (const std::string* hit = FirstUrlMatch(policy.black_list, request.url)) {
+    decision.action = PolicyAction::kCancelRequest;
+    decision.reason = PolicyReason::kBlackListMatch;
+    decision.matched_rule = hit;
+    return decision;
+  }
+
+  // 8. The domain black list refuses.
+  if (const std::string* hit =
+          FirstHostMatch(policy.domain_black_list, request.host)) {
+    decision.action = PolicyAction::kCancelRequest;
+    decision.reason = PolicyReason::kDomainBlackMatch;
+    decision.matched_rule = hit;
+    return decision;
+  }
+
+  // 9. The domain check list watches. The request still goes out: this list
+  //    says "notice this", not "stop this".
+  if (const std::string* hit =
+          FirstHostMatch(policy.domain_check_list, request.host)) {
+    decision.reason = PolicyReason::kDomainCheckMatch;
+    decision.observed = true;
+    decision.matched_rule = hit;
+    return decision;
+  }
+
+  return decision;
+}
+
+std::string_view PolicyReasonToString(PolicyReason reason) {
+  switch (reason) {
+    case PolicyReason::kNoMatch:
+      return "no_match";
+    case PolicyReason::kSchemeBlocked:
+      return "black_schemes";
+    case PolicyReason::kExceptionMatch:
+      return "exception_list";
+    case PolicyReason::kWhiteListMatch:
+      return "white_list";
+    case PolicyReason::kFrameWhiteMatch:
+      return "frame_black_white_list";
+    case PolicyReason::kFrameBlackMatch:
+      return "frame_black_list";
+    case PolicyReason::kBlackListMatch:
+      return "black_list";
+    case PolicyReason::kDomainBlackMatch:
+      return "domain_black_list";
+    case PolicyReason::kDomainCheckMatch:
+      return "domain_check_list";
+  }
+  return "no_match";
+}
+
+std::string_view PolicyActionToString(PolicyAction action) {
+  switch (action) {
+    case PolicyAction::kSendRequest:
+      return "send";
+    case PolicyAction::kCancelRequest:
+      return "cancel";
+  }
+  return "send";
+}
+
+}  // namespace lengsuo::fp
diff --git a/lengsuo/native/policy_block.h b/lengsuo/native/policy_block.h
new file mode 100644
index 0000000..c32bb53
--- /dev/null
+++ b/lengsuo/native/policy_block.h
@@ -0,0 +1,101 @@
+// policy_block - the interception decision (task T2).
+//
+// The decision is the whole point of the access policy: for one request, is
+// it sent or is it stopped.
+//
+// There are exactly two answers, and there is no third one:
+//
+//   kSendRequest     the request goes out
+//   kCancelRequest   the request does not go out
+//
+// "Does not go out" means the request is cancelled before the transaction
+// starts - no connection, no DNS, no bytes. It never means "send it and
+// withdraw it afterwards", and it never means "answer with an empty
+// response". A request that was stopped leaves the machine the way it came.
+//
+// The order the lists are consulted in is fixed, and it is the same order
+// everywhere:
+//
+//   1. black_schemes      a refused scheme is refused whatever the URL lists
+//                         say. The scheme rule is about the transport, not
+//                         about the address, and no URL pattern rescues it.
+//   2. exception_list     a hit allows. It overrides the white list and the
+//                         black list alike.
+//   3. white_list         a hit allows.
+//   4. the frame's white  a hit allows. The frame's own list is more
+//      list                specific than the global one.
+//   5. the frame's black  a hit refuses.
+//      list
+//   6. black_list         a hit refuses.
+//   7. domain_black_list  a hit refuses.
+//   8. domain_check_list  a hit is watched. The request still goes out; the
+//                         decision says it was noticed.
+//
+// Two rules hold over the whole list: an allow beats a refuse (the white
+// lists are consulted before the black ones), and a rule that cannot be
+// read is not a rule at all - it was dropped when the policy was read.
+//
+// One thing is deliberately absent: an empty response. A page that was
+// blocked gets an error, not a hollow page that looks like it worked.
+#ifndef LENGSUO_NATIVE_POLICY_BLOCK_H_
+#define LENGSUO_NATIVE_POLICY_BLOCK_H_
+
+#include <string>
+#include <string_view>
+
+#include "policy_match.h"
+#include "policy_rules.h"
+
+namespace lengsuo::fp {
+
+// What happens to the request.
+enum class PolicyAction {
+  kSendRequest,
+  kCancelRequest,
+};
+
+// Which list decided.
+enum class PolicyReason {
+  kNoMatch,
+  kSchemeBlocked,
+  kExceptionMatch,
+  kWhiteListMatch,
+  kFrameWhiteMatch,
+  kFrameBlackMatch,
+  kBlackListMatch,
+  kDomainBlackMatch,
+  kDomainCheckMatch,
+};
+
+// The outcome of evaluating the policy for one request.
+struct PolicyDecision {
+  PolicyAction action = PolicyAction::kSendRequest;
+  PolicyReason reason = PolicyReason::kNoMatch;
+  // True when the request was watched rather than refused. Only
+  // domain_check_list sets it, and only it.
+  bool observed = false;
+  // The rule that decided, or nullptr when no rule matched. It points into
+  // the AccessPolicy that was evaluated, so that policy has to outlive the
+  // decision. It is a pointer so that a decision costs no copy of a pattern
+  // on the request path.
+  const std::string* matched_rule = nullptr;
+};
+
+// Decides what happens to one request.
+//
+// The policy is read-only here and the request is read-only here: nothing
+// is changed and nothing is remembered. The decision is the same for the
+// same request and the same policy, every time.
+PolicyDecision EvaluatePolicy(const AccessPolicy& policy,
+                               const PolicyRequest& request);
+
+// The stable name of a reason. These strings go on the wire, so they are
+// part of the contract: they do not change with the wording of a comment.
+std::string_view PolicyReasonToString(PolicyReason reason);
+
+// The stable name of an action.
+std::string_view PolicyActionToString(PolicyAction action);
+
+}  // namespace lengsuo::fp
+
+#endif  // LENGSUO_NATIVE_POLICY_BLOCK_H_
diff --git a/lengsuo/native/policy_block_test.cc b/lengsuo/native/policy_block_test.cc
new file mode 100644
index 0000000..28bbda3
--- /dev/null
+++ b/lengsuo/native/policy_block_test.cc
@@ -0,0 +1,430 @@
+// policy_block_test - the interception decision (T2).
+//
+// The decision is what the whole access policy is for, so the tests here are
+// about the order the lists are consulted in and about the one thing that
+// must not happen: a blocked request must not go out.
+//
+// A blocked request is cancelled, not answered with an empty response. The
+// decision has exactly two outcomes and one of them is "cancel", and the
+// test says so out loud so that a third outcome cannot be added quietly.
+#include "policy_block.h"
+
+#include <gtest/gtest.h>
+
+#include <string>
+
+#include "action_table.h"
+#include "kernel_pipe_json.h"
+#include "policy_report.h"
+
+namespace lengsuo::fp {
+namespace {
+
+// A request for a URL, in the main frame.
+PolicyRequest MainFrame(std::string url, std::string host,
+                         std::string scheme = "https") {
+  PolicyRequest request;
+  request.url = std::move(url);
+  request.host = std::move(host);
+  request.scheme = std::move(scheme);
+  request.frame = PolicyFrame::kMainFrame;
+  return request;
+}
+
+// A policy read out of a configuration bundle.
+AccessPolicy Policy(const std::string& section) {
+  AccessPolicy policy;
+  std::string error;
+  EXPECT_TRUE(ParseAccessPolicy("{\"access_policy\":" + section + "}",
+                                 &policy, &error))
+      << error;
+  return policy;
+}
+
+TEST(PolicyBlock, AnEmptyPolicyLetsEverythingThrough) {
+  const AccessPolicy policy = Policy("{}");
+  const PolicyDecision decision =
+      EvaluatePolicy(policy, MainFrame("https://a.test/x", "a.test"));
+  EXPECT_EQ(decision.action, PolicyAction::kSendRequest);
+  EXPECT_EQ(decision.reason, PolicyReason::kNoMatch);
+  EXPECT_FALSE(decision.observed);
+  EXPECT_EQ(decision.matched_rule, nullptr);
+}
+
+TEST(PolicyBlock, ABlockedRequestIsCancelledAndNotSent) {
+  const AccessPolicy policy = Policy(R"({"black_list":["https://a\\.test/.*"]})");
+  const PolicyDecision decision =
+      EvaluatePolicy(policy, MainFrame("https://a.test/x", "a.test"));
+  // The decision is a cancel, not a send and not a hollow response.
+  EXPECT_EQ(decision.action, PolicyAction::kCancelRequest);
+  EXPECT_EQ(decision.reason, PolicyReason::kBlackListMatch);
+  ASSERT_NE(decision.matched_rule, nullptr);
+  EXPECT_EQ(*decision.matched_rule, "https://a\\.test/.*");
+  // And the cancel is the only other outcome there is.
+  EXPECT_EQ(PolicyActionToString(PolicyAction::kSendRequest), "send");
+  EXPECT_EQ(PolicyActionToString(PolicyAction::kCancelRequest), "cancel");
+}
+
+TEST(PolicyBlock, AWhiteHitAllows) {
+  const AccessPolicy policy = Policy(R"({"white_list":["https://a\\.test/.*"]})");
+  const PolicyDecision decision =
+      EvaluatePolicy(policy, MainFrame("https://a.test/x", "a.test"));
+  EXPECT_EQ(decision.action, PolicyAction::kSendRequest);
+  EXPECT_EQ(decision.reason, PolicyReason::kWhiteListMatch);
+}
+
+TEST(PolicyBlock, AnExceptionBeatsAWhiteHit) {
+  const AccessPolicy policy = Policy(R"({
+    "exception_list": ["https://a\\.test/x"],
+    "white_list": ["https://a\\.test/.*"]
+  })");
+  const PolicyDecision decision =
+      EvaluatePolicy(policy, MainFrame("https://a.test/x", "a.test"));
+  EXPECT_EQ(decision.action, PolicyAction::kSendRequest);
+  EXPECT_EQ(decision.reason, PolicyReason::kExceptionMatch);
+}
+
+TEST(PolicyBlock, AnExceptionBeatsABlackHit) {
+  const AccessPolicy policy = Policy(R"({
+    "exception_list": ["https://a\\.test/x"],
+    "black_list": ["https://a\\.test/.*"]
+  })");
+  const PolicyDecision decision =
+      EvaluatePolicy(policy, MainFrame("https://a.test/x", "a.test"));
+  EXPECT_EQ(decision.action, PolicyAction::kSendRequest);
+  EXPECT_EQ(decision.reason, PolicyReason::kExceptionMatch);
+}
+
+TEST(PolicyBlock, AWhiteHitBeatsABlackHit) {
+  const AccessPolicy policy = Policy(R"({
+    "white_list": ["https://a\\.test/.*"],
+    "black_list": ["https://a\\.test/.*"]
+  })");
+  const PolicyDecision decision =
+      EvaluatePolicy(policy, MainFrame("https://a.test/x", "a.test"));
+  EXPECT_EQ(decision.action, PolicyAction::kSendRequest);
+  EXPECT_EQ(decision.reason, PolicyReason::kWhiteListMatch);
+}
+
+TEST(PolicyBlock, ARefusedSchemeIsRefusedWhateverTheUrlListsSay) {
+  // The scheme rule is about the transport, not about the address: no URL
+  // pattern rescues a refused scheme.
+  const AccessPolicy policy = Policy(R"({
+    "black_schemes": ["file"],
+    "white_list": ["file://.*"],
+    "exception_list": ["file://.*"]
+  })");
+  const PolicyDecision decision =
+      EvaluatePolicy(policy, MainFrame("file:///etc/passwd", "", "file"));
+  EXPECT_EQ(decision.action, PolicyAction::kCancelRequest);
+  EXPECT_EQ(decision.reason, PolicyReason::kSchemeBlocked);
+}
+
+TEST(PolicyBlock, TheSchemeIsComparedWithoutRegardToCase) {
+  const AccessPolicy policy = Policy(R"({"black_schemes":["file"]})");
+  const PolicyDecision decision =
+      EvaluatePolicy(policy, MainFrame("FILE:///etc/passwd", "", "FILE"));
+  EXPECT_EQ(decision.action, PolicyAction::kCancelRequest);
+  EXPECT_EQ(decision.reason, PolicyReason::kSchemeBlocked);
+}
+
+TEST(PolicyBlock, AnotherSchemeIsNotRefused) {
+  const AccessPolicy policy = Policy(R"({"black_schemes":["file"]})");
+  const PolicyDecision decision =
+      EvaluatePolicy(policy, MainFrame("https://a.test/x", "a.test", "https"));
+  EXPECT_EQ(decision.action, PolicyAction::kSendRequest);
+}
+
+TEST(PolicyBlock, TheMainFrameListOnlyAppliesToTheMainFrame) {
+  const AccessPolicy policy = Policy(R"({"main_frame_list":["https://a\\.test/.*"]})");
+  PolicyRequest request = MainFrame("https://a.test/x", "a.test");
+  EXPECT_EQ(EvaluatePolicy(policy, request).action, PolicyAction::kCancelRequest);
+
+  request.frame = PolicyFrame::kSubFrame;
+  const PolicyDecision decision = EvaluatePolicy(policy, request);
+  EXPECT_EQ(decision.action, PolicyAction::kSendRequest);
+  EXPECT_EQ(decision.reason, PolicyReason::kNoMatch);
+}
+
+TEST(PolicyBlock, TheSubFrameListOnlyAppliesToASubFrame) {
+  const AccessPolicy policy =
+      Policy(R"({"sub_frame_black_list":["https://a\\.test/.*"]})");
+  PolicyRequest request = MainFrame("https://a.test/x", "a.test");
+  EXPECT_EQ(EvaluatePolicy(policy, request).action, PolicyAction::kSendRequest);
+
+  request.frame = PolicyFrame::kSubFrame;
+  const PolicyDecision decision = EvaluatePolicy(policy, request);
+  EXPECT_EQ(decision.action, PolicyAction::kCancelRequest);
+  EXPECT_EQ(decision.reason, PolicyReason::kFrameBlackMatch);
+}
+
+TEST(PolicyBlock, TheFrameListsAreSeparatePerFrameKind) {
+  const AccessPolicy policy = Policy(R"({
+    "frame_black_white_list": {
+      "main_frame": {"black": ["https://m\\.test/.*"],
+                     "white": ["https://mw\\.test/.*"]},
+      "sub_frame": {"black": ["https://s\\.test/.*"],
+                    "white": ["https://sw\\.test/.*"]}
+    }
+  })");
+  PolicyRequest main = MainFrame("https://m.test/x", "m.test");
+  PolicyRequest sub = MainFrame("https://s.test/x", "s.test");
+  sub.frame = PolicyFrame::kSubFrame;
+
+  EXPECT_EQ(EvaluatePolicy(policy, main).action, PolicyAction::kCancelRequest);
+  EXPECT_EQ(EvaluatePolicy(policy, sub).action, PolicyAction::kCancelRequest);
+
+  // The main frame's white list does not rescue the sub frame.
+  const AccessPolicy crossed = Policy(R"({
+    "frame_black_white_list": {
+      "main_frame": {"white": ["https://s\\.test/.*"]},
+      "sub_frame": {"black": ["https://s\\.test/.*"]}
+    }
+  })");
+  const PolicyDecision decision = EvaluatePolicy(crossed, sub);
+  EXPECT_EQ(decision.action, PolicyAction::kCancelRequest);
+  EXPECT_EQ(decision.reason, PolicyReason::kFrameBlackMatch);
+}
+
+TEST(PolicyBlock, AFrameWhiteHitAllows) {
+  const AccessPolicy policy = Policy(R"({
+    "frame_black_white_list": {
+      "main_frame": {"black": ["https://a\\.test/.*"],
+                     "white": ["https://a\\.test/.*"]}
+    }
+  })");
+  const PolicyDecision decision =
+      EvaluatePolicy(policy, MainFrame("https://a.test/x", "a.test"));
+  EXPECT_EQ(decision.action, PolicyAction::kSendRequest);
+  EXPECT_EQ(decision.reason, PolicyReason::kFrameWhiteMatch);
+}
+
+TEST(PolicyBlock, ADomainGlobRefuses) {
+  const AccessPolicy policy = Policy(R"({"domain_black_list":["*.ads.test"]})");
+  const PolicyDecision decision =
+      EvaluatePolicy(policy, MainFrame("https://a.ads.test/x", "a.ads.test"));
+  EXPECT_EQ(decision.action, PolicyAction::kCancelRequest);
+  EXPECT_EQ(decision.reason, PolicyReason::kDomainBlackMatch);
+  ASSERT_NE(decision.matched_rule, nullptr);
+  EXPECT_EQ(*decision.matched_rule, "*.ads.test");
+}
+
+TEST(PolicyBlock, ADomainGlobThatDoesNotMatchRefusesNothing) {
+  const AccessPolicy policy = Policy(R"({"domain_black_list":["*.ads.test"]})");
+  const PolicyDecision decision =
+      EvaluatePolicy(policy, MainFrame("https://a.test/x", "a.test"));
+  EXPECT_EQ(decision.action, PolicyAction::kSendRequest);
+  EXPECT_EQ(decision.reason, PolicyReason::kNoMatch);
+}
+
+TEST(PolicyBlock, ADomainCheckListWatchesButDoesNotRefuse) {
+  const AccessPolicy policy = Policy(R"({"domain_check_list":["*.watch.test"]})");
+  const PolicyDecision decision =
+      EvaluatePolicy(policy, MainFrame("https://a.watch.test/x", "a.watch.test"));
+  // The request still goes out: the check list says "notice this".
+  EXPECT_EQ(decision.action, PolicyAction::kSendRequest);
+  EXPECT_EQ(decision.reason, PolicyReason::kDomainCheckMatch);
+  EXPECT_TRUE(decision.observed);
+}
+
+TEST(PolicyBlock, ARefusedDomainBeatsACheckedOne) {
+  const AccessPolicy policy = Policy(R"({
+    "domain_black_list": ["*.watch.test"],
+    "domain_check_list": ["*.watch.test"]
+  })");
+  const PolicyDecision decision =
+      EvaluatePolicy(policy, MainFrame("https://a.watch.test/x", "a.watch.test"));
+  EXPECT_EQ(decision.action, PolicyAction::kCancelRequest);
+  EXPECT_FALSE(decision.observed);
+}
+
+TEST(PolicyBlock, AUrlPatternIsMatchedOverTheWholeUrl) {
+  const AccessPolicy policy = Policy(R"({"black_list":["example\\.test"]})");
+  // The pattern describes only the middle of the URL, so it does not match
+  // the whole URL and the request is not refused.
+  const PolicyDecision decision =
+      EvaluatePolicy(policy, MainFrame("https://example.test/x", "example.test"));
+  EXPECT_EQ(decision.action, PolicyAction::kSendRequest);
+}
+
+TEST(PolicyBlock, AReasonAndAnActionAlwaysAgree) {
+  // The decision never says both at once. A reason that means "refused"
+  // always goes with a cancel, and a reason that means "allowed" always
+  // goes with a send. There is no state in which a request was refused and
+  // sent.
+  const PolicyReason kRefused[] = {
+      PolicyReason::kSchemeBlocked,
+      PolicyReason::kFrameBlackMatch,
+      PolicyReason::kBlackListMatch,
+      PolicyReason::kDomainBlackMatch,
+  };
+  for (const PolicyReason reason : kRefused) {
+    PolicyDecision decision;
+    decision.reason = reason;
+    decision.action = PolicyAction::kCancelRequest;
+    EXPECT_EQ(decision.action, PolicyAction::kCancelRequest)
+        << PolicyReasonToString(reason);
+  }
+  const PolicyReason kAllowed[] = {
+      PolicyReason::kNoMatch,
+      PolicyReason::kExceptionMatch,
+      PolicyReason::kWhiteListMatch,
+      PolicyReason::kFrameWhiteMatch,
+  };
+  for (const PolicyReason reason : kAllowed) {
+    PolicyDecision decision;
+    decision.reason = reason;
+    decision.action = PolicyAction::kSendRequest;
+    EXPECT_EQ(decision.action, PolicyAction::kSendRequest)
+        << PolicyReasonToString(reason);
+  }
+  // The check list is the one reason that watches: the request still goes
+  // out, and the decision says it was noticed.
+  PolicyDecision watched;
+  watched.reason = PolicyReason::kDomainCheckMatch;
+  watched.action = PolicyAction::kSendRequest;
+  watched.observed = true;
+  EXPECT_EQ(watched.action, PolicyAction::kSendRequest);
+  EXPECT_TRUE(watched.observed);
+}
+
+TEST(PolicyBlock, EveryBlackListRefusesAndEveryWhiteListAllows) {
+  // Each list on its own, so that no list is quietly shadowed by another.
+  struct Case {
+    const char* section;
+    bool refused;
+  };
+  const Case kCases[] = {
+      {R"({"black_list":["https://a\\.test/.*"]})", true},
+      {R"({"white_list":["https://a\\.test/.*"]})", false},
+      {R"({"exception_list":["https://a\\.test/.*"]})", false},
+      {R"({"main_frame_list":["https://a\\.test/.*"]})", true},
+      {R"({"sub_frame_black_list":["https://a\\.test/.*"]})", false},
+      {R"({"frame_black_white_list":{"main_frame":{"black":["https://a\\.test/.*"]}}})",
+       true},
+      {R"({"frame_black_white_list":{"main_frame":{"white":["https://a\\.test/.*"]}}})",
+       false},
+      {R"({"domain_black_list":["a.test"]})", true},
+      {R"({"domain_check_list":["a.test"]})", false},
+  };
+  for (const Case& item : kCases) {
+    const AccessPolicy policy = Policy(item.section);
+    const PolicyDecision decision =
+        EvaluatePolicy(policy, MainFrame("https://a.test/x", "a.test"));
+    const bool refused = decision.action == PolicyAction::kCancelRequest;
+    EXPECT_EQ(refused, item.refused) << item.section;
+  }
+}
+
+TEST(PolicyBlock, TheReasonNamesAreStable) {
+  EXPECT_EQ(PolicyReasonToString(PolicyReason::kNoMatch), "no_match");
+  EXPECT_EQ(PolicyReasonToString(PolicyReason::kSchemeBlocked), "black_schemes");
+  EXPECT_EQ(PolicyReasonToString(PolicyReason::kExceptionMatch), "exception_list");
+  EXPECT_EQ(PolicyReasonToString(PolicyReason::kWhiteListMatch), "white_list");
+  EXPECT_EQ(PolicyReasonToString(PolicyReason::kFrameWhiteMatch),
+            "frame_black_white_list");
+  EXPECT_EQ(PolicyReasonToString(PolicyReason::kFrameBlackMatch),
+            "frame_black_list");
+  EXPECT_EQ(PolicyReasonToString(PolicyReason::kBlackListMatch), "black_list");
+  EXPECT_EQ(PolicyReasonToString(PolicyReason::kDomainBlackMatch),
+            "domain_black_list");
+  EXPECT_EQ(PolicyReasonToString(PolicyReason::kDomainCheckMatch),
+            "domain_check_list");
+}
+
+TEST(PolicyReport, ThePayloadCarriesTheDecision) {
+  const AccessPolicy policy = Policy(R"({"black_list":["https://a\\.test/.*"]})");
+  const PolicyRequest request = MainFrame("https://a.test/x", "a.test");
+  const PolicyDecision decision = EvaluatePolicy(policy, request);
+  const std::string payload = BuildPolicyEventPayload(request, decision);
+
+  JsonObject object;
+  ASSERT_TRUE(JsonObject::Parse(payload, &object)) << payload;
+  std::string value;
+  ASSERT_TRUE(object.GetString("from", &value));
+  EXPECT_EQ(value, "browser");
+  ASSERT_TRUE(object.GetString("action", &value));
+  EXPECT_EQ(value, kActionPolicyEvent);
+  ASSERT_TRUE(object.GetString("url", &value));
+  EXPECT_EQ(value, "https://a.test/x");
+  ASSERT_TRUE(object.GetString("category", &value));
+  EXPECT_EQ(value, "access");
+  ASSERT_TRUE(object.GetString("decision", &value));
+  EXPECT_EQ(value, "block");
+  ASSERT_TRUE(object.GetString("reason", &value));
+  EXPECT_EQ(value, "black_list");
+  ASSERT_TRUE(object.GetString("rule", &value));
+  EXPECT_EQ(value, "https://a\\.test/.*");
+}
+
+TEST(PolicyReport, ThePayloadPassesTheActionTable) {
+  // The report goes over the uplink, so it has to be a payload the action
+  // table accepts. That is the check that keeps the two from drifting.
+  const AccessPolicy policy = Policy(R"({"black_list":["https://a\\.test/.*"]})");
+  const PolicyRequest request = MainFrame("https://a.test/x", "a.test");
+  const PolicyDecision decision = EvaluatePolicy(policy, request);
+  const std::string payload = BuildPolicyEventPayload(request, decision);
+
+  const ActionCollectorPolicy collector;
+  const ActionValidation result = ValidateActionPayload(
+      ActionTable::Get(), kActionPolicyEvent, payload, collector);
+  EXPECT_TRUE(result.ok) << payload;
+}
+
+TEST(PolicyReport, TheCredentialsAreTakenOutOfTheReportedUrl) {
+  // A URL may carry a user name and a password, and neither of them
+  // belongs in a line that leaves the browser.
+  EXPECT_EQ(StripUrlCredentials("https://user:pass@a.test/x"),
+            "https://a.test/x");
+  EXPECT_EQ(StripUrlCredentials("https://user@a.test/x"), "https://a.test/x");
+  EXPECT_EQ(StripUrlCredentials("https://a.test/x"), "https://a.test/x");
+  // A URL without an authority keeps its address: a mailto: URL is not a
+  // URL with a password in it.
+  EXPECT_EQ(StripUrlCredentials("mailto:someone@a.test"),
+            "mailto:someone@a.test");
+}
+
+TEST(PolicyReport, TheCredentialsAreNotInThePayload) {
+  const AccessPolicy policy = Policy("{}");
+  const PolicyRequest request =
+      MainFrame("https://user:pass@a.test/x", "a.test");
+  const PolicyDecision decision = EvaluatePolicy(policy, request);
+  const std::string payload = BuildPolicyEventPayload(request, decision);
+  EXPECT_EQ(payload.find("pass"), std::string::npos) << payload;
+  EXPECT_EQ(payload.find("user"), std::string::npos) << payload;
+  EXPECT_NE(payload.find("https://a.test/x"), std::string::npos) << payload;
+}
+
+TEST(PolicyReport, AnAllowedRequestIsNamedAsAllowed) {
+  const AccessPolicy policy = Policy("{}");
+  const PolicyRequest request = MainFrame("https://a.test/x", "a.test");
+  const PolicyDecision decision = EvaluatePolicy(policy, request);
+  const std::string payload = BuildPolicyEventPayload(request, decision);
+
+  JsonObject object;
+  ASSERT_TRUE(JsonObject::Parse(payload, &object)) << payload;
+  std::string value;
+  ASSERT_TRUE(object.GetString("decision", &value));
+  EXPECT_EQ(value, "allow");
+  ASSERT_TRUE(object.GetString("reason", &value));
+  EXPECT_EQ(value, "no_match");
+  // No rule matched, so there is no rule to report.
+  EXPECT_FALSE(object.Has("rule"));
+}
+
+TEST(PolicyReport, AWatchedRequestIsNamedAsWatched) {
+  const AccessPolicy policy = Policy(R"({"domain_check_list":["*.watch.test"]})");
+  const PolicyRequest request =
+      MainFrame("https://a.watch.test/x", "a.watch.test");
+  const PolicyDecision decision = EvaluatePolicy(policy, request);
+  const std::string payload = BuildPolicyEventPayload(request, decision);
+
+  JsonObject object;
+  ASSERT_TRUE(JsonObject::Parse(payload, &object)) << payload;
+  std::string value;
+  ASSERT_TRUE(object.GetString("decision", &value));
+  EXPECT_EQ(value, "observe");
+}
+
+}  // namespace
+}  // namespace lengsuo::fp
diff --git a/lengsuo/native/policy_match.cc b/lengsuo/native/policy_match.cc
new file mode 100644
index 0000000..84a0843
--- /dev/null
+++ b/lengsuo/native/policy_match.cc
@@ -0,0 +1,646 @@
+#include "policy_match.h"
+
+#include <algorithm>
+#include <functional>
+#include <memory>
+#include <utility>
+#include <vector>
+
+#include "profile_bundle.h"
+
+namespace lengsuo::fp {
+namespace {
+
+// --- the pattern language ---------------------------------------------------
+//
+// The kernel evaluates a small, fixed regular expression language. It is not
+// PCRE and it is not RE2: it is the part of both that a URL rule actually
+// uses, written out so that the kernel carries no dependency and no
+// exception.
+//
+//   .            any one byte
+//   *  +  ?     zero or more, one or more, zero or one of the atom before
+//   {m} {m,} {m,n}  a counted number of the atom before
+//   [abc] [^abc] [a-z]   a byte, a negated set of bytes, a range
+//   \d \D \w \W \s \S     the usual shorthands
+//   \x            the byte x, whatever x is
+//   ( )          a group; the group does not capture
+//   |            an alternation
+//   ^  $         the start and the end of the URL
+//
+// What is not in the language: back references, look-around, lazy
+// quantifiers, and a count over a group. A pattern that uses one of those
+// is not a pattern the kernel can evaluate; it is dropped and counted rather
+// than half-applied.
+//
+// The matcher is a backtracking one with a step budget. A pattern can be
+// written so that the backtracking explodes - (a+a+)+b against a long run of
+// a's - and the budget turns that into "no match" instead of a browser that
+// hangs.
+constexpr std::size_t kMaxPatternLength = 1024;
+constexpr std::uint64_t kMaxMatchSteps = 200000;
+constexpr int kMaxGroupDepth = 64;
+
+using Range = std::pair<unsigned char, unsigned char>;
+
+enum class NodeKind {
+  kLiteral,
+  kAny,
+  kClass,
+  kConcat,
+  kAlternate,
+  kRepeat,
+  kAnchorStart,
+  kAnchorEnd,
+};
+
+struct Node {
+  NodeKind kind = NodeKind::kLiteral;
+  // The byte a kLiteral node matches.
+  unsigned char literal = 0;
+  // The ranges a kClass node matches.
+  std::vector<Range> ranges;
+  // True when a kClass node matches everything but its ranges.
+  bool negated = false;
+  // The children of a kConcat, kAlternate or kRepeat node. A kRepeat node has
+  // exactly one child: the atom it repeats.
+  std::vector<std::unique_ptr<Node>> children;
+  // The repetition bounds of a kRepeat node. A max of -1 is unbounded.
+  int min_count = 0;
+  int max_count = 0;
+};
+
+using NodePtr = std::unique_ptr<Node>;
+
+// The complement of a set of ranges over the whole byte range.
+std::vector<Range> Complement(const std::vector<Range>& ranges) {
+  std::vector<Range> sorted = ranges;
+  std::sort(sorted.begin(), sorted.end());
+  std::vector<Range> out;
+  int next = 0;
+  for (const Range& range : sorted) {
+    if (static_cast<int>(range.second) < next) {
+      continue;
+    }
+    if (static_cast<int>(range.first) > next) {
+      out.push_back({static_cast<unsigned char>(next),
+                     static_cast<unsigned char>(range.first - 1)});
+    }
+    if (range.second == 255) {
+      next = 256;
+      break;
+    }
+    next = static_cast<int>(range.second) + 1;
+  }
+  if (next <= 255) {
+    out.push_back({static_cast<unsigned char>(next), 255});
+  }
+  return out;
+}
+
+// One item of a character class: a single byte, or a set of bytes.
+struct ClassItem {
+  bool is_literal = false;
+  unsigned char literal = 0;
+  std::vector<Range> ranges;
+  bool negate_set = false;
+};
+
+class Parser {
+ public:
+  explicit Parser(std::string_view pattern) : pattern_(pattern) {}
+
+  bool Parse(NodePtr* out) {
+    NodePtr root;
+    if (!ParseAlternation(&root)) {
+      return false;
+    }
+    if (pos_ != pattern_.size()) {
+      // A ')' without its '('.
+      return false;
+    }
+    *out = std::move(root);
+    return true;
+  }
+
+ private:
+  bool ParseAlternation(NodePtr* out) {
+    std::vector<NodePtr> branches;
+    NodePtr first;
+    if (!ParseSequence(&first)) {
+      return false;
+    }
+    branches.push_back(std::move(first));
+    while (pos_ < pattern_.size() && pattern_[pos_] == '|') {
+      ++pos_;
+      NodePtr branch;
+      if (!ParseSequence(&branch)) {
+        return false;
+      }
+      branches.push_back(std::move(branch));
+    }
+    if (branches.size() == 1) {
+      *out = std::move(branches[0]);
+      return true;
+    }
+    auto node = std::make_unique<Node>();
+    node->kind = NodeKind::kAlternate;
+    node->children = std::move(branches);
+    *out = std::move(node);
+    return true;
+  }
+
+  bool ParseSequence(NodePtr* out) {
+    auto node = std::make_unique<Node>();
+    node->kind = NodeKind::kConcat;
+    while (pos_ < pattern_.size() && pattern_[pos_] != '|' &&
+           pattern_[pos_] != ')') {
+      NodePtr atom;
+      if (!ParseAtom(&atom)) {
+        return false;
+      }
+      if (!ParseQuantifier(&atom)) {
+        return false;
+      }
+      node->children.push_back(std::move(atom));
+    }
+    *out = std::move(node);
+    return true;
+  }
+
+  bool ParseAtom(NodePtr* out) {
+    if (pos_ >= pattern_.size()) {
+      return false;
+    }
+    const char c = pattern_[pos_];
+    if (c == '(') {
+      ++pos_;
+      if (++depth_ > kMaxGroupDepth) {
+        return false;
+      }
+      NodePtr inner;
+      if (!ParseAlternation(&inner)) {
+        return false;
+      }
+      if (pos_ >= pattern_.size() || pattern_[pos_] != ')') {
+        return false;
+      }
+      ++pos_;
+      --depth_;
+      *out = std::move(inner);
+      return true;
+    }
+    if (c == '[') {
+      return ParseClass(out);
+    }
+    if (c == '.') {
+      ++pos_;
+      auto node = std::make_unique<Node>();
+      node->kind = NodeKind::kAny;
+      *out = std::move(node);
+      return true;
+    }
+    if (c == '^') {
+      ++pos_;
+      auto node = std::make_unique<Node>();
+      node->kind = NodeKind::kAnchorStart;
+      *out = std::move(node);
+      return true;
+    }
+    if (c == '$') {
+      ++pos_;
+      auto node = std::make_unique<Node>();
+      node->kind = NodeKind::kAnchorEnd;
+      *out = std::move(node);
+      return true;
+    }
+    if (c == '\\') {
+      return ParseEscape(out);
+    }
+    if (c == '*' || c == '+' || c == '?') {
+      // A quantifier with nothing to repeat.
+      return false;
+    }
+    ++pos_;
+    auto node = std::make_unique<Node>();
+    node->kind = NodeKind::kLiteral;
+    node->literal = static_cast<unsigned char>(c);
+    *out = std::move(node);
+    return true;
+  }
+
+  // Reads an escape outside a character class.
+  bool ParseEscape(NodePtr* out) {
+    ++pos_;  // the backslash
+    if (pos_ >= pattern_.size()) {
+      return false;
+    }
+    const char c = pattern_[pos_++];
+    std::vector<Range> ranges;
+    bool negated = false;
+    switch (c) {
+      case 'd':
+        ranges = {{'0', '9'}};
+        break;
+      case 'D':
+        ranges = {{'0', '9'}};
+        negated = true;
+        break;
+      case 'w':
+        ranges = {{'0', '9'}, {'A', 'Z'}, {'_', '_'}, {'a', 'z'}};
+        break;
+      case 'W':
+        ranges = {{'0', '9'}, {'A', 'Z'}, {'_', '_'}, {'a', 'z'}};
+        negated = true;
+        break;
+      case 's':
+        ranges = {{'\t', '\r'}, {' ', ' '}};
+        break;
+      case 'S':
+        ranges = {{'\t', '\r'}, {' ', ' '}};
+        negated = true;
+        break;
+      default: {
+        auto node = std::make_unique<Node>();
+        node->kind = NodeKind::kLiteral;
+        node->literal = static_cast<unsigned char>(c);
+        *out = std::move(node);
+        return true;
+      }
+    }
+    auto node = std::make_unique<Node>();
+    node->kind = NodeKind::kClass;
+    node->ranges = negated ? Complement(ranges) : std::move(ranges);
+    *out = std::move(node);
+    return true;
+  }
+
+  // Reads one item of a character class.
+  bool ParseClassItem(ClassItem* item) {
+    if (pos_ >= pattern_.size()) {
+      return false;
+    }
+    const char c = pattern_[pos_];
+    if (c != '\\') {
+      ++pos_;
+      item->is_literal = true;
+      item->literal = static_cast<unsigned char>(c);
+      item->ranges.push_back({item->literal, item->literal});
+      return true;
+    }
+    ++pos_;  // the backslash
+    if (pos_ >= pattern_.size()) {
+      return false;
+    }
+    const char escape = pattern_[pos_++];
+    switch (escape) {
+      case 'd':
+        item->ranges = {{'0', '9'}};
+        return true;
+      case 'D':
+        item->ranges = {{'0', '9'}};
+        item->negate_set = true;
+        return true;
+      case 'w':
+        item->ranges = {{'0', '9'}, {'A', 'Z'}, {'_', '_'}, {'a', 'z'}};
+        return true;
+      case 'W':
+        item->ranges = {{'0', '9'}, {'A', 'Z'}, {'_', '_'}, {'a', 'z'}};
+        item->negate_set = true;
+        return true;
+      case 's':
+        item->ranges = {{'\t', '\r'}, {' ', ' '}};
+        return true;
+      case 'S':
+        item->ranges = {{'\t', '\r'}, {' ', ' '}};
+        item->negate_set = true;
+        return true;
+      default:
+        item->is_literal = true;
+        item->literal = static_cast<unsigned char>(escape);
+        item->ranges.push_back({item->literal, item->literal});
+        return true;
+    }
+  }
+
+  bool ParseClass(NodePtr* out) {
+    ++pos_;  // the '['
+    bool negated = false;
+    if (pos_ < pattern_.size() && pattern_[pos_] == '^') {
+      negated = true;
+      ++pos_;
+    }
+    std::vector<Range> ranges;
+    bool first = true;
+    while (true) {
+      if (pos_ >= pattern_.size()) {
+        return false;
+      }
+      if (pattern_[pos_] == ']' && !first) {
+        ++pos_;
+        break;
+      }
+      first = false;
+      ClassItem low;
+      if (!ParseClassItem(&low)) {
+        return false;
+      }
+      // A dash that is not the last byte of the class opens a range, and a
+      // range needs two literal bytes: '\d' cannot be an end of one.
+      const bool opens_range = pos_ + 1 < pattern_.size() &&
+                               pattern_[pos_] == '-' &&
+                               pattern_[pos_ + 1] != ']';
+      if (opens_range) {
+        if (!low.is_literal) {
+          return false;
+        }
+        ++pos_;
+        ClassItem high;
+        if (!ParseClassItem(&high)) {
+          return false;
+        }
+        if (!high.is_literal || low.literal > high.literal) {
+          return false;
+        }
+        ranges.push_back({low.literal, high.literal});
+        continue;
+      }
+      if (low.negate_set) {
+        const std::vector<Range> complement = Complement(low.ranges);
+        ranges.insert(ranges.end(), complement.begin(), complement.end());
+      } else {
+        ranges.insert(ranges.end(), low.ranges.begin(), low.ranges.end());
+      }
+    }
+    auto node = std::make_unique<Node>();
+    node->kind = NodeKind::kClass;
+    node->ranges = negated ? Complement(ranges) : std::move(ranges);
+    *out = std::move(node);
+    return true;
+  }
+
+  bool ParseQuantifier(NodePtr* atom) {
+    if (pos_ >= pattern_.size()) {
+      return true;
+    }
+    const char c = pattern_[pos_];
+    int min_count = 0;
+    int max_count = 0;
+    if (c == '*') {
+      max_count = -1;
+      ++pos_;
+    } else if (c == '+') {
+      min_count = 1;
+      max_count = -1;
+      ++pos_;
+    } else if (c == '?') {
+      max_count = 1;
+      ++pos_;
+    } else if (c == '{') {
+      if (!ParseCounted(&min_count, &max_count)) {
+        return false;
+      }
+    } else {
+      return true;
+    }
+    // A second quantifier on the same atom is a lazy quantifier, which this
+    // language does not have.
+    if (pos_ < pattern_.size()) {
+      const char next = pattern_[pos_];
+      if (next == '*' || next == '+' || next == '?' || next == '{') {
+        return false;
+      }
+    }
+    auto node = std::make_unique<Node>();
+    node->kind = NodeKind::kRepeat;
+    node->min_count = min_count;
+    node->max_count = max_count;
+    node->children.push_back(std::move(*atom));
+    *atom = std::move(node);
+    return true;
+  }
+
+  bool ParseCounted(int* min_count, int* max_count) {
+    const std::size_t start = pos_;
+    ++pos_;  // the '{'
+    int low = 0;
+    if (!ParseNumber(&low)) {
+      pos_ = start;
+      return false;
+    }
+    if (pos_ < pattern_.size() && pattern_[pos_] == '}') {
+      ++pos_;
+      *min_count = low;
+      *max_count = low;
+      return true;
+    }
+    if (pos_ >= pattern_.size() || pattern_[pos_] != ',') {
+      pos_ = start;
+      return false;
+    }
+    ++pos_;
+    if (pos_ < pattern_.size() && pattern_[pos_] == '}') {
+      ++pos_;
+      *min_count = low;
+      *max_count = -1;
+      return true;
+    }
+    int high = 0;
+    if (!ParseNumber(&high)) {
+      pos_ = start;
+      return false;
+    }
+    if (pos_ >= pattern_.size() || pattern_[pos_] != '}') {
+      pos_ = start;
+      return false;
+    }
+    ++pos_;
+    if (high < low) {
+      pos_ = start;
+      return false;
+    }
+    *min_count = low;
+    *max_count = high;
+    return true;
+  }
+
+  bool ParseNumber(int* out) {
+    if (pos_ >= pattern_.size() || pattern_[pos_] < '0' || pattern_[pos_] > '9') {
+      return false;
+    }
+    int value = 0;
+    while (pos_ < pattern_.size() && pattern_[pos_] >= '0' &&
+           pattern_[pos_] <= '9') {
+      if (value > 100000) {
+        // A count that big is a mistake, and the step budget would stop it
+        // anyway.
+        return false;
+      }
+      value = value * 10 + (pattern_[pos_] - '0');
+      ++pos_;
+    }
+    *out = value;
+    return true;
+  }
+
+  std::string_view pattern_;
+  std::size_t pos_ = 0;
+  int depth_ = 0;
+};
+
+bool ParsePattern(std::string_view pattern, NodePtr* out) {
+  if (pattern.size() > kMaxPatternLength) {
+    return false;
+  }
+  Parser parser(pattern);
+  return parser.Parse(out);
+}
+
+// --- the matcher ------------------------------------------------------------
+
+using Continuation = std::function<bool(std::size_t)>;
+
+struct Matcher {
+  std::string_view text;
+  std::uint64_t steps = 0;
+  bool exhausted = false;
+
+  bool Step() {
+    if (++steps > kMaxMatchSteps) {
+      exhausted = true;
+      return false;
+    }
+    return true;
+  }
+};
+
+bool MatchClass(const Node& node, unsigned char c) {
+  bool inside = false;
+  for (const Range& range : node.ranges) {
+    if (c >= range.first && c <= range.second) {
+      inside = true;
+      break;
+    }
+  }
+  return node.negated ? !inside : inside;
+}
+
+bool MatchNode(const Node& node,
+               std::size_t pos,
+               Matcher& matcher,
+               const Continuation& next);
+
+bool MatchChildren(const Node& node,
+                   std::size_t index,
+                   std::size_t pos,
+                   Matcher& matcher,
+                   const Continuation& next) {
+  if (index == node.children.size()) {
+    return next(pos);
+  }
+  return MatchNode(*node.children[index], pos, matcher,
+                   [&](std::size_t end) {
+                     return MatchChildren(node, index + 1, end, matcher, next);
+                   });
+}
+
+bool MatchRepeat(const Node& node,
+                 std::size_t count,
+                 std::size_t pos,
+                 Matcher& matcher,
+                 const Continuation& next) {
+  const Node& atom = *node.children[0];
+  // Greedy: take one more atom if the count allows it.
+  if (node.max_count < 0 ||
+      count < static_cast<std::size_t>(node.max_count)) {
+    const bool matched = MatchNode(atom, pos, matcher, [&](std::size_t end) {
+      if (end == pos) {
+        // An atom that matches nothing would repeat forever.
+        return false;
+      }
+      return MatchRepeat(node, count + 1, end, matcher, next);
+    });
+    if (matched) {
+      return true;
+    }
+    if (matcher.exhausted) {
+      return false;
+    }
+  }
+  if (count >= static_cast<std::size_t>(node.min_count)) {
+    return next(pos);
+  }
+  return false;
+}
+
+bool MatchNode(const Node& node,
+               std::size_t pos,
+               Matcher& matcher,
+               const Continuation& next) {
+  if (!matcher.Step()) {
+    return false;
+  }
+  switch (node.kind) {
+    case NodeKind::kLiteral:
+      if (pos < matcher.text.size() &&
+          static_cast<unsigned char>(matcher.text[pos]) == node.literal) {
+        return next(pos + 1);
+      }
+      return false;
+    case NodeKind::kAny:
+      if (pos < matcher.text.size()) {
+        return next(pos + 1);
+      }
+      return false;
+    case NodeKind::kClass:
+      if (pos < matcher.text.size() &&
+          MatchClass(node, static_cast<unsigned char>(matcher.text[pos]))) {
+        return next(pos + 1);
+      }
+      return false;
+    case NodeKind::kConcat:
+      return MatchChildren(node, 0, pos, matcher, next);
+    case NodeKind::kAlternate:
+      for (const NodePtr& child : node.children) {
+        if (MatchNode(*child, pos, matcher, next)) {
+          return true;
+        }
+        if (matcher.exhausted) {
+          return false;
+        }
+      }
+      return false;
+    case NodeKind::kAnchorStart:
+      return pos == 0 ? next(pos) : false;
+    case NodeKind::kAnchorEnd:
+      return pos == matcher.text.size() ? next(pos) : false;
+    case NodeKind::kRepeat:
+      return MatchRepeat(node, 0, pos, matcher, next);
+  }
+  return false;
+}
+
+}  // namespace
+
+bool MatchUrlPattern(std::string_view pattern, std::string_view url) {
+  NodePtr root;
+  if (!ParsePattern(pattern, &root)) {
+    return false;
+  }
+  Matcher matcher;
+  matcher.text = url;
+  const std::size_t size = url.size();
+  Continuation finish = [size](std::size_t end) { return end == size; };
+  return MatchNode(*root, 0, matcher, finish);
+}
+
+bool IsValidUrlPattern(std::string_view pattern) {
+  NodePtr root;
+  return ParsePattern(pattern, &root);
+}
+
+bool MatchDomainPattern(std::string_view pattern, std::string_view host) {
+  return MatchGlob(pattern, host);
+}
+
+}  // namespace lengsuo::fp
diff --git a/lengsuo/native/policy_match.h b/lengsuo/native/policy_match.h
new file mode 100644
index 0000000..446be21
--- /dev/null
+++ b/lengsuo/native/policy_match.h
@@ -0,0 +1,78 @@
+// policy_match - matching a request against the access policy (task T2).
+//
+// The policy matches a request in two different ways, and the two are kept
+// apart on purpose:
+//
+//   * a URL is matched by a regular expression, over the whole URL;
+//   * a host is matched by a glob, over the host.
+//
+// The glob is the one the profile sync rules already use - the MatchGlob in
+// native/profile_bundle.cc - so there is one glob in this codebase and not
+// two. The regular expression is the kernel's own; the reason is in
+// policy_match.cc.
+//
+// The kernel evaluates the pattern in a fixed little language rather than
+// pulling in an expression engine:
+//
+//   * std::regex is not an option. Its constructor throws on a pattern it
+//     cannot read, and the browser is built without exceptions, so a bad
+//     pattern would take the browser down instead of taking one rule out.
+//   * RE2 would work, but in this tree it needs Abseil, and a rule engine
+//     that drags half of Abseil in cannot be tested on its own.
+//
+// The language the kernel does evaluate is written out in policy_match.cc,
+// together with what it leaves out.
+#ifndef LENGSUO_NATIVE_POLICY_MATCH_H_
+#define LENGSUO_NATIVE_POLICY_MATCH_H_
+
+#include <string>
+#include <string_view>
+
+#include "policy_rules.h"
+
+namespace lengsuo::fp {
+
+// One request the policy is asked about.
+//
+// The URL, the host and the scheme are handed in rather than parsed out of
+// the URL here: the browser already has them, and parsing a URL is a job
+// for the browser's URL class, not for a rule engine.
+struct PolicyRequest {
+  // The whole URL, as the browser has it.
+  std::string url;
+  // The host, without the port. Empty when the URL has no host.
+  std::string host;
+  // The scheme, without the colon. Empty when the URL has no scheme.
+  std::string scheme;
+  // Which frame the request belongs to.
+  PolicyFrame frame = PolicyFrame::kMainFrame;
+};
+
+// Matches a URL pattern against a URL.
+//
+// The pattern is a regular expression and the match has to cover the whole
+// URL, not a part of it. This is the same anchoring the host glob has: the
+// pattern describes the whole thing or it does not describe it at all.
+// A pattern that means "any URL that mentions this" has to say so -
+// ".*example\.test.*".
+//
+// The anchors are therefore no-ops: the match already starts at the start
+// of the URL and ends at its end.
+//
+// A pattern outside the language the kernel evaluates does not match
+// anything. IsValidUrlPattern says so before the rule is ever used, and a
+// rule that fails it is dropped and counted when the policy is read.
+bool MatchUrlPattern(std::string_view pattern, std::string_view url);
+
+// True when the pattern is a regular expression the matcher can evaluate.
+bool IsValidUrlPattern(std::string_view pattern);
+
+// Matches a host pattern against a host.
+//
+// The pattern is a glob - '*' matches any run of bytes, '?' matches one -
+// and it is the same glob the profile sync rules use.
+bool MatchDomainPattern(std::string_view pattern, std::string_view host);
+
+}  // namespace lengsuo::fp
+
+#endif  // LENGSUO_NATIVE_POLICY_MATCH_H_
diff --git a/lengsuo/native/policy_match_test.cc b/lengsuo/native/policy_match_test.cc
new file mode 100644
index 0000000..7f94c0a
--- /dev/null
+++ b/lengsuo/native/policy_match_test.cc
@@ -0,0 +1,167 @@
+// policy_match_test - matching a request against the access policy (T2).
+//
+// Two matchers are tested here and they are deliberately different:
+//
+//   * the URL matcher is a regular expression over the whole URL;
+//   * the host matcher is the glob the profile sync rules already use.
+//
+// The tests that matter most are the ones about the edges: a pattern that
+// covers only part of the URL does not match, a pattern the kernel cannot
+// read is rejected rather than half-applied, and a pattern written to make
+// the matcher work hard is stopped instead of hanging the browser.
+#include "policy_match.h"
+
+#include <gtest/gtest.h>
+
+#include <string>
+#include <string_view>
+
+namespace lengsuo::fp {
+namespace {
+
+TEST(PolicyMatch, TheHostMatcherIsTheProfileGlob) {
+  // The same glob the profile sync rules use: '*' spans anything, '?' is one
+  // byte, and the pattern is anchored at both ends.
+  EXPECT_TRUE(MatchDomainPattern("*.example.test", "a.example.test"));
+  EXPECT_TRUE(MatchDomainPattern("*.example.test", "a.b.example.test"));
+  EXPECT_TRUE(MatchDomainPattern("example.test", "example.test"));
+  EXPECT_FALSE(MatchDomainPattern("example.test", "notexample.test"));
+  EXPECT_FALSE(MatchDomainPattern("*.example.test", "example.test"));
+  EXPECT_TRUE(MatchDomainPattern("a?c.test", "abc.test"));
+  EXPECT_FALSE(MatchDomainPattern("a?c.test", "abbc.test"));
+}
+
+TEST(PolicyMatch, TheUrlMatcherCoversTheWholeUrl) {
+  // A pattern that describes only the middle of the URL does not match: the
+  // pattern has to be about the whole URL.
+  EXPECT_FALSE(MatchUrlPattern("example\\.test", "https://example.test/a"));
+  EXPECT_TRUE(MatchUrlPattern("https://example\\.test/a",
+                              "https://example.test/a"));
+  // A pattern that covers the whole URL matches, and only that URL.
+  EXPECT_TRUE(MatchUrlPattern("https://.*", "https://example.test/a"));
+  EXPECT_FALSE(MatchUrlPattern("https://.*", "http://example.test/a"));
+}
+
+TEST(PolicyMatch, TheUrlMatcherReadsTheUsualSyntax) {
+  EXPECT_TRUE(MatchUrlPattern("https://example\\.test/.*", "https://example.test/x"));
+  EXPECT_TRUE(MatchUrlPattern(".*\\.ads\\..*", "https://a.ads.example/x"));
+  EXPECT_FALSE(MatchUrlPattern(".*\\.ads\\..*", "https://a.example/x"));
+  EXPECT_TRUE(MatchUrlPattern("a+b", "aab"));
+  EXPECT_TRUE(MatchUrlPattern("a+b", "ab"));
+  EXPECT_FALSE(MatchUrlPattern("a+b", "aabbbc"));
+  EXPECT_TRUE(MatchUrlPattern("colou?r", "color"));
+  EXPECT_TRUE(MatchUrlPattern("colou?r", "colour"));
+  EXPECT_TRUE(MatchUrlPattern("a{2,3}", "aa"));
+  EXPECT_TRUE(MatchUrlPattern("a{2,3}", "aaa"));
+  EXPECT_FALSE(MatchUrlPattern("a{2,3}", "a"));
+  EXPECT_FALSE(MatchUrlPattern("a{2,3}", "aaaa"));
+  EXPECT_TRUE(MatchUrlPattern("(ab|cd)ef", "abef"));
+  EXPECT_TRUE(MatchUrlPattern("(ab|cd)ef", "cdef"));
+  EXPECT_FALSE(MatchUrlPattern("(ab|cd)ef", "aef"));
+  EXPECT_TRUE(MatchUrlPattern("[a-c]x", "bx"));
+  EXPECT_FALSE(MatchUrlPattern("[a-c]x", "dx"));
+  EXPECT_TRUE(MatchUrlPattern("[^a-c]x", "dx"));
+  EXPECT_FALSE(MatchUrlPattern("[^a-c]x", "bx"));
+  EXPECT_TRUE(MatchUrlPattern("\\d+", "12345"));
+  EXPECT_FALSE(MatchUrlPattern("\\d+", "12a45"));
+  EXPECT_TRUE(MatchUrlPattern("\\w+\\s\\w+", "hello world"));
+  EXPECT_FALSE(MatchUrlPattern("\\w+\\s\\w+", "hello_world"));
+}
+
+TEST(PolicyMatch, TheAnchorsSayTheSameThingUnderAFullMatch) {
+  // The match has to cover the whole URL, so the URL's own start and end
+  // are already the anchors. Writing them says the same thing.
+  EXPECT_TRUE(MatchUrlPattern("^https://a\\.test$", "https://a.test"));
+  EXPECT_TRUE(MatchUrlPattern("https://a\\.test", "https://a.test"));
+  // And a pattern that pins the URL down does not match a longer URL.
+  EXPECT_FALSE(MatchUrlPattern("^https://a\\.test$", "https://a.test/b"));
+  EXPECT_FALSE(MatchUrlPattern("^https://a\\.test$", "http://a.test"));
+}
+
+TEST(PolicyMatch, TheWholeUrlIsTheSubject) {
+  // A pattern that names only the middle of the URL does not describe the
+  // URL, so it does not match it.
+  EXPECT_FALSE(MatchUrlPattern("example\\.test", "https://example.test/a"));
+  // To say "any URL that mentions it", the pattern has to say so.
+  EXPECT_TRUE(MatchUrlPattern(".*example\\.test.*", "https://example.test/a"));
+}
+
+TEST(PolicyMatch, TheUrlMatcherMatchesTheWholeStringOnly) {
+  // ".*" on its own matches everything, including the empty URL.
+  EXPECT_TRUE(MatchUrlPattern(".*", ""));
+  EXPECT_TRUE(MatchUrlPattern(".*", "https://example.test/a"));
+  // A pattern with nothing in it matches only the empty URL.
+  EXPECT_TRUE(MatchUrlPattern("", ""));
+  EXPECT_FALSE(MatchUrlPattern("", "x"));
+}
+
+TEST(PolicyMatch, AGroupIsNotCapturedButStillGroups) {
+  // The group changes what the pattern means, not what it keeps.
+  EXPECT_TRUE(MatchUrlPattern("(ab)+", "abab"));
+  EXPECT_TRUE(MatchUrlPattern("(ab)+", "ab"));
+  EXPECT_FALSE(MatchUrlPattern("(ab)+", "a"));
+}
+
+TEST(PolicyMatch, AClassMayHoldANegatedShorthand) {
+  EXPECT_TRUE(MatchUrlPattern("[\\D]+", "abc"));
+  EXPECT_FALSE(MatchUrlPattern("[\\D]+", "ab1"));
+}
+
+TEST(PolicyMatch, AClassMayHoldARange) {
+  EXPECT_TRUE(MatchUrlPattern("[0-9a-f]+", "00ff"));
+  EXPECT_FALSE(MatchUrlPattern("[0-9a-f]+", "00fg"));
+  // A range with its ends the wrong way round is not a range.
+  EXPECT_FALSE(IsValidUrlPattern("[z-a]"));
+}
+
+TEST(PolicyMatch, AClassMayEndWithADash) {
+  EXPECT_TRUE(MatchUrlPattern("[a-]+", "a--"));
+  EXPECT_FALSE(MatchUrlPattern("[a-]+", "ab"));
+}
+
+TEST(PolicyMatch, AnUnreadablePatternIsRejected) {
+  // Every one of these is a pattern the kernel cannot read. Each of them
+  // would have to be dropped and counted when the policy is read.
+  for (const char* pattern :
+       {"(", ")", "[", "[a", "a{", "a{2,1}", "*a", "a**", "a*?", "\\", "a{1,",
+        "[\\d-\\w]"}) {
+    EXPECT_FALSE(IsValidUrlPattern(pattern)) << pattern;
+  }
+}
+
+TEST(PolicyMatch, AReadablePatternIsAccepted) {
+  for (const char* pattern :
+       {"", "a", "a*", "a+", "a?", "a{2}", "a{2,}", "a{2,3}", "(a|b)", "[a-z]",
+        "\\d", "\\.", "^a$", "https://.*"}) {
+    EXPECT_TRUE(IsValidUrlPattern(pattern)) << pattern;
+  }
+}
+
+TEST(PolicyMatch, AnUnreadablePatternMatchesNothing) {
+  // A pattern that could not be read is a rule that does not fire. It must
+  // not match a URL by accident.
+  EXPECT_FALSE(MatchUrlPattern("(unclosed", "https://example.test/"));
+  EXPECT_FALSE(MatchUrlPattern("[unclosed", "https://example.test/"));
+}
+
+TEST(PolicyMatch, APatternThatWorksHardIsStopped) {
+  // The classic backtracking bomb: (a+a+)+b against a long run of a's.
+  // The matcher has to give up rather than hang the browser.
+  const std::string bomb = "(a+a+)+b";
+  const std::string subject(2000, 'a');
+  EXPECT_FALSE(MatchUrlPattern(bomb, subject));
+  // A pattern that backtracks a lot but does match still matches: the
+  // budget stops a runaway, it does not turn every hard pattern into a
+  // non-match.
+  EXPECT_TRUE(MatchUrlPattern("(a+)+b", "aaab"));
+}
+
+TEST(PolicyMatch, AHostPatternIsNotAUrlPattern) {
+  // The two matchers are different on purpose and neither stands in for the
+  // other.
+  EXPECT_FALSE(MatchDomainPattern("https://example.test", "example.test"));
+  EXPECT_FALSE(MatchUrlPattern("*.example.test", "a.example.test"));
+}
+
+}  // namespace
+}  // namespace lengsuo::fp
diff --git a/lengsuo/native/policy_report.cc b/lengsuo/native/policy_report.cc
new file mode 100644
index 0000000..9ff89bc
--- /dev/null
+++ b/lengsuo/native/policy_report.cc
@@ -0,0 +1,113 @@
+#include "policy_report.h"
+
+#include <string>
+
+namespace lengsuo::fp {
+namespace {
+
+// Appends a JSON string, quotes included.
+//
+// The control characters are written as \u00XX because a raw byte in a JSON
+// string is not always a JSON string: a URL may carry anything at all.
+void AppendJsonString(std::string* out, std::string_view value) {
+  static const char kHex[] = "0123456789abcdef";
+  out->push_back('"');
+  for (const char c : value) {
+    switch (c) {
+      case '"':
+        out->append("\\\"");
+        break;
+      case '\\':
+        out->append("\\\\");
+        break;
+      case '\b':
+        out->append("\\b");
+        break;
+      case '\f':
+        out->append("\\f");
+        break;
+      case '\n':
+        out->append("\\n");
+        break;
+      case '\r':
+        out->append("\\r");
+        break;
+      case '\t':
+        out->append("\\t");
+        break;
+      default:
+        if (static_cast<unsigned char>(c) < 0x20) {
+          out->append("\\u00");
+          out->push_back(kHex[(static_cast<unsigned char>(c) >> 4) & 0x0f]);
+          out->push_back(kHex[static_cast<unsigned char>(c) & 0x0f]);
+        } else {
+          out->push_back(c);
+        }
+        break;
+    }
+  }
+  out->push_back('"');
+}
+
+}  // namespace
+
+std::string StripUrlCredentials(std::string_view url) {
+  const std::size_t scheme_end = url.find("://");
+  if (scheme_end == std::string_view::npos) {
+    // No authority, so no credentials to take out.
+    return std::string(url);
+  }
+  const std::size_t authority_start = scheme_end + 3;
+  std::size_t authority_end = url.find_first_of("/?#", authority_start);
+  if (authority_end == std::string_view::npos) {
+    authority_end = url.size();
+  }
+  // The last "@" of the authority is the one that separates the
+  // credentials from the host. A host may not carry one, so the last is the
+  // only one that can be it.
+  const std::size_t at = url.rfind('@', authority_end);
+  if (at == std::string_view::npos || at < authority_start) {
+    return std::string(url);
+  }
+  std::string out(url.substr(0, authority_start));
+  out.append(url.substr(at + 1, authority_end - at - 1));
+  out.append(url.substr(authority_end));
+  return out;
+}
+
+std::string_view PolicyDecisionName(const PolicyDecision& decision) {
+  if (decision.action == PolicyAction::kCancelRequest) {
+    return kPolicyDecisionBlock;
+  }
+  if (decision.observed) {
+    return kPolicyDecisionObserve;
+  }
+  return kPolicyDecisionAllow;
+}
+
+std::string BuildPolicyEventPayload(const PolicyRequest& request,
+                                     const PolicyDecision& decision) {
+  std::string out;
+  out.reserve(256);
+  out += "{\"from\":\"";
+  out += kPolicyReportFrom;
+  out += "\",\"action\":\"";
+  out += kActionPolicyEvent;
+  out += "\",\"url\":";
+  AppendJsonString(&out, StripUrlCredentials(request.url));
+  out += ",\"category\":\"";
+  out += kPolicyCategory;
+  out += "\",\"decision\":\"";
+  out += PolicyDecisionName(decision);
+  out += "\",\"reason\":\"";
+  out += PolicyReasonToString(decision.reason);
+  out += "\"";
+  if (decision.matched_rule != nullptr) {
+    out += ",\"rule\":";
+    AppendJsonString(&out, *decision.matched_rule);
+  }
+  out += "}";
+  return out;
+}
+
+}  // namespace lengsuo::fp
diff --git a/lengsuo/native/policy_report.h b/lengsuo/native/policy_report.h
new file mode 100644
index 0000000..6e78b98
--- /dev/null
+++ b/lengsuo/native/policy_report.h
@@ -0,0 +1,66 @@
+// policy_report - the uplink payload for a policy decision (task T2).
+//
+// The policy is enforced in the browser process, so the browser process is
+// what tells the runner about it. The report goes over the pipe that
+// already carries the uplink events: one frame type, one action table, one
+// more name in it. There is no new channel and no new frame type.
+//
+// The payload carries:
+//
+//   from      "browser" - the policy is enforced in the browser process
+//   action    "PolicyEvent"
+//   url       the URL, without the credentials in it
+//   category  "access"
+//   decision  "block", "allow" or "observe"
+//   reason    the list that decided
+//   rule      the pattern that matched, when one did
+//
+// The credentials are taken out of the URL before it is reported. A URL may
+// carry a user name and a password, and neither of them belongs in a line
+// that leaves the browser.
+//
+// The builder builds a payload for any decision; it does not decide which
+// decisions are worth reporting. That is the caller's decision, and it is
+// the caller's to change.
+#ifndef LENGSUO_NATIVE_POLICY_REPORT_H_
+#define LENGSUO_NATIVE_POLICY_REPORT_H_
+
+#include <string>
+#include <string_view>
+
+#include "action_table.h"
+#include "policy_block.h"
+
+namespace lengsuo::fp {
+
+// Who the report comes from.
+inline constexpr char kPolicyReportFrom[] = "browser";
+
+// The category the access policy reports under.
+inline constexpr char kPolicyCategory[] = "access";
+
+// The decisions a report can carry.
+inline constexpr char kPolicyDecisionBlock[] = "block";
+inline constexpr char kPolicyDecisionAllow[] = "allow";
+inline constexpr char kPolicyDecisionObserve[] = "observe";
+
+// Builds the uplink payload for one decision.
+//
+// The URL is reported without its credentials. The rule is reported only
+// when a rule matched.
+std::string BuildPolicyEventPayload(const PolicyRequest& request,
+                                     const PolicyDecision& decision);
+
+// The URL as it is reported: the request's URL without the credentials.
+//
+// The credentials are the part between the "://" and the "@" of the
+// authority. A URL without a "://" has no authority and is left alone, so a
+// "mailto:" URL keeps its address.
+std::string StripUrlCredentials(std::string_view url);
+
+// The decision name that goes on the wire.
+std::string_view PolicyDecisionName(const PolicyDecision& decision);
+
+}  // namespace lengsuo::fp
+
+#endif  // LENGSUO_NATIVE_POLICY_REPORT_H_
diff --git a/lengsuo/native/policy_rules.cc b/lengsuo/native/policy_rules.cc
new file mode 100644
index 0000000..7302885
--- /dev/null
+++ b/lengsuo/native/policy_rules.cc
@@ -0,0 +1,310 @@
+#include "policy_rules.h"
+
+#include <algorithm>
+#include <cctype>
+#include <utility>
+
+#include "kernel_pipe_json.h"
+#include "policy_match.h"
+
+namespace lengsuo::fp {
+namespace {
+
+// --- reading a list of strings out of the raw array text ------------------
+//
+// The JSON reader keeps an array as raw text and offers no accessor for its
+// elements, so the elements are scanned here and handed back to the reader
+// one at a time: a raw literal is valid JSON on its own, so wrapping it in
+// a one-member object and parsing that resolves the escapes with the
+// decoder that is already tested. Writing a second escape decoder here
+// would mean two decoders to keep in step.
+
+bool IsJsonSpace(char c) {
+  return c == ' ' || c == '\t' || c == '\n' || c == '\r';
+}
+
+void SkipJsonSpace(std::string_view text, std::size_t* pos) {
+  while (*pos < text.size() && IsJsonSpace(text[*pos])) {
+    ++(*pos);
+  }
+}
+
+// Copies the raw literal (quotes included) that starts at `*pos` into `*raw`
+// and leaves `*pos` just past it.
+bool ScanRawLiteral(std::string_view text, std::size_t* pos, std::string* raw) {
+  if (*pos >= text.size() || text[*pos] != '"') {
+    return false;
+  }
+  const std::size_t start = *pos;
+  ++(*pos);
+  while (*pos < text.size()) {
+    const char c = text[*pos];
+    if (c == '\\') {
+      // The escaped byte cannot be the closing quote, whatever it is.
+      *pos += 2;
+      continue;
+    }
+    ++(*pos);
+    if (c == '"') {
+      raw->assign(text.substr(start, *pos - start));
+      return true;
+    }
+  }
+  return false;
+}
+
+// Resolves the escapes of one raw literal.
+bool DecodeLiteral(const std::string& raw, std::string* out) {
+  const std::string wrapped = "{\"v\":" + raw + "}";
+  JsonObject object;
+  if (!JsonObject::Parse(wrapped, &object)) {
+    return false;
+  }
+  return object.GetString("v", out);
+}
+
+// Reads a JSON array of strings. The text is the raw text the reader kept,
+// so it starts with '[' and ends with ']'.
+bool ParseStringArray(const std::string& text, std::vector<std::string>* out) {
+  std::size_t pos = 0;
+  SkipJsonSpace(text, &pos);
+  if (pos >= text.size() || text[pos] != '[') {
+    return false;
+  }
+  ++pos;
+  SkipJsonSpace(text, &pos);
+  if (pos < text.size() && text[pos] == ']') {
+    ++pos;
+    SkipJsonSpace(text, &pos);
+    return pos == text.size();
+  }
+  while (true) {
+    SkipJsonSpace(text, &pos);
+    std::string raw;
+    if (!ScanRawLiteral(text, &pos, &raw)) {
+      return false;
+    }
+    std::string item;
+    if (!DecodeLiteral(raw, &item)) {
+      return false;
+    }
+    out->push_back(std::move(item));
+    SkipJsonSpace(text, &pos);
+    if (pos >= text.size()) {
+      return false;
+    }
+    if (text[pos] == ',') {
+      ++pos;
+      continue;
+    }
+    if (text[pos] == ']') {
+      ++pos;
+      break;
+    }
+    return false;
+  }
+  SkipJsonSpace(text, &pos);
+  return pos == text.size();
+}
+
+// --- reading one list out of the section ----------------------------------
+
+// Reads a list of URL patterns.
+//
+// A list that is not there is an empty list. A list that cannot be read is
+// dropped and counted: one unreadable list must not take the whole policy
+// with it. A pattern the matcher cannot evaluate is dropped and counted for
+// the same reason - a rule that cannot fire must not fail the request that
+// trips over it.
+void ReadUrlList(const JsonObject& section,
+                 const char* key,
+                 std::uint64_t* skipped,
+                 std::vector<std::string>* out) {
+  const JsonValue* value = section.Find(key);
+  if (value == nullptr) {
+    return;
+  }
+  if (value->kind != JsonKind::kArray) {
+    ++*skipped;
+    return;
+  }
+  std::vector<std::string> items;
+  if (!ParseStringArray(value->text, &items)) {
+    ++*skipped;
+    return;
+  }
+  for (std::string& item : items) {
+    if (!IsValidUrlPattern(item)) {
+      ++*skipped;
+      continue;
+    }
+    out->push_back(std::move(item));
+  }
+}
+
+// Reads a list of host patterns.
+//
+// The host patterns are globs, and every byte sequence is a valid glob, so
+// there is nothing to validate here: a list that cannot be read is dropped
+// and counted and nothing else.
+void ReadGlobList(const JsonObject& section,
+                  const char* key,
+                  std::uint64_t* skipped,
+                  std::vector<std::string>* out) {
+  const JsonValue* value = section.Find(key);
+  if (value == nullptr) {
+    return;
+  }
+  if (value->kind != JsonKind::kArray) {
+    ++*skipped;
+    return;
+  }
+  std::vector<std::string> items;
+  if (!ParseStringArray(value->text, &items)) {
+    ++*skipped;
+    return;
+  }
+  for (std::string& item : items) {
+    out->push_back(std::move(item));
+  }
+}
+
+// Reads the black_schemes list. The names are canonicalised here so that
+// the comparison later is a plain string comparison: a scheme is
+// case-insensitive and is written with or without its colon.
+void ReadSchemeList(const JsonObject& section,
+                    std::uint64_t* skipped,
+                    std::vector<std::string>* out) {
+  const JsonValue* value = section.Find("black_schemes");
+  if (value == nullptr) {
+    return;
+  }
+  if (value->kind != JsonKind::kArray) {
+    ++*skipped;
+    return;
+  }
+  std::vector<std::string> items;
+  if (!ParseStringArray(value->text, &items)) {
+    ++*skipped;
+    return;
+  }
+  for (std::string& item : items) {
+    std::string scheme = item;
+    if (!scheme.empty() && scheme.back() == ':') {
+      scheme.pop_back();
+    }
+    std::transform(scheme.begin(), scheme.end(), scheme.begin(),
+                   [](unsigned char c) {
+                     return static_cast<char>(std::tolower(c));
+                   });
+    if (scheme.empty()) {
+      ++*skipped;
+      continue;
+    }
+    out->push_back(std::move(scheme));
+  }
+}
+
+// Reads the frame_black_white_list section: a black and a white list per
+// frame kind.
+void ReadFrameRules(const JsonObject& section,
+                    std::uint64_t* skipped,
+                    FramePolicyLists* main_frame,
+                    FramePolicyLists* sub_frame) {
+  const JsonValue* value = section.Find("frame_black_white_list");
+  if (value == nullptr) {
+    return;
+  }
+  if (value->kind != JsonKind::kObject) {
+    ++*skipped;
+    return;
+  }
+  JsonObject frames;
+  if (!JsonObject::Parse(value->text, &frames)) {
+    ++*skipped;
+    return;
+  }
+  struct Entry {
+    const char* key;
+    FramePolicyLists* lists;
+  };
+  const Entry entries[] = {{"main_frame", main_frame}, {"sub_frame", sub_frame}};
+  for (const Entry& entry : entries) {
+    const JsonValue* frame = frames.Find(entry.key);
+    if (frame == nullptr) {
+      continue;
+    }
+    if (frame->kind != JsonKind::kObject) {
+      ++*skipped;
+      continue;
+    }
+    JsonObject lists;
+    if (!JsonObject::Parse(frame->text, &lists)) {
+      ++*skipped;
+      continue;
+    }
+    ReadUrlList(lists, "black", skipped, &entry.lists->black);
+    ReadUrlList(lists, "white", skipped, &entry.lists->white);
+  }
+}
+
+}  // namespace
+
+bool ParseAccessPolicy(std::string_view bundle_json,
+                        AccessPolicy* out,
+                        std::string* error) {
+  auto fail = [error](const char* message) {
+    if (error != nullptr) {
+      *error = message;
+    }
+    return false;
+  };
+  if (out == nullptr) {
+    return fail("access_policy: no output");
+  }
+  // An unreadable bundle is the only failure that reaches the caller. A
+  // bundle without the section is an empty policy, and an empty policy
+  // refuses nothing: the platform did not ask for one.
+  JsonObject bundle;
+  if (!JsonObject::Parse(bundle_json, &bundle)) {
+    *out = AccessPolicy();
+    return fail("access_policy: malformed bundle");
+  }
+  const JsonValue* section = bundle.Find(kAccessPolicyConfigKey);
+  if (section == nullptr) {
+    *out = AccessPolicy();
+    return true;
+  }
+  if (section->kind != JsonKind::kObject) {
+    *out = AccessPolicy();
+    return fail("access_policy: the section is not an object");
+  }
+  // The reader keeps a nested object as raw text, so it is parsed again
+  // with the same reader.
+  JsonObject rules;
+  if (!JsonObject::Parse(section->text, &rules)) {
+    *out = AccessPolicy();
+    return fail("access_policy: malformed section");
+  }
+
+  AccessPolicy policy;
+  ReadUrlList(rules, "black_list", &policy.skipped_rules, &policy.black_list);
+  ReadUrlList(rules, "white_list", &policy.skipped_rules, &policy.white_list);
+  ReadUrlList(rules, "exception_list", &policy.skipped_rules,
+              &policy.exception_list);
+  ReadSchemeList(rules, &policy.skipped_rules, &policy.black_schemes);
+  ReadUrlList(rules, "main_frame_list", &policy.skipped_rules,
+              &policy.main_frame_list);
+  ReadUrlList(rules, "sub_frame_black_list", &policy.skipped_rules,
+              &policy.sub_frame_black_list);
+  ReadFrameRules(rules, &policy.skipped_rules, &policy.main_frame_rules,
+                 &policy.sub_frame_rules);
+  ReadGlobList(rules, "domain_black_list", &policy.skipped_rules,
+               &policy.domain_black_list);
+  ReadGlobList(rules, "domain_check_list", &policy.skipped_rules,
+               &policy.domain_check_list);
+  *out = std::move(policy);
+  return true;
+}
+
+}  // namespace lengsuo::fp
diff --git a/lengsuo/native/policy_rules.h b/lengsuo/native/policy_rules.h
new file mode 100644
index 0000000..9458176
--- /dev/null
+++ b/lengsuo/native/policy_rules.h
@@ -0,0 +1,123 @@
+// policy_rules - the access policy rules (task T2).
+//
+// The access policy is configuration, not code. The runner sends it in the
+// ConfigBundle (frame type 0x03) and the kernel applies whatever the bundle
+// says. Nothing in this file names a site: "example.com" is blocked because
+// the configuration lists it, not because this code knows the site.
+//
+// The configuration carries three URL lists whose semantics do not overlap:
+//
+//   black_list      a hit means refuse
+//   white_list      a hit means allow
+//   exception_list  a hit overrides the conclusion of the two above
+//
+// The priority is fixed here because two repos that each decide their own
+// would decide differently:
+//
+//   exception_list > white_list > black_list
+//
+// `black_schemes` is independent of the URL lists: a scheme on that list is
+// refused whatever the URL lists say, and no URL pattern rescues it. The
+// scheme rule is a statement about the transport, not about the address.
+//
+// The rest of the lists:
+//
+//   main_frame_list      the main frame's own list
+//   sub_frame_black_list the sub frame's own list
+//   frame_black_white_list  a black and a white list per frame kind
+//   domain_black_list    host patterns that are refused
+//   domain_check_list    host patterns that are watched but not refused
+//
+// What the two kinds of list item mean:
+//
+//   * the URL lists hold regular expressions, matched against the whole URL
+//     (see policy_match.h);
+//   * the domain lists hold globs, matched against the host. The glob is the
+//     one the profile sync rules already use - native/profile_bundle.cc's
+//     MatchGlob - so there is exactly one glob in this codebase.
+//
+// Two rules are not negotiable:
+//
+//   * A rule that cannot be read is dropped and counted. One bad pattern
+//     never fails the whole policy and never fails the browser.
+//   * A configuration that has not arrived is an empty policy, and an empty
+//     policy refuses nothing. A browser that blocks everything because the
+//     runner is not up yet is a broken browser.
+#ifndef LENGSUO_NATIVE_POLICY_RULES_H_
+#define LENGSUO_NATIVE_POLICY_RULES_H_
+
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace lengsuo::fp {
+
+// The name of the configuration section that carries the access policy.
+inline constexpr char kAccessPolicyConfigKey[] = "access_policy";
+
+// Which frame a request belongs to.
+enum class PolicyFrame {
+  kMainFrame,
+  kSubFrame,
+};
+
+// One frame's black and white lists.
+//
+// The lists are separate because a frame can be on the black list for one
+// address and on the white list for another; the priority between them is
+// the same as everywhere else (white wins over black, an exception wins over
+// both).
+struct FramePolicyLists {
+  std::vector<std::string> black;
+  std::vector<std::string> white;
+};
+
+// The rules the configuration carries.
+struct AccessPolicy {
+  // The URL lists. The items are regular expressions matched against the
+  // whole URL.
+  std::vector<std::string> black_list;
+  std::vector<std::string> white_list;
+  std::vector<std::string> exception_list;
+
+  // The schemes that are refused whatever the URL lists say. The names carry
+  // no colon ("file", not "file:").
+  std::vector<std::string> black_schemes;
+
+  // main_frame_list: the main frame's own list. Read as a black list: the
+  // brief names the sub frame's list "black" and does not name the main
+  // frame's, so the two are read the same way.
+  std::vector<std::string> main_frame_list;
+  // sub_frame_black_list: the sub frame's own list.
+  std::vector<std::string> sub_frame_black_list;
+
+  // The frame_black_white_list section: a black and a white list per frame
+  // kind.
+  FramePolicyLists main_frame_rules;
+  FramePolicyLists sub_frame_rules;
+
+  // The domain lists. The items are globs matched against the host.
+  std::vector<std::string> domain_black_list;
+  std::vector<std::string> domain_check_list;
+
+  // The rules that were dropped because they could not be read. Counted, not
+  // fatal.
+  std::uint64_t skipped_rules = 0;
+};
+
+// Reads the access_policy section out of a frozen configuration bundle.
+//
+// Returns false only when the bundle itself cannot be read. A bundle that
+// carries no access_policy section yields an empty policy and returns true:
+// the platform did not ask for one, so there is nothing to enforce.
+//
+// A list that cannot be read is dropped and counted; the rest of the policy
+// still applies. A rule that cannot be read is a rule that does not fire.
+bool ParseAccessPolicy(std::string_view bundle_json,
+                        AccessPolicy* out,
+                        std::string* error);
+
+}  // namespace lengsuo::fp
+
+#endif  // LENGSUO_NATIVE_POLICY_RULES_H_
diff --git a/lengsuo/native/policy_rules_test.cc b/lengsuo/native/policy_rules_test.cc
new file mode 100644
index 0000000..0fab31f
--- /dev/null
+++ b/lengsuo/native/policy_rules_test.cc
@@ -0,0 +1,221 @@
+// policy_rules_test - reading the access policy out of the configuration.
+//
+// The rules are configuration, so the tests are about what happens to a
+// configuration that is not quite right. The two rules that are not
+// negotiable get their own tests:
+//
+//   * a rule that cannot be read is dropped and counted, and the rest of the
+//     policy still applies;
+//   * a configuration that has not arrived is an empty policy, and an empty
+//     policy refuses nothing.
+#include "policy_rules.h"
+
+#include <gtest/gtest.h>
+
+#include <string>
+
+namespace lengsuo::fp {
+namespace {
+
+// A configuration bundle with the given access_policy section.
+std::string Bundle(const std::string& section) {
+  return "{\"access_policy\":" + section + "}";
+}
+
+// Reads the policy out of a bundle, failing the test if it cannot be read.
+AccessPolicy Read(const std::string& bundle) {
+  AccessPolicy policy;
+  std::string error;
+  EXPECT_TRUE(ParseAccessPolicy(bundle, &policy, &error)) << error;
+  return policy;
+}
+
+TEST(PolicyRules, ReadsTheUrlLists) {
+  const AccessPolicy policy = Read(Bundle(R"({
+    "black_list": ["https://a.test/.*"],
+    "white_list": ["https://b.test/.*"],
+    "exception_list": ["https://c.test/.*"]
+  })"));
+  ASSERT_EQ(policy.black_list.size(), 1u);
+  EXPECT_EQ(policy.black_list[0], "https://a.test/.*");
+  ASSERT_EQ(policy.white_list.size(), 1u);
+  EXPECT_EQ(policy.white_list[0], "https://b.test/.*");
+  ASSERT_EQ(policy.exception_list.size(), 1u);
+  EXPECT_EQ(policy.exception_list[0], "https://c.test/.*");
+  EXPECT_EQ(policy.skipped_rules, 0u);
+}
+
+TEST(PolicyRules, ReadsTheFrameLists) {
+  const AccessPolicy policy = Read(Bundle(R"({
+    "main_frame_list": ["https://m.test/.*"],
+    "sub_frame_black_list": ["https://s.test/.*"],
+    "frame_black_white_list": {
+      "main_frame": {"black": ["https://mb.test/.*"],
+                     "white": ["https://mw.test/.*"]},
+      "sub_frame": {"black": ["https://sb.test/.*"],
+                    "white": ["https://sw.test/.*"]}
+    }
+  })"));
+  ASSERT_EQ(policy.main_frame_list.size(), 1u);
+  EXPECT_EQ(policy.main_frame_list[0], "https://m.test/.*");
+  ASSERT_EQ(policy.sub_frame_black_list.size(), 1u);
+  EXPECT_EQ(policy.sub_frame_black_list[0], "https://s.test/.*");
+  ASSERT_EQ(policy.main_frame_rules.black.size(), 1u);
+  EXPECT_EQ(policy.main_frame_rules.black[0], "https://mb.test/.*");
+  ASSERT_EQ(policy.main_frame_rules.white.size(), 1u);
+  EXPECT_EQ(policy.main_frame_rules.white[0], "https://mw.test/.*");
+  ASSERT_EQ(policy.sub_frame_rules.black.size(), 1u);
+  EXPECT_EQ(policy.sub_frame_rules.black[0], "https://sb.test/.*");
+  ASSERT_EQ(policy.sub_frame_rules.white.size(), 1u);
+  EXPECT_EQ(policy.sub_frame_rules.white[0], "https://sw.test/.*");
+}
+
+TEST(PolicyRules, ReadsTheDomainLists) {
+  const AccessPolicy policy = Read(Bundle(R"({
+    "domain_black_list": ["*.ads.test"],
+    "domain_check_list": ["*.watch.test"]
+  })"));
+  ASSERT_EQ(policy.domain_black_list.size(), 1u);
+  EXPECT_EQ(policy.domain_black_list[0], "*.ads.test");
+  ASSERT_EQ(policy.domain_check_list.size(), 1u);
+  EXPECT_EQ(policy.domain_check_list[0], "*.watch.test");
+}
+
+TEST(PolicyRules, TheSchemeListIsCanonicalised) {
+  // A scheme is written with or without its colon, in either case, and it
+  // is compared without regard to either.
+  const AccessPolicy policy = Read(Bundle(R"({
+    "black_schemes": ["file:", "FTP", "ws:"]
+  })"));
+  ASSERT_EQ(policy.black_schemes.size(), 3u);
+  EXPECT_EQ(policy.black_schemes[0], "file");
+  EXPECT_EQ(policy.black_schemes[1], "ftp");
+  EXPECT_EQ(policy.black_schemes[2], "ws");
+}
+
+TEST(PolicyRules, AConfigurationThatHasNotArrivedRefusesNothing) {
+  // No section at all: the platform did not ask for a policy, so there is
+  // nothing to enforce. A browser that refuses everything because the
+  // runner is not up yet is a broken browser.
+  AccessPolicy policy;
+  std::string error;
+  ASSERT_TRUE(ParseAccessPolicy("{\"other\":1}", &policy, &error)) << error;
+  EXPECT_TRUE(policy.black_list.empty());
+  EXPECT_TRUE(policy.white_list.empty());
+  EXPECT_TRUE(policy.black_schemes.empty());
+  EXPECT_EQ(policy.skipped_rules, 0u);
+}
+
+TEST(PolicyRules, AnUnreadableBundleLeavesAnEmptyPolicy) {
+  AccessPolicy policy;
+  std::string error;
+  EXPECT_FALSE(ParseAccessPolicy("{not json", &policy, &error));
+  EXPECT_FALSE(error.empty());
+  // The policy is empty, not half-read: a failed read leaves nothing
+  // behind that could refuse a request.
+  EXPECT_TRUE(policy.black_list.empty());
+  EXPECT_TRUE(policy.white_list.empty());
+}
+
+TEST(PolicyRules, ASectionThatIsNotAnObjectIsAnUnreadableBundle) {
+  AccessPolicy policy;
+  std::string error;
+  EXPECT_FALSE(ParseAccessPolicy("{\"access_policy\":[1,2]}", &policy, &error));
+  EXPECT_TRUE(policy.black_list.empty());
+}
+
+TEST(PolicyRules, AListThatIsNotAnArrayIsDroppedAndCounted) {
+  // The rest of the policy still applies: one bad list does not take the
+  // whole policy with it.
+  const AccessPolicy policy = Read(Bundle(R"({
+    "black_list": "not a list",
+    "white_list": ["https://b.test/.*"]
+  })"));
+  EXPECT_TRUE(policy.black_list.empty());
+  ASSERT_EQ(policy.white_list.size(), 1u);
+  EXPECT_EQ(policy.skipped_rules, 1u);
+}
+
+TEST(PolicyRules, AListThatIsNotMadeOfStringsIsDroppedAndCounted) {
+  const AccessPolicy policy = Read(Bundle(R"({
+    "black_list": [1, 2]
+  })"));
+  EXPECT_TRUE(policy.black_list.empty());
+  EXPECT_EQ(policy.skipped_rules, 1u);
+}
+
+TEST(PolicyRules, AUrlPatternTheMatcherCannotReadIsDroppedAndCounted) {
+  // The rule that cannot fire must not fail the request that trips over
+  // it, and it must not take the good rules with it.
+  const AccessPolicy policy = Read(Bundle(R"({
+    "black_list": ["https://good.test/.*", "(unclosed", "https://also-good.test/.*"]
+  })"));
+  ASSERT_EQ(policy.black_list.size(), 2u);
+  EXPECT_EQ(policy.black_list[0], "https://good.test/.*");
+  EXPECT_EQ(policy.black_list[1], "https://also-good.test/.*");
+  EXPECT_EQ(policy.skipped_rules, 1u);
+}
+
+TEST(PolicyRules, ADomainPatternIsNeverDroppedForBeingUnreadable) {
+  // Every byte sequence is a valid glob, so the domain lists are only ever
+  // dropped as a whole.
+  const AccessPolicy policy = Read(Bundle(R"({
+    "domain_black_list": ["*.a.test", "??b", "[weird]"]
+  })"));
+  EXPECT_EQ(policy.domain_black_list.size(), 3u);
+  EXPECT_EQ(policy.skipped_rules, 0u);
+}
+
+TEST(PolicyRules, AnEmptySchemeIsDroppedAndCounted) {
+  const AccessPolicy policy = Read(Bundle(R"({"black_schemes":["", ":"]})"));
+  EXPECT_TRUE(policy.black_schemes.empty());
+  EXPECT_EQ(policy.skipped_rules, 2u);
+}
+
+TEST(PolicyRules, AFrameSectionThatIsNotAnObjectIsDroppedAndCounted) {
+  const AccessPolicy policy = Read(Bundle(R"({
+    "frame_black_white_list": "not an object",
+    "black_list": ["https://a.test/.*"]
+  })"));
+  EXPECT_TRUE(policy.main_frame_rules.black.empty());
+  ASSERT_EQ(policy.black_list.size(), 1u);
+  EXPECT_EQ(policy.skipped_rules, 1u);
+}
+
+TEST(PolicyRules, AFrameListThatIsNotAnArrayIsDroppedAndCounted) {
+  const AccessPolicy policy = Read(Bundle(R"({
+    "frame_black_white_list": {
+      "main_frame": {"black": "not a list", "white": ["https://w.test/.*"]},
+      "sub_frame": {"black": ["https://b.test/.*"]}
+    }
+  })"));
+  EXPECT_TRUE(policy.main_frame_rules.black.empty());
+  ASSERT_EQ(policy.main_frame_rules.white.size(), 1u);
+  EXPECT_EQ(policy.main_frame_rules.white[0], "https://w.test/.*");
+  ASSERT_EQ(policy.sub_frame_rules.black.size(), 1u);
+  EXPECT_EQ(policy.skipped_rules, 1u);
+}
+
+TEST(PolicyRules, AnEmptyPolicyIsEmpty) {
+  const AccessPolicy policy = Read(Bundle("{}"));
+  EXPECT_TRUE(policy.black_list.empty());
+  EXPECT_TRUE(policy.white_list.empty());
+  EXPECT_TRUE(policy.exception_list.empty());
+  EXPECT_TRUE(policy.black_schemes.empty());
+  EXPECT_TRUE(policy.main_frame_list.empty());
+  EXPECT_TRUE(policy.sub_frame_black_list.empty());
+  EXPECT_TRUE(policy.domain_black_list.empty());
+  EXPECT_TRUE(policy.domain_check_list.empty());
+  EXPECT_EQ(policy.skipped_rules, 0u);
+}
+
+TEST(PolicyRules, AnEscapedPatternIsReadAsItWasWritten) {
+  const AccessPolicy policy = Read(Bundle(R"({
+    "black_list": ["https://a\\.test/.*"]
+  })"));
+  ASSERT_EQ(policy.black_list.size(), 1u);
+  EXPECT_EQ(policy.black_list[0], "https://a\\.test/.*");
+}
+
+}  // namespace
+}  // namespace lengsuo::fp
diff --git a/lengsuo/native/product_brand.h b/lengsuo/native/product_brand.h
new file mode 100644
index 0000000..0bd9cc8
--- /dev/null
+++ b/lengsuo/native/product_brand.h
@@ -0,0 +1,25 @@
+// product_brand - the product brand label this build advertises.
+//
+// Chromium only emits a product brand into the UA-CH brand list when it is
+// built from the branded tree (CHROMIUM_BRANDING=0). An unbranded build
+// advertises `Chromium` plus the GREASE brand and nothing else, which is a
+// single-field giveaway in any client-hint check: real Chrome always lists
+// `Google Chrome` alongside `Chromium`.
+//
+// The engine underneath is still Chromium; the product identity is what we
+// ship, and the brand list has to describe the shipped product rather than the
+// source tree it was compiled from. Versions are not hardcoded here on
+// purpose - they come from chrome/VERSION so the pair cannot drift.
+#ifndef LENGSUO_NATIVE_PRODUCT_BRAND_H_
+#define LENGSUO_NATIVE_PRODUCT_BRAND_H_
+
+#include <string_view>
+
+namespace lengsuo::native {
+
+// Must stay consistent with the UA string's product token (`Chrome/<version>`).
+inline constexpr std::string_view kProductBrand = "Google Chrome";
+
+}  // namespace lengsuo::native
+
+#endif  // LENGSUO_NATIVE_PRODUCT_BRAND_H_
diff --git a/lengsuo/native/profile_bundle.cc b/lengsuo/native/profile_bundle.cc
new file mode 100644
index 0000000..fea0852
--- /dev/null
+++ b/lengsuo/native/profile_bundle.cc
@@ -0,0 +1,359 @@
+#include "profile_bundle.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "kernel_pipe_json.h"
+
+namespace lengsuo::fp {
+namespace {
+
+// The patterns no collection may ever contain.
+//
+// The brief's rule is that Cookies and Network Cache are excluded "under
+// any circumstances". The exclude list in the configuration says the same
+// thing, but the configuration is remote input: a platform that listed
+// "*Cookies*" in the include list would otherwise get the cookies. So
+// these two patterns are a floor, not a preference - the collection cannot
+// contain them even if the configuration asks for them.
+//
+// This is the only place in this file that names a file. The white list
+// stays in the configuration: what is collected is the platform's decision.
+constexpr char kForbiddenCookies[] = "*Cookies*";
+constexpr char kForbiddenNetwork[] = "*Network*";
+
+// Compares two paths byte-wise, as unsigned bytes.
+//
+// std::string's own operator< would do the same on every platform we
+// build for, but the two repos that agree on the manifest order have to
+// agree for a reason that is written down rather than inherited. The
+// comparison is therefore spelled out: unsigned byte by unsigned byte, and
+// a prefix sorts before the longer path that starts with it.
+int ComparePaths(const std::string& left, const std::string& right) {
+  const std::size_t shared = std::min(left.size(), right.size());
+  for (std::size_t i = 0; i < shared; ++i) {
+    const auto a = static_cast<unsigned char>(left[i]);
+    const auto b = static_cast<unsigned char>(right[i]);
+    if (a != b) {
+      return a < b ? -1 : 1;
+    }
+  }
+  if (left.size() == right.size()) {
+    return 0;
+  }
+  return left.size() < right.size() ? -1 : 1;
+}
+
+// Reads a JSON string literal, resolving the escapes.
+//
+// The reader in kernel_pipe_json.h keeps arrays as raw text, so the array
+// of patterns has to be scanned here. The escape set is the one JSON
+// defines; a \u escape is accepted for a BMP code point and a lone
+// surrogate is refused, because a pattern that names a half a character
+// cannot match a path.
+bool ScanJsonString(std::string_view text, std::size_t* pos, std::string* out) {
+  if (*pos >= text.size() || text[*pos] != '"') {
+    return false;
+  }
+  ++(*pos);
+  out->clear();
+  while (*pos < text.size()) {
+    const char c = text[*pos];
+    if (c == '"') {
+      ++(*pos);
+      return true;
+    }
+    if (c == '\\') {
+      ++(*pos);
+      if (*pos >= text.size()) {
+        return false;
+      }
+      const char escape = text[*pos];
+      ++(*pos);
+      switch (escape) {
+        case '"': out->push_back('"'); break;
+        case '\\': out->push_back('\\'); break;
+        case '/': out->push_back('/'); break;
+        case 'b': out->push_back('\b'); break;
+        case 'f': out->push_back('\f'); break;
+        case 'n': out->push_back('\n'); break;
+        case 'r': out->push_back('\r'); break;
+        case 't': out->push_back('\t'); break;
+        case 'u': {
+          if (*pos + 4 > text.size()) {
+            return false;
+          }
+          std::uint32_t code = 0;
+          for (int i = 0; i < 4; ++i) {
+            const char digit = text[*pos + static_cast<std::size_t>(i)];
+            std::uint32_t value = 0;
+            if (digit >= '0' && digit <= '9') {
+              value = static_cast<std::uint32_t>(digit - '0');
+            } else if (digit >= 'a' && digit <= 'f') {
+              value = static_cast<std::uint32_t>(digit - 'a' + 10);
+            } else if (digit >= 'A' && digit <= 'F') {
+              value = static_cast<std::uint32_t>(digit - 'A' + 10);
+            } else {
+              return false;
+            }
+            code = (code << 4) | value;
+          }
+          *pos += 4;
+          if (code >= 0xD800 && code <= 0xDFFF) {
+            // A surrogate on its own is not a character.
+            return false;
+          }
+          if (code <= 0x7F) {
+            out->push_back(static_cast<char>(code));
+          } else if (code <= 0x7FF) {
+            out->push_back(static_cast<char>(0xC0 | (code >> 6)));
+            out->push_back(static_cast<char>(0x80 | (code & 0x3F)));
+          } else {
+            out->push_back(static_cast<char>(0xE0 | (code >> 12)));
+            out->push_back(static_cast<char>(0x80 | ((code >> 6) & 0x3F)));
+            out->push_back(static_cast<char>(0x80 | (code & 0x3F)));
+          }
+          break;
+        }
+        default:
+          return false;
+      }
+      continue;
+    }
+    if (static_cast<unsigned char>(c) < 0x20) {
+      return false;
+    }
+    out->push_back(c);
+    ++(*pos);
+  }
+  return false;
+}
+
+// Reads a JSON array of strings. The array text is the raw text the
+// reader kept, so it starts with '[' and ends with ']'.
+bool ParseStringArray(std::string_view text, std::vector<std::string>* out) {
+  std::size_t pos = 0;
+  auto skip_space = [&text, &pos]() {
+    while (pos < text.size() && (text[pos] == ' ' || text[pos] == '\t' ||
+                                 text[pos] == '\n' || text[pos] == '\r')) {
+      ++pos;
+    }
+  };
+  skip_space();
+  if (pos >= text.size() || text[pos] != '[') {
+    return false;
+  }
+  ++pos;
+  skip_space();
+  if (pos < text.size() && text[pos] == ']') {
+    ++pos;
+    skip_space();
+    return pos == text.size();
+  }
+  while (true) {
+    skip_space();
+    std::string item;
+    if (!ScanJsonString(text, &pos, &item)) {
+      return false;
+    }
+    out->push_back(std::move(item));
+    skip_space();
+    if (pos >= text.size()) {
+      return false;
+    }
+    if (text[pos] == ',') {
+      ++pos;
+      continue;
+    }
+    if (text[pos] == ']') {
+      ++pos;
+      break;
+    }
+    return false;
+  }
+  skip_space();
+  return pos == text.size();
+}
+
+// True when any of `patterns` matches `text`.
+bool MatchesAny(const std::vector<std::string>& patterns,
+                 std::string_view text) {
+  for (const std::string& pattern : patterns) {
+    if (MatchGlob(pattern, text)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace
+
+ProfileSyncConfig DefaultProfileSyncConfig() {
+  ProfileSyncConfig config;
+  // The white list. History is in it because the ruling is that the
+  // history is uploaded by default; its scope is still the pattern's, so
+  // a path that does not look like a history file is not collected.
+  config.include = {"*Local Storage*", "*Extension State*", "*History*"};
+  // The black list. The exclude always wins.
+  config.exclude = {"*Cache*", "*Cookies*", "*Network*"};
+  config.max_package_bytes = kProfileBundleMaxBytes;
+  return config;
+}
+
+bool MatchGlob(std::string_view pattern, std::string_view text) {
+  std::size_t p = 0;
+  std::size_t t = 0;
+  std::size_t star = std::string_view::npos;
+  std::size_t star_end = 0;
+  while (t < text.size()) {
+    if (p < pattern.size() && (pattern[p] == '?' || pattern[p] == text[t])) {
+      ++p;
+      ++t;
+    } else if (p < pattern.size() && pattern[p] == '*') {
+      // Remember where the star was and try the shortest match first.
+      star = p++;
+      star_end = t;
+    } else if (star != std::string_view::npos) {
+      // Let the star swallow one more byte and try again.
+      p = star + 1;
+      t = ++star_end;
+    } else {
+      return false;
+    }
+  }
+  while (p < pattern.size() && pattern[p] == '*') {
+    ++p;
+  }
+  return p == pattern.size();
+}
+
+bool ParseProfileSyncConfig(std::string_view bundle_json,
+                            ProfileSyncConfig* out,
+                            std::string* error) {
+  auto fail = [error](const char* message) {
+    if (error != nullptr) {
+      *error = message;
+    }
+    return false;
+  };
+  if (out == nullptr) {
+    return fail("profile_sync: no output");
+  }
+  JsonObject bundle;
+  if (!JsonObject::Parse(bundle_json, &bundle)) {
+    return fail("profile_sync: malformed bundle");
+  }
+  const JsonValue* section = bundle.Find(kProfileSyncConfigKey);
+  if (section == nullptr) {
+    // No section means the platform did not ask for a profile upload.
+    return fail("profile_sync: the bundle carries no profile_sync section");
+  }
+  if (section->kind != JsonKind::kObject) {
+    return fail("profile_sync: the section is not an object");
+  }
+  // The reader keeps a nested object as raw text, so it is parsed again
+  // with the same reader.
+  JsonObject rules;
+  if (!JsonObject::Parse(section->text, &rules)) {
+    return fail("profile_sync: malformed section");
+  }
+
+  ProfileSyncConfig config;
+  const JsonValue* include = rules.Find("include");
+  if (include == nullptr || include->kind != JsonKind::kArray) {
+    return fail("profile_sync: the section has no include list");
+  }
+  if (!ParseStringArray(include->text, &config.include)) {
+    return fail("profile_sync: the include list is malformed");
+  }
+  const JsonValue* exclude = rules.Find("exclude");
+  if (exclude != nullptr) {
+    if (exclude->kind != JsonKind::kArray) {
+      return fail("profile_sync: the exclude list is not an array");
+    }
+    if (!ParseStringArray(exclude->text, &config.exclude)) {
+      return fail("profile_sync: the exclude list is malformed");
+    }
+  }
+  const JsonValue* ceiling = rules.Find("max_package_bytes");
+  if (ceiling != nullptr) {
+    std::int64_t value = 0;
+    if (!rules.GetInt64("max_package_bytes", &value) || value < 0) {
+      return fail("profile_sync: the package ceiling is malformed");
+    }
+    if (value > 0) {
+      // The configuration may lower the ceiling; it may never raise it.
+      config.max_package_bytes = std::min<std::uint64_t>(
+          static_cast<std::uint64_t>(value), kProfileBundleMaxBytes);
+    }
+  }
+  if (config.max_package_bytes == 0) {
+    config.max_package_bytes = kProfileBundleMaxBytes;
+  }
+  *out = std::move(config);
+  return true;
+}
+
+void CollectProfileBundle(const ProfileSyncConfig& config,
+                          const std::vector<ProfileFile>& files,
+                          ProfileBundle* out) {
+  if (out == nullptr) {
+    return;
+  }
+  *out = ProfileBundle();
+
+  // The order is decided before anything is collected: the manifest is
+  // sorted by path, so two repos that hold the same profile produce the
+  // same list without exchanging anything.
+  std::vector<ProfileFile> ordered = files;
+  std::sort(ordered.begin(), ordered.end(),
+            [](const ProfileFile& left, const ProfileFile& right) {
+              return ComparePaths(left.relative_path, right.relative_path) < 0;
+            });
+
+  const std::uint64_t ceiling =
+      config.max_package_bytes == 0 ? kProfileBundleMaxBytes
+                                    : config.max_package_bytes;
+
+  for (const ProfileFile& file : ordered) {
+    if (!file.readable) {
+      // A file that cannot be read is skipped and counted. It never fails
+      // the collection: one locked file must not stop a container from
+      // closing.
+      ++out->skipped_unreadable;
+      continue;
+    }
+    if (MatchesAny({kForbiddenCookies, kForbiddenNetwork},
+                   file.relative_path)) {
+      // The floor. These never go out, whatever the configuration says.
+      ++out->excluded;
+      continue;
+    }
+    if (!MatchesAny(config.include, file.relative_path)) {
+      ++out->excluded;
+      continue;
+    }
+    if (MatchesAny(config.exclude, file.relative_path)) {
+      // The exclude wins over the include.
+      ++out->excluded;
+      continue;
+    }
+    if (out->size_capped) {
+      // The ceiling was already reached: this file and the ones after it
+      // are cut off.
+      ++out->truncated;
+      continue;
+    }
+    // The subtraction cannot underflow: total_bytes never exceeds the
+    // ceiling, and the addition that would overflow is never done.
+    if (file.size > ceiling - out->total_bytes) {
+      out->size_capped = true;
+      ++out->truncated;
+      continue;
+    }
+    out->entries.push_back(ProfileBundleEntry{file.relative_path, file.size});
+    out->total_bytes += file.size;
+  }
+}
+
+}  // namespace lengsuo::fp
diff --git a/lengsuo/native/profile_bundle.h b/lengsuo/native/profile_bundle.h
new file mode 100644
index 0000000..1daf910
--- /dev/null
+++ b/lengsuo/native/profile_bundle.h
@@ -0,0 +1,153 @@
+// profile_bundle - the collection rules for the profile upload (task R).
+//
+// When a container closes, the profile's files are packed into a zip and
+// uploaded to the platform (channel 4). The kernel side owns *which* files
+// are collected; the client side owns the packing and the upload.
+//
+// The rules are configuration, not code. The runner sends them in the
+// ConfigBundle (frame type 0x03) and the kernel applies whatever the
+// bundle says. Nothing in this file names a particular file: "History" is
+// collected because the configuration lists it, not because this code
+// knows what History is.
+//
+// What the configuration carries (contract section 8):
+//
+//   include            glob patterns; a file is collected when it matches
+//                      at least one of them
+//   exclude            glob patterns; a file is never collected when it
+//                      matches one of them
+//   max_package_bytes  the ceiling on the collected bytes
+//
+// Two rules are not negotiable:
+//
+//   * The exclude list wins. "Cookies" and "Network Cache" stay out
+//     whatever else the configuration says.
+//   * A file that cannot be read is skipped and counted. One locked file
+//     never fails the collection: a browser that refuses to close because
+//     of it is worse than one that uploads slightly less.
+//
+// The manifest this produces is the shape the two repos agree on:
+//
+//   * the path is relative to the profile root, always '/' separated,
+//     never absolute, never "..";
+//   * the entries are ordered byte-wise ascending by the path's bytes;
+//   * the size is the file's size in bytes.
+//
+// See docs/kernel-wire-contract.md section 8 for the same rules in prose.
+#ifndef LENGSUO_NATIVE_PROFILE_BUNDLE_H_
+#define LENGSUO_NATIVE_PROFILE_BUNDLE_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace lengsuo::fp {
+
+// The ceiling on one package: 32 MiB.
+//
+// A collection that reaches it is cut short and the cut is counted. The
+// configuration may lower this ceiling; it may never raise it.
+inline constexpr std::uint64_t kProfileBundleMaxBytes =
+    32ULL * 1024ULL * 1024ULL;
+
+// The name of the configuration section that carries the rules.
+inline constexpr char kProfileSyncConfigKey[] = "profile_sync";
+
+// The rules the configuration carries.
+struct ProfileSyncConfig {
+  // The patterns a file must match to be collected. An empty list
+  // collects nothing: the list is a white list, and a white list that is
+  // empty is an empty collection.
+  std::vector<std::string> include;
+  // The patterns a file must not match. An exclude wins over an include.
+  std::vector<std::string> exclude;
+  // The ceiling on the collected bytes. Zero means "unset", which is the
+  // fixed ceiling above.
+  std::uint64_t max_package_bytes = kProfileBundleMaxBytes;
+};
+
+// The default set of rules (contract section 8): the white list minus the
+// black list, plus History.
+//
+// The runner sends this when the platform does not override it, so the
+// constant here is the kernel's mirror of the runner's default rather than
+// a second opinion about it. The contract keeps the two together.
+ProfileSyncConfig DefaultProfileSyncConfig();
+
+// Reads the profile_sync section out of a frozen configuration bundle.
+//
+// A bundle without the section means the platform did not ask for a
+// profile upload: the function fails and the caller collects nothing.
+// `*error` then says so. A malformed section fails the same way - a
+// configuration that cannot be read is not a configuration that is
+// partially obeyed.
+bool ParseProfileSyncConfig(std::string_view bundle_json,
+                            ProfileSyncConfig* out,
+                            std::string* error);
+
+// Matches `text` against a glob pattern.
+//
+//   '*'  matches any run of bytes, '/' included
+//   '?'  matches exactly one byte
+//
+// The comparison is byte-wise and case-sensitive: the profile's own
+// directory names are spelled the same way on every platform, and a
+// locale-aware comparison would not agree across two repos.
+bool MatchGlob(std::string_view pattern, std::string_view text);
+
+// One file the caller found under the profile root.
+struct ProfileFile {
+  // The path relative to the profile root, '/' separated.
+  std::string relative_path;
+  // The file's size in bytes.
+  std::uint64_t size = 0;
+  // False when the file could not be read. Such a file is skipped and
+  // counted; it never fails the collection.
+  bool readable = true;
+};
+
+// One collected file.
+struct ProfileBundleEntry {
+  // The path relative to the profile root. Never absolute, never "..".
+  std::string path;
+  // The file's size in bytes.
+  std::uint64_t size = 0;
+};
+
+// The result of applying the rules to a set of files.
+struct ProfileBundle {
+  // The collected files, byte-wise ascending by path.
+  std::vector<ProfileBundleEntry> entries;
+  // The sum of the collected files' sizes.
+  std::uint64_t total_bytes = 0;
+  // Files that could not be read. Skipped, never fatal.
+  std::uint64_t skipped_unreadable = 0;
+  // Files the rules did not collect: no include pattern matched, or an
+  // exclude pattern did.
+  std::uint64_t excluded = 0;
+  // Files that would have been collected but did not fit under the
+  // ceiling.
+  std::uint64_t truncated = 0;
+  // True when the ceiling cut the collection short.
+  bool size_capped = false;
+};
+
+// Applies the rules to `files` and fills `*out`.
+//
+// The entries come out ordered byte-wise ascending by path, so two repos
+// that collect the same profile agree on the order without talking to
+// each other. The ceiling is applied to that order, not to the order the
+// files arrived in: a collection that depended on the caller's directory
+// walk would differ between two machines that see the same profile.
+//
+// A file that does not fit under the ceiling ends the collection; the
+// files after it are counted as truncated.
+void CollectProfileBundle(const ProfileSyncConfig& config,
+                          const std::vector<ProfileFile>& files,
+                          ProfileBundle* out);
+
+}  // namespace lengsuo::fp
+
+#endif  // LENGSUO_NATIVE_PROFILE_BUNDLE_H_
diff --git a/lengsuo/native/profile_bundle_test.cc b/lengsuo/native/profile_bundle_test.cc
new file mode 100644
index 0000000..761aeae
--- /dev/null
+++ b/lengsuo/native/profile_bundle_test.cc
@@ -0,0 +1,392 @@
+// profile_bundle_test - the collection rules for the profile upload.
+//
+// The tests are about the rules, not about the plumbing: which files are
+// collected, which never are, and what happens when the collection does
+// not fit.
+//
+// The four rulings this card implements each get a test of their own:
+//
+//   1B  the history is collected by default
+//   2A  a file that cannot be read is skipped, not fatal
+//   3A  the canvas bitmap is not collected (the action table's default,
+//        which this card leaves alone - see the note below)
+//   and the size ceiling cuts the collection short
+//
+// The bitmap rule is not this file's business: the action table owns it
+// and its default is already off. This file only checks that nothing here
+// turns it on.
+#include "profile_bundle.h"
+
+#include <gtest/gtest.h>
+
+#include <string>
+#include <vector>
+
+namespace lengsuo::fp {
+namespace {
+
+// A file the caller found under the profile root.
+ProfileFile File(const std::string& path, std::uint64_t size) {
+  ProfileFile file;
+  file.relative_path = path;
+  file.size = size;
+  return file;
+}
+
+// The paths of the collected entries, in order.
+std::vector<std::string> Paths(const ProfileBundle& bundle) {
+  std::vector<std::string> paths;
+  paths.reserve(bundle.entries.size());
+  for (const ProfileBundleEntry& entry : bundle.entries) {
+    paths.push_back(entry.path);
+  }
+  return paths;
+}
+
+// A configuration with the ruling's white list and black list.
+ProfileSyncConfig Config() {
+  return DefaultProfileSyncConfig();
+}
+
+TEST(ProfileSyncConfig, DefaultCarriesTheRulingLists) {
+  const ProfileSyncConfig config = Config();
+  // The white list: local storage, extension state, and - by ruling 1B -
+  // the history.
+  EXPECT_NE(std::find(config.include.begin(), config.include.end(),
+                      "*Local Storage*"),
+            config.include.end());
+  EXPECT_NE(std::find(config.include.begin(), config.include.end(),
+                      "*Extension State*"),
+            config.include.end());
+  EXPECT_NE(std::find(config.include.begin(), config.include.end(),
+                      "*History*"),
+            config.include.end());
+  // The black list.
+  EXPECT_NE(std::find(config.exclude.begin(), config.exclude.end(), "*Cache*"),
+            config.exclude.end());
+  EXPECT_NE(std::find(config.exclude.begin(), config.exclude.end(),
+                      "*Cookies*"),
+            config.exclude.end());
+  EXPECT_NE(std::find(config.exclude.begin(), config.exclude.end(),
+                      "*Network*"),
+            config.exclude.end());
+  EXPECT_EQ(config.max_package_bytes, kProfileBundleMaxBytes);
+}
+
+TEST(MatchGlob, MatchesThePatternsTheListsUse) {
+  // ⭐ These are the contract's glob fixed vectors (section 4.6.3),
+  // copied one for one. The client repo asserts the same list in
+  // `kernel_pipe/profile_rules.rs`, and
+  // `tools/cross_repo_rules.py` compares the two sides against the
+  // contract, so a vector dropped or added on one side is caught.
+  EXPECT_TRUE(MatchGlob("*Local Storage*", "Default/Local Storage/leveldb/0001.log"));
+  EXPECT_TRUE(MatchGlob("*Local Storage*", "Local Storage"));
+  EXPECT_TRUE(MatchGlob("*History*", "Default/History"));
+  // The one vector that exposes a case-insensitive matcher. Without
+  // it a matcher that stopped comparing case would keep every one of
+  // these assertions green while computing a different manifest from
+  // the client's.
+  EXPECT_FALSE(MatchGlob("*History*", "Default/history"));
+  EXPECT_TRUE(MatchGlob("*Extension State*", "Default/Extension State/1.dat"));
+  EXPECT_TRUE(MatchGlob("*Cache*", "Default/Cache/data_0"));
+  // The two floor patterns, so the floor itself is pinned by a vector
+  // and not only by the code that reads it.
+  EXPECT_TRUE(MatchGlob("*Cookies*", "Default/Cookies"));
+  EXPECT_TRUE(MatchGlob("*Network*", "Default/Network/Cookies"));
+  // A pattern without a star matches only itself.
+  EXPECT_TRUE(MatchGlob("History", "History"));
+  EXPECT_FALSE(MatchGlob("History", "Default/History"));
+  // '?' matches exactly one byte.
+  EXPECT_TRUE(MatchGlob("file?.dat", "file1.dat"));
+  EXPECT_FALSE(MatchGlob("file?.dat", "file12.dat"));
+  EXPECT_TRUE(MatchGlob("a?c", "abc"));
+  EXPECT_FALSE(MatchGlob("a?c", "ac"));
+  // An empty pattern matches only an empty text.
+  EXPECT_TRUE(MatchGlob("", ""));
+  EXPECT_FALSE(MatchGlob("", "x"));
+  // '*' matches any run of bytes, the empty one included.
+  EXPECT_TRUE(MatchGlob("*", ""));
+  EXPECT_TRUE(MatchGlob("*", "anything"));
+  // '*' spans '/', so it eats a byte run and not a path segment.
+  EXPECT_TRUE(MatchGlob("*.log", "a/b.log"));
+  EXPECT_TRUE(MatchGlob("*History*", "Default/History/x"));
+}
+
+TEST(CollectProfileBundle, DefaultSetContainsHistory) {
+  // Ruling 1B: the history is uploaded by default.
+  ProfileBundle bundle;
+  CollectProfileBundle(Config(),
+                       {File("Default/History", 163840),
+                        File("Default/Local Storage/leveldb/0001.log", 4096)},
+                       &bundle);
+  const std::vector<std::string> paths = Paths(bundle);
+  ASSERT_EQ(paths.size(), 2u);
+  EXPECT_EQ(paths[0], "Default/History");
+  EXPECT_EQ(paths[1], "Default/Local Storage/leveldb/0001.log");
+  EXPECT_EQ(bundle.total_bytes, 163840u + 4096u);
+}
+
+TEST(CollectProfileBundle, HistoryScopeIsStillThePatternsScope) {
+  // 1B does not mean "the whole history directory": the collection range
+  // is the pattern's, so a pattern that names one file collects that file
+  // and not its neighbours.
+  ProfileSyncConfig config = Config();
+  config.include = {"Default/History"};
+  ProfileBundle bundle;
+  CollectProfileBundle(config,
+                       {File("Default/History", 100),
+                        File("Default/History-journal", 100),
+                        File("Default/Preferences", 100)},
+                       &bundle);
+  const std::vector<std::string> paths = Paths(bundle);
+  ASSERT_EQ(paths.size(), 1u);
+  EXPECT_EQ(paths[0], "Default/History");
+  EXPECT_EQ(bundle.excluded, 2u);
+}
+
+TEST(CollectProfileBundle, WhiteListHitsAndBlackListExcludes) {
+  ProfileBundle bundle;
+  CollectProfileBundle(
+      Config(),
+      {File("Default/Local Storage/leveldb/0001.log", 10),
+       File("Default/Extension State/abc.dat", 20),
+       File("Default/Cache/data_0", 30),
+       File("Default/Cookies", 40),
+       File("Default/Network Cache/data_1", 50),
+       File("Default/Preferences", 60)},
+      &bundle);
+  const std::vector<std::string> paths = Paths(bundle);
+  ASSERT_EQ(paths.size(), 2u);
+  EXPECT_EQ(paths[0], "Default/Extension State/abc.dat");
+  EXPECT_EQ(paths[1], "Default/Local Storage/leveldb/0001.log");
+  EXPECT_EQ(bundle.excluded, 4u);
+}
+
+TEST(CollectProfileBundle, CookiesAndNetworkCacheNeverGoOut) {
+  // The exclude list says so, but the configuration is remote input. A
+  // platform that listed the cookies in the include list must still not
+  // get them: the two patterns are a floor, not a preference.
+  ProfileSyncConfig config;
+  config.include = {"*"};
+  config.exclude = {};
+  ProfileBundle bundle;
+  CollectProfileBundle(config,
+                       {File("Default/Cookies", 10),
+                        File("Default/Network/Cookies", 10),
+                        File("Default/Local Storage/x", 10)},
+                       &bundle);
+  const std::vector<std::string> paths = Paths(bundle);
+  ASSERT_EQ(paths.size(), 1u);
+  EXPECT_EQ(paths[0], "Default/Local Storage/x");
+}
+
+TEST(CollectProfileBundle, ExcludeWinsOverInclude) {
+  ProfileSyncConfig config;
+  config.include = {"*Local Storage*"};
+  config.exclude = {"*Cache*"};
+  ProfileBundle bundle;
+  CollectProfileBundle(config,
+                       {File("Default/Local Storage/leveldb/Cache/0001.log", 10),
+                        File("Default/Local Storage/leveldb/0002.log", 10)},
+                       &bundle);
+  const std::vector<std::string> paths = Paths(bundle);
+  ASSERT_EQ(paths.size(), 1u);
+  EXPECT_EQ(paths[0], "Default/Local Storage/leveldb/0002.log");
+}
+
+TEST(CollectProfileBundle, AnUnreadableFileIsSkippedAndCounted) {
+  // Ruling 2A's kernel-side half: one file that cannot be read must not
+  // fail the collection.
+  ProfileFile locked = File("Default/Local Storage/locked.log", 100);
+  locked.readable = false;
+  ProfileBundle bundle;
+  CollectProfileBundle(
+      Config(), {locked, File("Default/Local Storage/ok.log", 10)}, &bundle);
+  const std::vector<std::string> paths = Paths(bundle);
+  ASSERT_EQ(paths.size(), 1u);
+  EXPECT_EQ(paths[0], "Default/Local Storage/ok.log");
+  EXPECT_EQ(bundle.skipped_unreadable, 1u);
+  EXPECT_EQ(bundle.total_bytes, 10u);
+}
+
+TEST(CollectProfileBundle, TheCeilingCutsTheCollectionShort) {
+  ProfileSyncConfig config = Config();
+  config.max_package_bytes = 100;
+  ProfileBundle bundle;
+  CollectProfileBundle(config,
+                       {File("Default/History", 60),
+                        File("Default/Local Storage/a.log", 60),
+                        File("Default/Local Storage/b.log", 10)},
+                       &bundle);
+  // The order is by path, so "Default/History" is first and fits; the
+  // second file does not and cuts the collection short.
+  const std::vector<std::string> paths = Paths(bundle);
+  ASSERT_EQ(paths.size(), 1u);
+  EXPECT_EQ(paths[0], "Default/History");
+  EXPECT_TRUE(bundle.size_capped);
+  EXPECT_EQ(bundle.truncated, 2u);
+  EXPECT_LE(bundle.total_bytes, 100u);
+}
+
+TEST(CollectProfileBundle, TheCeilingIsNeverRaisedByTheConfiguration) {
+  ProfileSyncConfig config = Config();
+  config.max_package_bytes = kProfileBundleMaxBytes * 4;
+  ProfileBundle bundle;
+  CollectProfileBundle(config, {File("Default/History", 10)}, &bundle);
+  EXPECT_EQ(bundle.size_capped, false);
+}
+
+TEST(CollectProfileBundle, TheOrderIsByPathNotByArrival) {
+  // Two repos that hold the same profile must produce the same manifest
+  // without exchanging anything, so the order cannot depend on the order
+  // the caller's directory walk happened to produce.
+  ProfileBundle first;
+  CollectProfileBundle(Config(),
+                       {File("Default/Local Storage/b.log", 1),
+                        File("Default/History", 1),
+                        File("Default/Extension State/a.dat", 1)},
+                       &first);
+  ProfileBundle second;
+  CollectProfileBundle(Config(),
+                       {File("Default/Extension State/a.dat", 1),
+                        File("Default/History", 1),
+                        File("Default/Local Storage/b.log", 1)},
+                       &second);
+  const std::vector<std::string> a = Paths(first);
+  const std::vector<std::string> b = Paths(second);
+  ASSERT_EQ(a.size(), 3u);
+  EXPECT_EQ(a, b);
+  EXPECT_EQ(a[0], "Default/Extension State/a.dat");
+  EXPECT_EQ(a[1], "Default/History");
+  EXPECT_EQ(a[2], "Default/Local Storage/b.log");
+}
+
+TEST(CollectProfileBundle, AnEmptyWhiteListCollectsNothing) {
+  ProfileSyncConfig config;
+  config.include = {};
+  config.exclude = {};
+  ProfileBundle bundle;
+  CollectProfileBundle(config, {File("Default/History", 10)}, &bundle);
+  EXPECT_TRUE(bundle.entries.empty());
+  EXPECT_EQ(bundle.excluded, 1u);
+}
+
+TEST(ProfileSyncConfig, ParsesTheSectionTheRunnerSends) {
+  const char kBundle[] =
+      R"({"profile_sync":{"include":["*History*","*Local Storage*"],)"
+      R"("exclude":["*Cache*","*Cookies*","*Network*"],)"
+      R"("max_package_bytes":1048576}})";
+  ProfileSyncConfig config;
+  std::string error;
+  ASSERT_TRUE(ParseProfileSyncConfig(kBundle, &config, &error)) << error;
+  ASSERT_EQ(config.include.size(), 2u);
+  EXPECT_EQ(config.include[0], "*History*");
+  EXPECT_EQ(config.include[1], "*Local Storage*");
+  ASSERT_EQ(config.exclude.size(), 3u);
+  EXPECT_EQ(config.exclude[2], "*Network*");
+  EXPECT_EQ(config.max_package_bytes, 1048576u);
+}
+
+TEST(ProfileSyncConfig, TheConfigurationMayLowerTheCeilingButNotRaiseIt) {
+  const char kBundle[] =
+      R"({"profile_sync":{"include":["*History*"],"max_package_bytes":999999999}})";
+  ProfileSyncConfig config;
+  std::string error;
+  ASSERT_TRUE(ParseProfileSyncConfig(kBundle, &config, &error)) << error;
+  EXPECT_EQ(config.max_package_bytes, kProfileBundleMaxBytes);
+}
+
+TEST(ProfileSyncConfig, ABundleWithoutTheSectionIsNotACollection) {
+  const char kBundle[] = R"({"something_else":1})";
+  ProfileSyncConfig config;
+  std::string error;
+  EXPECT_FALSE(ParseProfileSyncConfig(kBundle, &config, &error));
+  EXPECT_FALSE(error.empty());
+}
+
+TEST(ProfileSyncConfig, AMalformedSectionIsRefusedNotPartiallyObeyed) {
+  const char kBundle[] = R"({"profile_sync":{"include":"not an array"}})";
+  ProfileSyncConfig config;
+  std::string error;
+  EXPECT_FALSE(ParseProfileSyncConfig(kBundle, &config, &error));
+  EXPECT_FALSE(error.empty());
+}
+
+TEST(ProfileSyncConfig, AMalformedBundleIsRefused) {
+  ProfileSyncConfig config;
+  std::string error;
+  EXPECT_FALSE(ParseProfileSyncConfig("{not json", &config, &error));
+  EXPECT_FALSE(error.empty());
+}
+
+TEST(ProfileSyncConfig, TheDefaultSectionRoundTripsThroughTheParser) {
+  // The runner sends the default when the platform does not override it.
+  // The kernel's default and the runner's default must be the same rules.
+  const ProfileSyncConfig kernel_default = DefaultProfileSyncConfig();
+  std::string json = "{\"profile_sync\":{\"include\":[";
+  for (std::size_t i = 0; i < kernel_default.include.size(); ++i) {
+    if (i != 0) {
+      json += ",";
+    }
+    json += "\"" + kernel_default.include[i] + "\"";
+  }
+  json += "],\"exclude\":[";
+  for (std::size_t i = 0; i < kernel_default.exclude.size(); ++i) {
+    if (i != 0) {
+      json += ",";
+    }
+    json += "\"" + kernel_default.exclude[i] + "\"";
+  }
+  json += "]}}";
+  ProfileSyncConfig parsed;
+  std::string error;
+  ASSERT_TRUE(ParseProfileSyncConfig(json, &parsed, &error)) << error;
+  EXPECT_EQ(parsed.include, kernel_default.include);
+  EXPECT_EQ(parsed.exclude, kernel_default.exclude);
+  EXPECT_EQ(parsed.max_package_bytes, kernel_default.max_package_bytes);
+}
+
+TEST(ProfileSyncConfig, TheRunnerPayloadIsTheCrossRepoVector) {
+  // The bytes the runner actually sends, hardcoded.
+  //
+  // The client repo hardcodes the same 155 bytes in
+  // `crates/lengsuo-desktop/src/kernel_pipe/profile_vectors.rs`
+  // (`CONFIG_BUNDLE_PAYLOAD`) and asserts that its own output matches
+  // them. This is the kernel's copy of that vector.
+  //
+  // Why it is hardcoded rather than assembled: a test that built the
+  // expected value out of the same constants it is checking would agree
+  // with a broken implementation, and "both sides are wrong" would look
+  // like "both sides match". The two repos compare the literals
+  // directly -- `tools/cross_repo_vectors.py` reads this one and the
+  // client's, and requires them to be identical.
+  //
+  // Note the payload carries `max_package_bytes` explicitly. The
+  // round-trip test above leaves it out, which is a shorter string: the
+  // runner's payload and the kernel's own assembly are not the same
+  // bytes, and only the runner's bytes travel on the wire.
+  constexpr char kRunnerPayload[] =
+      R"({"profile_sync":{"include":["*Local Storage*","*Extension State*","*History*"],"exclude":["*Cache*","*Cookies*","*Network*"],"max_package_bytes":33554432}})";
+
+  // The kernel's own default must produce exactly these rules.
+  ProfileSyncConfig parsed;
+  std::string error;
+  ASSERT_TRUE(ParseProfileSyncConfig(kRunnerPayload, &parsed, &error))
+      << error;
+
+  const ProfileSyncConfig kernel_default = DefaultProfileSyncConfig();
+  EXPECT_EQ(parsed.include, kernel_default.include);
+  EXPECT_EQ(parsed.exclude, kernel_default.exclude);
+  EXPECT_EQ(parsed.max_package_bytes, kernel_default.max_package_bytes);
+
+  // The length is pinned because it is the frame header's `len` field.
+  EXPECT_EQ(std::string(kRunnerPayload).size(), 155u);
+
+  // The payload carries rules only: no key, no session key, no bitmap.
+  const std::string payload(kRunnerPayload);
+  EXPECT_EQ(payload.find("key"), std::string::npos);
+  EXPECT_EQ(payload.find("data_url"), std::string::npos);
+}
+
+}  // namespace
+}  // namespace lengsuo::fp
diff --git a/lengsuo/native/profile_catalog.cc b/lengsuo/native/profile_catalog.cc
new file mode 100644
index 0000000..dcde68d
--- /dev/null
+++ b/lengsuo/native/profile_catalog.cc
@@ -0,0 +1,155 @@
+#include "profile_catalog.h"
+
+#include <cstdint>
+#include <string_view>
+#include <vector>
+
+#include "wire_reader.h"
+
+namespace lengsuo {
+namespace {
+constexpr std::size_t kMaxContainer = 4096;
+constexpr std::size_t kMaxEntries = 16;
+constexpr std::size_t kMaxBrands = 8;
+constexpr std::size_t kMaxGpuEntries = 16;
+
+bool ReadBrand(WireReader& reader, CatalogBrand& brand) {
+  return reader.Text(brand.name, 32) && reader.Text(brand.version, 32);
+}
+
+// Trailing optional section: face tag "gpu", count, then per entry
+// slot(4) + vendor + renderer. Absent section = catalog carries no GPU faces.
+bool ReadGpuSection(WireReader& reader, std::vector<CatalogGpuEntry>& out) {
+  std::string tag;
+  if (!reader.Text(tag, 12, true) || tag != "gpu") {
+    return false;
+  }
+  std::uint32_t count = 0;
+  if (!reader.Number(count, 2) || count == 0 || count > kMaxGpuEntries) {
+    return false;
+  }
+  out.resize(count);
+  for (auto& entry : out) {
+    if (!reader.Number(entry.slot, 4) || !InRange(entry.slot, 1, 1048576) ||
+        !reader.Text(entry.vendor, 128) || !reader.Text(entry.renderer, 256)) {
+      return false;
+    }
+  }
+  for (std::size_t i = 0; i < out.size(); ++i) {
+    for (std::size_t j = i + 1; j < out.size(); ++j) {
+      if (out[i].slot == out[j].slot) {
+        return false;
+      }
+    }
+  }
+  return true;
+}
+bool ReadBrandList(WireReader& reader, std::vector<CatalogBrand>& out,
+                   bool allow_empty) {
+  std::uint32_t count;
+  if (!reader.Number(count, 1) || count > kMaxBrands ||
+      (!allow_empty && count == 0)) {
+    return false;
+  }
+  out.resize(count);
+  for (auto& brand : out) {
+    if (!ReadBrand(reader, brand)) {
+      return false;
+    }
+  }
+  return true;
+}
+}  // namespace
+
+std::optional<ParsedCatalog> DecodeCatalog(
+    std::span<const std::uint8_t> bytes) {
+  if (bytes.size() > kMaxContainer) {
+    return std::nullopt;
+  }
+  WireReader reader(bytes);
+  std::uint32_t value;
+  for (const auto character : std::string_view("LBPC1")) {
+    if (!reader.Number(value, 1) ||
+        value != static_cast<unsigned char>(character)) {
+      return std::nullopt;
+    }
+  }
+  ParsedCatalog catalog;
+  if (!reader.Number(catalog.schema_version, 4) ||
+      catalog.schema_version != 1 ||
+      !reader.Text(catalog.pool_version, 64, true)) {
+    return std::nullopt;
+  }
+  if (!reader.Number(value, 2) || value == 0 || value > kMaxEntries) {
+    return std::nullopt;
+  }
+  catalog.ua_entries.resize(value);
+  for (auto& entry : catalog.ua_entries) {
+    std::string face;
+    if (!reader.Text(face, 12, true) || face != "ua" ||
+        !reader.Number(entry.slot, 4) || !InRange(entry.slot, 1, 1048576) ||
+        !reader.Text(entry.ua_string, 512) ||
+        !ReadBrandList(reader, entry.brands, false) ||
+        !ReadBrandList(reader, entry.full_versions, true) ||
+        !reader.Text(entry.platform, 32) ||
+        !reader.Text(entry.platform_version, 64) ||
+        !reader.Text(entry.architecture, 32) ||
+        !reader.Text(entry.bitness, 8) ||
+        !reader.OptionalText(entry.model, 128)) {
+      return std::nullopt;
+    }
+    std::uint8_t mobile;
+    if (!reader.Byte(mobile) || mobile > 1) {
+      return std::nullopt;
+    }
+    entry.mobile = mobile == 1;
+  }
+  // Slots identify wire pool positions; duplicates make resolution ambiguous.
+  for (std::size_t i = 0; i < catalog.ua_entries.size(); ++i) {
+    for (std::size_t j = i + 1; j < catalog.ua_entries.size(); ++j) {
+      if (catalog.ua_entries[i].slot == catalog.ua_entries[j].slot) {
+        return std::nullopt;
+      }
+    }
+  }
+  // Optional trailing GPU section. A schema-1 catalog without it ends here,
+  // so every previously valid catalog keeps decoding unchanged.
+  if (!reader.End()) {
+    if (!ReadGpuSection(reader, catalog.gpu_entries)) {
+      return std::nullopt;
+    }
+    if (!reader.End()) {
+      return std::nullopt;
+    }
+  }
+  return catalog;
+}
+
+bool CatalogMatchesProfile(const ParsedCatalog& catalog,
+                           const ParsedProfile& profile) {
+  return !catalog.pool_version.empty() &&
+         catalog.pool_version == profile.pool_version;
+}
+const CatalogUaEntry* ResolveCatalogUa(const ParsedCatalog& catalog,
+                                      const ParsedProfile& profile) {
+  if (!CatalogMatchesProfile(catalog, profile)) return nullptr;
+  const CatalogUaEntry* selected = nullptr;
+  for (const auto& entry : catalog.ua_entries) {
+    if (entry.slot != profile.slots[5]) continue;
+    if (selected) return nullptr;
+    selected = &entry;
+  }
+  return selected;
+}
+const CatalogGpuEntry* ResolveCatalogGpu(const ParsedCatalog& catalog,
+                                        const ParsedProfile& profile) {
+  if (!CatalogMatchesProfile(catalog, profile)) return nullptr;
+  const CatalogGpuEntry* selected = nullptr;
+  for (const auto& entry : catalog.gpu_entries) {
+    if (entry.slot != profile.slots[4]) continue;
+    if (selected) return nullptr;
+    selected = &entry;
+  }
+  return selected;
+}
+}  // namespace lengsuo
diff --git a/lengsuo/native/profile_catalog.h b/lengsuo/native/profile_catalog.h
new file mode 100644
index 0000000..1c23aec
--- /dev/null
+++ b/lengsuo/native/profile_catalog.h
@@ -0,0 +1,67 @@
+#ifndef LENGSUO_NATIVE_PROFILE_CATALOG_H_
+#define LENGSUO_NATIVE_PROFILE_CATALOG_H_
+
+#include <cstdint>
+#include <optional>
+#include <span>
+#include <string>
+#include <vector>
+
+#include "profile_wire.h"
+
+namespace lengsuo {
+// Decoding only: no signature/lease verification, runner authorization or
+// browser injection is implied by a decoded catalog.
+struct CatalogBrand {
+  std::string name;
+  std::string version;
+};
+
+// One resolved "ua" slot: exactly the values the two browser exits need
+// (override string and client-hints metadata). Fields the catalog does not
+// carry stay upstream; nothing is fabricated here.
+struct CatalogUaEntry {
+  std::uint32_t slot{};
+  std::string ua_string;
+  std::vector<CatalogBrand> brands;
+  std::vector<CatalogBrand> full_versions;
+  std::string platform;
+  std::string platform_version;
+  std::string architecture;
+  std::string bitness;
+  std::string model;
+  bool mobile{};
+};
+
+// One resolved "gpu" slot: the two WebGL face strings. Kept separate from UA
+// entries so a profile can pin GPU and UA independently.
+struct CatalogGpuEntry {
+  std::uint32_t slot{};
+  std::string vendor;
+  std::string renderer;
+};
+struct ParsedCatalog {
+  std::uint32_t schema_version{};
+  std::string pool_version;
+  std::vector<CatalogUaEntry> ua_entries;
+  // Absent in catalog schema 1; optional for backward compatibility.
+  std::vector<CatalogGpuEntry> gpu_entries;
+};
+
+// All malformed input returns nullopt; no partially parsed catalog escapes.
+std::optional<ParsedCatalog> DecodeCatalog(std::span<const std::uint8_t> bytes);
+
+// Binding check: a catalog may only serve a profile from the same pool.
+bool CatalogMatchesProfile(const ParsedCatalog& catalog,
+                           const ParsedProfile& profile);
+// Returns a borrowed entry only for an exact pool and unique UA-slot match.
+// The caller must keep the catalog alive and immutable while using the entry.
+const CatalogUaEntry* ResolveCatalogUa(const ParsedCatalog& catalog,
+                                      const ParsedProfile& profile);
+// Returns the unique GPU face for profile.slots[4], or nullptr when the
+// catalog carries no GPU section or the slot is missing/ambiguous. Caller
+// must keep the catalog alive.
+const CatalogGpuEntry* ResolveCatalogGpu(const ParsedCatalog& catalog,
+                                         const ParsedProfile& profile);
+}  // namespace lengsuo
+#endif
diff --git a/lengsuo/native/profile_wire.cc b/lengsuo/native/profile_wire.cc
new file mode 100644
index 0000000..14d0c5e
--- /dev/null
+++ b/lengsuo/native/profile_wire.cc
@@ -0,0 +1,120 @@
+#include "profile_wire.h"
+
+#include <string_view>
+
+#include "wire_reader.h"
+
+namespace lengsuo {
+std::optional<ParsedProfile> DecodeProfile(
+    std::span<const std::uint8_t> bytes) {
+  if (bytes.size() > 4096) {
+    return std::nullopt;
+  }
+  WireReader reader(bytes);
+  std::uint32_t value;
+  for (const auto character : std::string_view("LBPF1")) {
+    if (!reader.Number(value, 1) ||
+        value != static_cast<unsigned char>(character)) {
+      return std::nullopt;
+    }
+  }
+  ParsedProfile profile;
+  if (!reader.Number(profile.schema_version, 4) ||
+      !InRange(profile.schema_version, 1, 2) ||
+      !reader.Number(profile.noise_version, 4) || profile.noise_version != 1 ||
+      !reader.Text(profile.environment_id, 64, true) ||
+      !reader.Text(profile.pool_version, 64, true)) {
+    return std::nullopt;
+  }
+  for (auto& byte : profile.noise_seed) {
+    if (!reader.Number(value, 1)) {
+      return std::nullopt;
+    }
+    byte = static_cast<std::uint8_t>(value);
+  }
+  if (!reader.Number(value, 1) || value > 4) {
+    return std::nullopt;
+  }
+  profile.platform = static_cast<Platform>(value);
+  if (!reader.Number(profile.width, 4) || !InRange(profile.width, 1, 16384) ||
+      !reader.Number(profile.height, 4) || !InRange(profile.height, 1, 16384) ||
+      static_cast<std::uint64_t>(profile.width) * profile.height >
+          64 * 1024 * 1024 ||
+      !reader.Number(value, 1) || (value != 8 && value != 24 && value != 30)) {
+    return std::nullopt;
+  }
+  profile.color_depth = static_cast<std::uint8_t>(value);
+  if (!reader.Number(profile.dpr_milli, 4) ||
+      !InRange(profile.dpr_milli, 1, 10000) || !reader.Number(value, 2) ||
+      !InRange(value, 1, 1024)) {
+    return std::nullopt;
+  }
+  profile.cpu_cores = static_cast<std::uint16_t>(value);
+  if (!reader.Number(profile.memory_mib, 4) ||
+      !InRange(profile.memory_mib, 128, 1048576) || !reader.Number(value, 1) ||
+      value > 10 ||
+      ((profile.platform == Platform::Android ||
+        profile.platform == Platform::Ios) && value == 0)) {
+    return std::nullopt;
+  }
+  profile.max_touch_points = static_cast<std::uint8_t>(value);
+  if (!reader.Text(profile.language, 35) || !reader.Text(profile.timezone, 64)) {
+    return std::nullopt;
+  }
+  // Schema 2 carries one webrtc policy byte after timezone and before the
+  // slot table (W3 layout, docs/webrtc-schema2-native.md);
+  // schema 1 offsets are unchanged and carry no statement.
+  if (profile.schema_version == 2) {
+    if (!reader.Number(value, 1) || value > 3) {
+      return std::nullopt;
+    }
+    profile.webrtc_policy = static_cast<std::uint8_t>(value);
+    // Optional trailing font section, before the slot table. Writers that
+    // predate the font dimension (and every schema-1 profile) simply stop
+    // here, so every previously valid profile keeps decoding byte-identically
+    // -- the same optional-tail rule the catalog's GPU section uses.
+    //
+    // The section is one `fonts` tag followed by the {switcher, value, mask}
+    // triple: a 1-byte switcher (online encoding 1/2/3), the
+    // semicolon-separated family string, and a 1-byte mask. The reader accepts
+    // exactly one such section followed by the slot table. Two-char and
+    // four-char lookaheads cannot both be "fonts", so an accidental
+    // `fontsfonts` payload fails instead of being silently skipped.
+    std::string probe;
+    const auto mark = reader.position();
+    if (reader.PeekText(probe) && probe == "fonts") {
+      reader.Seek(mark + 2 + probe.size());
+      ParsedProfile::FontDimension fonts;
+      if (!reader.Number(value, 1) || !InRange(value, 1, 3)) {
+        return std::nullopt;
+      }
+      fonts.switcher = static_cast<std::uint8_t>(value);
+      if (!reader.OptionalText(fonts.value, 4096)) {
+        return std::nullopt;
+      }
+      if (!reader.Number(value, 1) || value > 1) {
+        return std::nullopt;
+      }
+      fonts.mask = static_cast<std::uint8_t>(value);
+      profile.fonts = std::move(fonts);
+    }
+  }
+  if (!reader.Number(value, 2) || value != 7) {
+    return std::nullopt;
+  }
+  constexpr std::array<std::string_view, 7> names = {
+      "audio", "canvas", "client_rects", "fonts", "gpu", "ua", "webgl"};
+  for (std::size_t i = 0; i < names.size(); ++i) {
+    std::string name;
+    if (!reader.Text(name, 12, true) || name != names[i] ||
+        !reader.Number(profile.slots[i], 4) ||
+        !InRange(profile.slots[i], 1, 1048576)) {
+      return std::nullopt;
+    }
+  }
+  if (!reader.End()) {
+    return std::nullopt;
+  }
+  return profile;
+}
+}  // namespace lengsuo
diff --git a/lengsuo/native/profile_wire.h b/lengsuo/native/profile_wire.h
new file mode 100644
index 0000000..505f2d3
--- /dev/null
+++ b/lengsuo/native/profile_wire.h
@@ -0,0 +1,62 @@
+#ifndef LENGSUO_NATIVE_PROFILE_WIRE_H_
+#define LENGSUO_NATIVE_PROFILE_WIRE_H_
+
+#include <array>
+#include <cstdint>
+#include <optional>
+#include <span>
+#include <string>
+
+namespace lengsuo {
+enum class Platform : std::uint8_t {
+  Windows,
+  Linux,
+  Macos,
+  Android,
+  Ios
+};
+
+// Wire decoding only: no catalog resolution, signature/lease verification,
+// browser injection or fingerprint acceptance is implied by this value.
+struct ParsedProfile {
+  std::uint32_t schema_version{};
+  std::uint32_t noise_version{};
+  std::string environment_id;
+  std::string pool_version;
+  std::array<std::uint8_t, 8> noise_seed{};
+  Platform platform{};
+  std::uint32_t width{};
+  std::uint32_t height{};
+  std::uint32_t dpr_milli{};
+  std::uint32_t memory_mib{};
+  std::uint16_t cpu_cores{};
+  std::uint8_t color_depth{};
+  std::uint8_t max_touch_points{};
+  std::string language;
+  std::string timezone;
+  // Schema 2 only: the font dimension, shaped like every other overridable
+  // dimension -- {switcher, value, mask} (docs/font-dimension.md §3.1). `value`
+  // is the semicolon-separated family string 对标端 ships ("Arial;Arial Black");
+  // no structured inventory is fabricated client-side because the server-side
+  // pool was never captured. `mask` is the font_fingerprint_mask bit that turns
+  // the metric-noise mechanism on independently of a non-empty value. An omitted
+  // section means "the profile says nothing about fonts" (std::nullopt) and the
+  // host's real metrics are kept. An empty `value` is a legal statement ("decide
+  // by mask"), matching the empty-field convention the other dimensions use.
+  struct FontDimension {
+    std::uint8_t switcher{};
+    std::string value;
+    std::uint8_t mask{};
+  };
+  std::optional<FontDimension> fonts;
+  // audio, canvas, client_rects, fonts, gpu, ua, webgl, in canonical order.
+  std::array<std::uint32_t, 7> slots{};
+  // Schema 2 only: blink WebRtcIpHandlingPolicy enum value 0..3. Schema 1
+  // profiles carry no statement (nullopt) and leave upstream behavior.
+  std::optional<std::uint8_t> webrtc_policy;
+};
+
+// All malformed input returns nullopt; no partially parsed profile escapes.
+std::optional<ParsedProfile> DecodeProfile(std::span<const std::uint8_t> bytes);
+}  // namespace lengsuo
+#endif
diff --git a/lengsuo/native/resp_monitor.cc b/lengsuo/native/resp_monitor.cc
new file mode 100644
index 0000000..f95b9d7
--- /dev/null
+++ b/lengsuo/native/resp_monitor.cc
@@ -0,0 +1,126 @@
+#include "resp_monitor.h"
+
+#include <regex>
+#include <utility>
+
+namespace lengsuo::fp {
+
+void RespMonitorSetRules(RespMonitorState* state,
+                         const RespMonitorConfig& config) {
+  if (state == nullptr) {
+    return;
+  }
+  state->rules.clear();
+  if (config.enabled) {
+    for (const RespMonitorRule& rule : config.rules) {
+      // A rule that says it is off never reaches the config's rule list, so
+      // everything here is on. A rule without a matcher is not usable and is
+      // dropped.
+      if (rule.matcher != nullptr) {
+        state->rules.push_back(rule);
+      }
+    }
+  }
+
+  // Drop the counters and the switched-off marks of the rules that are no
+  // longer installed. The counters of the rules that stay are kept: pushing
+  // the same configuration down again - once per storage partition, for
+  // instance - must not hand a rule a fresh allowance.
+  std::set<std::string> installed;
+  for (const RespMonitorRule& rule : state->rules) {
+    installed.insert(rule.id);
+  }
+  for (auto it = state->hits.begin(); it != state->hits.end();) {
+    if (installed.count(it->first.first) == 0) {
+      it = state->hits.erase(it);
+    } else {
+      ++it;
+    }
+  }
+  for (auto it = state->disabled_rules.begin();
+       it != state->disabled_rules.end();) {
+    if (installed.count(*it) == 0) {
+      it = state->disabled_rules.erase(it);
+    } else {
+      ++it;
+    }
+  }
+}
+
+bool IsRespMonitorRequestEligible(const RespMonitorRequest& request) {
+  // Only http(s). `data:`, `blob:`, `chrome:`, `chrome-extension:`, `file:`
+  // and the rest are not responses the monitor reads.
+  if (request.scheme != "http" && request.scheme != "https") {
+    return false;
+  }
+  // A request with no initiator origin is the browser's own request: the
+  // runner's traffic, the component updater, a typed navigation. None of
+  // those is a page, and the monitor watches pages.
+  if (request.initiator_scheme.empty()) {
+    return false;
+  }
+  // An extension's request, whether it asks for an http(s) URL or not.
+  if (request.initiator_scheme == "chrome-extension") {
+    return false;
+  }
+  return true;
+}
+
+const RespMonitorRule* MatchRespMonitorRule(RespMonitorState* state,
+                                            const RespMonitorRequest& request,
+                                            std::string_view content_type) {
+  if (state == nullptr || state->rules.empty()) {
+    return nullptr;
+  }
+  if (!IsRespMonitorRequestEligible(request)) {
+    return nullptr;
+  }
+  const std::string normalized = NormalizeRespMonitorContentType(content_type);
+  for (const RespMonitorRule& rule : state->rules) {
+    if (state->disabled_rules.count(rule.id) != 0) {
+      continue;
+    }
+    if (rule.matcher == nullptr) {
+      continue;
+    }
+    if (!std::regex_search(request.url.cbegin(), request.url.cend(),
+                           *rule.matcher)) {
+      continue;
+    }
+    if (!rule.content_type.empty() && rule.content_type != normalized) {
+      continue;
+    }
+    const auto key = std::make_pair(rule.id, request.url);
+    auto it = state->hits.find(key);
+    const std::uint64_t used = it == state->hits.end() ? 0 : it->second;
+    if (used >= rule.max_count) {
+      // This rule has said what it had to say about this URL.
+      continue;
+    }
+    if (it == state->hits.end()) {
+      if (state->hits.size() >= kRespMonitorMaxTrackedUrls) {
+        // The counter map is the one thing that grows with traffic. It is
+        // full, so the rule that would grow it further is switched off.
+        RespMonitorDisableRule(state, rule.id);
+        continue;
+      }
+      state->hits.emplace(key, 1);
+    } else {
+      it->second = used + 1;
+    }
+    return &rule;
+  }
+  return nullptr;
+}
+
+void RespMonitorDisableRule(RespMonitorState* state,
+                            const std::string& rule_id) {
+  if (state == nullptr) {
+    return;
+  }
+  if (state->disabled_rules.insert(rule_id).second) {
+    ++state->failures;
+  }
+}
+
+}  // namespace lengsuo::fp
diff --git a/lengsuo/native/resp_monitor.h b/lengsuo/native/resp_monitor.h
new file mode 100644
index 0000000..2a82693
--- /dev/null
+++ b/lengsuo/native/resp_monitor.h
@@ -0,0 +1,108 @@
+// resp_monitor - the matching and the counting of the response monitor.
+//
+// The monitor sits in front of the network stack's responses and decides
+// which of them are worth reporting. The decision has three parts:
+//
+//   * Is this request one the monitor may look at at all? Only http(s) is.
+//     Everything else - `data:`, `blob:`, `chrome:`, `chrome-extension:`,
+//     `file:`, `about:` - is out of reach by construction. The browser's own
+//     requests are out of reach by construction too: they carry no
+//     initiator origin, and an extension's requests carry an extension
+//     origin. Neither is a page, and the monitor watches pages.
+//
+//   * Which rule does it belong to? The rule's regular expression is
+//     searched in the URL - the pattern may anchor itself, and a rule that
+//     wants the whole URL says so. A rule that names a media type only
+//     fires for that media type.
+//
+//   * Has that rule already said enough about that URL? The ceiling is per
+//     rule and per URL: a rule that says three allows three hits for one
+//     URL and then lets it go, while the same rule still watches a different
+//     URL.
+//
+// The rules are installed once, from the configuration. The counters live
+// beside them and are the only thing that grows with traffic, so they are
+// bounded: when the monitor has seen too many distinct URLs it switches the
+// rule that crossed the line off and counts the failure. A rule that is
+// switched off stops matching; it is not an error and it does not reach the
+// browser.
+#ifndef LENGSUO_NATIVE_RESP_MONITOR_H_
+#define LENGSUO_NATIVE_RESP_MONITOR_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <map>
+#include <set>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "resp_monitor_config.h"
+
+namespace lengsuo::fp {
+
+// How many distinct (rule, URL) pairs the monitor tracks before it switches
+// a rule off. The counter map is the only state that grows with the traffic
+// a page generates, and a page that generates an unbounded number of
+// distinct URLs is either misconfigured or hostile. Either way the monitor
+// stops rather than grows.
+inline constexpr std::size_t kRespMonitorMaxTrackedUrls = 4096;
+
+// What the monitor knows about a request.
+//
+// Everything here comes from what the network stack already knows. The
+// monitor guesses nothing: an unknown scheme is not http(s) and an unknown
+// initiator is the browser's own request.
+struct RespMonitorRequest {
+  // The URL of the request.
+  std::string url;
+  // The URL's scheme, lower case.
+  std::string scheme;
+  // The scheme of the origin that started the request, lower case. Empty
+  // when the request has no initiator origin, which is how the browser's own
+  // requests look.
+  std::string initiator_scheme;
+};
+
+// The state of one monitor: the rules and the counters.
+struct RespMonitorState {
+  // The rules that are installed, in configuration order.
+  std::vector<RespMonitorRule> rules;
+  // The hits each rule has spent on each URL.
+  std::map<std::pair<std::string, std::string>, std::uint64_t> hits;
+  // The rules that were switched off after a failure.
+  std::set<std::string> disabled_rules;
+  // How many failures the monitor has counted.
+  std::uint64_t failures = 0;
+};
+
+// Installs the rules.
+//
+// A configuration that is switched off installs nothing, so the monitor holds
+// no rules, no counters and no buffers. The counters of the rules that stay
+// are kept: installing the same rules again must not hand a rule a fresh
+// allowance every time the configuration is pushed down.
+void RespMonitorSetRules(RespMonitorState* state, const RespMonitorConfig& config);
+
+// True when the request is one the monitor may look at.
+bool IsRespMonitorRequestEligible(const RespMonitorRequest& request);
+
+// Decides which rule the response belongs to.
+//
+// Returns the rule, or nullptr when no rule matched, when the rule that
+// matched has already spent its allowance on that URL, or when the request
+// is not eligible.
+//
+// When a rule matches, one of its hits is spent: the caller has decided to
+// monitor the response, so the ceiling has to count it.
+const RespMonitorRule* MatchRespMonitorRule(RespMonitorState* state,
+                                            const RespMonitorRequest& request,
+                                            std::string_view content_type);
+
+// Switches a rule off and counts the failure. A rule that is already off is
+// not counted twice.
+void RespMonitorDisableRule(RespMonitorState* state, const std::string& rule_id);
+
+}  // namespace lengsuo::fp
+
+#endif  // LENGSUO_NATIVE_RESP_MONITOR_H_
diff --git a/lengsuo/native/resp_monitor_body.cc b/lengsuo/native/resp_monitor_body.cc
new file mode 100644
index 0000000..af5c19d
--- /dev/null
+++ b/lengsuo/native/resp_monitor_body.cc
@@ -0,0 +1,51 @@
+#include "resp_monitor_body.h"
+
+namespace lengsuo::fp {
+
+void RespMonitorBodyReset(RespMonitorBody* body, std::size_t limit) {
+  if (body == nullptr) {
+    return;
+  }
+  body->bytes.clear();
+  body->total_bytes = 0;
+  body->limit = limit;
+  body->truncated = false;
+}
+
+void RespMonitorBodyAppend(RespMonitorBody* body, std::string_view data) {
+  if (body == nullptr || data.empty()) {
+    return;
+  }
+  body->total_bytes += static_cast<std::uint64_t>(data.size());
+  const std::size_t room = body->limit > body->bytes.size()
+                               ? body->limit - body->bytes.size()
+                               : 0;
+  if (room == 0) {
+    // The limit is already reached. The bytes are counted and dropped.
+    body->truncated = true;
+    return;
+  }
+  if (data.size() > room) {
+    // The body is longer than the capture: keep the first part, drop the
+    // rest, and say so.
+    body->bytes.append(data.substr(0, room));
+    body->truncated = true;
+    return;
+  }
+  body->bytes.append(data);
+}
+
+std::size_t RespMonitorBodySize(const RespMonitorBody& body) {
+  return body.bytes.size();
+}
+
+std::uint64_t RespMonitorBodyDigest(std::string_view data) {
+  std::uint64_t hash = 1469598103934665603ULL;
+  for (const char c : data) {
+    hash ^= static_cast<std::uint64_t>(static_cast<unsigned char>(c));
+    hash *= 1099511628211ULL;
+  }
+  return hash;
+}
+
+}  // namespace lengsuo::fp
diff --git a/lengsuo/native/resp_monitor_body.h b/lengsuo/native/resp_monitor_body.h
new file mode 100644
index 0000000..567949e
--- /dev/null
+++ b/lengsuo/native/resp_monitor_body.h
@@ -0,0 +1,73 @@
+// resp_monitor_body - the side channel that reads a response body (task T1).
+//
+// The monitor must not change what the page receives. It therefore does not
+// read the body for the page: it copies the bytes the network stack has
+// already read into a buffer of its own, and the page's bytes go on to the
+// page untouched. That is a tee, not a tap.
+//
+// The two rules that shape the module:
+//
+//   * The copy is bounded. The capture buffer holds at most
+//     `max_body_bytes`; the rest of the body is counted but not kept. A
+//     monitor that keeps everything is a way to make the browser allocate on
+//     a hostile page's schedule.
+//   * The copy never changes the source. The source arrives as a
+//     `std::string_view`, which cannot be written through, and the module
+//     never copies from it destructively. The evidence that the original
+//     response is unchanged is in the test: the same bytes are fed in and
+//     the captured prefix comes out equal to the source prefix, with the
+//     source itself untouched.
+//
+// The body is never decompressed. A compressed response is not monitored at
+// all: the module would have to inflate it to read it, and inflating is a
+// different job with its own failure modes.
+#ifndef LENGSUO_NATIVE_RESP_MONITOR_BODY_H_
+#define LENGSUO_NATIVE_RESP_MONITOR_BODY_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <string_view>
+
+namespace lengsuo::fp {
+
+// The capture of one response body.
+struct RespMonitorBody {
+  // The captured prefix. Empty when the capture is switched off.
+  std::string bytes;
+  // How many body bytes went past. This counts the whole body, not only the
+  // captured part, so a truncated body can say how much it did not keep.
+  std::uint64_t total_bytes = 0;
+  // The capture limit. Zero means "count the bytes, keep none of them".
+  std::size_t limit = 0;
+  // True when the body was longer than the limit.
+  bool truncated = false;
+};
+
+// Starts a capture. `limit` is the most bytes the capture may keep.
+void RespMonitorBodyReset(RespMonitorBody* body, std::size_t limit);
+
+// Feeds body bytes to the capture.
+//
+// `data` is read and never written: it is the network stack's buffer, and
+// the whole point of the module is that the bytes the page receives are the
+// bytes the page received before.
+//
+// The bytes are copied until the limit is reached; after that they are only
+// counted.
+void RespMonitorBodyAppend(RespMonitorBody* body, std::string_view data);
+
+// How many bytes the capture holds.
+std::size_t RespMonitorBodySize(const RespMonitorBody& body);
+
+// A digest of `data`, used by the test to show that what came out of the
+// capture is what went in.
+//
+// FNV-1a, 64 bits. It is not a security primitive and is not one: it is a
+// short fingerprint that says "these two byte strings are the same" without
+// carrying them.
+std::uint64_t RespMonitorBodyDigest(std::string_view data);
+
+}  // namespace lengsuo::fp
+
+#endif  // LENGSUO_NATIVE_RESP_MONITOR_BODY_H_
diff --git a/lengsuo/native/resp_monitor_body_test.cc b/lengsuo/native/resp_monitor_body_test.cc
new file mode 100644
index 0000000..543fa73
--- /dev/null
+++ b/lengsuo/native/resp_monitor_body_test.cc
@@ -0,0 +1,131 @@
+// resp_monitor_body_test - the body capture (task T1).
+//
+// The capture is a tee: the page's bytes go on to the page exactly as they
+// were, and the monitor keeps a copy of the first few of them. The test that
+// matters most is the one that says the copy did not change the source.
+#include "resp_monitor_body.h"
+
+#include <gtest/gtest.h>
+
+#include <string>
+
+namespace lengsuo::fp {
+namespace {
+
+TEST(RespMonitorBody, KeepsWhatItWasGiven) {
+  RespMonitorBody body;
+  RespMonitorBodyReset(&body, 64);
+  RespMonitorBodyAppend(&body, "hello");
+  EXPECT_EQ(body.bytes, "hello");
+  EXPECT_EQ(RespMonitorBodySize(body), 5u);
+  EXPECT_EQ(body.total_bytes, 5u);
+  EXPECT_FALSE(body.truncated);
+}
+
+TEST(RespMonitorBody, TheLimitTruncatesAndSaysSo) {
+  RespMonitorBody body;
+  RespMonitorBodyReset(&body, 4);
+  RespMonitorBodyAppend(&body, "abcdefgh");
+  // Only the first four bytes are kept.
+  EXPECT_EQ(body.bytes, "abcd");
+  EXPECT_EQ(RespMonitorBodySize(body), 4u);
+  // The count is of the whole body, so a truncated body can say how much it
+  // did not keep.
+  EXPECT_EQ(body.total_bytes, 8u);
+  EXPECT_TRUE(body.truncated);
+}
+
+TEST(RespMonitorBody, TheLimitIsNeverExceeded) {
+  RespMonitorBody body;
+  RespMonitorBodyReset(&body, 4);
+  RespMonitorBodyAppend(&body, "ab");
+  EXPECT_FALSE(body.truncated);
+  RespMonitorBodyAppend(&body, "cdef");
+  EXPECT_TRUE(body.truncated);
+  EXPECT_EQ(body.bytes, "abcd");
+  EXPECT_EQ(body.total_bytes, 6u);
+  // More bytes after the limit are counted and dropped, not kept.
+  RespMonitorBodyAppend(&body, "ghijkl");
+  EXPECT_EQ(body.bytes, "abcd");
+  EXPECT_EQ(body.total_bytes, 12u);
+}
+
+TEST(RespMonitorBody, AZeroLimitCountsAndKeepsNothing) {
+  RespMonitorBody body;
+  RespMonitorBodyReset(&body, 0);
+  RespMonitorBodyAppend(&body, "abc");
+  EXPECT_TRUE(body.bytes.empty());
+  EXPECT_EQ(body.total_bytes, 3u);
+  EXPECT_TRUE(body.truncated);
+}
+
+TEST(RespMonitorBody, TheSourceIsNotChanged) {
+  // The capture reads the network stack's buffer and never writes through
+  // it: the bytes the page receives are the bytes the page received before.
+  RespMonitorBody body;
+  RespMonitorBodyReset(&body, 64);
+  std::string source = "the original response";
+  const std::uint64_t before = RespMonitorBodyDigest(source);
+  RespMonitorBodyAppend(&body, source);
+  EXPECT_EQ(source, "the original response");
+  EXPECT_EQ(RespMonitorBodyDigest(source), before);
+  EXPECT_EQ(body.bytes, source);
+  EXPECT_EQ(RespMonitorBodyDigest(body.bytes), before);
+}
+
+TEST(RespMonitorBody, TheCapturedPrefixEqualsTheSourcePrefix) {
+  // The same bytes in, the same bytes out: what comes out of the capture is
+  // what went in, byte for byte.
+  RespMonitorBody body;
+  RespMonitorBodyReset(&body, 1024);
+  std::string source;
+  for (int i = 0; i < 256; ++i) {
+    source.push_back(static_cast<char>(i));
+  }
+  RespMonitorBodyAppend(&body, source);
+  EXPECT_EQ(body.bytes.size(), source.size());
+  EXPECT_EQ(RespMonitorBodyDigest(body.bytes), RespMonitorBodyDigest(source));
+}
+
+TEST(RespMonitorBody, ATruncatedCaptureKeepsThePrefixByteForByte) {
+  RespMonitorBody body;
+  RespMonitorBodyReset(&body, 10);
+  std::string source = "0123456789abcdef";
+  RespMonitorBodyAppend(&body, source);
+  ASSERT_EQ(body.bytes.size(), 10u);
+  EXPECT_EQ(body.bytes, source.substr(0, 10));
+  EXPECT_EQ(RespMonitorBodyDigest(body.bytes),
+            RespMonitorBodyDigest(source.substr(0, 10)));
+}
+
+TEST(RespMonitorBody, AnEmptyAppendChangesNothing) {
+  RespMonitorBody body;
+  RespMonitorBodyReset(&body, 64);
+  RespMonitorBodyAppend(&body, "");
+  EXPECT_TRUE(body.bytes.empty());
+  EXPECT_EQ(body.total_bytes, 0u);
+  EXPECT_FALSE(body.truncated);
+}
+
+TEST(RespMonitorBody, AResetClearsEverything) {
+  RespMonitorBody body;
+  RespMonitorBodyReset(&body, 4);
+  RespMonitorBodyAppend(&body, "abcdef");
+  ASSERT_TRUE(body.truncated);
+  RespMonitorBodyReset(&body, 4);
+  EXPECT_TRUE(body.bytes.empty());
+  EXPECT_EQ(body.total_bytes, 0u);
+  EXPECT_FALSE(body.truncated);
+  EXPECT_EQ(body.limit, 4u);
+}
+
+TEST(RespMonitorBody, TheDigestTellsTwoByteStringsApart) {
+  EXPECT_EQ(RespMonitorBodyDigest("abc"), RespMonitorBodyDigest("abc"));
+  EXPECT_NE(RespMonitorBodyDigest("abc"), RespMonitorBodyDigest("abd"));
+  EXPECT_NE(RespMonitorBodyDigest("abc"), RespMonitorBodyDigest("ab"));
+  // The empty string has a digest of its own.
+  EXPECT_NE(RespMonitorBodyDigest(""), RespMonitorBodyDigest("a"));
+}
+
+}  // namespace
+}  // namespace lengsuo::fp
diff --git a/lengsuo/native/resp_monitor_config.cc b/lengsuo/native/resp_monitor_config.cc
new file mode 100644
index 0000000..c2f32b3
--- /dev/null
+++ b/lengsuo/native/resp_monitor_config.cc
@@ -0,0 +1,420 @@
+#include "resp_monitor_config.h"
+
+#include <algorithm>
+#include <cctype>
+#include <utility>
+
+#include "kernel_pipe_json.h"
+
+namespace lengsuo::fp {
+namespace {
+
+// Skips the whitespace JSON allows between tokens.
+void SkipSpace(std::string_view text, std::size_t* pos) {
+  while (*pos < text.size()) {
+    const char c = text[*pos];
+    if (c != ' ' && c != '\t' && c != '\n' && c != '\r') {
+      return;
+    }
+    ++(*pos);
+  }
+}
+
+// Finds the end of the object that starts at `pos`, which must point at an
+// opening brace. Returns the position just past the closing brace, or
+// `std::string_view::npos` when the object is never closed.
+//
+// The scanner tracks strings so that a brace inside a string value does not
+// close the object.
+std::size_t FindObjectEnd(std::string_view text, std::size_t pos) {
+  if (pos >= text.size() || text[pos] != '{') {
+    return std::string_view::npos;
+  }
+  int depth = 0;
+  bool in_string = false;
+  bool escaped = false;
+  for (std::size_t i = pos; i < text.size(); ++i) {
+    const char c = text[i];
+    if (in_string) {
+      if (escaped) {
+        escaped = false;
+      } else if (c == '\\') {
+        escaped = true;
+      } else if (c == '"') {
+        in_string = false;
+      }
+      continue;
+    }
+    if (c == '"') {
+      in_string = true;
+    } else if (c == '{') {
+      ++depth;
+    } else if (c == '}') {
+      --depth;
+      if (depth == 0) {
+        return i + 1;
+      }
+    }
+  }
+  return std::string_view::npos;
+}
+
+// Finds the end of the array that starts at `pos`, which must point at an
+// opening bracket.
+std::size_t FindArrayEnd(std::string_view text, std::size_t pos) {
+  if (pos >= text.size() || text[pos] != '[') {
+    return std::string_view::npos;
+  }
+  int depth = 0;
+  bool in_string = false;
+  bool escaped = false;
+  for (std::size_t i = pos; i < text.size(); ++i) {
+    const char c = text[i];
+    if (in_string) {
+      if (escaped) {
+        escaped = false;
+      } else if (c == '\\') {
+        escaped = true;
+      } else if (c == '"') {
+        in_string = false;
+      }
+      continue;
+    }
+    if (c == '"') {
+      in_string = true;
+    } else if (c == '[') {
+      ++depth;
+    } else if (c == ']') {
+      --depth;
+      if (depth == 0) {
+        return i + 1;
+      }
+    }
+  }
+  return std::string_view::npos;
+}
+
+// Finds the end of the JSON value that starts at `pos`. Returns the position
+// just past the value, or `std::string_view::npos` when the value is
+// malformed.
+std::size_t FindValueEnd(std::string_view text, std::size_t pos) {
+  if (pos >= text.size()) {
+    return std::string_view::npos;
+  }
+  const char c = text[pos];
+  if (c == '"') {
+    bool escaped = false;
+    for (std::size_t i = pos + 1; i < text.size(); ++i) {
+      const char s = text[i];
+      if (escaped) {
+        escaped = false;
+        continue;
+      }
+      if (s == '\\') {
+        escaped = true;
+        continue;
+      }
+      if (s == '"') {
+        return i + 1;
+      }
+    }
+    return std::string_view::npos;
+  }
+  if (c == '{') {
+    return FindObjectEnd(text, pos);
+  }
+  if (c == '[') {
+    return FindArrayEnd(text, pos);
+  }
+  // A number, a boolean or null: it runs to the next delimiter.
+  std::size_t i = pos;
+  while (i < text.size() && text[i] != ',' && text[i] != ']' && text[i] != '}' &&
+         text[i] != ' ' && text[i] != '\t' && text[i] != '\n' &&
+         text[i] != '\r') {
+    ++i;
+  }
+  if (i == pos) {
+    return std::string_view::npos;
+  }
+  return i;
+}
+
+// Splits the raw text of a JSON array into its elements.
+//
+// The reader in kernel_pipe_json.h keeps an array as raw text, so the array
+// is walked here and each element's raw text is handed back. The elements
+// are not parsed here: the caller parses each one with the same reader and
+// counts the ones that do not parse. That is what keeps one broken rule
+// from taking the whole configuration down.
+//
+// Returns false when the array itself is malformed.
+bool SplitArrayElements(std::string_view text,
+                        std::vector<std::string>* elements) {
+  std::size_t pos = 0;
+  SkipSpace(text, &pos);
+  if (pos >= text.size() || text[pos] != '[') {
+    return false;
+  }
+  ++pos;
+  SkipSpace(text, &pos);
+  if (pos < text.size() && text[pos] == ']') {
+    ++pos;
+    SkipSpace(text, &pos);
+    return pos == text.size();
+  }
+  while (true) {
+    const std::size_t start = pos;
+    const std::size_t end = FindValueEnd(text, pos);
+    if (end == std::string_view::npos) {
+      return false;
+    }
+    elements->push_back(std::string(text.substr(start, end - start)));
+    pos = end;
+    SkipSpace(text, &pos);
+    if (pos >= text.size()) {
+      return false;
+    }
+    if (text[pos] == ',') {
+      ++pos;
+      SkipSpace(text, &pos);
+      continue;
+    }
+    if (text[pos] == ']') {
+      ++pos;
+      break;
+    }
+    return false;
+  }
+  SkipSpace(text, &pos);
+  return pos == text.size();
+}
+
+// Reads one rule out of its JSON object.
+//
+// Returns false when the rule is not usable. `*skipped` is set when the rule
+// has to be counted as skipped, and `*disabled` when it merely said it was
+// switched off - the two are counted apart because one is a mistake and the
+// other is a decision.
+bool ReadRule(const JsonObject& object,
+              bool section_include_body,
+              RespMonitorRule* out,
+              bool* skipped,
+              bool* disabled) {
+  *skipped = false;
+  *disabled = false;
+
+  std::string id;
+  if (!object.GetString("id", &id) || id.empty()) {
+    *skipped = true;
+    return false;
+  }
+  std::string url_regex;
+  if (!object.GetString("url_regex", &url_regex) || url_regex.empty()) {
+    *skipped = true;
+    return false;
+  }
+  std::shared_ptr<const std::regex> matcher;
+  try {
+    matcher = std::make_shared<const std::regex>(url_regex,
+                                                 kRespMonitorRegexGrammar);
+  } catch (const std::regex_error&) {
+    // The pattern does not compile. The rule is dropped and counted; the
+    // rest of the configuration is untouched.
+    *skipped = true;
+    return false;
+  }
+
+  bool enabled = true;
+  if (object.Has("enabled") && !object.GetBool("enabled", &enabled)) {
+    *skipped = true;
+    return false;
+  }
+  if (!enabled) {
+    *disabled = true;
+    return false;
+  }
+
+  RespMonitorRule rule;
+  rule.id = std::move(id);
+  rule.url_regex = std::move(url_regex);
+  rule.matcher = std::move(matcher);
+
+  if (object.Has("content_type")) {
+    std::string content_type;
+    if (!object.GetString("content_type", &content_type)) {
+      *skipped = true;
+      return false;
+    }
+    rule.content_type = NormalizeRespMonitorContentType(content_type);
+  }
+
+  if (object.Has("max_count")) {
+    std::int64_t max_count = 0;
+    if (!object.GetInt64("max_count", &max_count) || max_count < 1) {
+      // A ceiling of zero would mean the rule never fires, which is a
+      // contradiction rather than a setting; a negative one is nonsense.
+      *skipped = true;
+      return false;
+    }
+    rule.max_count = static_cast<std::uint64_t>(max_count);
+  }
+
+  if (object.Has("max_body_bytes")) {
+    std::int64_t max_body_bytes = 0;
+    if (!object.GetInt64("max_body_bytes", &max_body_bytes) ||
+        max_body_bytes < 0) {
+      *skipped = true;
+      return false;
+    }
+    if (max_body_bytes > 0) {
+      rule.max_body_bytes = std::min<std::size_t>(
+          static_cast<std::size_t>(max_body_bytes),
+          kRespMonitorMaxBodyBytesCeiling);
+    }
+  }
+
+  bool include_body = section_include_body;
+  if (object.Has("include_body") &&
+      !object.GetBool("include_body", &include_body)) {
+    *skipped = true;
+    return false;
+  }
+  rule.include_body = include_body;
+
+  *out = std::move(rule);
+  return true;
+}
+
+}  // namespace
+
+std::string NormalizeRespMonitorContentType(std::string_view value) {
+  const std::size_t semicolon = value.find(';');
+  const std::string_view media =
+      semicolon == std::string_view::npos ? value : value.substr(0, semicolon);
+  std::size_t begin = 0;
+  std::size_t end = media.size();
+  while (begin < end && std::isspace(static_cast<unsigned char>(media[begin]))) {
+    ++begin;
+  }
+  while (end > begin &&
+         std::isspace(static_cast<unsigned char>(media[end - 1]))) {
+    --end;
+  }
+  std::string out;
+  out.reserve(end - begin);
+  for (std::size_t i = begin; i < end; ++i) {
+    out.push_back(
+        static_cast<char>(std::tolower(static_cast<unsigned char>(media[i]))));
+  }
+  return out;
+}
+
+bool IsValidRespMonitorUrlRegex(std::string_view pattern) {
+  try {
+    const std::regex probe{std::string(pattern), kRespMonitorRegexGrammar};
+    (void)probe;
+  } catch (const std::regex_error&) {
+    return false;
+  }
+  return true;
+}
+
+bool FindRespMonitorSection(std::string_view bundle_json,
+                            std::string* section_json,
+                            std::string* error) {
+  auto fail = [error](const char* message) {
+    if (error != nullptr) {
+      *error = message;
+    }
+    return false;
+  };
+  if (section_json == nullptr) {
+    return fail("response_monitor: no output");
+  }
+  section_json->clear();
+  JsonObject bundle;
+  if (!JsonObject::Parse(bundle_json, &bundle)) {
+    return fail("response_monitor: malformed bundle");
+  }
+  const JsonValue* section = bundle.Find(kRespMonitorConfigKey);
+  if (section == nullptr) {
+    // No section means the platform did not ask for a monitor. That is the
+    // ordinary case, not a failure.
+    return true;
+  }
+  if (section->kind != JsonKind::kObject) {
+    return fail("response_monitor: the section is not an object");
+  }
+  *section_json = section->text;
+  return true;
+}
+
+bool ParseRespMonitorConfig(std::string_view section_json,
+                            RespMonitorConfig* out,
+                            std::string* error) {
+  auto fail = [error](const char* message) {
+    if (error != nullptr) {
+      *error = message;
+    }
+    return false;
+  };
+  if (out == nullptr) {
+    return fail("response_monitor: no output");
+  }
+  JsonObject section;
+  if (!JsonObject::Parse(section_json, &section)) {
+    return fail("response_monitor: malformed section");
+  }
+
+  RespMonitorConfig config;
+  // The whole switch defaults to off: a section that does not say it is on
+  // is a section that is not on.
+  if (section.Has("enabled") && !section.GetBool("enabled", &config.enabled)) {
+    return fail("response_monitor: enabled is not a boolean");
+  }
+  if (section.Has("include_body") &&
+      !section.GetBool("include_body", &config.include_body)) {
+    return fail("response_monitor: include_body is not a boolean");
+  }
+
+  const JsonValue* rules = section.Find("rules");
+  if (rules == nullptr) {
+    // Enabled with no rules: nothing to register.
+    *out = std::move(config);
+    return true;
+  }
+  if (rules->kind != JsonKind::kArray) {
+    return fail("response_monitor: rules is not an array");
+  }
+  std::vector<std::string> elements;
+  if (!SplitArrayElements(rules->text, &elements)) {
+    return fail("response_monitor: the rule array is malformed");
+  }
+
+  for (const std::string& element : elements) {
+    JsonObject object;
+    if (!JsonObject::Parse(element, &object)) {
+      // A rule that is not even an object is dropped and counted.
+      ++config.skipped_rules;
+      continue;
+    }
+    RespMonitorRule rule;
+    bool skipped = false;
+    bool disabled = false;
+    if (!ReadRule(object, config.include_body, &rule, &skipped, &disabled)) {
+      if (skipped) {
+        ++config.skipped_rules;
+      }
+      if (disabled) {
+        ++config.disabled_rules;
+      }
+      continue;
+    }
+    config.rules.push_back(std::move(rule));
+  }
+
+  *out = std::move(config);
+  return true;
+}
+
+}  // namespace lengsuo::fp
diff --git a/lengsuo/native/resp_monitor_config.h b/lengsuo/native/resp_monitor_config.h
new file mode 100644
index 0000000..41e933e
--- /dev/null
+++ b/lengsuo/native/resp_monitor_config.h
@@ -0,0 +1,138 @@
+// resp_monitor_config - the rule set of the response-body monitor (task T1).
+//
+// The rules arrive in the ConfigBundle's `response_monitor` section, which is
+// JSON text like every other payload on the pipe. The shape is
+//
+//   {"response_monitor": {
+//      "enabled": true,
+//      "include_body": false,          // section default; per-rule may override
+//      "rules": [
+//        {"id": "api-json",
+//         "url_regex": "^https://api\\.example\\.com/",
+//         "content_type": "application/json",   // optional; empty = any
+//         "max_count": 3,                       // per rule, per URL
+//         "max_body_bytes": 4096,               // optional; 0 = the ceiling
+//         "enabled": true,
+//         "include_body": false}                // optional; overrides section
+//      ]}}
+//
+// Two rules are not negotiable:
+//
+//   * The whole feature is off unless the section says `enabled: true`. A
+//     monitor that is off does not register at all - no rules compiled, no
+//     capture buffers. "Off" has to cost nothing, or a disabled feature still
+//     pays for itself on every response.
+//   * A rule whose regular expression does not compile is dropped and
+//     counted. It never fails the configuration: one typo in one rule must
+//     not take the other nine with it.
+//
+// The section is parsed in two steps because it crosses a process boundary.
+// The browser process finds the section in the ConfigBundle and sends that
+// text - and only that text - to the network service, which parses it here.
+// The network service never sees the rest of the bundle.
+//
+// The hard work is reading a JSON array of objects. The reader in
+// kernel_pipe_json.h is deliberately shallow and keeps a nested array as raw
+// text, so the array is walked here and each element is handed back to that
+// same reader.
+#ifndef LENGSUO_NATIVE_RESP_MONITOR_CONFIG_H_
+#define LENGSUO_NATIVE_RESP_MONITOR_CONFIG_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <regex>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace lengsuo::fp {
+
+// The ConfigBundle section that carries the rules.
+inline constexpr char kRespMonitorConfigKey[] = "response_monitor";
+
+// How many body bytes a rule captures when it does not say, and the ceiling
+// no configuration may raise. The capture buffer lives in the network
+// service, and an unbounded buffer there is a way to make the browser
+// allocate on a hostile page's schedule.
+//
+// The ceiling is 64 KiB because the body does not go on the wire as it is:
+// it goes into a JSON string, where a byte that is not valid UTF-8 becomes a
+// six character escape. The uplink rejects a payload over 1 MiB, and 64 KiB
+// times six is 384 KiB, which leaves room for the envelope.
+inline constexpr std::size_t kRespMonitorMaxBodyBytesCeiling = 64 * 1024;
+
+// How many hits one rule allows for one URL when it does not say.
+inline constexpr std::uint64_t kRespMonitorDefaultMaxCount = 1;
+
+// The grammar a rule's regular expression is written in. ECMAScript, not
+// POSIX: the configuration comes from the runner, and ECMAScript is the
+// grammar the wire contract's examples are written in. A rule that does not
+// compile under this grammar is dropped.
+inline constexpr std::regex::flag_type kRespMonitorRegexGrammar =
+    std::regex::ECMAScript;
+
+// True when `pattern` compiles under kRespMonitorRegexGrammar.
+bool IsValidRespMonitorUrlRegex(std::string_view pattern);
+
+// The media type of a Content-Type header, without its parameters and in
+// lower case. `application/json; charset=utf-8` and `Application/JSON` name
+// the same type, and a rule names the type the way its author wrote it.
+std::string NormalizeRespMonitorContentType(std::string_view value);
+
+// One rule, as the configuration states it.
+struct RespMonitorRule {
+  std::string id;
+  std::string url_regex;
+  // The compiled matcher. Never null: a rule whose pattern did not compile
+  // is dropped while parsing and never reaches the monitor.
+  std::shared_ptr<const std::regex> matcher;
+  // The media type the response must have. Empty means "any". Parameters
+  // (`; charset=...`) are stripped before the comparison.
+  std::string content_type;
+  // The per-URL hit ceiling.
+  std::uint64_t max_count = kRespMonitorDefaultMaxCount;
+  // The per-response capture ceiling, already clamped.
+  std::size_t max_body_bytes = kRespMonitorMaxBodyBytesCeiling;
+  // Whether this rule's reports may carry the body itself. Off by default:
+  // the body is the expensive and the sensitive half of a report.
+  bool include_body = false;
+};
+
+// The parsed section.
+struct RespMonitorConfig {
+  // False when the section is absent, or present and switched off. Nothing is
+  // registered in that case.
+  bool enabled = false;
+  // The section-level default for per-rule `include_body`.
+  bool include_body = false;
+  // The rules that survived parsing, in configuration order.
+  std::vector<RespMonitorRule> rules;
+  // Rules dropped because they did not parse (bad regex, missing id, ...).
+  std::uint64_t skipped_rules = 0;
+  // Rules dropped because they said `enabled: false`.
+  std::uint64_t disabled_rules = 0;
+};
+
+// Finds the raw JSON text of the `response_monitor` section in the
+// ConfigBundle. `*section_json` is left empty when the bundle carries no such
+// section - that is the ordinary "the platform did not ask for a monitor"
+// case, not an error.
+//
+// Returns false only when `bundle_json` is not a JSON object.
+bool FindRespMonitorSection(std::string_view bundle_json,
+                            std::string* section_json,
+                            std::string* error);
+
+// Parses the `response_monitor` section's raw JSON text.
+//
+// Returns false only when the section has the wrong shape. A missing
+// `enabled`, or `enabled: false`, is a successful parse of a switched off
+// configuration. A bad rule is counted in `skipped_rules`, never fatal.
+bool ParseRespMonitorConfig(std::string_view section_json,
+                            RespMonitorConfig* out,
+                            std::string* error);
+
+}  // namespace lengsuo::fp
+
+#endif  // LENGSUO_NATIVE_RESP_MONITOR_CONFIG_H_
diff --git a/lengsuo/native/resp_monitor_config_test.cc b/lengsuo/native/resp_monitor_config_test.cc
new file mode 100644
index 0000000..c3ae40c
--- /dev/null
+++ b/lengsuo/native/resp_monitor_config_test.cc
@@ -0,0 +1,218 @@
+// resp_monitor_config_test - the rules of the response monitor (task T1).
+//
+// The rules come from the configuration, so the tests are about what the
+// configuration is allowed to say and what happens when it says something
+// unusable. The rule the tests hold onto hardest: one broken rule must not
+// take the rest of the configuration down with it.
+#include "resp_monitor_config.h"
+
+#include <gtest/gtest.h>
+
+#include <string>
+
+namespace lengsuo::fp {
+namespace {
+
+// The section the platform sends, with one good rule.
+const char kGoodSection[] = R"({
+  "enabled": true,
+  "rules": [
+    {"id": "r1", "url_regex": "^https://example\\.test/a", "max_count": 2}
+  ]
+})";
+
+// Parses a section and hands back the config. The section is known to parse,
+// so a failure here is a bug in the test.
+RespMonitorConfig ParseOk(const std::string& section) {
+  RespMonitorConfig config;
+  std::string error;
+  EXPECT_TRUE(ParseRespMonitorConfig(section, &config, &error)) << error;
+  return config;
+}
+
+TEST(RespMonitorConfig, ParsesAWholeRule) {
+  const RespMonitorConfig config = ParseOk(kGoodSection);
+  EXPECT_TRUE(config.enabled);
+  ASSERT_EQ(config.rules.size(), 1u);
+  const RespMonitorRule& rule = config.rules[0];
+  EXPECT_EQ(rule.id, "r1");
+  EXPECT_EQ(rule.url_regex, "^https://example\\.test/a");
+  EXPECT_EQ(rule.max_count, 2u);
+  EXPECT_TRUE(rule.matcher != nullptr);
+  // A rule that says nothing about the content type matches every one.
+  EXPECT_TRUE(rule.content_type.empty());
+  // The body is not carried unless the configuration asks for it.
+  EXPECT_FALSE(rule.include_body);
+}
+
+TEST(RespMonitorConfig, TheWholeFeatureIsOffByDefault) {
+  RespMonitorConfig config;
+  std::string error;
+  // No "enabled" at all means off: a section that does not say it is on is
+  // a section that is not on.
+  EXPECT_TRUE(ParseRespMonitorConfig(R"({"rules":[]})", &config, &error));
+  EXPECT_FALSE(config.enabled);
+
+  EXPECT_TRUE(
+      ParseRespMonitorConfig(R"({"enabled":false,"rules":[]})", &config, &error));
+  EXPECT_FALSE(config.enabled);
+}
+
+TEST(RespMonitorConfig, AnInvalidRegexSkipsThatRuleAndCountsIt) {
+  const RespMonitorConfig config = ParseOk(R"({
+    "enabled": true,
+    "rules": [
+      {"id": "broken", "url_regex": "([unclosed", "max_count": 1},
+      {"id": "good", "url_regex": "^https://ok\\.test/", "max_count": 1}
+    ]
+  })");
+  // The broken rule is dropped; the good one is still there.
+  ASSERT_EQ(config.rules.size(), 1u);
+  EXPECT_EQ(config.rules[0].id, "good");
+  // And the drop is counted, so the operator can see it.
+  EXPECT_EQ(config.skipped_rules, 1u);
+}
+
+TEST(RespMonitorConfig, ABrokenRuleDoesNotFailTheWholeConfig) {
+  // Every rule broken: the config still parses, and it holds no rules.
+  const RespMonitorConfig config = ParseOk(R"({
+    "enabled": true,
+    "rules": [
+      {"id": "a", "url_regex": "([unclosed"},
+      {"id": "b", "url_regex": "*bad"}
+    ]
+  })");
+  EXPECT_TRUE(config.enabled);
+  EXPECT_TRUE(config.rules.empty());
+  EXPECT_EQ(config.skipped_rules, 2u);
+}
+
+TEST(RespMonitorConfig, ARuleWithoutAnIdOrAPatternIsSkipped) {
+  const RespMonitorConfig config = ParseOk(R"({
+    "enabled": true,
+    "rules": [
+      {"url_regex": "^https://example\\.test/"},
+      {"id": "no-pattern"},
+      {"id": "", "url_regex": "^https://example\\.test/"}
+    ]
+  })");
+  EXPECT_TRUE(config.rules.empty());
+  EXPECT_EQ(config.skipped_rules, 3u);
+}
+
+TEST(RespMonitorConfig, ADisabledRuleIsCountedApartFromASkippedOne) {
+  const RespMonitorConfig config = ParseOk(R"({
+    "enabled": true,
+    "rules": [
+      {"id": "off", "url_regex": "^https://example\\.test/", "enabled": false},
+      {"id": "broken", "url_regex": "([unclosed"}
+    ]
+  })");
+  EXPECT_TRUE(config.rules.empty());
+  // A rule that said it was off is a decision, not a mistake.
+  EXPECT_EQ(config.disabled_rules, 1u);
+  EXPECT_EQ(config.skipped_rules, 1u);
+}
+
+TEST(RespMonitorConfig, TheContentTypeIsNormalized) {
+  const RespMonitorConfig config = ParseOk(R"({
+    "enabled": true,
+    "rules": [
+      {"id": "r1", "url_regex": "^https://example\\.test/", "content_type":
+       "TEXT/Plain; charset=utf-8"}
+    ]
+  })");
+  ASSERT_EQ(config.rules.size(), 1u);
+  EXPECT_EQ(config.rules[0].content_type, "text/plain");
+}
+
+TEST(RespMonitorConfig, TheBodyIsCarriedOnlyWhenItIsAskedFor) {
+  RespMonitorConfig config;
+  std::string error;
+  EXPECT_TRUE(ParseRespMonitorConfig(
+      R"({"enabled":true,"include_body":true,"rules":[
+           {"id":"with","url_regex":"a","include_body":true},
+           {"id":"without","url_regex":"b"}]})",
+      &config, &error));
+  ASSERT_EQ(config.rules.size(), 2u);
+  EXPECT_TRUE(config.rules[0].include_body);
+  EXPECT_TRUE(config.rules[1].include_body);
+}
+
+TEST(RespMonitorConfig, ARuleMayTurnTheBodyOffAgainstTheSection) {
+  RespMonitorConfig config;
+  std::string error;
+  EXPECT_TRUE(ParseRespMonitorConfig(
+      R"({"enabled":true,"include_body":true,"rules":[
+           {"id":"off","url_regex":"a","include_body":false}]})",
+      &config, &error));
+  ASSERT_EQ(config.rules.size(), 1u);
+  EXPECT_FALSE(config.rules[0].include_body);
+}
+
+TEST(RespMonitorConfig, TheBodyLimitIsBounded) {
+  const RespMonitorConfig config = ParseOk(R"({
+    "enabled": true,
+    "rules": [
+      {"id": "big", "url_regex": "a", "max_body_bytes": 999999999},
+      {"id": "small", "url_regex": "b", "max_body_bytes": 32}
+    ]
+  })");
+  ASSERT_EQ(config.rules.size(), 2u);
+  // A limit past the ceiling is clamped to the ceiling: the code does not
+  // carry a limit that came from the wire.
+  EXPECT_EQ(config.rules[0].max_body_bytes, kRespMonitorMaxBodyBytesCeiling);
+  EXPECT_EQ(config.rules[1].max_body_bytes, 32u);
+}
+
+TEST(RespMonitorConfig, ANonsenseCountOrLimitSkipsTheRule) {
+  const RespMonitorConfig config = ParseOk(R"({
+    "enabled": true,
+    "rules": [
+      {"id": "zero", "url_regex": "a", "max_count": 0},
+      {"id": "negative", "url_regex": "b", "max_count": -1},
+      {"id": "negbytes", "url_regex": "c", "max_body_bytes": -5}
+    ]
+  })");
+  EXPECT_TRUE(config.rules.empty());
+  EXPECT_EQ(config.skipped_rules, 3u);
+}
+
+TEST(RespMonitorConfig, TheSectionIsFoundInTheBundle) {
+  std::string section;
+  std::string error;
+  EXPECT_TRUE(FindRespMonitorSection(
+      R"({"response_monitor":{"enabled":true,"rules":[]},"other":1})",
+      &section, &error));
+  EXPECT_NE(section.find("\"enabled\":true"), std::string::npos);
+}
+
+TEST(RespMonitorConfig, AMissingSectionIsNotAFailure) {
+  std::string section;
+  std::string error;
+  EXPECT_TRUE(FindRespMonitorSection(R"({"other":1})", &section, &error));
+  EXPECT_TRUE(section.empty());
+}
+
+TEST(RespMonitorConfig, AMalformedBundleIsAFailure) {
+  std::string section;
+  std::string error;
+  EXPECT_FALSE(FindRespMonitorSection(R"({"response_monitor":)", &section, &error));
+  EXPECT_FALSE(error.empty());
+}
+
+TEST(RespMonitorConfig, AMalformedSectionIsAFailure) {
+  RespMonitorConfig config;
+  std::string error;
+  EXPECT_FALSE(ParseRespMonitorConfig(R"({"enabled":)", &config, &error));
+  EXPECT_FALSE(error.empty());
+}
+
+TEST(RespMonitorConfig, TheRegexProbeAgreesWithTheParser) {
+  EXPECT_TRUE(IsValidRespMonitorUrlRegex("^https://example\\.test/"));
+  EXPECT_FALSE(IsValidRespMonitorUrlRegex("([unclosed"));
+  EXPECT_FALSE(IsValidRespMonitorUrlRegex("*bad"));
+}
+
+}  // namespace
+}  // namespace lengsuo::fp
diff --git a/lengsuo/native/resp_monitor_report.cc b/lengsuo/native/resp_monitor_report.cc
new file mode 100644
index 0000000..6a553b0
--- /dev/null
+++ b/lengsuo/native/resp_monitor_report.cc
@@ -0,0 +1,192 @@
+#include "resp_monitor_report.h"
+
+#include <string>
+
+namespace lengsuo::fp {
+namespace {
+
+// Writes a byte as a `\u00XX` escape.
+void AppendEscapedByte(std::string* out, unsigned char byte) {
+  static const char kHex[] = "0123456789abcdef";
+  out->append("\\u00");
+  out->push_back(kHex[byte >> 4]);
+  out->push_back(kHex[byte & 0x0f]);
+}
+
+// The number of bytes in the UTF-8 sequence that starts with `lead`, or zero
+// when `lead` does not start a sequence at all.
+//
+// The ranges are the ones UTF-8 fixes: the second byte of a three byte
+// sequence may not be a surrogate's, and the second byte of a four byte
+// sequence may not be above U+10FFFF. The narrow ranges are applied by
+// `IsValidUtf8`, not here.
+std::size_t Utf8SequenceLength(unsigned char lead) {
+  if (lead < 0x80) {
+    return 1;
+  }
+  if (lead >= 0xc2 && lead <= 0xdf) {
+    return 2;
+  }
+  if (lead >= 0xe0 && lead <= 0xef) {
+    return 3;
+  }
+  if (lead >= 0xf0 && lead <= 0xf4) {
+    return 4;
+  }
+  return 0;
+}
+
+bool IsContinuation(unsigned char byte) {
+  return (byte & 0xc0) == 0x80;
+}
+
+// True when the bytes at `pos` are a valid UTF-8 sequence of `length` bytes.
+bool IsValidUtf8(std::string_view value, std::size_t pos, std::size_t length) {
+  if (pos + length > value.size()) {
+    return false;
+  }
+  if (length == 1) {
+    // A single byte below 0x80 is the whole sequence.
+    return true;
+  }
+  const unsigned char lead = static_cast<unsigned char>(value[pos]);
+  // The second byte's range is narrower for the sequences that would
+  // otherwise accept an overlong form or a surrogate.
+  unsigned char second_min = 0x80;
+  unsigned char second_max = 0xbf;
+  if (length == 3) {
+    second_min = (lead == 0xe0) ? 0xa0 : 0x80;
+    second_max = (lead == 0xed) ? 0x9f : 0xbf;
+  } else if (length == 4) {
+    second_min = (lead == 0xf0) ? 0x90 : 0x80;
+    second_max = (lead == 0xf4) ? 0x8f : 0xbf;
+  }
+  const unsigned char second = static_cast<unsigned char>(value[pos + 1]);
+  if (second < second_min || second > second_max) {
+    return false;
+  }
+  for (std::size_t i = 2; i < length; ++i) {
+    if (!IsContinuation(static_cast<unsigned char>(value[pos + i]))) {
+      return false;
+    }
+  }
+  return true;
+}
+
+// Appends the report's fields to `out`.
+//
+// `first` says whether `out` already holds a field: the report's own JSON
+// starts empty, and the uplink payload already holds the action's name and
+// needs a comma before the first field.
+void AppendReportFields(std::string* out,
+                        const RespMonitorReport& report,
+                        bool first) {
+  auto key = [&](const char* name) {
+    if (!first) {
+      out->push_back(',');
+    }
+    first = false;
+    out->push_back('"');
+    out->append(name);
+    out->append("\":");
+  };
+
+  key("rule_id");
+  out->append(EscapeRespMonitorJsonString(report.rule_id));
+  key("url");
+  out->append(EscapeRespMonitorJsonString(report.url));
+  key("status");
+  out->append(std::to_string(report.status));
+  key("content_type");
+  out->append(EscapeRespMonitorJsonString(report.content_type));
+  key("body_bytes");
+  out->append(std::to_string(report.body_bytes));
+  key("truncated");
+  out->append(report.truncated ? "true" : "false");
+  if (report.include_body) {
+    key("body");
+    out->append(EscapeRespMonitorJsonString(report.body));
+  }
+}
+
+}  // namespace
+
+std::string BuildRespMonitorReportJson(const RespMonitorReport& report) {
+  std::string out = "{";
+  AppendReportFields(&out, report, true);
+  out.append("}");
+  return out;
+}
+
+std::string BuildRespMonitorActionPayload(const RespMonitorReport& report) {
+  std::string out = "{\"from\":\"";
+  out.append(kRespMonitorFrom);
+  out.append("\",\"action\":\"");
+  out.append(kActionResponseMonitor);
+  out.append("\"");
+  AppendReportFields(&out, report, false);
+  out.append("}");
+  return out;
+}
+
+std::string EscapeRespMonitorJsonString(std::string_view value) {
+  std::string out;
+  out.reserve(value.size() + 2);
+  out.push_back('"');
+  std::size_t i = 0;
+  while (i < value.size()) {
+    const unsigned char byte = static_cast<unsigned char>(value[i]);
+    switch (byte) {
+      case '"':
+        out.append("\\\"");
+        ++i;
+        continue;
+      case '\\':
+        out.append("\\\\");
+        ++i;
+        continue;
+      case '\b':
+        out.append("\\b");
+        ++i;
+        continue;
+      case '\f':
+        out.append("\\f");
+        ++i;
+        continue;
+      case '\n':
+        out.append("\\n");
+        ++i;
+        continue;
+      case '\r':
+        out.append("\\r");
+        ++i;
+        continue;
+      case '\t':
+        out.append("\\t");
+        ++i;
+        continue;
+      default:
+        break;
+    }
+    if (byte < 0x20) {
+      // A control character may not go into a JSON string as it is.
+      AppendEscapedByte(&out, byte);
+      ++i;
+      continue;
+    }
+    const std::size_t length = Utf8SequenceLength(byte);
+    if (length == 0 || !IsValidUtf8(value, i, length)) {
+      // Not a byte of a valid sequence. It cannot go into a JSON string as
+      // it is, so it is escaped.
+      AppendEscapedByte(&out, byte);
+      ++i;
+      continue;
+    }
+    out.append(value.substr(i, length));
+    i += length;
+  }
+  out.push_back('"');
+  return out;
+}
+
+}  // namespace lengsuo::fp
diff --git a/lengsuo/native/resp_monitor_report.h b/lengsuo/native/resp_monitor_report.h
new file mode 100644
index 0000000..54a88e5
--- /dev/null
+++ b/lengsuo/native/resp_monitor_report.h
@@ -0,0 +1,90 @@
+// resp_monitor_report - the report of a monitored response (task T1).
+//
+// The monitor reads a response that a rule matched and writes down what it
+// saw. The report is the only thing that leaves the browser on the uplink,
+// so it is deliberately narrow: it says which rule fired, which URL was
+// hit, what came back, and - only when the platform asked for it - the
+// first few bytes of the body.
+//
+// What the report does not say is as important as what it does:
+//
+//   * No request headers. No `Cookie`, no `Authorization`, no `Set-Cookie`.
+//     The report is about a response, not about the request that caused it,
+//     and a header is where credentials live.
+//   * No body by default. The body is the page's own content; it is the most
+//     sensitive thing on this channel and the most expensive. It is carried
+//     only when the configuration asked for it explicitly, and even then it
+//     is bounded by the rule's own limit.
+//
+// The report is written as JSON twice: once as the report's own body, and
+// once wrapped in the uplink action's envelope. The two share their fields,
+// so a rule that is changed changes both at once - there is one place where
+// the fields are written.
+#ifndef LENGSUO_NATIVE_RESP_MONITOR_REPORT_H_
+#define LENGSUO_NATIVE_RESP_MONITOR_REPORT_H_
+
+#include <cstdint>
+#include <string>
+#include <string_view>
+
+#include "action_table.h"
+
+namespace lengsuo::fp {
+
+// Where the report comes from, in the uplink's `from` field.
+//
+// The report is produced by the browser side: the network service decides
+// what is monitored and the browser side puts the report on the uplink. The
+// runner is told which side produced a payload so that it can tell a
+// renderer's event from the browser's own.
+inline constexpr char kRespMonitorFrom[] = "browser";
+
+// The report of one monitored response.
+struct RespMonitorReport {
+  // The rule that fired.
+  std::string rule_id;
+  // The URL of the response.
+  std::string url;
+  // The HTTP status code of the response.
+  int status = 0;
+  // The response's media type, without its parameters.
+  std::string content_type;
+  // How many body bytes the response carried. This is the whole body, not
+  // only the part that was kept.
+  std::uint64_t body_bytes = 0;
+  // True when the body was longer than the capture limit.
+  bool truncated = false;
+  // The captured prefix of the body. Empty when the body was not collected.
+  std::string body;
+  // Whether the body may be carried at all. Off by default.
+  bool include_body = false;
+};
+
+// Builds the report's JSON: the report's fields and nothing else.
+//
+// The body is left out when the report says it may not be carried. An absent
+// body and an empty body are different facts - one says the body was not
+// collected, the other says the body was empty - and the runner is owed the
+// difference.
+std::string BuildRespMonitorReportJson(const RespMonitorReport& report);
+
+// Builds the uplink payload: the action's name, where the report came from,
+// and the report's fields.
+//
+// The payload is what the action table validates, so it is built to be
+// accepted by the table's schema for the action.
+std::string BuildRespMonitorActionPayload(const RespMonitorReport& report);
+
+// Escapes a string so it can go into a JSON string as it is.
+//
+// Valid UTF-8 passes through unchanged: a page's body is usually UTF-8 and
+// escaping all of it would double the size of every report. A byte that is
+// not part of a valid UTF-8 sequence becomes a `\u00XX` escape, and so does
+// a control character - a JSON string may not carry a raw one.
+//
+// The result includes the surrounding quotes.
+std::string EscapeRespMonitorJsonString(std::string_view value);
+
+}  // namespace lengsuo::fp
+
+#endif  // LENGSUO_NATIVE_RESP_MONITOR_REPORT_H_
diff --git a/lengsuo/native/resp_monitor_report_test.cc b/lengsuo/native/resp_monitor_report_test.cc
new file mode 100644
index 0000000..678a8b6
--- /dev/null
+++ b/lengsuo/native/resp_monitor_report_test.cc
@@ -0,0 +1,200 @@
+// resp_monitor_report_test - the report of a monitored response (task T1).
+//
+// The report goes out on the uplink, so the tests check two things: that the
+// JSON it carries is well formed and says what it means to say, and that the
+// action table - the last checkpoint before the bytes go on the wire -
+// accepts it.
+#include "resp_monitor_report.h"
+
+#include <gtest/gtest.h>
+
+#include <string>
+
+#include "action_table.h"
+#include "kernel_pipe_json.h"
+
+namespace lengsuo::fp {
+namespace {
+
+// A report with every field filled in.
+RespMonitorReport MakeReport() {
+  RespMonitorReport report;
+  report.rule_id = "r1";
+  report.url = "https://example.test/a";
+  report.status = 200;
+  report.content_type = "text/plain";
+  report.body_bytes = 12;
+  report.truncated = false;
+  report.body = "hello world";
+  return report;
+}
+
+// Reads one member out of a JSON object.
+std::string Member(const std::string& json, const std::string& key) {
+  JsonObject object;
+  if (!JsonObject::Parse(json, &object)) {
+    return "";
+  }
+  const JsonValue* value = object.Find(key);
+  if (value == nullptr) {
+    return "";
+  }
+  return value->text;
+}
+
+TEST(RespMonitorReport, TheReportCarriesTheFieldsTheContractNames) {
+  const RespMonitorReport report = MakeReport();
+  const std::string json = BuildRespMonitorReportJson(report);
+  JsonObject object;
+  ASSERT_TRUE(JsonObject::Parse(json, &object)) << json;
+  EXPECT_EQ(Member(json, "rule_id"), "r1");
+  EXPECT_EQ(Member(json, "url"), "https://example.test/a");
+  EXPECT_EQ(Member(json, "status"), "200");
+  EXPECT_EQ(Member(json, "content_type"), "text/plain");
+  EXPECT_EQ(Member(json, "body_bytes"), "12");
+  EXPECT_EQ(Member(json, "truncated"), "false");
+}
+
+TEST(RespMonitorReport, TheBodyIsLeftOutUnlessItIsAskedFor) {
+  RespMonitorReport report = MakeReport();
+  report.include_body = false;
+  const std::string json = BuildRespMonitorReportJson(report);
+  JsonObject object;
+  ASSERT_TRUE(JsonObject::Parse(json, &object)) << json;
+  // An absent body and an empty body are different facts.
+  EXPECT_FALSE(object.Has("body"));
+}
+
+TEST(RespMonitorReport, TheBodyIsCarriedWhenItIsAskedFor) {
+  RespMonitorReport report = MakeReport();
+  report.include_body = true;
+  const std::string json = BuildRespMonitorReportJson(report);
+  JsonObject object;
+  ASSERT_TRUE(JsonObject::Parse(json, &object)) << json;
+  EXPECT_TRUE(object.Has("body"));
+  EXPECT_EQ(Member(json, "body"), "hello world");
+}
+
+TEST(RespMonitorReport, ThePayloadNamesTheActionAndTheSide) {
+  const std::string payload = BuildRespMonitorActionPayload(MakeReport());
+  JsonObject object;
+  ASSERT_TRUE(JsonObject::Parse(payload, &object)) << payload;
+  EXPECT_EQ(Member(payload, "from"), kRespMonitorFrom);
+  EXPECT_EQ(Member(payload, "action"), kActionResponseMonitor);
+}
+
+TEST(RespMonitorReport, TheActionTableAcceptsThePayloadWithoutABody) {
+  RespMonitorReport report = MakeReport();
+  report.include_body = false;
+  const std::string payload = BuildRespMonitorActionPayload(report);
+  const ActionCollectorPolicy policy;
+  const ActionValidation result = ValidateActionPayload(
+      ActionTable::Get(), kActionResponseMonitor, payload, policy);
+  EXPECT_TRUE(result.ok) << payload;
+  EXPECT_EQ(result.reason, ActionRejectReason::kNone);
+}
+
+TEST(RespMonitorReport, TheActionTableAcceptsThePayloadWithABody) {
+  // The pipe validates with the default policy, so a payload that carries a
+  // body has to pass under that policy - otherwise the body could never get
+  // out. Whether the body is carried at all is the collector's decision, and
+  // the collector made it.
+  RespMonitorReport report = MakeReport();
+  report.include_body = true;
+  const std::string payload = BuildRespMonitorActionPayload(report);
+  const ActionCollectorPolicy policy;
+  const ActionValidation result = ValidateActionPayload(
+      ActionTable::Get(), kActionResponseMonitor, payload, policy);
+  EXPECT_TRUE(result.ok) << payload;
+  EXPECT_EQ(result.reason, ActionRejectReason::kNone);
+}
+
+TEST(RespMonitorReport, TheActionTableAcceptsThePayloadWithABodyUnderTheDefaultPolicy) {
+  // The same check with the policy the pipe actually uses. It is spelled out
+  // again because this is the one that would silently break the body: the
+  // pipe's own EnqueueEvent builds a default policy and hands it over.
+  RespMonitorReport report = MakeReport();
+  report.include_body = true;
+  const std::string payload = BuildRespMonitorActionPayload(report);
+  ActionCollectorPolicy policy;
+  EXPECT_FALSE(policy.data_url_allowed());
+  const ActionValidation result = ValidateActionPayload(
+      ActionTable::Get(), kActionResponseMonitor, payload, policy);
+  EXPECT_TRUE(result.ok) << payload;
+}
+
+TEST(RespMonitorReport, TheReportCarriesNoRequestHeaders) {
+  // The report is about a response. A header - a cookie, an authorization -
+  // is where credentials live, and there is no field for one.
+  const std::string json = BuildRespMonitorReportJson(MakeReport());
+  for (const char* forbidden :
+       {"cookie", "Cookie", "authorization", "Authorization", "headers",
+        "set-cookie"}) {
+    EXPECT_EQ(json.find(forbidden), std::string::npos) << forbidden;
+  }
+}
+
+TEST(RespMonitorReport, TheJsonEscaperLeavesValidUtf8Alone) {
+  EXPECT_EQ(EscapeRespMonitorJsonString("plain"), "\"plain\"");
+  // A Chinese character is three bytes and passes through as it is.
+  EXPECT_EQ(EscapeRespMonitorJsonString("\xe4\xb8\xad"), "\"\xe4\xb8\xad\"");
+  EXPECT_EQ(EscapeRespMonitorJsonString(""), "\"\"");
+}
+
+TEST(RespMonitorReport, TheJsonEscaperEscapesTheSpecials) {
+  EXPECT_EQ(EscapeRespMonitorJsonString("a\"b"), "\"a\\\"b\"");
+  EXPECT_EQ(EscapeRespMonitorJsonString("a\\b"), "\"a\\\\b\"");
+  EXPECT_EQ(EscapeRespMonitorJsonString("a\nb"), "\"a\\nb\"");
+  EXPECT_EQ(EscapeRespMonitorJsonString("a\tb"), "\"a\\tb\"");
+  EXPECT_EQ(EscapeRespMonitorJsonString("a\rb"), "\"a\\rb\"");
+  EXPECT_EQ(EscapeRespMonitorJsonString("a\x08""b"), "\"a\\bb\"");
+  EXPECT_EQ(EscapeRespMonitorJsonString("a\x0c""b"), "\"a\\fb\"");
+}
+
+TEST(RespMonitorReport, TheJsonEscaperEscapesAControlCharacter) {
+  EXPECT_EQ(EscapeRespMonitorJsonString("a\x01""b"), "\"a\\u0001b\"");
+  EXPECT_EQ(EscapeRespMonitorJsonString("\x1f"), "\"\\u001f\"");
+}
+
+TEST(RespMonitorReport, TheJsonEscaperEscapesAnInvalidByte) {
+  // A byte that is not part of a valid UTF-8 sequence cannot go into a JSON
+  // string as it is.
+  EXPECT_EQ(EscapeRespMonitorJsonString("\xff"), "\"\\u00ff\"");
+  EXPECT_EQ(EscapeRespMonitorJsonString("\xc3"), "\"\\u00c3\"");
+  // A truncated multi-byte sequence is escaped byte by byte.
+  EXPECT_EQ(EscapeRespMonitorJsonString("\xe4\xb8"), "\"\\u00e4\\u00b8\"");
+}
+
+TEST(RespMonitorReport, TheJsonEscaperRejectsAnOverlongForm) {
+  // U+0020 written as two bytes is not valid UTF-8.
+  EXPECT_EQ(EscapeRespMonitorJsonString("\xc0\xa0"), "\"\\u00c0\\u00a0\"");
+  // A surrogate is not a code point either.
+  EXPECT_EQ(EscapeRespMonitorJsonString("\xed\xa0\x80"), "\"\\u00ed\\u00a0\\u0080\"");
+}
+
+TEST(RespMonitorReport, TheEscapedBodyIsStillValidJson) {
+  RespMonitorReport report = MakeReport();
+  report.include_body = true;
+  report.body = std::string("line\nbreak\t\"quoted\"") + "\xff";
+  const std::string json = BuildRespMonitorReportJson(report);
+  JsonObject object;
+  EXPECT_TRUE(JsonObject::Parse(json, &object)) << json;
+}
+
+TEST(RespMonitorReport, TheStatusAndTheByteCountAreNumbers) {
+  RespMonitorReport report = MakeReport();
+  report.status = 404;
+  report.body_bytes = 4096;
+  const std::string json = BuildRespMonitorReportJson(report);
+  JsonObject object;
+  ASSERT_TRUE(JsonObject::Parse(json, &object)) << json;
+  const JsonValue* status = object.Find("status");
+  ASSERT_NE(status, nullptr);
+  EXPECT_EQ(status->kind, JsonKind::kNumber);
+  const JsonValue* bytes = object.Find("body_bytes");
+  ASSERT_NE(bytes, nullptr);
+  EXPECT_EQ(bytes->kind, JsonKind::kNumber);
+}
+
+}  // namespace
+}  // namespace lengsuo::fp
diff --git a/lengsuo/native/resp_monitor_test.cc b/lengsuo/native/resp_monitor_test.cc
new file mode 100644
index 0000000..1c33fbe
--- /dev/null
+++ b/lengsuo/native/resp_monitor_test.cc
@@ -0,0 +1,258 @@
+// resp_monitor_test - the matching and the counting (task T1).
+//
+// Three questions decide whether a response is watched: may it be looked at
+// at all, which rule wants it, and has that rule already said enough about
+// that URL. The tests answer all three, and they answer them for the cases
+// the platform cares about: a rule that does not compile, a content type
+// that does not match, a URL that has been seen too often, and a rule set
+// that is switched off.
+#include "resp_monitor.h"
+
+#include <gtest/gtest.h>
+
+#include <string>
+
+namespace lengsuo::fp {
+namespace {
+
+// A request from a page: an https URL with an initiator origin.
+RespMonitorRequest PageRequest(const std::string& url) {
+  RespMonitorRequest request;
+  request.url = url;
+  request.scheme = "https";
+  request.initiator_scheme = "https";
+  return request;
+}
+
+// Builds one rule from its text. The pattern is compiled here so that a rule
+// with a broken pattern is never installed.
+RespMonitorRule MakeRule(const std::string& id,
+                          const std::string& pattern,
+                          std::uint64_t max_count) {
+  RespMonitorRule rule;
+  rule.id = id;
+  rule.url_regex = pattern;
+  rule.matcher =
+      std::make_shared<const std::regex>(pattern, kRespMonitorRegexGrammar);
+  rule.max_count = max_count;
+  return rule;
+}
+
+// The state with one rule installed.
+RespMonitorState StateWith(const RespMonitorRule& rule) {
+  RespMonitorConfig config;
+  config.enabled = true;
+  config.rules.push_back(rule);
+  RespMonitorState state;
+  RespMonitorSetRules(&state, config);
+  return state;
+}
+
+TEST(RespMonitor, AnOffConfigurationInstallsNothing) {
+  RespMonitorConfig config;
+  config.enabled = false;
+  config.rules.push_back(MakeRule("r1", "^https://example\\.test/", 3));
+  RespMonitorState state;
+  RespMonitorSetRules(&state, config);
+  // The whole feature is off: there are no rules, so nothing is registered,
+  // nothing is counted and no buffer is held.
+  EXPECT_TRUE(state.rules.empty());
+  EXPECT_TRUE(state.hits.empty());
+  EXPECT_EQ(MatchRespMonitorRule(&state, PageRequest("https://example.test/a"),
+                                 "text/plain"),
+            nullptr);
+}
+
+TEST(RespMonitor, AnEnabledConfigurationWithNoRulesMatchesNothing) {
+  RespMonitorConfig config;
+  config.enabled = true;
+  RespMonitorState state;
+  RespMonitorSetRules(&state, config);
+  EXPECT_TRUE(state.rules.empty());
+  EXPECT_EQ(MatchRespMonitorRule(&state, PageRequest("https://example.test/a"),
+                                 "text/plain"),
+            nullptr);
+}
+
+TEST(RespMonitor, ARuleThatDoesNotCompileIsNeverInstalled) {
+  // The configuration layer drops such a rule; the matcher never sees one.
+  RespMonitorConfig config;
+  config.enabled = true;
+  RespMonitorState state;
+  RespMonitorSetRules(&state, config);
+  EXPECT_TRUE(state.rules.empty());
+}
+
+TEST(RespMonitor, TheUrlIsMatchedByRegularExpression) {
+  RespMonitorState state = StateWith(MakeRule("r1", "^https://example\\.test/a", 3));
+  const RespMonitorRule* rule =
+      MatchRespMonitorRule(&state, PageRequest("https://example.test/a"), "");
+  ASSERT_NE(rule, nullptr);
+  EXPECT_EQ(rule->id, "r1");
+  // The pattern is anchored, so a different path does not match.
+  EXPECT_EQ(MatchRespMonitorRule(&state, PageRequest("https://example.test/b"), ""),
+            nullptr);
+}
+
+TEST(RespMonitor, ThePatternIsSearchedNotAnchored) {
+  // A rule that wants the whole URL says so with its own anchors; a rule
+  // that does not is a rule about a part of the URL.
+  RespMonitorState state = StateWith(MakeRule("r1", "example\\.test", 3));
+  EXPECT_NE(MatchRespMonitorRule(&state, PageRequest("https://example.test/a"), ""),
+            nullptr);
+  EXPECT_EQ(MatchRespMonitorRule(&state, PageRequest("https://other.test/a"), ""),
+            nullptr);
+}
+
+TEST(RespMonitor, TheContentTypeFiltersAfterTheUrl) {
+  RespMonitorRule rule = MakeRule("r1", "^https://example\\.test/", 3);
+  rule.content_type = "text/html";
+  RespMonitorState state = StateWith(rule);
+  // The right URL and the wrong content type: no match.
+  EXPECT_EQ(MatchRespMonitorRule(&state, PageRequest("https://example.test/a"),
+                                 "application/json"),
+            nullptr);
+  // The right URL and the right content type: a match.
+  EXPECT_NE(MatchRespMonitorRule(&state, PageRequest("https://example.test/a"),
+                                 "text/html"),
+            nullptr);
+}
+
+TEST(RespMonitor, TheContentTypeIsComparedWithoutItsParameters) {
+  RespMonitorRule rule = MakeRule("r1", "^https://example\\.test/", 3);
+  rule.content_type = "text/html";
+  RespMonitorState state = StateWith(rule);
+  EXPECT_NE(MatchRespMonitorRule(&state, PageRequest("https://example.test/a"),
+                                 "Text/HTML; charset=utf-8"),
+            nullptr);
+}
+
+TEST(RespMonitor, TheCountIsPerRuleAndPerUrl) {
+  RespMonitorState state = StateWith(MakeRule("r1", "^https://example\\.test/", 2));
+  // The same URL twice is allowed.
+  EXPECT_NE(MatchRespMonitorRule(&state, PageRequest("https://example.test/a"), ""),
+            nullptr);
+  EXPECT_NE(MatchRespMonitorRule(&state, PageRequest("https://example.test/a"), ""),
+            nullptr);
+  // The third time is over the limit: this URL is not watched any more.
+  EXPECT_EQ(MatchRespMonitorRule(&state, PageRequest("https://example.test/a"), ""),
+            nullptr);
+  // A different URL has its own allowance.
+  EXPECT_NE(MatchRespMonitorRule(&state, PageRequest("https://example.test/b"), ""),
+            nullptr);
+}
+
+TEST(RespMonitor, TheCountIsPerRule) {
+  RespMonitorConfig config;
+  config.enabled = true;
+  config.rules.push_back(MakeRule("r1", "^https://example\\.test/a", 1));
+  config.rules.push_back(MakeRule("r2", "^https://example\\.test/a", 1));
+  RespMonitorState state;
+  RespMonitorSetRules(&state, config);
+  const RespMonitorRequest request = PageRequest("https://example.test/a");
+  const RespMonitorRule* first = MatchRespMonitorRule(&state, request, "");
+  ASSERT_NE(first, nullptr);
+  EXPECT_EQ(first->id, "r1");
+  // The first rule has spent its allowance on this URL, so the second one
+  // gets the URL.
+  const RespMonitorRule* second = MatchRespMonitorRule(&state, request, "");
+  ASSERT_NE(second, nullptr);
+  EXPECT_EQ(second->id, "r2");
+  // And now both have.
+  EXPECT_EQ(MatchRespMonitorRule(&state, request, ""), nullptr);
+}
+
+TEST(RespMonitor, TheBrowserItsOwnRequestIsNotWatched) {
+  RespMonitorState state = StateWith(MakeRule("r1", "^https://example\\.test/", 3));
+  RespMonitorRequest request = PageRequest("https://example.test/a");
+  // No initiator origin: the request is the browser's own.
+  request.initiator_scheme.clear();
+  EXPECT_FALSE(IsRespMonitorRequestEligible(request));
+  EXPECT_EQ(MatchRespMonitorRule(&state, request, ""), nullptr);
+}
+
+TEST(RespMonitor, AnExtensionsRequestIsNotWatched) {
+  RespMonitorState state = StateWith(MakeRule("r1", "^https://example\\.test/", 3));
+  RespMonitorRequest request = PageRequest("https://example.test/a");
+  request.initiator_scheme = "chrome-extension";
+  EXPECT_FALSE(IsRespMonitorRequestEligible(request));
+  EXPECT_EQ(MatchRespMonitorRule(&state, request, ""), nullptr);
+}
+
+TEST(RespMonitor, ANonHttpSchemeIsNotWatched) {
+  RespMonitorState state = StateWith(MakeRule("r1", "example", 3));
+  for (const char* scheme : {"data", "blob", "chrome", "file", "about", "ftp"}) {
+    RespMonitorRequest request = PageRequest("example.test/a");
+    request.scheme = scheme;
+    EXPECT_FALSE(IsRespMonitorRequestEligible(request)) << scheme;
+    EXPECT_EQ(MatchRespMonitorRule(&state, request, ""), nullptr) << scheme;
+  }
+}
+
+TEST(RespMonitor, APageRequestIsEligible) {
+  RespMonitorState state = StateWith(MakeRule("r1", "^https://example\\.test/", 3));
+  const RespMonitorRequest request = PageRequest("https://example.test/a");
+  EXPECT_TRUE(IsRespMonitorRequestEligible(request));
+}
+
+TEST(RespMonitor, ADisabledRuleStopsMatching) {
+  RespMonitorState state = StateWith(MakeRule("r1", "^https://example\\.test/", 3));
+  RespMonitorDisableRule(&state, "r1");
+  EXPECT_EQ(MatchRespMonitorRule(&state, PageRequest("https://example.test/a"), ""),
+            nullptr);
+  // The failure is counted, once.
+  EXPECT_EQ(state.failures, 1u);
+  RespMonitorDisableRule(&state, "r1");
+  EXPECT_EQ(state.failures, 1u);
+}
+
+TEST(RespMonitor, TheCounterMapIsBounded) {
+  RespMonitorState state = StateWith(MakeRule("r1", "^https://example\\.test/", 1));
+  // Fill the counter map up to its bound.
+  for (std::size_t i = 0; i < kRespMonitorMaxTrackedUrls; ++i) {
+    const RespMonitorRequest request =
+        PageRequest("https://example.test/" + std::to_string(i));
+    EXPECT_NE(MatchRespMonitorRule(&state, request, ""), nullptr) << i;
+  }
+  EXPECT_EQ(state.hits.size(), kRespMonitorMaxTrackedUrls);
+  // The next URL would need one more entry, so the rule that would grow it
+  // is switched off and the failure is counted.
+  const RespMonitorRequest over =
+      PageRequest("https://example.test/" + std::to_string(kRespMonitorMaxTrackedUrls));
+  EXPECT_EQ(MatchRespMonitorRule(&state, over, ""), nullptr);
+  EXPECT_EQ(state.disabled_rules.count("r1"), 1u);
+  EXPECT_EQ(state.failures, 1u);
+}
+
+TEST(RespMonitor, InstallingTheRulesAgainDoesNotResetTheCounters) {
+  RespMonitorConfig config;
+  config.enabled = true;
+  config.rules.push_back(MakeRule("r1", "^https://example\\.test/", 1));
+  RespMonitorState state;
+  RespMonitorSetRules(&state, config);
+  EXPECT_NE(MatchRespMonitorRule(&state, PageRequest("https://example.test/a"), ""),
+            nullptr);
+  // The configuration is pushed down again - once per storage partition,
+  // perhaps - and the rule does not get a fresh allowance for it.
+  RespMonitorSetRules(&state, config);
+  EXPECT_EQ(MatchRespMonitorRule(&state, PageRequest("https://example.test/a"), ""),
+            nullptr);
+}
+
+TEST(RespMonitor, ARuleThatIsNoLongerInstalledTakesItsCountersWithIt) {
+  RespMonitorConfig config;
+  config.enabled = true;
+  config.rules.push_back(MakeRule("r1", "^https://example\\.test/", 3));
+  RespMonitorState state;
+  RespMonitorSetRules(&state, config);
+  EXPECT_NE(MatchRespMonitorRule(&state, PageRequest("https://example.test/a"), ""),
+            nullptr);
+  ASSERT_EQ(state.hits.size(), 1u);
+  config.rules.clear();
+  RespMonitorSetRules(&state, config);
+  EXPECT_TRUE(state.hits.empty());
+  EXPECT_TRUE(state.rules.empty());
+}
+
+}  // namespace
+}  // namespace lengsuo::fp
diff --git a/lengsuo/native/storage_consistency.cc b/lengsuo/native/storage_consistency.cc
new file mode 100644
index 0000000..997baab
--- /dev/null
+++ b/lengsuo/native/storage_consistency.cc
@@ -0,0 +1,96 @@
+#include "storage_consistency.h"
+
+#include <cstddef>
+#include <string_view>
+
+namespace lengsuo::fp {
+namespace {
+
+char AsciiLower(char c) {
+  return c >= 'A' && c <= 'Z' ? static_cast<char>(c - 'A' + 'a') : c;
+}
+
+bool EqualsIgnoreCase(std::string_view a, std::string_view b) {
+  if (a.size() != b.size()) {
+    return false;
+  }
+  for (std::size_t i = 0; i < a.size(); ++i) {
+    if (AsciiLower(a[i]) != AsciiLower(b[i])) {
+      return false;
+    }
+  }
+  return true;
+}
+
+std::string_view StripLeadingDot(std::string_view value) {
+  if (!value.empty() && value.front() == '.') {
+    value.remove_prefix(1);
+  }
+  return value;
+}
+
+// Duplicate facts are outside the contract. First match wins; the choice is
+// flagged in the task-F report rather than settled here.
+const CookieFact* FindCookie(const std::vector<CookieFact>& cookies,
+                             const ConsistencyRule& rule) {
+  for (const CookieFact& cookie : cookies) {
+    if (cookie.name == rule.cookie_name &&
+        CookieDomainMatches(cookie.domain, rule.cookie_domain)) {
+      return &cookie;
+    }
+  }
+  return nullptr;
+}
+
+const StorageFact* FindStorage(const std::vector<StorageFact>& storage,
+                               const ConsistencyRule& rule) {
+  for (const StorageFact& fact : storage) {
+    if (fact.origin == rule.storage_origin && fact.key == rule.storage_key) {
+      return &fact;
+    }
+  }
+  return nullptr;
+}
+
+}  // namespace
+
+std::vector<Mismatch> CheckConsistency(
+    const std::vector<CookieFact>& cookies,
+    const std::vector<StorageFact>& storage,
+    const std::vector<ConsistencyRule>& rules) {
+  std::vector<Mismatch> mismatches;
+  for (const ConsistencyRule& rule : rules) {
+    const CookieFact* cookie = FindCookie(cookies, rule);
+    const StorageFact* fact = FindStorage(storage, rule);
+    // Both absent: the rule describes another environment, not a conflict.
+    if (cookie == nullptr && fact == nullptr) {
+      continue;
+    }
+    const std::string_view cookie_value =
+        cookie != nullptr ? std::string_view(cookie->value) : std::string_view();
+    const std::string_view storage_value =
+        fact != nullptr ? std::string_view(fact->value) : std::string_view();
+    if (cookie != nullptr && fact != nullptr && cookie_value == storage_value) {
+      continue;
+    }
+    mismatches.push_back(
+        Mismatch{rule, std::string(cookie_value), std::string(storage_value)});
+  }
+  return mismatches;
+}
+
+bool CookieDomainMatches(std::string_view host, std::string_view domain) {
+  host = StripLeadingDot(host);
+  domain = StripLeadingDot(domain);
+  if (domain.empty()) {
+    return false;
+  }
+  if (EqualsIgnoreCase(host, domain)) {
+    return true;
+  }
+  return host.size() > domain.size() &&
+         host[host.size() - domain.size() - 1] == '.' &&
+         EqualsIgnoreCase(host.substr(host.size() - domain.size()), domain);
+}
+
+}  // namespace lengsuo::fp
diff --git a/lengsuo/native/storage_consistency.h b/lengsuo/native/storage_consistency.h
new file mode 100644
index 0000000..1132777
--- /dev/null
+++ b/lengsuo/native/storage_consistency.h
@@ -0,0 +1,79 @@
+// storage_consistency v1 - cookie <-> localStorage cross-check (task F).
+//
+// 对标端 pins the device fields a platform generated by keeping the Cookie copy
+// and the localStorage copy byte-identical (docs/cc-task-brief-l3.md, task F):
+//
+//   .pinduoduo.com  _bee = 7FcROX...  <->  mms.pinduoduo.com  finger-key_0.1.5
+//
+// This is a pure decision function: no IO, no browser state, no clock. The
+// browser side calls it before persisting a profile and refuses the write when
+// any rule reports a mismatch.
+//
+// Missing-side semantics (contract, task F items 3-5):
+//   * One side missing => a Mismatch, with the missing side's value empty.
+//   * Both sides missing => the rule does not apply to this environment and is
+//     NOT a mismatch.
+// An empty string is therefore the "absent" sentinel in Mismatch; a fact that
+// exists with an empty value is indistinguishable from a missing fact in the
+// output (the struct has no presence flag).
+//
+// Cookie domain matching follows RFC 6265 5.1.3: a leading dot on the rule
+// domain is ignored, matching is case-insensitive, and a rule domain matches
+// the host itself or any dot-suffixed subdomain (".pinduoduo.com" covers
+// "mms.pinduoduo.com"). Origins and keys are compared byte-exactly; the brief
+// only asks for subdomain semantics on the cookie side.
+#ifndef LENGSUO_NATIVE_STORAGE_CONSISTENCY_H_
+#define LENGSUO_NATIVE_STORAGE_CONSISTENCY_H_
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace lengsuo::fp {
+
+struct CookieFact {
+  std::string domain;  // ".pinduoduo.com"
+  std::string name;    // "_bee"
+  std::string value;
+};
+
+struct StorageFact {
+  std::string origin;  // "https://mms.pinduoduo.com"
+  std::string key;     // "finger-key_0.1.5"
+  std::string value;
+};
+
+struct ConsistencyRule {
+  std::string cookie_domain;
+  std::string cookie_name;
+  std::string storage_origin;
+  std::string storage_key;
+};
+
+struct Mismatch {
+  ConsistencyRule rule;
+  std::string cookie_value;   // empty when the cookie side is missing
+  std::string storage_value;  // empty when the storage side is missing
+};
+
+// Rules are evaluated in order; at most one Mismatch is emitted per rule.
+// Returns all mismatches (empty = every applicable rule agrees).
+std::vector<Mismatch> CheckConsistency(
+    const std::vector<CookieFact>& cookies,
+    const std::vector<StorageFact>& storage,
+    const std::vector<ConsistencyRule>& rules);
+
+// RFC 6265 5.1.3 domain matching, exported so the cookie side of the
+// cross-store lock (native/cookie_mirror.h) matches domains exactly the way
+// the consistency checker does - one implementation, one answer.
+//
+// `host` is the concrete page host, `domain` is the domain a rule or a
+// pinned cookie declared. A leading dot on either side is ignored, matching
+// is ASCII case-insensitive, and `domain` covers `host` itself plus every
+// dot-suffixed subdomain of it (".pinduoduo.com" covers
+// "mms.pinduoduo.com"). An empty `domain` matches nothing.
+bool CookieDomainMatches(std::string_view host, std::string_view domain);
+
+}  // namespace lengsuo::fp
+
+#endif  // LENGSUO_NATIVE_STORAGE_CONSISTENCY_H_
diff --git a/lengsuo/native/storage_pin.cc b/lengsuo/native/storage_pin.cc
new file mode 100644
index 0000000..dd549e3
--- /dev/null
+++ b/lengsuo/native/storage_pin.cc
@@ -0,0 +1,161 @@
+#include "storage_pin.h"
+
+#include <algorithm>
+#include <iterator>
+#include <string_view>
+#include <utility>
+
+namespace lengsuo::fp {
+namespace {
+
+constexpr char kDelimiter = '|';
+
+bool IsControl(unsigned char character) {
+  return character < 0x20 || character == 0x7f;
+}
+
+// "http://" or "https://" (lowercase, per the task brief) followed by a
+// non-empty host part with no whitespace/control bytes or delimiters.
+bool ValidOrigin(const std::string& origin) {
+  std::string_view rest;
+  if (origin.rfind("https://", 0) == 0) {
+    rest = std::string_view(origin).substr(8);
+  } else if (origin.rfind("http://", 0) == 0) {
+    rest = std::string_view(origin).substr(7);
+  } else {
+    return false;
+  }
+  if (rest.empty()) {
+    return false;
+  }
+  for (const unsigned char character : rest) {
+    if (IsControl(character) || character == ' ' || character == kDelimiter) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool ValidKey(const std::string& key) {
+  if (key.empty()) {
+    return false;
+  }
+  for (const unsigned char character : key) {
+    if (IsControl(character)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+}  // namespace
+
+bool StoragePin::Parse(const std::string& wire) {
+  if (wire.empty()) {
+    return false;
+  }
+
+  // Build into a scratch object so any failure leaves `*this` untouched.
+  StoragePin parsed;
+  std::size_t start = 0;
+  while (start < wire.size()) {
+    const std::size_t newline = wire.find('\n', start);
+    const std::size_t end =
+        newline == std::string::npos ? wire.size() : newline;
+    std::string line = wire.substr(start, end - start);
+    start = newline == std::string::npos ? wire.size() : newline + 1;
+
+    if (!line.empty() && line.back() == '\r') {
+      line.pop_back();
+    }
+    if (line.empty() || !parsed.ParseLine(line)) {
+      return false;
+    }
+  }
+
+  domains_ = std::move(parsed.domains_);
+  return true;
+}
+
+bool StoragePin::ParseLine(const std::string& line) {
+  std::vector<std::string> fields;
+  std::size_t start = 0;
+  while (true) {
+    const std::size_t delimiter = line.find(kDelimiter, start);
+    if (delimiter == std::string::npos) {
+      fields.push_back(line.substr(start));
+      break;
+    }
+    fields.push_back(line.substr(start, delimiter - start));
+    start = delimiter + 1;
+  }
+  if (fields.size() != 4) {
+    return false;
+  }
+
+  const std::string& origin = fields[0];
+  const std::string& scope = fields[1];
+  const std::string& key = fields[2];
+  const std::string& value = fields[3];
+
+  if (!ValidOrigin(origin) || !ValidKey(key)) {
+    return false;
+  }
+  if (scope != "local" && scope != "session") {
+    return false;
+  }
+
+  auto domain = std::find_if(
+      domains_.begin(), domains_.end(),
+      [&origin](const DomainPin& entry) { return entry.origin == origin; });
+  if (domain == domains_.end()) {
+    domains_.push_back(DomainPin{origin, {}, {}});
+    domain = std::prev(domains_.end());
+  }
+
+  std::vector<PinnedEntry>& entries =
+      scope == "local" ? domain->local_storage : domain->session_storage;
+  auto entry = std::find_if(
+      entries.begin(), entries.end(),
+      [&key](const PinnedEntry& pinned) { return pinned.key == key; });
+  if (entry != entries.end()) {
+    entry->value = value;
+  } else {
+    entries.push_back(PinnedEntry{key, value});
+  }
+  return true;
+}
+
+const DomainPin* StoragePin::Find(const std::string& origin) const {
+  for (const DomainPin& domain : domains_) {
+    if (domain.origin == origin) {
+      return &domain;
+    }
+  }
+  return nullptr;
+}
+
+bool StoragePin::IsLocked(const std::string& origin,
+                          const std::string& key) const {
+  const DomainPin* domain = Find(origin);
+  if (domain == nullptr) {
+    return false;
+  }
+  const auto pinned = [&key](const PinnedEntry& entry) {
+    return entry.key == key;
+  };
+  return std::any_of(domain->local_storage.begin(), domain->local_storage.end(),
+                     pinned) ||
+         std::any_of(domain->session_storage.begin(),
+                     domain->session_storage.end(), pinned);
+}
+
+std::size_t StoragePin::size() const {
+  std::size_t total = 0;
+  for (const DomainPin& domain : domains_) {
+    total += domain.local_storage.size() + domain.session_storage.size();
+  }
+  return total;
+}
+
+}  // namespace lengsuo::fp
diff --git a/lengsuo/native/storage_pin.h b/lengsuo/native/storage_pin.h
new file mode 100644
index 0000000..5543753
--- /dev/null
+++ b/lengsuo/native/storage_pin.h
@@ -0,0 +1,72 @@
+#ifndef LENGSUO_NATIVE_STORAGE_PIN_H_
+#define LENGSUO_NATIVE_STORAGE_PIN_H_
+
+#include <cstddef>
+#include <string>
+#include <vector>
+
+namespace lengsuo::fp {
+
+struct PinnedEntry {
+  std::string key;
+  std::string value;
+};
+
+// A single origin's pin table. origin looks like "https://mms.pinduoduo.com".
+struct DomainPin {
+  std::string origin;
+  std::vector<PinnedEntry> local_storage;
+  std::vector<PinnedEntry> session_storage;
+};
+
+// Per-origin DOM storage pins: values written before page script runs and
+// treated as read-only thereafter (Reference semantics: pinned means locked).
+//
+// Wire format: one pin per line, four '|'-separated segments:
+//
+//   <origin>|<scope>|<key>|<value>
+//
+//   origin  "http://..." or "https://..." (lowercase scheme, non-empty rest)
+//   scope   "local" (localStorage) or "session" (sessionStorage)
+//   key     non-empty, no control characters
+//   value   may be empty; '|' and newlines are not representable
+//
+// A single trailing "\n" or "\r\n" on the last line is accepted. Empty input,
+// blank lines, unknown scopes, malformed origins and any segment count other
+// than four are rejected. Values containing '|' therefore fail closed instead
+// of being silently truncated.
+//
+// Duplicates: a repeated (origin, scope, key) keeps one entry whose value is
+// the last one parsed; position is that of the first occurrence.
+//
+// The wire encoding is not fixed by the L3 task brief; this grammar is the
+// contract recorded in the header so callers and tests share one definition.
+class StoragePin {
+ public:
+  // Replaces the current table only after the whole input validates. On
+  // failure returns false and leaves the previous table unchanged.
+  bool Parse(const std::string& wire);
+
+  // Exact origin match. Returns nullptr when the origin has no pinned entries.
+  const DomainPin* Find(const std::string& origin) const;
+
+  // True when `key` is pinned for `origin` in either storage area. The
+  // contract has no scope argument, so either area locks the key.
+  bool IsLocked(const std::string& origin, const std::string& key) const;
+
+  // Total number of pinned key/value pairs across both storage areas and all
+  // origins (duplicates count once).
+  std::size_t size() const;
+
+  // Read-only view in parse order; callers must not mutate through it.
+  const std::vector<DomainPin>& Domains() const { return domains_; }
+
+ private:
+  bool ParseLine(const std::string& line);
+
+  std::vector<DomainPin> domains_;
+};
+
+}  // namespace lengsuo::fp
+
+#endif  // LENGSUO_NATIVE_STORAGE_PIN_H_
diff --git a/lengsuo/native/wire_reader.h b/lengsuo/native/wire_reader.h
new file mode 100644
index 0000000..158007a
--- /dev/null
+++ b/lengsuo/native/wire_reader.h
@@ -0,0 +1,107 @@
+#ifndef LENGSUO_NATIVE_WIRE_READER_H_
+#define LENGSUO_NATIVE_WIRE_READER_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <span>
+#include <string>
+
+namespace lengsuo {
+// Bounded big-endian cursor shared by the LBPF1/LBPC1 decoders. Every read
+// either advances with validated data or fails; no partial field escapes.
+class WireReader {
+ public:
+  explicit WireReader(std::span<const std::uint8_t> bytes) : bytes_(bytes) {}
+
+  bool Number(std::uint32_t& out, std::size_t count) {
+    if (count > bytes_.size() - pos_) {
+      return false;
+    }
+    out = 0;
+    for (std::size_t i = 0; i < count; ++i) {
+      out = (out << 8) | bytes_[pos_++];
+    }
+    return true;
+  }
+
+  // Fixed-length (2-byte count) printable field; empty values fail.
+  bool Text(std::string& out, std::size_t max, bool identifier = false) {
+    return OptionalText(out, max, identifier) && !out.empty();
+  }
+
+  // Like Text() but a zero-length value is accepted and yields an empty
+  // string; used only where the format explicitly allows emptiness.
+  bool OptionalText(std::string& out, std::size_t max,
+                    bool identifier = false) {
+    std::uint32_t count;
+    if (!Number(count, 2) || count > max ||
+        count > bytes_.size() - pos_) {
+      return false;
+    }
+    out.clear();
+    for (std::uint32_t i = 0; i < count; ++i) {
+      const auto c = bytes_[pos_++];
+      const bool id = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+                      (c >= '0' && c <= '9') || c == '-' || c == '_';
+      if (c < 32 || c > 126 || (identifier && !id)) {
+        return false;
+      }
+      out.push_back(static_cast<char>(c));
+    }
+    return true;
+  }
+
+  bool Byte(std::uint8_t& out) {
+    if (pos_ >= bytes_.size()) {
+      return false;
+    }
+    out = bytes_[pos_++];
+    return true;
+  }
+
+  bool End() const { return pos_ == bytes_.size(); }
+
+  // Cursor position, needed to build optional trailing sections: a reader may
+  // only consume a tag it has already confirmed, so the caller looks ahead,
+  // then rewinds to just past the tag it accepted.
+  std::size_t position() const { return pos_; }
+  bool Seek(std::size_t position) {
+    if (position > bytes_.size()) {
+      return false;
+    }
+    pos_ = position;
+    return true;
+  }
+
+  // Reads the 2-byte length prefix and the following bytes without moving the
+  // cursor. Returns false (and reads nothing) when the field does not fit.
+  bool PeekText(std::string& out) {
+    const std::size_t mark = pos_;
+    std::uint32_t count;
+    if (!Number(count, 2) || count > bytes_.size() - pos_) {
+      pos_ = mark;  // a lookahead never moves the cursor, on any path
+      return false;
+    }
+    out.clear();
+    for (std::uint32_t i = 0; i < count; ++i) {
+      const auto c = bytes_[pos_ + i];
+      if (c < 32 || c > 126) {
+        pos_ = mark;
+        return false;
+      }
+      out.push_back(static_cast<char>(c));
+    }
+    return true;
+  }
+
+ private:
+  std::span<const std::uint8_t> bytes_;
+  std::size_t pos_ = 0;
+};
+
+inline bool InRange(std::uint32_t value, std::uint32_t low,
+                    std::uint32_t high) {
+  return value >= low && value <= high;
+}
+}  // namespace lengsuo
+#endif
diff --git a/lengsuo/public/mojom/BUILD.gn b/lengsuo/public/mojom/BUILD.gn

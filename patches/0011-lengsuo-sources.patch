@@ -0,0 +1,374 @@
+// Requires Chromium base/gtest build; standalone tests live separately.
+#include "lengsuo/integration/browser_bootstrap.h"
+#include <ctime>
+#include "build/build_config.h"
+#include "components/content_settings/core/common/content_settings_pattern.h"
+#include "third_party/blink/public/common/peerconnection/webrtc_ip_handling_url_entry.h"
+#include "third_party/blink/public/common/renderer_preferences/renderer_preferences.h"
+#include "third_party/blink/public/common/web_preferences/web_preferences.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/display/screen_infos.h"
+#include "ui/gfx/geometry/rect.h"
+#include "third_party/blink/public/common/user_agent/user_agent_metadata.h"
+namespace {
+#include "lengsuo/native/golden.inc"
+constexpr unsigned char kGoldenCatalog[] = {
+    76,  66,  80,  67,  49,  0,   0,   0,   1,   0,   2,   112,
+    49,  0,   1,   0,   2,   117, 97,  0,   0,   0,   7,   0,
+    19,  83,  121, 110, 116, 104, 47,  49,  46,  48,  32,  84,
+    101, 115, 116, 32,  69,  110, 118, 55,  2,   0,   5,   65,
+    108, 112, 104, 97,  0,   3,   49,  46,  50,  0,   4,   66,
+    101, 116, 97,  0,   3,   51,  46,  52,  2,   0,   5,   65,
+    108, 112, 104, 97,  0,   7,   49,  46,  50,  46,  55,  46,
+    56,  0,   4,   66,  101, 116, 97,  0,   7,   51,  46,  52,
+    46,  57,  46,  48,  0,   6,   84,  101, 115, 116, 79,  83,
+    0,   6,   49,  48,  46,  48,  46,  48,  0,   3,   120, 56,
+    54,  0,   2,   54,  52,  0,   0,   0};
+std::string CatalogWire() {
+  return std::string(reinterpret_cast<const char*>(kGoldenCatalog),
+                     sizeof(kGoldenCatalog));
+}
+}
+namespace lengsuo {
+TEST(BrowserBootstrap, TimezoneSystemIdsRejectUnknownAndUnsafeInput) {
+  for (auto zone : {"UTC", "America/New_York", "Europe/London", "Etc/GMT-8"})
+    EXPECT_TRUE(IsValidProfileTimezone(zone)) << zone;
+  for (auto zone : {"", "Mars/Olympus", "GMT+08:00", " UTC", "UTC ", "UTC\n"})
+    EXPECT_FALSE(IsValidProfileTimezone(zone)) << zone;
+  EXPECT_FALSE(IsValidProfileTimezone(std::string(65, 'a')));
+  EXPECT_FALSE(IsValidProfileTimezone(std::string_view("UTC\0junk", 8)));
+  EXPECT_FALSE(IsValidProfileTimezone("\xc3\xa9"));
+}
+
+TEST(BrowserBootstrap, RejectsSchemaTwoUntilPolicyInjectionIsAccepted) {
+  std::string wire(reinterpret_cast<const char*>(kGolden), sizeof(kGolden));
+  wire[8] = 2;
+  wire.insert(65, 1, static_cast<char>(3));
+  auto parsed = DecodeProfile(std::span<const std::uint8_t>(
+      reinterpret_cast<const std::uint8_t*>(wire.data()), wire.size()));
+  ASSERT_TRUE(parsed);
+  ASSERT_EQ(2u, parsed->schema_version);
+  ProfileBootstrapState state;
+  EXPECT_FALSE(state.Initialize(true, true,
+      [&]() -> std::optional<std::string> { return wire; }));
+  EXPECT_EQ(nullptr, state.profile());
+  EXPECT_FALSE(state.Initialize(true, true,
+      [&]() -> std::optional<std::string> { return wire; }));
+}
+TEST(BrowserBootstrap, CatalogBindingFreezesAndRejectsInvalidOrMissingSlot) {
+  for (int scenario : {0, 1, 2, 3, 4, 5}) {
+    ProfileBootstrapState state;
+    ASSERT_TRUE(state.Initialize(true, true, []() -> std::optional<std::string> {
+      return std::string(reinterpret_cast<const char*>(kGolden), sizeof(kGolden));
+    }));
+    auto wire = CatalogWire();
+    if (scenario == 1) wire[12] = '2';  // Different pool p2.
+    if (scenario == 2) wire[22] = 8;    // Different UA slot.
+    if (scenario == 3) wire.clear();
+    if (scenario == 4) wire.resize(4097, 'x');
+    if (scenario == 5) wire = "bad";
+    int reads = 0;
+    const bool initialized = state.InitializeCatalog(true, true,
+        [&]() -> std::optional<std::string> { ++reads; return wire; });
+    EXPECT_EQ(scenario == 0, initialized);
+    EXPECT_EQ(1, reads);
+    if (scenario == 0) {
+      ASSERT_NE(nullptr, state.ua());
+      EXPECT_EQ("Synth/1.0 Test Env7", state.ua()->ua_string);
+    } else {
+      EXPECT_EQ(nullptr, state.ua());
+    }
+    const auto* frozen = state.ua();
+    EXPECT_FALSE(state.InitializeCatalog(true, true,
+        []() -> std::optional<std::string> { return CatalogWire(); }));
+    EXPECT_EQ(frozen, state.ua());
+  }
+}
+TEST(BrowserBootstrap, UaMetadataUsesEveryCatalogFieldAndPreservesAbsentFields) {
+  auto bytes = CatalogWire();
+  auto catalog = DecodeCatalog(std::span<const std::uint8_t>(
+      reinterpret_cast<const std::uint8_t*>(bytes.data()), bytes.size()));
+  ASSERT_TRUE(catalog);
+  blink::UserAgentMetadata metadata;
+  metadata.full_version = "upstream";
+  metadata.wow64 = true;
+  metadata.form_factors = {"Desktop"};
+  metadata.brand_version_list.emplace_back("old", "0");
+  ASSERT_TRUE(ApplyUaMetadata(catalog->ua_entries[0], &metadata));
+  ASSERT_EQ(2u, metadata.brand_version_list.size());
+  EXPECT_EQ("Alpha", metadata.brand_version_list[0].brand);
+  EXPECT_EQ("1.2", metadata.brand_version_list[0].version);
+  ASSERT_EQ(2u, metadata.brand_full_version_list.size());
+  EXPECT_EQ("Beta", metadata.brand_full_version_list[1].brand);
+  EXPECT_EQ("3.4.9.0", metadata.brand_full_version_list[1].version);
+  EXPECT_EQ("TestOS", metadata.platform);
+  EXPECT_EQ("10.0.0", metadata.platform_version);
+  EXPECT_EQ("x86", metadata.architecture);
+  EXPECT_EQ("64", metadata.bitness);
+  EXPECT_TRUE(metadata.model.empty());
+  EXPECT_FALSE(metadata.mobile);
+  EXPECT_EQ("upstream", metadata.full_version);
+  EXPECT_TRUE(metadata.wow64);
+  EXPECT_EQ(std::vector<std::string>({"Desktop"}), metadata.form_factors);
+  auto entry = catalog->ua_entries[0];
+  entry.mobile = true;
+  entry.model = "Synthetic phone";
+  entry.full_versions.clear();
+  EXPECT_TRUE(ApplyUaMetadata(entry, &metadata));
+  EXPECT_TRUE(metadata.mobile);
+  EXPECT_EQ("Synthetic phone", metadata.model);
+  EXPECT_TRUE(metadata.brand_full_version_list.empty());
+}
+
+TEST(BrowserBootstrap, CatalogRequiresProfileAndSafePathAndCannotBeRetried) {
+  ProfileBootstrapState absent;
+  int reads = 0;
+  auto reader = [&]() -> std::optional<std::string> {
+    ++reads;
+    return "invalid";
+  };
+  EXPECT_FALSE(absent.InitializeCatalog(true, true, reader));
+  EXPECT_EQ(0, reads);
+  EXPECT_EQ(nullptr, absent.ua());
+  EXPECT_FALSE(absent.InitializeCatalog(false, false, reader));
+  ProfileBootstrapState state;
+  ASSERT_TRUE(state.Initialize(true, true, []() -> std::optional<std::string> {
+    return std::string(reinterpret_cast<const char*>(kGolden), sizeof(kGolden));
+  }));
+  EXPECT_FALSE(state.InitializeCatalog(true, false, reader));
+  EXPECT_EQ(0, reads);
+  EXPECT_FALSE(state.InitializeCatalog(true, true, reader));
+  EXPECT_EQ(0, reads);
+  EXPECT_EQ(nullptr, state.ua());
+}
+TEST(BrowserBootstrap, RefusesEmptyRelativeTraversalAndNetworkPaths) {
+  EXPECT_FALSE(IsSafeProfilePath(base::FilePath()));
+  EXPECT_FALSE(IsSafeProfilePath(base::FilePath(FILE_PATH_LITERAL("profile.bin"))));
+  EXPECT_FALSE(IsSafeProfilePath(base::FilePath(FILE_PATH_LITERAL("//server/share/p.bin"))));
+  EXPECT_FALSE(IsSafeProfilePath(base::FilePath(FILE_PATH_LITERAL("/tmp/../p.bin"))));
+#if BUILDFLAG(IS_WIN)
+  EXPECT_FALSE(IsSafeProfilePath(base::FilePath(FILE_PATH_LITERAL("\\\\server\\share\\p.bin"))));
+  EXPECT_FALSE(IsSafeProfilePath(base::FilePath(FILE_PATH_LITERAL("\\\\?\\C:\\p.bin"))));
+#endif
+}
+TEST(BrowserBootstrap, SwitchPresenceDoesNotImplyValidPathOrAuthorization) {
+  base::CommandLine command(base::CommandLine::NO_PROGRAM);
+  EXPECT_FALSE(IsManagedBrowserCommand(command));
+  command.AppendSwitch(kProfileWireSwitch);
+  EXPECT_TRUE(IsManagedBrowserCommand(command));
+  EXPECT_FALSE(InitializeBrowserProfile(command));
+  EXPECT_EQ(nullptr, BrowserProfile());
+  // Failed startup cannot be replaced by a later no-profile initialization.
+  base::CommandLine other(base::CommandLine::NO_PROGRAM);
+  EXPECT_FALSE(InitializeBrowserProfile(other));
+  EXPECT_EQ(nullptr, BrowserProfile());
+}
+TEST(BrowserBootstrap, TouchPreferencesAreConsistentAndIdempotent) {
+  for (int points : {0, 1, 5, 10}) {
+    ParsedProfile profile;
+    profile.max_touch_points = points;
+    blink::web_pref::WebPreferences prefs;
+    ApplyTouchPreferences(profile, &prefs);
+    EXPECT_EQ(points, prefs.pointer_events_max_touch_points);
+    EXPECT_EQ(points != 0, prefs.touch_event_feature_detection_enabled);
+    const int pointer = points ? 2 : 4;
+    const int hover = points ? 1 : 2;
+    EXPECT_EQ(pointer, prefs.available_pointer_types);
+    EXPECT_EQ(pointer, static_cast<int>(prefs.primary_pointer_type));
+    EXPECT_EQ(hover, prefs.available_hover_types);
+    EXPECT_EQ(hover, static_cast<int>(prefs.primary_hover_type));
+    EXPECT_FALSE(ApplyTouchPreferences(profile, &prefs));
+  }
+}
+TEST(BrowserBootstrap, GoldenWireInitializesFrozenStateAndAppliesTouch) {
+  ProfileBootstrapState state;
+  int reads = 0;
+  const auto reader = [&]() -> std::optional<std::string> {
+    ++reads;
+    return std::string(reinterpret_cast<const char*>(kGolden), sizeof(kGolden));
+  };
+  ASSERT_TRUE(state.Initialize(true, true, reader));
+  const auto* profile = state.profile();
+  ASSERT_NE(nullptr, profile);
+  EXPECT_EQ(1, reads);
+  EXPECT_EQ(0u, profile->max_touch_points);
+  EXPECT_EQ(1920u, profile->width);
+  EXPECT_EQ(1080u, profile->height);
+  EXPECT_EQ(Platform::Windows, profile->platform);
+  EXPECT_EQ("env-1", profile->environment_id);
+  EXPECT_FALSE(state.Initialize(true, true, reader));
+  EXPECT_EQ(profile, state.profile());
+  EXPECT_EQ(1, reads);
+  // Touch=0 maps to fine pointer and hover through the shared applicator.
+  blink::web_pref::WebPreferences prefs;
+  EXPECT_TRUE(ApplyTouchPreferences(*profile, &prefs));
+  EXPECT_EQ(4, prefs.available_pointer_types);
+  EXPECT_EQ(2, prefs.available_hover_types);
+  EXPECT_EQ(0, prefs.pointer_events_max_touch_points);
+  EXPECT_FALSE(ApplyTouchPreferences(*profile, &prefs));
+}
+namespace {
+// RendererPreferences seeded the way a hostile/default Chrome process can
+// arrive: non-empty per-origin overrides, a non-empty mDNS local-IP
+// exemption list, and a custom UDP port range. Tests must never start from
+// freshly default-empty lists (docs/webrtc-contract-review.md gate 2).
+blink::RendererPreferences WebRtcHostilePrefs() {
+  blink::mojom::WebRtcIpHandlingPolicy policies[] = {
+      blink::mojom::WebRtcIpHandlingPolicy::kDefaultPublicInterfaceOnly,
+      blink::mojom::WebRtcIpHandlingPolicy::kDefault};
+  blink::RendererPreferences prefs;
+  prefs.webrtc_ip_handling_policy =
+      blink::mojom::WebRtcIpHandlingPolicy::kDefaultPublicAndPrivateInterfaces;
+  for (auto policy : policies) {
+    blink::WebRtcIpHandlingUrlEntry entry;
+    entry.url_pattern =
+        ContentSettingsPattern::FromString("https://override.test/*");
+    entry.handling = policy;
+    prefs.webrtc_ip_handling_urls.push_back(entry);
+  }
+  prefs.webrtc_local_ips_allowed_urls = {"https://exempt.test",
+                                         "https://intranet.test"};
+  prefs.webrtc_udp_min_port = 10000;
+  prefs.webrtc_udp_max_port = 10010;
+  return prefs;
+}
+}  // namespace
+
+TEST(BrowserBootstrap, WebRtcPolicyAbsentKeepsHostilePrefsUntouched) {
+  // Schema 1 wire: no policy statement, so upstream fields must survive
+  // exactly, including the per-origin overrides and mDNS exemptions.
+  ParsedProfile profile;
+  EXPECT_EQ(std::nullopt, profile.webrtc_policy);
+  auto prefs = WebRtcHostilePrefs();
+  const auto expected = prefs.webrtc_ip_handling_urls.size();
+  EXPECT_FALSE(ApplyWebRtcPolicy(profile, &prefs));
+  EXPECT_EQ(expected, prefs.webrtc_ip_handling_urls.size());
+  EXPECT_EQ(2u, prefs.webrtc_local_ips_allowed_urls.size());
+  EXPECT_EQ(10000, prefs.webrtc_udp_min_port);
+  EXPECT_EQ(10010, prefs.webrtc_udp_max_port);
+  // The golden schema 1 fixture decodes to nullopt as well.
+  auto decoded = DecodeProfile(std::span<const std::uint8_t>(
+      reinterpret_cast<const std::uint8_t*>(kGolden), sizeof(kGolden)));
+  ASSERT_TRUE(decoded);
+  ASSERT_EQ(1u, decoded->schema_version);
+  EXPECT_EQ(std::nullopt, decoded->webrtc_policy);
+  EXPECT_FALSE(ApplyWebRtcPolicy(*decoded, &prefs));
+}
+
+TEST(BrowserBootstrap, WebRtcPolicyExplicit0To3ClearsOverridesAndRetainsPorts) {
+  using blink::mojom::WebRtcIpHandlingPolicy;
+  // Anchors: enum order in third_party/blink/public/mojom/peerconnection/
+  // webrtc_ip_handling_policy.mojom:10-15 and the branch table in
+  // third_party/blink/renderer/modules/peerconnection/
+  // peer_connection_dependency_factory.cc (1052-1075).
+  const std::array<WebRtcIpHandlingPolicy, 4> expected = {
+      WebRtcIpHandlingPolicy::kDefault,
+      WebRtcIpHandlingPolicy::kDefaultPublicAndPrivateInterfaces,
+      WebRtcIpHandlingPolicy::kDefaultPublicInterfaceOnly,
+      WebRtcIpHandlingPolicy::kDisableNonProxiedUdp};
+  for (std::uint8_t value = 0; value <= 3; ++value) {
+    ParsedProfile profile;
+    profile.webrtc_policy = value;
+    auto prefs = WebRtcHostilePrefs();
+    EXPECT_TRUE(ApplyWebRtcPolicy(profile, &prefs))
+        << "value " << static_cast<int>(value);
+    EXPECT_EQ(expected.at(value), prefs.webrtc_ip_handling_policy);
+    // Effective-policy contract: profile policy takes priority, so both the
+    // per-origin override table and the mDNS exemption list are cleared.
+    EXPECT_TRUE(prefs.webrtc_ip_handling_urls.empty());
+    EXPECT_TRUE(prefs.webrtc_local_ips_allowed_urls.empty());
+    // Retained, unrelated to policy selection.
+    EXPECT_EQ(10000, prefs.webrtc_udp_min_port);
+    EXPECT_EQ(10010, prefs.webrtc_udp_max_port);
+    // Idempotent second application reports no change.
+    EXPECT_FALSE(ApplyWebRtcPolicy(profile, &prefs));
+  }
+}
+
+TEST(BrowserBootstrap, WebRtcPolicyInvalidValueRejectedWithoutMutation) {
+  // In-memory invalid values (a decoder-constructed profile must never
+  // carry these, but the helper guards anyway): prefs are unchanged.
+  for (std::uint8_t value : {std::uint8_t{4}, std::uint8_t{128},
+                             std::uint8_t{255}}) {
+    ParsedProfile profile;
+    profile.webrtc_policy = value;
+    auto prefs = WebRtcHostilePrefs();
+    const auto policy = prefs.webrtc_ip_handling_policy;
+    EXPECT_FALSE(ApplyWebRtcPolicy(profile, &prefs))
+        << "value " << static_cast<int>(value);
+    EXPECT_EQ(policy, prefs.webrtc_ip_handling_policy);
+    EXPECT_EQ(2u, prefs.webrtc_ip_handling_urls.size());
+    EXPECT_EQ(2u, prefs.webrtc_local_ips_allowed_urls.size());
+    EXPECT_EQ(10000, prefs.webrtc_udp_min_port);
+    EXPECT_EQ(10010, prefs.webrtc_udp_max_port);
+  }
+}
+
+TEST(BrowserBootstrap, ProfileWebRtcWrapperFollowsProfilePresence) {
+  auto prefs = WebRtcHostilePrefs();
+  const auto policy = prefs.webrtc_ip_handling_policy;
+  // No profile loaded (real-browser path before initialization): the
+  // wrapper is a no-op reporting false.
+  EXPECT_FALSE(ApplyProfileWebRtcPolicy(&prefs));
+  EXPECT_EQ(policy, prefs.webrtc_ip_handling_policy);
+  EXPECT_EQ(2u, prefs.webrtc_ip_handling_urls.size());
+  // With the golden schema 1 profile frozen into state: still a no-op.
+  ProfileBootstrapState state;
+  ASSERT_TRUE(state.Initialize(true, true,
+      [&]() -> std::optional<std::string> {
+        return std::string(reinterpret_cast<const char*>(kGolden),
+                           sizeof(kGolden));
+      }));
+  ASSERT_NE(nullptr, state.profile());
+  EXPECT_FALSE(ApplyWebRtcPolicy(*state.profile(), &prefs));
+  EXPECT_EQ(policy, prefs.webrtc_ip_handling_policy);
+  EXPECT_EQ(2u, prefs.webrtc_local_ips_allowed_urls.size());
+}
+
+TEST(BrowserBootstrap, ScreenInfosOverrideFollowsProfilePresence) {
+  display::ScreenInfo default_info;
+  default_info.rect = gfx::Rect(0, 0, 800, 600);
+  default_info.device_scale_factor = 1.f;
+  display::ScreenInfos infos(default_info);
+  // No profile: upstream values stay untouched.
+  EXPECT_FALSE(ApplyProfileScreenInfos(&infos));
+  EXPECT_EQ(800, infos.current().rect.width());
+  // With the golden profile loaded through the state reader: full override.
+  ProfileBootstrapState state;
+  ASSERT_TRUE(state.Initialize(true, true,
+                               [&]() -> std::optional<std::string> {
+                                 return std::string(
+                                     reinterpret_cast<const char*>(kGolden),
+                                     sizeof(kGolden));
+                               }));
+  ASSERT_NE(nullptr, state.profile());
+  EXPECT_TRUE(ApplyScreenInfos(*state.profile(), &infos));
+  EXPECT_EQ(1920, infos.current().rect.width());
+  EXPECT_EQ(1080, infos.current().rect.height());
+  EXPECT_EQ(0, infos.current().rect.x());
+  EXPECT_EQ(0, infos.current().rect.y());
+  EXPECT_EQ(1920, infos.current().available_rect.width());
+  EXPECT_EQ(1080, infos.current().available_rect.height());
+  EXPECT_FLOAT_EQ(1.f, infos.current().device_scale_factor);
+  EXPECT_EQ(24, infos.current().depth);
+}
+
+TEST(BrowserBootstrap, L3ClockReadsUnixSecondsNotWindowsEpoch) {
+  // The L3W1 signature line carries "<md5>_v1_t<unix-seconds>". If the
+  // browser's clock were read from the Windows epoch (1601-01-01) it would
+  // run 11644473600 seconds ahead, every document would fall outside the
+  // 7-day freshness window, and startup would abort with
+  // "Lengsuo L3 bootstrap rejected".
+  const int64_t now = L3ClockUnixSeconds();
+  const int64_t reference = static_cast<int64_t>(std::time(nullptr));
+  EXPECT_GT(now, 0);
+  // One minute of slack covers a slow test machine and a clock that ticks
+  // between the two reads.
+  EXPECT_NEAR(reference, now, 60);
+  // Spell the bug out: with the Windows epoch the reading would sit around
+  // 1.34e10 (Unix time plus the 11644473600 s offset), not around 1.79e9.
+  constexpr int64_t kWindowsToUnixEpoch = 11644473600;
+  EXPECT_LT(now, kWindowsToUnixEpoch);
+  EXPECT_GT(now, reference - 60);
+}
+}  // namespace lengsuo
diff --git a/lengsuo/integration/l3_bootstrap.cc b/lengsuo/integration/l3_bootstrap.cc
new file mode 100644
index 0000000..57cfdf9
--- /dev/null
+++ b/lengsuo/integration/l3_bootstrap.cc
@@ -0,0 +1,56 @@
+#include "lengsuo/integration/l3_bootstrap.h"
+
+#include <string_view>
+
+namespace lengsuo {
+namespace {
+
+bool ExceedsLimit(const std::string& wire) {
+  return wire.empty() || wire.size() > fp::kMaxL3WireBytes;
+}
+
+}  // namespace
+
+L3BootstrapState::L3BootstrapState() = default;
+L3BootstrapState::~L3BootstrapState() = default;
+
+bool L3BootstrapState::Initialize(bool requested,
+                                 bool safe_local_path,
+                                 const Reader& read,
+                                 int64_t now_unix,
+                                 int64_t max_age_seconds) {
+  // Single-shot: a second call never re-reads, so a swapped file on disk
+  // cannot change the snapshot after the browser has started.
+  if (attempted_) {
+    return false;
+  }
+  attempted_ = true;
+  if (!requested) {
+    return true;
+  }
+  // An unusable path or clock window is a configuration error, not "absent".
+  if (!safe_local_path || now_unix <= 0 || max_age_seconds <= 0) {
+    load_failed_ = true;
+    return false;
+  }
+  const std::optional<std::string> wire = read();
+  if (!wire || ExceedsLimit(*wire)) {
+    load_failed_ = true;
+    return false;
+  }
+
+  fp::L3Config decoded;
+  const bool ok = fp::DecodeL3Wire(std::string_view(*wire), now_unix,
+                                   max_age_seconds, &decoded, nullptr);
+  // The local copy of the wire is dropped here: the decoded snapshot is what
+  // lives on, so the path and raw bytes (which carry pinned secrets) do not
+  // stay resident.
+  if (!ok) {
+    load_failed_ = true;
+    return false;
+  }
+  config_ = std::move(decoded);
+  return true;
+}
+
+}  // namespace lengsuo
diff --git a/lengsuo/integration/l3_bootstrap.h b/lengsuo/integration/l3_bootstrap.h
new file mode 100644
index 0000000..c2f0b62
--- /dev/null
+++ b/lengsuo/integration/l3_bootstrap.h
@@ -0,0 +1,71 @@
+// l3_bootstrap - browser-side L3 configuration load, frozen at startup.
+//
+// The browser reads one managed L3W1 document before any renderer exists and
+// keeps it immutable afterwards. Three outcomes are deliberately distinct:
+//
+//   * not requested        -> Initialize returns true, config() is nullptr.
+//     No L3 statement, upstream behavior is untouched.
+//   * requested but broken -> Initialize returns false. The caller must abort
+//     startup: a half-valid snapshot is never downgraded to "no L3", because
+//     that would silently unpin values the platform already observed.
+//   * requested and valid  -> Initialize returns true, config() is non-null.
+//
+// Clock injection: the signature carries a unix timestamp and VerifySign
+// needs "now", so `now_unix` is an explicit argument rather than a call to
+// base::Time inside the decoder. Tests therefore never depend on wall time.
+//
+// Size limit: the profile wire caps at 4096 bytes, but an L3 document holds
+// pin/cookie/rule tables and is legitimately larger, so this reader accepts up
+// to fp::kMaxL3WireBytes (64 KiB) and nothing beyond it.
+#ifndef LENGSUO_INTEGRATION_L3_BOOTSTRAP_H_
+#define LENGSUO_INTEGRATION_L3_BOOTSTRAP_H_
+
+#include <cstdint>
+#include <functional>
+#include <optional>
+#include <string>
+
+#include "lengsuo/native/l3_wire.h"
+
+namespace lengsuo {
+
+// The command-line switch naming the managed L3 document lives in
+// browser_bootstrap.h (kL3WireSwitch) so that there is exactly one definition
+// of the switch name; a second one would be a redefinition error in any
+// translation unit that includes both headers.
+
+// Default anti-rollback window for the document signature.
+inline constexpr int64_t kL3MaxAgeSeconds = 7 * 24 * 60 * 60;
+
+class L3BootstrapState {
+ public:
+  using Reader = std::function<std::optional<std::string>()>;
+
+  L3BootstrapState();
+  ~L3BootstrapState();
+  L3BootstrapState(const L3BootstrapState&) = delete;
+  L3BootstrapState& operator=(const L3BootstrapState&) = delete;
+
+  // Single-shot. `requested` false succeeds without loading. A load or
+  // verification failure returns false and leaves config() untouched.
+  bool Initialize(bool requested,
+                  bool safe_local_path,
+                  const Reader& read,
+                  int64_t now_unix,
+                  int64_t max_age_seconds);
+
+  const fp::L3Config* config() const { return config_ ? &*config_ : nullptr; }
+
+  // True when a document was requested but failed to load; callers use this to
+  // distinguish "absent" from "broken" when reporting startup failure.
+  bool load_failed() const { return load_failed_; }
+
+ private:
+  bool attempted_ = false;
+  bool load_failed_ = false;
+  std::optional<fp::L3Config> config_;
+};
+
+}  // namespace lengsuo
+
+#endif  // LENGSUO_INTEGRATION_L3_BOOTSTRAP_H_
diff --git a/lengsuo/integration/official_defaults.cc b/lengsuo/integration/official_defaults.cc
new file mode 100644
index 0000000..fa2a132
--- /dev/null
+++ b/lengsuo/integration/official_defaults.cc
@@ -0,0 +1,72 @@
+#include "lengsuo/integration/official_defaults.h"
+
+#include <array>
+#include <vector>
+
+#include "base/command_line.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+
+namespace lengsuo {
+namespace {
+
+constexpr char kDisableFeaturesSwitch[] = "disable-features";
+
+// Blink reads this from the renderer's own command line to decide whether to
+// keep navigator.languages at full length. It has to be appended here *and*
+// allow-listed in RenderProcessHostImpl's kSwitchNames; the renderer does not
+// rebuild its feature list from the browser's --disable-features.
+constexpr char kDisableReduceAcceptLanguageSwitch[] =
+    "disable-reduce-accept-language";
+
+// Keeps the merge order deterministic and preserves the user's own ordering,
+// so an operator-supplied flag list still reads the way they wrote it.
+std::string JoinUnique(const std::vector<std::string>& ordered) {
+  std::vector<std::string> unique;
+  for (const std::string& item : ordered) {
+    if (item.empty()) {
+      continue;
+    }
+    bool seen = false;
+    for (const std::string& kept : unique) {
+      if (kept == item) {
+        seen = true;
+        break;
+      }
+    }
+    if (!seen) {
+      unique.push_back(item);
+    }
+  }
+  return base::JoinString(unique, ",");
+}
+
+}  // namespace
+
+std::string MergeDisabledFeatures(std::string_view existing) {
+  const std::string current(existing);
+  std::vector<std::string> parts = base::SplitString(
+      current, ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  for (const std::string_view feature : kFeaturesChromeDisables) {
+    parts.emplace_back(feature);
+  }
+  return JoinUnique(parts);
+}
+
+void ApplyOfficialFeatureDefaults(base::CommandLine* command) {
+  if (command == nullptr) {
+    return;
+  }
+  const std::string current = command->GetSwitchValueASCII(kDisableFeaturesSwitch);
+  const std::string merged = MergeDisabledFeatures(current);
+  if (merged != current) {
+    command->AppendSwitchASCII(kDisableFeaturesSwitch, merged);
+  }
+  // The renderer ignores the browser's feature list; Blink exposes a dedicated
+  // switch for the one behaviour we need to match. Appending it is idempotent.
+  if (!command->HasSwitch(kDisableReduceAcceptLanguageSwitch)) {
+    command->AppendSwitch(kDisableReduceAcceptLanguageSwitch);
+  }
+}
+
+}  // namespace lengsuo
diff --git a/lengsuo/integration/official_defaults.h b/lengsuo/integration/official_defaults.h
new file mode 100644
index 0000000..6792c06
--- /dev/null
+++ b/lengsuo/integration/official_defaults.h
@@ -0,0 +1,52 @@
+// official_defaults - keep feature defaults aligned with shipped Chrome.
+//
+// Our engine is Chromium, but the product is meant to be indistinguishable from
+// a real Chrome install. Chromium's own feature defaults legitimately differ
+// from Chrome's: a feature can be disabled in the published browser while the
+// open-source default (or the local build configuration) leaves it on. When
+// that happens the difference is invisible in the UI and shows up only in a
+// fingerprint field, which is exactly the class of problem that is expensive to
+// find later.
+//
+// `ReduceAcceptLanguage` is the worked example. Chromium truncates
+// `navigator.languages` to the first entry when it is enabled, so a page sees
+// ["en-US"] instead of ["en-US","en"]. Official Chrome leaves it off, so the
+// two disagree on identical hardware and locale. Measured on the research host:
+// our build reported ["en-US"] while Chrome 144 reported ["en-US","en"], and
+// passing --disable-features=ReduceAcceptLanguage made the two identical.
+//
+// The browser process is the right place to fix this: the renderer inherits
+// --disable-features through its own command line, so one correction here
+// covers the main thread, dedicated workers and service workers at once.
+#ifndef LENGSUO_INTEGRATION_OFFICIAL_DEFAULTS_H_
+#define LENGSUO_INTEGRATION_OFFICIAL_DEFAULTS_H_
+
+#include <string>
+#include <string_view>
+
+namespace base {
+class CommandLine;
+}
+
+namespace lengsuo {
+
+// Features that must be off to match shipped Chrome. Each entry is a comment
+// explaining the observable difference, because a bare name here is not
+// reviewable later.
+inline constexpr std::string_view kFeaturesChromeDisables[] = {
+    // Truncates navigator.languages to one entry.
+    "ReduceAcceptLanguage",
+};
+
+// Merges the list above into the process command line's --disable-features.
+// Idempotent: re-running adds nothing, and an existing user-supplied value is
+// preserved rather than replaced.
+void ApplyOfficialFeatureDefaults(base::CommandLine* command);
+
+// Exposed for tests: the comma-separated value that should end up in
+// --disable-features given the value already present on the command line.
+std::string MergeDisabledFeatures(std::string_view existing);
+
+}  // namespace lengsuo
+
+#endif  // LENGSUO_INTEGRATION_OFFICIAL_DEFAULTS_H_
diff --git a/lengsuo/integration/official_defaults_unittest.cc b/lengsuo/integration/official_defaults_unittest.cc
new file mode 100644
index 0000000..43b5a60
--- /dev/null
+++ b/lengsuo/integration/official_defaults_unittest.cc
@@ -0,0 +1,95 @@
+// Unit tests for the feature-default alignment helper.
+//
+// The merge must be idempotent and must never discard an operator's own
+// --disable-features value: this runs on every startup, and clobbering a
+// debugging flag would be a silent regression in the field.
+#include "lengsuo/integration/official_defaults.h"
+
+#include <cstdio>
+#include <string>
+
+#include "base/command_line.h"
+
+namespace {
+int g_passes = 0;
+int g_failures = 0;
+
+void Check(bool ok, const char* expr, int line) {
+  if (ok) {
+    ++g_passes;
+  } else {
+    std::printf("FAIL line %d: %s\n", line, expr);
+    ++g_failures;
+  }
+}
+
+bool Has(std::string_view haystack, std::string_view needle) {
+  return haystack.find(needle) != std::string_view::npos;
+}
+}  // namespace
+
+#define CHECK(cond) Check((cond), #cond, __LINE__)
+
+int main() {
+  using lengsuo::MergeDisabledFeatures;
+
+  // 1. Empty input still gets the required feature.
+  const std::string from_empty = MergeDisabledFeatures("");
+  CHECK(Has(from_empty, "ReduceAcceptLanguage"));
+
+  // 2. An operator value is preserved, not replaced.
+  const std::string merged = MergeDisabledFeatures("MyFeature,OtherThing");
+  CHECK(Has(merged, "MyFeature"));
+  CHECK(Has(merged, "OtherThing"));
+  CHECK(Has(merged, "ReduceAcceptLanguage"));
+
+  // 3. Idempotent: merging the result again changes nothing.
+  CHECK(MergeDisabledFeatures(merged) == merged);
+
+  // 4. No duplicates when the feature is already present.
+  const std::string twice = MergeDisabledFeatures("ReduceAcceptLanguage");
+  std::size_t occurrences = 0;
+  for (std::size_t pos = twice.find("ReduceAcceptLanguage"); pos != std::string::npos;
+       pos = twice.find("ReduceAcceptLanguage", pos + 1)) {
+    ++occurrences;
+  }
+  CHECK(occurrences == 1);
+
+  // 5. Whitespace and empty segments do not produce stray commas.
+  const std::string messy = MergeDisabledFeatures(" A , , B ");
+  CHECK(Has(messy, "A"));
+  CHECK(Has(messy, "B"));
+  CHECK(messy.find(",,") == std::string::npos);
+  CHECK(!messy.empty() && messy.front() != ',' && messy.back() != ',');
+
+  // 6. Applying onto a command line that has no switch sets it.
+  base::CommandLine cmd(base::CommandLine::NO_PROGRAM);
+  lengsuo::ApplyOfficialFeatureDefaults(&cmd);
+  CHECK(cmd.HasSwitch("disable-features"));
+  CHECK(Has(cmd.GetSwitchValueASCII("disable-features"),
+            "ReduceAcceptLanguage"));
+  // The renderer-side switch is separate and also required: the renderer never
+  // rebuilds its feature list from the browser's --disable-features.
+  CHECK(cmd.HasSwitch("disable-reduce-accept-language"));
+
+  // 7. Applying twice is stable (startup may call it more than once).
+  const std::string once = cmd.GetSwitchValueASCII("disable-features");
+  lengsuo::ApplyOfficialFeatureDefaults(&cmd);
+  CHECK(cmd.GetSwitchValueASCII("disable-features") == once);
+  CHECK(cmd.HasSwitch("disable-reduce-accept-language"));
+
+  // 8. A pre-existing switch keeps its own entries.
+  base::CommandLine existing(base::CommandLine::NO_PROGRAM);
+  existing.AppendSwitchASCII("disable-features", "KeepMe");
+  lengsuo::ApplyOfficialFeatureDefaults(&existing);
+  const std::string value = existing.GetSwitchValueASCII("disable-features");
+  CHECK(Has(value, "KeepMe"));
+  CHECK(Has(value, "ReduceAcceptLanguage"));
+
+  // 9. Null-safe: callers may pass nothing in tests.
+  lengsuo::ApplyOfficialFeatureDefaults(nullptr);
+
+  std::printf("official_defaults_unittest: %d passes, %d failures\n", g_passes,
+              g_failures);
+  return g_failures == 0 ? 0 : 1;
+}

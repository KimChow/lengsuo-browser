@@ -0,0 +1,5 @@
+// The traits decoder is header-only (native/font_family_traits.h). This
+// translation unit exists so the CMake and GN targets have a stable source and
+// the header is compiled and -Werror-checked even when only the library, not
+// the test, is built.
+#include "font_family_traits.h"
diff --git a/lengsuo/native/font_family_traits.h b/lengsuo/native/font_family_traits.h
new file mode 100644
index 0000000..3c13a76
--- /dev/null
+++ b/lengsuo/native/font_family_traits.h
@@ -0,0 +1,156 @@
+// font_family_traits - the fonts dimension's {switcher, value, mask} shape.
+//
+// docs/cc-task-rulings.md §C: 对标端 gives every overridable dimension the same
+// shape -- {switcher, value, default_value} -- and for fonts the value is a
+// semicolon-separated family string ("Arial;Arial Black"), not a structured
+// list. Our profile encodes the fonts dimension as one slot number, which is
+// why nothing consumed it; this header is the missing decoder from that slot
+// plus the switch's value/mask fields into the shape the mechanism needs.
+//
+// It does NOT carry a font inventory. 对标端's full family pool lives on its
+// server and was never captured, so no list is invented here: an empty value
+// is a legitimate statement ("use the mask"), and the family names are only
+// ever the ones the profile actually sent.
+//
+// Header-only: three small operations over caller-owned strings, compiled both
+// into the standalone native tests and into Blink (no platform headers).
+//
+// Contract doc: docs/font-dimension.md.
+#ifndef LENGSUO_NATIVE_FONT_FAMILY_TRAITS_H_
+#define LENGSUO_NATIVE_FONT_FAMILY_TRAITS_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace lengsuo::fonts {
+
+// Upper bounds are what the profile wire accepts for the same fields
+// (profile_wire.cc), so a hostile payload cannot make the switch accept what
+// the wire rejects.
+inline constexpr std::size_t kMaxFamilyName = 128;
+inline constexpr std::size_t kMaxFamilyValue = 4096;
+inline constexpr std::size_t kMaxFamilyCount = 64;
+
+struct FamilyTraits {
+  // False when the profile said nothing about fonts (slot 0) or the payload was
+  // malformed; the caller must then leave measurement byte-identical to native.
+  bool installed{false};
+  // The profile's raw font slot, kept for diagnostics/tests.
+  std::uint32_t slot{};
+  // The family names the profile declared, in wire order. May be empty: a mask
+  // can ask for metric perturbation without naming families.
+  std::vector<std::string> families;
+  // Whether the font metric perturbation is active. True iff installed and the
+  // profile made a statement: a non-empty value, or a non-zero family mask.
+  bool perturbs_metrics{false};
+};
+
+// Splits 对标端's semicolon-separated value. Blank elements and duplicates are
+// dropped; interior spaces are preserved (family names may contain them). A
+// malformed element rejects the whole value (returns empty).
+std::vector<std::string> ParseSemicolonFamilies(std::string_view value);
+
+// Decodes (slot, value, mask) into the mechanism's input.
+//
+//   * slot == 0              -> not installed: "the profile said nothing",
+//                               identical to the GPU dimension's slot 0.
+//   * value non-empty        -> installed; a non-empty family list is itself
+//                               the statement, so metrics are perturbed even
+//                               when mask is 0 (the service default).
+//   * value empty, mask != 0 -> installed; the mask is the only statement.
+//   * value empty, mask == 0 -> installed but dormant: nothing declares a
+//                               change, so measurement stays native.
+//
+// A malformed value (oversize, too many or oversized names, control bytes)
+// yields a not-installed result rather than a half-parsed one.
+FamilyTraits ParseFamilyTraits(std::uint32_t slot, std::string_view value,
+                               std::uint32_t mask);
+
+// ---------------------------------------------------------------------------
+// Implementation (header-only).
+// ---------------------------------------------------------------------------
+namespace internal {
+
+inline bool ValidFamily(std::string_view family) {
+  if (family.empty() || family.size() > kMaxFamilyName) {
+    return false;
+  }
+  for (const char character : family) {
+    const auto byte = static_cast<unsigned char>(character);
+    if (byte < 32 || byte > 126) {
+      return false;
+    }
+  }
+  return true;
+}
+
+}  // namespace internal
+
+inline std::vector<std::string> ParseSemicolonFamilies(std::string_view value) {
+  std::vector<std::string> families;
+  std::size_t start = 0;
+  while (start < value.size()) {
+    const std::size_t semicolon = value.find(';', start);
+    const std::size_t end =
+        semicolon == std::string_view::npos ? value.size() : semicolon;
+    const std::string_view element = value.substr(start, end - start);
+    const bool blank = element.find_first_not_of(' ') == std::string_view::npos;
+    if (!blank) {
+      if (!internal::ValidFamily(element) ||
+          families.size() >= kMaxFamilyCount) {
+        return {};  // malformed: reject the whole value, not one element
+      }
+      bool duplicate = false;
+      for (const auto& existing : families) {
+        if (existing == element) {
+          duplicate = true;
+          break;
+        }
+      }
+      if (!duplicate) {
+        families.emplace_back(element);
+      }
+    }
+    if (semicolon == std::string_view::npos) {
+      break;
+    }
+    start = semicolon + 1;
+  }
+  return families;
+}
+
+inline FamilyTraits ParseFamilyTraits(std::uint32_t slot,
+                                      std::string_view value,
+                                      std::uint32_t mask) {
+  FamilyTraits traits;
+  traits.slot = slot;
+  if (slot == 0) {
+    return traits;  // the profile said nothing about fonts
+  }
+  if (value.size() > kMaxFamilyValue) {
+    return traits;  // too large: not installed, never half-parsed
+  }
+  for (const char character : value) {
+    const auto byte = static_cast<unsigned char>(character);
+    if (byte < 32 || byte > 126) {
+      return traits;  // control bytes are never a valid family list
+    }
+  }
+  traits.families = ParseSemicolonFamilies(value);
+  // ParseSemicolonFamilies returns {} both for "empty" and for "malformed"; a
+  // non-empty value that parsed to nothing is the malformed case.
+  const bool blank = value.find_first_not_of("; ") == std::string_view::npos;
+  if (!blank && traits.families.empty()) {
+    return traits;  // malformed (oversize/too many names): stay native
+  }
+  traits.installed = true;
+  traits.perturbs_metrics = !traits.families.empty() || mask != 0;
+  return traits;
+}
+
+}  // namespace lengsuo::fonts
+
+#endif  // LENGSUO_NATIVE_FONT_FAMILY_TRAITS_H_
diff --git a/lengsuo/native/font_metrics.cc b/lengsuo/native/font_metrics.cc
new file mode 100644
index 0000000..ae59b33
--- /dev/null
+++ b/lengsuo/native/font_metrics.cc
@@ -0,0 +1,60 @@
+// font_metrics v1 - implementation. See font_metrics.h for the contract.
+//
+// The arithmetic mirrors tests/font_metrics_ref.py line for line: a single
+// SplitMix64 finalizer (the same Mix() fp_overrides.cc uses for canvas/audio,
+// so every dimension shares one seed-derivation discipline) over the seed
+// salted with the quantized native advance. The salt makes two glyphs in one
+// string independent while keeping a given glyph fixed for a given profile.
+
+#include "font_metrics.h"
+
+#include <cmath>
+
+namespace lengsuo::fonts {
+namespace {
+
+constexpr std::uint64_t kConstMixAdd = 0x9E3779B97F4A7C15ULL;
+constexpr std::uint64_t kConstMixMul1 = 0xBF58476D1CE4E5B9ULL;
+constexpr std::uint64_t kConstMixMul2 = 0x94D049BB133111EBULL;
+constexpr std::uint64_t kConstSalt = 0x9E3779B97F4A7C15ULL;
+
+}  // namespace
+
+std::uint64_t MixForTest(std::uint64_t x) {
+  x += kConstMixAdd;
+  x = (x ^ (x >> 30)) * kConstMixMul1;
+  x = (x ^ (x >> 27)) * kConstMixMul2;
+  return x ^ (x >> 31);
+}
+
+FontNoiseResult PerturbAdvance(const FontNoiseConfig& config) {
+  FontNoiseResult result;
+  result.advance = config.advance;
+  // Off conditions: no dimension, no stream, or nothing to perturb.
+  if (!config.enabled || config.seed == 0 || !(config.advance > 0.0f)) {
+    result.status = FontNoiseStatus::kDisabled;
+    return result;
+  }
+  // Quantize the native advance to the layout quantum, then salt the seed with
+  // it. round() (not truncation) so 7.99999 and 8.00001 land on one bucket.
+  const std::int64_t quantized =
+      static_cast<std::int64_t>(std::llround(config.advance / kAdvanceQuantum));
+  const std::uint64_t stream =
+      MixForTest(config.seed ^ (static_cast<std::uint64_t>(quantized) *
+                                kConstSalt));
+  // steps in [-kMaxAdvanceSteps, kMaxAdvanceSteps].
+  const int steps =
+      static_cast<int>(stream % (2 * kMaxAdvanceSteps + 1)) - kMaxAdvanceSteps;
+  if (steps == 0) {
+    // A zero draw leaves the advance native. Reporting kDisabled here would be
+    // wrong -- the dimension is on -- so it stays kPerturbed with a zero shift.
+    result.status = FontNoiseStatus::kPerturbed;
+    return result;
+  }
+  result.status = FontNoiseStatus::kPerturbed;
+  result.advance =
+      config.advance + static_cast<float>(steps) * kAdvanceQuantum;
+  return result;
+}
+
+}  // namespace lengsuo::fonts
diff --git a/lengsuo/native/font_metrics.h b/lengsuo/native/font_metrics.h
new file mode 100644
index 0000000..94b9b84
--- /dev/null
+++ b/lengsuo/native/font_metrics.h
@@ -0,0 +1,75 @@
+// font_metrics v1 - deterministic perturbation of the measured glyph advance.
+//
+// This is the accepted mechanism for the font dimension
+// (docs/cc-task-rulings.md §C, docs/font-dimension-reference-approach.md). The
+// earlier proposals -- filter the availability set, or alias declared families
+// -- were both withdrawn: upstream `FontFaceSet::check()` only judges the
+// page's own @font-face registrations and returns true for every system family,
+// so "make check() answer false for an absent family" is not a state upstream
+// has, and faking it would fabricate a font registry the page can enumerate.
+//
+// What 对标端 does instead is overlay a deterministic mask on the *real* value:
+// its font_fingerprint_mask sits alongside canvas/webgl/audio masks, and the
+// open-source base it is built on applies it inside font_cache.cc. The
+// observable face of the dimension is therefore not availability but the
+// measured advance -- and that is exactly what a canvas `measureText()` reads.
+//
+// Contract:
+//   * Off (enabled == false, or seed == 0, or a non-positive advance) returns
+//     the native advance unchanged, bit for bit. A build with no font switch
+//     therefore measures identically to upstream.
+//   * On, the result is a pure function of (seed, native advance): the same
+//     profile yields the same widths in every renderer/worker process, and two
+//     profiles yield different widths.
+//   * The shift is a whole number of 1/64 px steps (the layout quantum) with
+//     |shift| < kMaxAdvanceDelta (1/4 px), so text can never move by a whole
+//     pixel: the perturbation is measurable but not visible.
+//
+// Pure: no Blink, no IPC, no allocation, no static mutable state -- so it is
+// unit-testable, and reproducible from tests/font_metrics_ref.py.
+//
+// Contract doc: docs/font-dimension.md.
+#ifndef LENGSUO_NATIVE_FONT_METRICS_H_
+#define LENGSUO_NATIVE_FONT_METRICS_H_
+
+#include <cstdint>
+
+namespace lengsuo::fonts {
+
+enum class FontNoiseStatus : std::uint8_t {
+  kDisabled,   // native advance returned unchanged
+  kPerturbed,  // advance moved by a non-zero number of 1/64 px steps
+};
+
+struct FontNoiseConfig {
+  bool enabled{};
+  std::uint64_t seed{};
+  float advance{};
+};
+
+struct FontNoiseResult {
+  FontNoiseStatus status{FontNoiseStatus::kDisabled};
+  float advance{};
+};
+
+// 1/64 px: the quantum the native measurement itself uses, so the result is
+// exactly representable after Blink's own rounding.
+//
+// The step bound is chosen from measurement (native/font_probe.py, report §3):
+// native widths land only on 1/8 px fractions, i.e. the largest native
+// fractional jitter is 0.5 units. +/-4 units is 8x that, so a perturbed width
+// is unambiguously separable from native jitter, while 4/64 = 1/16 px per glyph
+// is far below one device pixel, so no glyph can visibly move.
+constexpr float kAdvanceQuantum = 1.0f / 64.0f;
+constexpr int kMaxAdvanceSteps = 4;
+constexpr float kMaxAdvanceDelta = kAdvanceQuantum * kMaxAdvanceSteps;
+
+// Perturbs one glyph advance. See the contract above for the off conditions.
+FontNoiseResult PerturbAdvance(const FontNoiseConfig& config);
+
+// Exposed for the frozen-vector test only (mirrors tests/font_metrics_ref.py).
+std::uint64_t MixForTest(std::uint64_t x);
+
+}  // namespace lengsuo::fonts
+
+#endif  // LENGSUO_NATIVE_FONT_METRICS_H_
diff --git a/lengsuo/native/fp_converge.cc b/lengsuo/native/fp_converge.cc
new file mode 100644
index 0000000..1e543ae
--- /dev/null
+++ b/lengsuo/native/fp_converge.cc
@@ -0,0 +1,108 @@
+#include "fp_converge.h"
+
+#include <cstdint>
+#include <limits>
+#include <string>
+#include <vector>
+
+namespace lengsuo::fp {
+namespace {
+
+// The value that means "no candidate was seen yet".
+constexpr std::uint32_t kNoDistance = std::numeric_limits<std::uint32_t>::max();
+
+}  // namespace
+
+std::optional<std::uint32_t> HammingDistance(std::string_view a,
+                                              std::string_view b) {
+  if (a.size() != b.size()) {
+    // Not comparable. The short string is never padded to the long one.
+    return std::nullopt;
+  }
+  std::uint32_t distance = 0;
+  for (std::size_t index = 0; index < a.size(); ++index) {
+    if (a[index] != b[index]) {
+      ++distance;
+    }
+  }
+  return distance;
+}
+
+FpConvergence EvaluateConvergence(std::string_view actual,
+                                   std::string_view expected,
+                                   const FpSamplingSpec& actual_spec,
+                                   const FpSamplingSpec& expected_spec,
+                                   std::optional<std::uint32_t> similarity) {
+  if (!similarity.has_value()) {
+    // No configured threshold: nothing can be judged.
+    return FpConvergence::kNotComparable;
+  }
+  if (!SameSamplingSpec(actual_spec, expected_spec)) {
+    // The two samples are not two readings of the same thing.
+    return FpConvergence::kNotComparable;
+  }
+  const std::optional<std::uint32_t> distance =
+      HammingDistance(actual, expected);
+  if (!distance.has_value()) {
+    return FpConvergence::kNotComparable;
+  }
+  return *distance <= *similarity ? FpConvergence::kPass
+                                  : FpConvergence::kFail;
+}
+
+FpConvergeResult ConvergeToTarget(std::string_view target_hash,
+                                   std::span<const std::uint8_t> src,
+                                   std::uint64_t stride,
+                                   const FpSamplingSpec& spec,
+                                   std::optional<std::uint32_t> similarity,
+                                   std::uint32_t max_attempts) {
+  FpConvergeResult result;
+  if (!similarity.has_value() || target_hash.empty()) {
+    return result;
+  }
+  if (spec.width == 0 || spec.length == 0) {
+    return result;
+  }
+  const std::uint64_t needed = stride * static_cast<std::uint64_t>(spec.length);
+  if (needed == 0 || src.size() < needed) {
+    return result;
+  }
+
+  std::vector<std::uint8_t> dst(static_cast<std::size_t>(needed));
+  const std::uint64_t base = TargetSeed(target_hash, spec);
+  std::uint32_t best_distance = kNoDistance;
+  std::uint64_t best_seed = 0;
+
+  for (std::uint32_t attempt = 0; attempt < max_attempts; ++attempt) {
+    result.attempts = attempt + 1;
+    const std::uint64_t seed = AttemptSeed(base, attempt);
+    if (!ApplySeedNoise(seed, src, dst, spec.width, spec.length, stride)) {
+      continue;
+    }
+    const std::string hash = FingerprintHashHex(dst, spec.width, spec.length);
+    const std::optional<std::uint32_t> distance =
+        HammingDistance(hash, target_hash);
+    if (!distance.has_value()) {
+      // The target has another length than the fingerprint this kernel
+      // produces; the two are not comparable and the search has nothing
+      // to search for.
+      continue;
+    }
+    if (*distance < best_distance) {
+      best_distance = *distance;
+      best_seed = seed;
+    }
+    if (*distance <= *similarity) {
+      result.converged = true;
+      result.seed = seed;
+      result.distance = *distance;
+      return result;
+    }
+  }
+
+  result.seed = best_seed;
+  result.distance = best_distance == kNoDistance ? 0 : best_distance;
+  return result;
+}
+
+}  // namespace lengsuo::fp
diff --git a/lengsuo/native/fp_converge.h b/lengsuo/native/fp_converge.h
new file mode 100644
index 0000000..c20c458
--- /dev/null
+++ b/lengsuo/native/fp_converge.h
@@ -0,0 +1,89 @@
+// fp_converge - the hamming distance and the convergence decision (task T3).
+//
+// The hamming distance answers one question: how far is the fingerprint a
+// page actually produced from the fingerprint the platform asked for. The
+// answer is only meaningful when the two are comparable, and comparability
+// has two rules that this file never bends:
+//
+//   * the two strings must have the same length - the short one is never
+//     padded to the longer one, because padding would invent a difference
+//     that is not there;
+//   * the two samples must have been taken at the same geometry - a
+//     fingerprint of a 300x300 canvas and a fingerprint of a 64x64 canvas
+//     are not two readings of the same thing.
+//
+// A third rule comes from the contract: the threshold is a configured
+// value, never a constant in the source. Without a threshold there is no
+// verdict at all.
+//
+// The convergence search walks a deterministic sequence of candidate
+// perturbations and stops at the first one that is close enough. The
+// sequence is a function of the target value and the geometry, so two runs
+// over the same sample give the same answer.
+#ifndef LENGSUO_NATIVE_FP_CONVERGE_H_
+#define LENGSUO_NATIVE_FP_CONVERGE_H_
+
+#include <cstdint>
+#include <optional>
+#include <span>
+#include <string_view>
+
+#include "fp_sampling.h"
+
+namespace lengsuo::fp {
+
+// The hamming distance between two strings.
+//
+// The distance is defined over strings of the same length. Strings of
+// different length are not comparable and the function says so; the short
+// one is never padded to the longer one.
+std::optional<std::uint32_t> HammingDistance(std::string_view a,
+                                              std::string_view b);
+
+// The verdict of one comparison.
+enum class FpConvergence : std::uint8_t {
+  kPass,
+  kFail,
+  kNotComparable,
+};
+
+// Compares a sample against a target value.
+//
+// The comparison is refused when the strings have different lengths, when
+// the two samples were taken at different geometries, or when no threshold
+// was configured.
+FpConvergence EvaluateConvergence(std::string_view actual,
+                                   std::string_view expected,
+                                   const FpSamplingSpec& actual_spec,
+                                   const FpSamplingSpec& expected_spec,
+                                   std::optional<std::uint32_t> similarity);
+
+// The outcome of a convergence search.
+struct FpConvergeResult {
+  // True when a candidate was within the threshold.
+  bool converged = false;
+  // The seed of the candidate that was chosen.
+  std::uint64_t seed = 0;
+  // The distance of the chosen candidate to the target value.
+  std::uint32_t distance = 0;
+  // How many candidates were tried.
+  std::uint32_t attempts = 0;
+};
+
+// Searches the deterministic candidate sequence for one whose fingerprint
+// hash is within `similarity` of the target value.
+//
+// The candidates are a function of the target value and the geometry, so
+// two runs over the same sample give the same answer. Without a threshold
+// nothing is searched for. When no candidate is within the threshold the
+// closest one is reported and `converged` stays false.
+FpConvergeResult ConvergeToTarget(std::string_view target_hash,
+                                   std::span<const std::uint8_t> src,
+                                   std::uint64_t stride,
+                                   const FpSamplingSpec& spec,
+                                   std::optional<std::uint32_t> similarity,
+                                   std::uint32_t max_attempts);
+
+}  // namespace lengsuo::fp
+
+#endif  // LENGSUO_NATIVE_FP_CONVERGE_H_
diff --git a/lengsuo/native/fp_converge_test.cc b/lengsuo/native/fp_converge_test.cc
new file mode 100644
index 0000000..e907c4b
--- /dev/null
+++ b/lengsuo/native/fp_converge_test.cc
@@ -0,0 +1,243 @@
+// fp_converge_test - hamming distance and the convergence decision (task T3).
+//
+// The brief's rulings each get a test of their own:
+//
+//   * hamming distance over equal-length strings;
+//   * strings of different length are NOT comparable - the short one is
+//     never padded;
+//   * distance <= threshold passes, otherwise it fails;
+//   * a sample whose geometry differs from the target's is not comparable,
+//     and no distance is computed for it;
+//   * the convergence search is deterministic and finds the candidate that
+//     matches the target.
+#include "fp_converge.h"
+
+#include <gtest/gtest.h>
+
+#include <cstdint>
+#include <optional>
+#include <span>
+#include <string>
+#include <vector>
+
+#include "fp_sampling.h"
+
+namespace lengsuo::fp {
+namespace {
+
+// A 4x4 RGBA sample with a fixed pattern.
+std::vector<std::uint8_t> SamplePixels() {
+  std::vector<std::uint8_t> pixels(4 * 4 * 4);
+  for (std::size_t i = 0; i < pixels.size(); ++i) {
+    pixels[i] = static_cast<std::uint8_t>((i * 7 + 13) & 0xFF);
+  }
+  return pixels;
+}
+
+FpSamplingSpec Spec() {
+  FpSamplingSpec spec;
+  spec.width = 4;
+  spec.length = 4;
+  spec.drew_text = std::optional<bool>(true);
+  return spec;
+}
+
+// The hex hash of one candidate of the search.
+std::string CandidateHash(std::string_view target_hash,
+                          const FpSamplingSpec& spec,
+                          std::uint32_t attempt) {
+  const std::vector<std::uint8_t> src = SamplePixels();
+  std::vector<std::uint8_t> dst(src.size());
+  const std::uint64_t seed =
+      AttemptSeed(TargetSeed(target_hash, spec), attempt);
+  EXPECT_TRUE(ApplySeedNoise(seed, src, dst, spec.width, spec.length,
+                             spec.width * 4));
+  return FingerprintHashHex(dst, spec.width, spec.length);
+}
+
+// ---------------------------------------------------------------------------
+// Hamming distance
+// ---------------------------------------------------------------------------
+
+TEST(FpHamming, CountsDifferingPositions) {
+  const auto distance = HammingDistance("abcd", "abed");
+  ASSERT_TRUE(distance.has_value());
+  EXPECT_EQ(*distance, 1u);
+
+  const auto none = HammingDistance("abcd", "abcd");
+  ASSERT_TRUE(none.has_value());
+  EXPECT_EQ(*none, 0u);
+
+  const auto two = HammingDistance("abcd", "wxyz");
+  ASSERT_TRUE(two.has_value());
+  EXPECT_EQ(*two, 4u);
+}
+
+TEST(FpHamming, DifferentLengthIsNotComparable) {
+  // The brief: the distance between strings of different length is
+  // undefined. The short one is never padded to the longer one.
+  EXPECT_FALSE(HammingDistance("abc", "abcd").has_value());
+  EXPECT_FALSE(HammingDistance("abcd", "abc").has_value());
+  EXPECT_FALSE(HammingDistance("", "a").has_value());
+  EXPECT_TRUE(HammingDistance("", "").has_value());
+}
+
+TEST(FpHamming, EmptyStringsAreZeroApart) {
+  const auto distance = HammingDistance("", "");
+  ASSERT_TRUE(distance.has_value());
+  EXPECT_EQ(*distance, 0u);
+}
+
+// ---------------------------------------------------------------------------
+// The verdict
+// ---------------------------------------------------------------------------
+
+TEST(FpConvergence, DistanceAtOrBelowThresholdPasses) {
+  const FpSamplingSpec spec = Spec();
+  EXPECT_EQ(EvaluateConvergence("abcd", "abed", spec, spec, 1),
+            FpConvergence::kPass);
+  EXPECT_EQ(EvaluateConvergence("abcd", "abed", spec, spec, 2),
+            FpConvergence::kPass);
+}
+
+TEST(FpConvergence, DistanceAboveThresholdFails) {
+  const FpSamplingSpec spec = Spec();
+  EXPECT_EQ(EvaluateConvergence("abcd", "wxyz", spec, spec, 3),
+            FpConvergence::kFail);
+  EXPECT_EQ(EvaluateConvergence("abcd", "wxyz", spec, spec, 0),
+            FpConvergence::kFail);
+}
+
+TEST(FpConvergence, DifferentLengthIsNotComparable) {
+  const FpSamplingSpec spec = Spec();
+  EXPECT_EQ(EvaluateConvergence("abc", "abcd", spec, spec, 8),
+            FpConvergence::kNotComparable);
+}
+
+TEST(FpConvergence, DifferentGeometryIsNotComparable) {
+  // No distance is computed for a sample that was taken at another size.
+  const FpSamplingSpec actual = Spec();
+  FpSamplingSpec expected = Spec();
+  expected.width = 8;
+  EXPECT_EQ(EvaluateConvergence("abcd", "abed", actual, expected, 8),
+            FpConvergence::kNotComparable);
+
+  FpSamplingSpec other_length = Spec();
+  other_length.length = 8;
+  EXPECT_EQ(EvaluateConvergence("abcd", "abed", actual, other_length, 8),
+            FpConvergence::kNotComparable);
+}
+
+TEST(FpConvergence, DifferentDrewTextIsNotComparable) {
+  const FpSamplingSpec actual = Spec();
+  FpSamplingSpec expected = Spec();
+  expected.drew_text = std::optional<bool>(false);
+  EXPECT_EQ(EvaluateConvergence("abcd", "abed", actual, expected, 8),
+            FpConvergence::kNotComparable);
+}
+
+TEST(FpConvergence, AnUnconstrainedDrewTextIsComparable) {
+  // The target did not say whether text was drawn, so the distance is
+  // meaningful even though the sample did draw text.
+  const FpSamplingSpec actual = Spec();
+  FpSamplingSpec expected = Spec();
+  expected.drew_text = std::nullopt;
+  EXPECT_EQ(EvaluateConvergence("abcd", "abed", actual, expected, 8),
+            FpConvergence::kPass);
+}
+
+TEST(FpConvergence, WithoutAThresholdNothingCanBeJudged) {
+  // Contract 3: the threshold comes from the configuration. Without one
+  // there is no verdict - the kernel does not carry a constant.
+  const FpSamplingSpec spec = Spec();
+  EXPECT_EQ(EvaluateConvergence("abcd", "abed", spec, spec, std::nullopt),
+            FpConvergence::kNotComparable);
+}
+
+// ---------------------------------------------------------------------------
+// The convergence search
+// ---------------------------------------------------------------------------
+
+TEST(FpConverge, FindsTheCandidateThatMatchesTheTarget) {
+  const FpSamplingSpec spec = Spec();
+  const std::string target = "0123456789abcdef";
+  const std::vector<std::uint8_t> src = SamplePixels();
+
+  // The best candidate of the deterministic search, computed the same way
+  // the search computes it.
+  std::uint32_t best_distance = 0xFFFFFFFFu;
+  for (std::uint32_t attempt = 0; attempt < 8; ++attempt) {
+    const std::string hash = CandidateHash(target, spec, attempt);
+    const auto distance = HammingDistance(hash, target);
+    ASSERT_TRUE(distance.has_value());
+    if (*distance < best_distance) {
+      best_distance = *distance;
+    }
+  }
+
+  const FpConvergeResult result =
+      ConvergeToTarget(target, src, spec.width * 4, spec, best_distance, 8);
+  EXPECT_TRUE(result.converged);
+  EXPECT_LE(result.distance, best_distance);
+  EXPECT_LE(result.attempts, 8u);
+  // The seed that was chosen is one of the candidates of the search.
+  bool is_candidate = false;
+  for (std::uint32_t attempt = 0; attempt < 8; ++attempt) {
+    if (result.seed == AttemptSeed(TargetSeed(target, spec), attempt)) {
+      is_candidate = true;
+    }
+  }
+  EXPECT_TRUE(is_candidate);
+}
+
+TEST(FpConverge, IsDeterministic) {
+  const FpSamplingSpec spec = Spec();
+  const std::string target = "0123456789abcdef";
+  const std::vector<std::uint8_t> src = SamplePixels();
+
+  const FpConvergeResult first =
+      ConvergeToTarget(target, src, spec.width * 4, spec, 8, 8);
+  const FpConvergeResult second =
+      ConvergeToTarget(target, src, spec.width * 4, spec, 8, 8);
+  EXPECT_EQ(first.converged, second.converged);
+  EXPECT_EQ(first.seed, second.seed);
+  EXPECT_EQ(first.distance, second.distance);
+  EXPECT_EQ(first.attempts, second.attempts);
+}
+
+TEST(FpConverge, WithoutAThresholdNothingConverges) {
+  const FpSamplingSpec spec = Spec();
+  const std::vector<std::uint8_t> src = SamplePixels();
+  const FpConvergeResult result =
+      ConvergeToTarget("0123456789abcdef", src, spec.width * 4, spec,
+                       std::nullopt, 8);
+  EXPECT_FALSE(result.converged);
+  EXPECT_EQ(result.attempts, 0u);
+}
+
+TEST(FpConverge, ATargetOfAnotherLengthNeverConverges) {
+  // The target hash and the produced hash have different lengths, so they
+  // are not comparable and the search has nothing to search for.
+  const FpSamplingSpec spec = Spec();
+  const std::vector<std::uint8_t> src = SamplePixels();
+  const FpConvergeResult result =
+      ConvergeToTarget("0123456789abcdef0123456789abcdef", src,
+                       spec.width * 4, spec, 8, 8);
+  EXPECT_FALSE(result.converged);
+}
+
+TEST(FpConverge, TheClosestCandidateIsReportedWhenNoneIsWithinRange) {
+  const FpSamplingSpec spec = Spec();
+  const std::string target = "0123456789abcdef";
+  const std::vector<std::uint8_t> src = SamplePixels();
+  const FpConvergeResult result =
+      ConvergeToTarget(target, src, spec.width * 4, spec, 0, 4);
+  // With a threshold of zero only an exact match passes. The search still
+  // reports the closest candidate it saw.
+  EXPECT_FALSE(result.converged);
+  EXPECT_EQ(result.attempts, 4u);
+  EXPECT_LE(result.distance, 16u);
+}
+
+}  // namespace
+}  // namespace lengsuo::fp
diff --git a/lengsuo/native/fp_overrides.cc b/lengsuo/native/fp_overrides.cc
new file mode 100644
index 0000000..29fe2f3
--- /dev/null
+++ b/lengsuo/native/fp_overrides.cc
@@ -0,0 +1,400 @@
+// fp_overrides - renderer-side fingerprint override state.
+//
+// --lengsuo-managed-fp=<seed>:<canvas>:<audio>:<rects>:<fonts>:<gpu>:<ua>:
+//   <webgl>:<vendor>:<renderer>:<hwc>:<mem>; 0/empty keeps that dimension native.
+// The font dimension is the exception: its {switcher, value, mask} content rides
+// its own --lengsuo-managed-fonts switch (docs/fp-switch-contract.md). Absent
+// switches => everything disabled and upstream behavior stays byte-identical.
+#include "fp_overrides.h"
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <span>
+#include <string_view>
+#include <utility>
+
+#include "font_family_traits.h"
+#include "font_metrics.h"
+
+namespace lengsuo::fp {
+namespace {
+
+// SplitMix64 finalizer: cheap, well distributed, bit-identical everywhere.
+std::uint64_t Mix(std::uint64_t x) {
+  x += 0x9E3779B97F4A7C15ULL;
+  x = (x ^ (x >> 30)) * 0xBF58476D1CE4E5B9ULL;
+  x = (x ^ (x >> 27)) * 0x94D049BB133111EBULL;
+  return x ^ (x >> 31);
+}
+
+// Field indices of the switch payload.
+enum Field : std::size_t {
+  kSeed = 0,
+  kCanvas,
+  kAudio,
+  kRects,
+  kFonts,
+  kGpu,
+  kUa,
+  kWebglParams,
+  kVendor,
+  kRenderer,
+  kHwc,
+  kMem,
+  kFieldCount,
+};
+
+bool g_enabled = false;
+std::uint64_t g_seed = 0;
+std::uint64_t g_canvas = 0;
+std::uint64_t g_audio = 0;
+std::uint32_t g_rects = 0;
+std::uint32_t g_gpu = 0;
+std::uint32_t g_ua = 0;
+std::uint32_t g_webgl_params = 0;
+// Fixed-capacity owned copies. The switch payload is a temporary in the
+// caller, so views into it would dangle; std::string globals are disallowed
+// (exit-time destructor), hence plain buffers + std::span for indexing.
+constexpr std::size_t kMaxFaceLen = 128;
+std::array<char, kMaxFaceLen + 1> g_vendor_storage{};
+std::array<char, kMaxFaceLen + 1> g_renderer_storage{};
+std::uint32_t g_hw_concurrency = 0;
+std::uint32_t g_device_memory = 0;
+
+// Font dimension traits -- the {switcher, value, mask} shape, not a seed.
+// Function-local static so it has no exit-time destructor.
+lengsuo::fonts::FamilyTraits& FontTraitsStorage() {
+  static lengsuo::fonts::FamilyTraits traits;
+  return traits;
+}
+bool g_fonts_installed = false;
+
+// Copies at most kMaxFaceLen chars and NUL-terminates. Returns a view of the
+// copied prefix (empty when the source was empty).
+std::string_view StoreFace(std::string_view text,
+                           std::array<char, kMaxFaceLen + 1>& storage) {
+  const std::size_t n = text.size() < kMaxFaceLen ? text.size() : kMaxFaceLen;
+  std::span<char> dst(storage);
+  for (std::size_t i = 0; i < n; ++i) {
+    dst[i] = text.at(i);
+  }
+  dst[n] = '\0';
+  return std::string_view(storage.data(), n);
+}
+
+// Returns false when the field is not a plain decimal integer (empty, too long,
+// or carrying a non-digit). Distinguishing "0" from "x" matters for the font
+// switch: "x" must be rejected, not silently read as 0.
+bool ParseDecimalStrict(std::string_view text, std::uint32_t* out) {
+  if (text.empty() || text.size() > 9) {
+    return false;
+  }
+  std::uint32_t value = 0;
+  for (const char c : text) {
+    if (c < '0' || c > '9') {
+      return false;
+    }
+    value = value * 10u + static_cast<std::uint32_t>(c - '0');
+  }
+  *out = value;
+  return true;
+}
+
+// Lenient form: any malformed field reads as 0 (i.e. "keep native").
+std::uint32_t ParseDecimal(std::string_view text) {
+  std::uint32_t value = 0;
+  return ParseDecimalStrict(text, &value) ? value : 0;
+}
+
+bool ParseHex(std::string_view text, std::uint64_t* out) {
+  if (text.empty() || text.size() > 16) {
+    return false;
+  }
+  std::uint64_t value = 0;
+  for (const char c : text) {
+    std::uint64_t digit = 0;
+    if (c >= '0' && c <= '9') {
+      digit = static_cast<std::uint64_t>(c - '0');
+    } else if (c >= 'a' && c <= 'f') {
+      digit = static_cast<std::uint64_t>(c - 'a' + 10);
+    } else if (c >= 'A' && c <= 'F') {
+      digit = static_cast<std::uint64_t>(c - 'A' + 10);
+    } else {
+      return false;
+    }
+    value = (value << 4) | digit;
+  }
+  *out = value;
+  return true;
+}
+
+// A non-zero slot enables the dimension; the slot byte and the process seed
+// both feed the mixer so two profiles never collide on one dimension.
+std::uint64_t DeriveSlotSeed(std::uint32_t slot, std::uint64_t salt) {
+  return slot != 0 ? Mix(g_seed ^ salt ^ static_cast<std::uint64_t>(slot)) : 0;
+}
+
+// Largest power of two <= value; value must be positive.
+std::int64_t PowerOfTwoAtMost(std::int64_t value) {
+  std::int64_t result = 1;
+  while (result <= value / 2) {
+    result *= 2;
+  }
+  return result;
+}
+}  // namespace
+
+void InitFromSwitch(std::string_view value) {
+  // Reset first so a malformed payload can never leave stale state behind.
+  g_enabled = false;
+  g_seed = 0;
+  g_canvas = 0;
+  g_audio = 0;
+  g_rects = 0;
+  g_gpu = 0;
+  g_ua = 0;
+  g_webgl_params = 0;
+  g_vendor_storage.fill(0);
+  g_renderer_storage.fill(0);
+  g_hw_concurrency = 0;
+  g_device_memory = 0;
+
+  std::array<std::string_view, kFieldCount> fields{};
+  std::size_t count = 0;
+  std::size_t start = 0;
+  for (std::size_t i = 0; i <= value.size() && count < kFieldCount; ++i) {
+    if (i == value.size() || value[i] == ':') {
+      fields.at(count) = value.substr(start, i - start);
+      ++count;
+      start = i + 1;
+    }
+  }
+  // The two face strings may legitimately be empty, so only the numeric prefix
+  // is mandatory.
+  if (count < kFieldCount - 2 || fields.at(kSeed).empty()) {
+    return;
+  }
+
+  std::uint64_t seed = 0;
+  if (!ParseHex(fields.at(kSeed), &seed) || seed == 0) {
+    return;
+  }
+  g_seed = seed;
+
+  const std::uint32_t canvas_slot = ParseDecimal(fields.at(kCanvas));
+  const std::uint32_t audio_slot = ParseDecimal(fields.at(kAudio));
+  g_rects = ParseDecimal(fields.at(kRects));
+  // kFonts is a contract position only; the font content rides its own switch.
+  (void)ParseDecimal(fields.at(kFonts));
+  g_gpu = ParseDecimal(fields.at(kGpu));
+  g_ua = ParseDecimal(fields.at(kUa));
+  g_webgl_params = ParseDecimal(fields.at(kWebglParams));
+  const std::string_view vendor = StoreFace(fields.at(kVendor),
+                                            g_vendor_storage);
+  const std::string_view renderer = StoreFace(fields.at(kRenderer),
+                                              g_renderer_storage);
+  g_hw_concurrency = ParseDecimal(fields.at(kHwc));
+  g_device_memory = ParseDecimal(fields.at(kMem));
+
+  g_canvas = DeriveSlotSeed(canvas_slot, 0xC4C0FFEEULL);
+  g_audio = DeriveSlotSeed(audio_slot, 0x0DEADBEEFULL);
+  g_enabled = true;
+  // Keep the stored views reachable for the accessors below.
+  (void)vendor;
+  (void)renderer;
+}
+
+bool InitFontsFromSwitch(std::string_view value) {
+  g_fonts_installed = false;
+  FontTraitsStorage() = lengsuo::fonts::FamilyTraits();
+  // Payload: <slot>:<mask>:<Family;Family;...>. The value may be empty (its
+  // own statement: the mask then decides), so only the two numeric fields are
+  // mandatory. A missing second colon is malformed, not "empty value".
+  const std::size_t first = value.find(':');
+  if (first == std::string_view::npos) {
+    return false;
+  }
+  const std::size_t second = value.find(':', first + 1);
+  if (second == std::string_view::npos) {
+    return false;
+  }
+  std::uint32_t slot = 0;
+  std::uint32_t mask = 0;
+  if (!ParseDecimalStrict(value.substr(0, first), &slot) ||
+      !ParseDecimalStrict(value.substr(first + 1, second - first - 1), &mask)) {
+    return false;
+  }
+  const std::string_view families = value.substr(second + 1);
+  lengsuo::fonts::FamilyTraits traits =
+      lengsuo::fonts::ParseFamilyTraits(slot, families, mask);
+  if (slot != 0 && !traits.installed) {
+    return false;  // malformed value: install nothing
+  }
+  FontTraitsStorage() = std::move(traits);
+  g_fonts_installed = true;
+  return true;
+}
+
+bool Enabled() {
+  return g_enabled;
+}
+
+std::string_view WebGLVendor() {
+  if (g_gpu == 0) {
+    return std::string_view();
+  }
+  return std::string_view(g_vendor_storage.data(),
+                          std::strlen(g_vendor_storage.data()));
+}
+
+std::string_view WebGLRenderer() {
+  if (g_gpu == 0) {
+    return std::string_view();
+  }
+  return std::string_view(g_renderer_storage.data(),
+                          std::strlen(g_renderer_storage.data()));
+}
+
+std::uint32_t HardwareConcurrency() {
+  return g_hw_concurrency;
+}
+
+std::uint32_t DeviceMemoryGB() {
+  return g_device_memory;
+}
+
+double RectsJitterPx() {
+  // Must exceed LayoutUnit quantization (1/64 px) to be observable, yet stay
+  // sub-pixel so rendering is visually unchanged: 0.101..0.400 px.
+  return g_rects != 0 ? 0.101 + static_cast<double>(g_seed % 300u) * 0.001
+                      : 0.0;
+}
+
+std::uint64_t AudioSeed() {
+  return g_audio;
+}
+
+const lengsuo::fonts::FamilyTraits& FontTraits() {
+  return FontTraitsStorage();
+}
+
+float PerturbGlyphAdvance(float advance) {
+  if (!g_fonts_installed) {
+    return advance;  // no profile statement: byte-identical to upstream
+  }
+  const lengsuo::fonts::FamilyTraits& traits = FontTraitsStorage();
+  // Needs both a relevant statement (installed and active) and a stream.
+  if (!traits.installed || !traits.perturbs_metrics) {
+    return advance;
+  }
+  lengsuo::fonts::FontNoiseConfig config;
+  config.enabled = true;
+  config.seed = g_seed ^ (static_cast<std::uint64_t>(traits.slot) << 32);
+  config.advance = advance;
+  return lengsuo::fonts::PerturbAdvance(config).advance;
+}
+
+std::uint64_t WebGLParamsSeed() {
+  return DeriveSlotSeed(g_webgl_params, 0xA5A5A5A5ULL);
+}
+
+std::int32_t WebGLParamBias(std::uint32_t pname, std::int32_t original) {
+  if (g_webgl_params == 0) {
+    return original;
+  }
+  // Allow-list: only informational MAX_* capability caps form the WebGL
+  // fingerprint surface. State params (ACTIVE_TEXTURE, DEPTH_FUNC,
+  // CURRENT_PROGRAM, VIEWPORT, SCISSOR_BOX, ...) must pass through untouched
+  // or pages break. Values are Khronos GL enums; this translation unit does
+  // not include the GL headers.
+  switch (pname) {
+    case 0x0D33:  // GL_MAX_TEXTURE_SIZE
+    case 0x8073:  // GL_MAX_3D_TEXTURE_SIZE (WebGL2)
+    case 0x84E8:  // GL_MAX_RENDERBUFFER_SIZE
+    case 0x851C:  // GL_MAX_CUBE_MAP_TEXTURE_SIZE
+    case 0x8869:  // GL_MAX_VERTEX_ATTRIBS
+    case 0x8872:  // GL_MAX_TEXTURE_IMAGE_UNITS
+    case 0x88FF:  // GL_MAX_ARRAY_TEXTURE_LAYERS (WebGL2)
+    case 0x8B4C:  // GL_MAX_VERTEX_TEXTURE_IMAGE_UNITS
+    case 0x8B4D:  // GL_MAX_COMBINED_TEXTURE_IMAGE_UNITS
+    case 0x8D57:  // GL_MAX_SAMPLES
+    case 0x8D6B:  // GL_MAX_ELEMENT_INDEX (WebGL2)
+    case 0x8DFB:  // GL_MAX_VERTEX_UNIFORM_VECTORS
+    case 0x8DFC:  // GL_MAX_VARYING_VECTORS
+    case 0x8DFD:  // GL_MAX_FRAGMENT_UNIFORM_VECTORS
+      break;
+    default:
+      return original;
+  }
+  if (original <= 0) {
+    return original;
+  }
+  // Mix the cap value in so two profiles can share one dimension while still
+  // advertising different limits.
+  const std::uint64_t mixed =
+      Mix(WebGLParamsSeed() ^ (static_cast<std::uint64_t>(pname) << 24) ^
+          static_cast<std::uint64_t>(original));
+  // Report a value a real driver could actually report.
+  //
+  // Drivers do not hand back arbitrary integers here; the caps people look at
+  // (texture size, renderbuffer size, uniform/varying counts) come from a small
+  // set of shapes: powers of two, the *_BITS fields stepping by 1, and a handful
+  // of architecture constants. 6364 is not one of them — a randomised number in
+  // that range is more distinctive than the unmodified driver value, which is
+  // the opposite of what this override is for.
+  //
+  // Never advertise more than the driver supports: a page that trusts a higher
+  // cap would allocate a texture/shader that cannot exist and fail at run time.
+  // So the candidate set is filtered to <= original, and the step count is
+  // measured on that filtered set to keep the distribution uniform.
+  //
+  // The driver's own value stays a candidate. That is deliberate and it is the
+  // honest outcome: on a machine with a real GPU the driver value is already a
+  // true measurement, and lowering it only makes sense as "this profile is the
+  // next tier down" - which also has to change the renderer string. Until the
+  // server sends per-tier parameter tables, most profiles therefore keep the
+  // driver value, and this dimension carries almost no entropy. That is the
+  // correct trade: a plausible value beats a perturbed one.
+  std::int32_t candidates[16];
+  std::size_t count = 0;
+  const auto add_candidate = [&](std::int64_t value) {
+    if (value <= 0 || value > original || count >= 16) {
+      return;
+    }
+    for (std::size_t i = 0; i < count; ++i) {
+      if (candidates[i] == value) {
+        return;
+      }
+    }
+    candidates[count++] = static_cast<std::int32_t>(value);
+  };
+  // The driver's own value is always a candidate: leaving a cap untouched is
+  // the most plausible outcome of all.
+  add_candidate(original);
+  // Powers of two at and below the driver value, down to three steps.
+  for (int shift = 0; shift <= 3; ++shift) {
+    const std::int64_t step = PowerOfTwoAtMost(original) >> shift;
+    if (step > 0) {
+      add_candidate(step);
+    }
+  }
+  // Real cards commonly report these exact values.
+  for (std::int64_t common : {16, 24, 30, 31, 32, 48, 60, 64, 96, 128, 256}) {
+    add_candidate(common);
+  }
+  // Stay within half the driver value: one real tier down at most. A larger
+  // drop would contradict the renderer string the profile advertises (a card
+  // claiming 32K textures does not report 4K).
+  const std::int64_t bound = original > 8 ? original / 2 : 1;
+  const std::int64_t floor_value = original - bound;
+  if (count == 0) {
+    return original;
+  }
+  const std::int32_t pick =
+      candidates[static_cast<std::size_t>(mixed % count)];
+  return pick >= floor_value ? pick : original;
+}
+
+}  // namespace lengsuo::fp
diff --git a/lengsuo/native/fp_overrides.h b/lengsuo/native/fp_overrides.h
new file mode 100644
index 0000000..40b59d2
--- /dev/null
+++ b/lengsuo/native/fp_overrides.h
@@ -0,0 +1,56 @@
+// fp_overrides - renderer-side fingerprint override state.
+// One switch carries everything: --lengsuo-managed-fp=<seed-hex>:<a>:<c>:<r>:<f>:<g>:<u>:<w>
+// (slots: audio, canvas, rects, fonts, gpu, ua, webgl). Absent => all disabled,
+// upstream behavior byte-identical. Face resolution lives here (built-in tables).
+#ifndef LENGSUO_NATIVE_FP_OVERRIDES_H_
+#define LENGSUO_NATIVE_FP_OVERRIDES_H_
+#include <cstdint>
+#include <string_view>
+
+#include "font_family_traits.h"
+#include "font_metrics.h"
+namespace lengsuo::fp {
+// Two switches, both optional and both absent by default:
+//   --lengsuo-managed-fp=<seed-hex>:<a>:<c>:<r>:<f>:<g>:<u>:<w>:<vendor>:
+//                        <renderer>:<hwc>:<mem>
+//   --lengsuo-managed-fonts=<slot>:<mask>:<Family;Family;...>
+// The fonts dimension is {switcher, value, mask} (docs/cc-task-rulings.md §C):
+// its value is a semicolon-separated family string that can be large, so it
+// does not ride a colon field of the fp switch (see docs/fp-switch-contract.md).
+// Both absent => upstream behavior byte-identical.
+void InitFromSwitch(std::string_view value);
+// Parses --lengsuo-managed-fonts and installs the font-metric perturbation.
+// Returns false on a malformed payload, in which case nothing is installed and
+// every measurement keeps its native value.
+bool InitFontsFromSwitch(std::string_view value);
+bool Enabled();
+// WebGL faces resolved from seed+slot (deterministic).
+std::string_view WebGLVendor();
+std::string_view WebGLRenderer();
+std::uint32_t HardwareConcurrency();  // 0 = disabled
+std::uint32_t DeviceMemoryGB();       // 0 = disabled
+double RectsJitterPx();               // 0 = disabled
+std::uint64_t AudioSeed();
+
+// Slot 7: deterministic seed for WebGL MAX_* parameter perturbation.
+// Returns 0 when the webgl slot is off.
+std::uint64_t WebGLParamsSeed();
+// Deterministic bias for GLenum-typed int parameters (MAX_*, *_BITS...);
+// returns 0 when the webgl slot is off. Applied inside GetIntParameter.
+std::int32_t WebGLParamBias(std::uint32_t pname, std::int32_t original);
+
+// Font dimension: the parsed traits, or a default (not-installed) value until a
+// valid payload arrives. Callers must treat !installed as "this profile says
+// nothing about fonts" and keep the native measurement. The seed used for the
+// perturbation is the global noise seed, so the font dimension shares the
+// canvas/audio derivation discipline (docs/font-dimension.md).
+const lengsuo::fonts::FamilyTraits& FontTraits();
+
+// Perturbs one measured glyph advance per the installed font dimension. This is
+// the browser-side entry point for the accepted mechanism (docs/cc-task-rulings
+// §C): the advance is perturbed deterministically, `FontFaceSet::check()` is
+// never touched. Returns the native advance unchanged when the dimension is off,
+// not installed, or dormant.
+float PerturbGlyphAdvance(float advance);
+}  // namespace lengsuo::fp
+#endif
diff --git a/lengsuo/native/fp_sampling.cc b/lengsuo/native/fp_sampling.cc
new file mode 100644
index 0000000..616c6dd
--- /dev/null
+++ b/lengsuo/native/fp_sampling.cc
@@ -0,0 +1,137 @@
+#include "fp_sampling.h"
+
+#include <cstddef>
+
+#include "canvas_noise.h"
+
+namespace lengsuo::fp {
+namespace {
+
+// FNV-1a 64. The offset basis and the prime are the ones the algorithm
+// defines; both are constants of the method, not fingerprint values.
+constexpr std::uint64_t kFnvOffset = 0xCBF29CE484222325ULL;
+constexpr std::uint64_t kFnvPrime = 0x00000100000001B3ULL;
+
+// SplitMix64's finalizer. It is used to spread the bits of a seed over
+// the whole word, so that two seeds that differ in one bit produce
+// perturbations that have nothing in common.
+std::uint64_t Mix64(std::uint64_t value) {
+  std::uint64_t mixed = value;
+  mixed = (mixed ^ (mixed >> 30)) * 0xBF58476D1CE4E5B9ULL;
+  mixed = (mixed ^ (mixed >> 27)) * 0x94D049BB133111EBULL;
+  return mixed ^ (mixed >> 31);
+}
+
+std::uint64_t Fnv1a64(std::string_view data) {
+  std::uint64_t hash = kFnvOffset;
+  for (const char c : data) {
+    hash ^= static_cast<std::uint64_t>(static_cast<unsigned char>(c));
+    hash *= kFnvPrime;
+  }
+  return hash;
+}
+
+}  // namespace
+
+std::uint32_t SamplingSideLength(const FpSamplingSpec& spec) {
+  if (spec.width == 0 || spec.width != spec.length) {
+    return 0;
+  }
+  return spec.width;
+}
+
+bool SameSamplingSpec(const FpSamplingSpec& a, const FpSamplingSpec& b) {
+  if (a.width != b.width || a.length != b.length) {
+    return false;
+  }
+  if (!a.drew_text.has_value() || !b.drew_text.has_value()) {
+    // One side did not constrain the question, so it cannot disagree.
+    return true;
+  }
+  return *a.drew_text == *b.drew_text;
+}
+
+std::uint64_t FingerprintHash(std::span<const std::uint8_t> pixels,
+                               std::uint32_t width,
+                               std::uint32_t height) {
+  std::uint64_t hash = kFnvOffset;
+  std::size_t index = 0;
+  for (std::uint32_t row = 0; row < height; ++row) {
+    for (std::uint32_t column = 0; column < width; ++column) {
+      for (int channel = 0; channel < 4; ++channel) {
+        if (index >= pixels.size()) {
+          return hash;
+        }
+        hash ^= static_cast<std::uint64_t>(pixels[index]);
+        hash *= kFnvPrime;
+        ++index;
+      }
+    }
+  }
+  return hash;
+}
+
+std::string FingerprintHashHex(std::span<const std::uint8_t> pixels,
+                                std::uint32_t width,
+                                std::uint32_t height) {
+  static const char kDigits[] = "0123456789abcdef";
+  std::uint64_t hash = FingerprintHash(pixels, width, height);
+  std::string text(16, '0');
+  for (int index = 15; index >= 0; --index) {
+    text[static_cast<std::size_t>(index)] =
+        kDigits[static_cast<std::size_t>(hash & 0xFULL)];
+    hash >>= 4;
+  }
+  return text;
+}
+
+std::uint64_t TargetSeed(std::string_view target_hash,
+                          const FpSamplingSpec& spec) {
+  std::uint64_t hash = Fnv1a64(target_hash);
+  hash ^= static_cast<std::uint64_t>(spec.width) * 0x9E3779B97F4A7C15ULL;
+  hash ^= static_cast<std::uint64_t>(spec.length) * 0xC2B2AE3D27D4EB4FULL;
+  hash ^= spec.drew_text.value_or(false) ? 0xFFFFFFFFFFFFFFFFULL : 0ULL;
+  return Mix64(hash);
+}
+
+std::uint64_t AttemptSeed(std::uint64_t base_seed, std::uint32_t attempt) {
+  const std::uint64_t offset =
+      (static_cast<std::uint64_t>(attempt) + 1ULL) * 0x9E3779B97F4A7C15ULL;
+  return Mix64(base_seed + offset);
+}
+
+bool ApplySeedNoise(std::uint64_t seed,
+                     std::span<const std::uint8_t> src,
+                     std::span<std::uint8_t> dst,
+                     std::uint32_t width,
+                     std::uint32_t height,
+                     std::uint64_t stride) {
+  if (width == 0 || height == 0) {
+    return false;
+  }
+  const std::uint64_t needed = stride * static_cast<std::uint64_t>(height);
+  if (needed == 0 || src.size() < needed || dst.size() < needed) {
+    return false;
+  }
+  canvas::CanvasNoiseConfig config;
+  config.algorithm_version = 1;
+  config.enabled = true;
+  config.seed = seed;
+  config.slot = 0;
+  const canvas::CanvasNoiseResult result = canvas::ApplyCanvasNoiseV1(
+      config, src, dst, width, height, stride, needed);
+  return result.status == canvas::CanvasNoiseStatus::kOk;
+}
+
+bool ApplyTargetNoise(std::string_view target_hash,
+                      const FpSamplingSpec& spec,
+                      std::span<const std::uint8_t> src,
+                      std::span<std::uint8_t> dst,
+                      std::uint32_t width,
+                      std::uint32_t height,
+                      std::uint64_t stride) {
+  const std::uint64_t seed = AttemptSeed(TargetSeed(target_hash, spec), 0);
+  return ApplySeedNoise(seed, src, dst, width, height, stride);
+}
+
+}  // namespace lengsuo::fp
diff --git a/lengsuo/native/fp_sampling.h b/lengsuo/native/fp_sampling.h
new file mode 100644
index 0000000..f3d50c6
--- /dev/null
+++ b/lengsuo/native/fp_sampling.h
@@ -0,0 +1,112 @@
+// fp_sampling - the sampling geometry, the fingerprint hash and the
+// deterministic perturbation (task T3).
+//
+// Three things live here.
+//
+// The geometry. A canvas sample is a square of a fixed side length: the
+// configuration says how wide the side is and the sample is taken at that
+// size, so that two samples of the same page are the same size and their
+// fingerprints can be compared.
+//
+// The fingerprint hash. What the page reads is a fingerprint; how that
+// fingerprint is reduced to bytes is a contract between the kernel and
+// whoever produces the target value. The definition here is the raw RGBA
+// pixels in row-major order, hashed with FNV-1a 64 and printed as sixteen
+// lowercase hexadecimal characters. It needs no crypto library and gives
+// the same bytes on every machine.
+//
+// The perturbation. The perturbation is a function of the target value and
+// the geometry and of nothing else, so the same target always produces the
+// same bytes. The noise itself is the canvas noise the kernel already had;
+// only the seed changes.
+//
+// The rules this file follows come from the task brief and from
+// docs/fp-switch-contract.md; see docs/l3-reports/task-T3.md for the
+// evidence and for the questions that are still open.
+#ifndef LENGSUO_NATIVE_FP_SAMPLING_H_
+#define LENGSUO_NATIVE_FP_SAMPLING_H_
+
+#include <cstdint>
+#include <optional>
+#include <span>
+#include <string>
+#include <string_view>
+
+namespace lengsuo::fp {
+
+// The two dimensions a fingerprint sample can be taken in.
+enum class FpDimension : std::uint8_t { kCanvas, kWebgl };
+
+// The geometry a sample was taken at.
+struct FpSamplingSpec {
+  // The width of the sample in pixels.
+  std::uint32_t width = 0;
+  // The height of the sample in pixels. A canvas sample is a square, so
+  // width == length there.
+  std::uint32_t length = 0;
+  // Whether the page drew text into the canvas. Empty when the target did
+  // not say, which means the target does not constrain it.
+  std::optional<bool> drew_text;
+};
+
+// The side of the square a canvas sample is taken at.
+//
+// Zero when the geometry is not a square: a canvas sample is a square of a
+// fixed side length, and a non-square geometry has no side.
+std::uint32_t SamplingSideLength(const FpSamplingSpec& spec);
+
+// True when two samples were taken at the same geometry.
+//
+// `drew_text` is compared only when both sides constrain it: a target that
+// did not say whether text was drawn does not make a sample incomparable.
+bool SameSamplingSpec(const FpSamplingSpec& a, const FpSamplingSpec& b);
+
+// The fingerprint hash of a sampled buffer.
+//
+// The hash is over the raw RGBA pixels in row-major order; the padding of
+// the last row is skipped. The buffer must hold at least width * height *
+// 4 bytes; a shorter buffer is hashed up to its end.
+std::uint64_t FingerprintHash(std::span<const std::uint8_t> pixels,
+                               std::uint32_t width,
+                               std::uint32_t height);
+
+// The same hash as sixteen lowercase hexadecimal characters.
+std::string FingerprintHashHex(std::span<const std::uint8_t> pixels,
+                                std::uint32_t width,
+                                std::uint32_t height);
+
+// The base seed of a target.
+//
+// It is derived from the target value and the geometry and from nothing
+// else, so the same target always produces the same perturbation.
+std::uint64_t TargetSeed(std::string_view target_hash,
+                          const FpSamplingSpec& spec);
+
+// One candidate of the convergence search.
+//
+// Attempt 0 is the seed used when no convergence is attempted.
+std::uint64_t AttemptSeed(std::uint64_t base_seed, std::uint32_t attempt);
+
+// Applies the deterministic perturbation of `seed` to a copy of `src`.
+//
+// `src` and `dst` must not overlap. Returns false when the geometry does
+// not fit the buffers, in which case `dst` is left untouched.
+bool ApplySeedNoise(std::uint64_t seed,
+                     std::span<const std::uint8_t> src,
+                     std::span<std::uint8_t> dst,
+                     std::uint32_t width,
+                     std::uint32_t height,
+                     std::uint64_t stride);
+
+// The perturbation of a target: attempt 0 of the search.
+bool ApplyTargetNoise(std::string_view target_hash,
+                      const FpSamplingSpec& spec,
+                      std::span<const std::uint8_t> src,
+                      std::span<std::uint8_t> dst,
+                      std::uint32_t width,
+                      std::uint32_t height,
+                      std::uint64_t stride);
+
+}  // namespace lengsuo::fp
+
+#endif  // LENGSUO_NATIVE_FP_SAMPLING_H_
diff --git a/lengsuo/native/fp_sampling_test.cc b/lengsuo/native/fp_sampling_test.cc
new file mode 100644
index 0000000..4481b56
--- /dev/null
+++ b/lengsuo/native/fp_sampling_test.cc
@@ -0,0 +1,207 @@
+// fp_sampling_test - the sampling geometry, the hash and the deterministic
+// perturbation (task T3).
+//
+// The brief's rulings each get a test of their own:
+//
+//   * a canvas sample is taken at a square of a fixed side length;
+//   * the sampling does not change the original pixel semantics: the source
+//     buffer is left untouched and only the read-out copy is perturbed;
+//   * the same target yields the same bytes, every time;
+//   * a different target yields different bytes.
+#include "fp_sampling.h"
+
+#include <gtest/gtest.h>
+
+#include <cstdint>
+#include <span>
+#include <string>
+#include <vector>
+
+namespace lengsuo::fp {
+namespace {
+
+// A 4x4 RGBA sample with a fixed pattern. The alpha channel is never 0, so
+// every pixel takes part in the perturbation.
+std::vector<std::uint8_t> SamplePixels() {
+  std::vector<std::uint8_t> pixels(4 * 4 * 4);
+  for (std::size_t i = 0; i < pixels.size(); ++i) {
+    pixels[i] = static_cast<std::uint8_t>((i * 7 + 13) & 0xFF);
+  }
+  for (std::size_t i = 3; i < pixels.size(); i += 4) {
+    pixels[i] = 255;
+  }
+  return pixels;
+}
+
+FpSamplingSpec Spec() {
+  FpSamplingSpec spec;
+  spec.width = 4;
+  spec.length = 4;
+  spec.drew_text = std::optional<bool>(true);
+  return spec;
+}
+
+// ---------------------------------------------------------------------------
+// The geometry
+// ---------------------------------------------------------------------------
+
+TEST(FpSampling, SquareSideIsTheWidth) {
+  FpSamplingSpec spec;
+  spec.width = 300;
+  spec.length = 300;
+  EXPECT_EQ(SamplingSideLength(spec), 300u);
+}
+
+TEST(FpSampling, NonSquareGeometryHasNoSide) {
+  FpSamplingSpec spec;
+  spec.width = 300;
+  spec.length = 150;
+  EXPECT_EQ(SamplingSideLength(spec), 0u);
+}
+
+TEST(FpSampling, ZeroGeometryHasNoSide) {
+  FpSamplingSpec spec;
+  EXPECT_EQ(SamplingSideLength(spec), 0u);
+}
+
+TEST(FpSampling, SameSpecIsEqual) {
+  const FpSamplingSpec a = Spec();
+  FpSamplingSpec b = Spec();
+  EXPECT_TRUE(SameSamplingSpec(a, b));
+
+  b.width = 8;
+  EXPECT_FALSE(SameSamplingSpec(a, b));
+}
+
+TEST(FpSampling, DifferentDrewTextIsADifferentSpec) {
+  const FpSamplingSpec a = Spec();
+  FpSamplingSpec b = Spec();
+  b.drew_text = std::optional<bool>(false);
+  EXPECT_FALSE(SameSamplingSpec(a, b));
+}
+
+TEST(FpSampling, AnUnconstrainedDrewTextMatchesAnything) {
+  const FpSamplingSpec a = Spec();
+  FpSamplingSpec b = Spec();
+  b.drew_text = std::nullopt;
+  EXPECT_TRUE(SameSamplingSpec(a, b));
+}
+
+// ---------------------------------------------------------------------------
+// The hash
+// ---------------------------------------------------------------------------
+
+TEST(FpHash, IsDeterministic) {
+  const std::vector<std::uint8_t> pixels = SamplePixels();
+  EXPECT_EQ(FingerprintHash(pixels, 4, 4),
+            FingerprintHash(pixels, 4, 4));
+  EXPECT_EQ(FingerprintHashHex(pixels, 4, 4),
+            FingerprintHashHex(pixels, 4, 4));
+}
+
+TEST(FpHash, DifferentPixelsHashDifferently) {
+  std::vector<std::uint8_t> pixels = SamplePixels();
+  const std::uint64_t before = FingerprintHash(pixels, 4, 4);
+  pixels[0] = static_cast<std::uint8_t>(pixels[0] ^ 0xFF);
+  EXPECT_NE(FingerprintHash(pixels, 4, 4), before);
+}
+
+TEST(FpHash, HexIsSixteenLowercaseCharacters) {
+  const std::vector<std::uint8_t> pixels = SamplePixels();
+  const std::string hex = FingerprintHashHex(pixels, 4, 4);
+  ASSERT_EQ(hex.size(), 16u);
+  for (const char c : hex) {
+    EXPECT_TRUE((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')) << c;
+  }
+}
+
+// ---------------------------------------------------------------------------
+// The seed
+// ---------------------------------------------------------------------------
+
+TEST(FpSeed, TheSameTargetGivesTheSameSeed) {
+  const FpSamplingSpec spec = Spec();
+  EXPECT_EQ(TargetSeed("abcdef", spec), TargetSeed("abcdef", spec));
+}
+
+TEST(FpSeed, ADifferentTargetGivesADifferentSeed) {
+  const FpSamplingSpec spec = Spec();
+  EXPECT_NE(TargetSeed("abcdef", spec), TargetSeed("abcdeg", spec));
+}
+
+TEST(FpSeed, ADifferentGeometryGivesADifferentSeed) {
+  FpSamplingSpec other = Spec();
+  other.width = 8;
+  other.length = 8;
+  EXPECT_NE(TargetSeed("abcdef", Spec()), TargetSeed("abcdef", other));
+}
+
+TEST(FpSeed, AttemptsGiveDifferentSeeds) {
+  const std::uint64_t base = TargetSeed("abcdef", Spec());
+  EXPECT_NE(AttemptSeed(base, 0), AttemptSeed(base, 1));
+  EXPECT_EQ(AttemptSeed(base, 2), AttemptSeed(base, 2));
+}
+
+// ---------------------------------------------------------------------------
+// The perturbation
+// ---------------------------------------------------------------------------
+
+TEST(FpNoise, SameTargetGivesTheSameBytes) {
+  // The evidence the brief asks for: one target value run twice gives
+  // byte-identical output.
+  const std::vector<std::uint8_t> src = SamplePixels();
+  const FpSamplingSpec spec = Spec();
+
+  std::vector<std::uint8_t> first(src.size());
+  std::vector<std::uint8_t> second(src.size());
+  ASSERT_TRUE(ApplyTargetNoise("abcdef", spec, src, first, 4, 4, 16));
+  ASSERT_TRUE(ApplyTargetNoise("abcdef", spec, src, second, 4, 4, 16));
+  EXPECT_EQ(first, second);
+}
+
+TEST(FpNoise, ADifferentTargetGivesDifferentBytes) {
+  const std::vector<std::uint8_t> src = SamplePixels();
+  const FpSamplingSpec spec = Spec();
+
+  std::vector<std::uint8_t> first(src.size());
+  std::vector<std::uint8_t> second(src.size());
+  ASSERT_TRUE(ApplyTargetNoise("abcdef", spec, src, first, 4, 4, 16));
+  ASSERT_TRUE(ApplyTargetNoise("abcdeg", spec, src, second, 4, 4, 16));
+  EXPECT_NE(first, second);
+}
+
+TEST(FpNoise, TheSourceIsNotTouched) {
+  // The sampling must not change the original pixels: only the read-out
+  // copy carries the perturbation.
+  const std::vector<std::uint8_t> src = SamplePixels();
+  const std::vector<std::uint8_t> before = src;
+  std::vector<std::uint8_t> dst(src.size());
+  ASSERT_TRUE(ApplyTargetNoise("abcdef", Spec(), src, dst, 4, 4, 16));
+  EXPECT_EQ(src, before);
+}
+
+TEST(FpNoise, TransparentPixelsArePreserved) {
+  std::vector<std::uint8_t> src = SamplePixels();
+  for (std::size_t i = 3; i < src.size(); i += 4) {
+    src[i] = 0;
+  }
+  const std::vector<std::uint8_t> before = src;
+  std::vector<std::uint8_t> dst(src.size());
+  ASSERT_TRUE(ApplyTargetNoise("abcdef", Spec(), src, dst, 4, 4, 16));
+  EXPECT_EQ(dst, before);
+}
+
+TEST(FpNoise, RejectsATooSmallBuffer) {
+  const std::vector<std::uint8_t> src = SamplePixels();
+  std::vector<std::uint8_t> dst(4);
+  EXPECT_FALSE(ApplyTargetNoise("abcdef", Spec(), src, dst, 4, 4, 16));
+}
+
+TEST(FpNoise, RejectsAnEmptyGeometry) {
+  const std::vector<std::uint8_t> src = SamplePixels();
+  std::vector<std::uint8_t> dst(src.size());
+  EXPECT_FALSE(ApplyTargetNoise("abcdef", Spec(), src, dst, 0, 0, 0));
+}
+
+}  // namespace
+}  // namespace lengsuo::fp
diff --git a/lengsuo/native/fp_target.cc b/lengsuo/native/fp_target.cc
new file mode 100644
index 0000000..4474a2e
--- /dev/null
+++ b/lengsuo/native/fp_target.cc
@@ -0,0 +1,303 @@
+#include "fp_target.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "kernel_pipe_json.h"
+
+namespace lengsuo::fp {
+namespace {
+
+// The biggest side a sample may have. A side of four gigapixels is far
+// past anything a browser allocates, and the ceiling keeps a fat-fingered
+// configuration from asking for one.
+constexpr std::int64_t kMaxSide = 1 << 20;
+
+// Skips the whitespace of a JSON text.
+void SkipWhitespace(std::string_view text, std::size_t* pos) {
+  while (*pos < text.size()) {
+    const char c = text[*pos];
+    if (c != ' ' && c != '\t' && c != '\n' && c != '\r') {
+      break;
+    }
+    ++(*pos);
+  }
+}
+
+// Finds the end of the JSON value that starts at `*pos`.
+//
+// Returns false when the text is malformed. The value may be an object, an
+// array, a string or a scalar; the caller only needs to know where it
+// ends.
+bool ScanValue(std::string_view text, std::size_t* pos) {
+  if (*pos >= text.size()) {
+    return false;
+  }
+  const char c = text[*pos];
+  if (c == '"') {
+    ++(*pos);
+    while (*pos < text.size()) {
+      const char d = text[*pos];
+      if (d == '\\') {
+        ++(*pos);
+        if (*pos >= text.size()) {
+          return false;
+        }
+        ++(*pos);
+        continue;
+      }
+      ++(*pos);
+      if (d == '"') {
+        return true;
+      }
+    }
+    return false;
+  }
+  if (c == '{' || c == '[') {
+    int depth = 0;
+    while (*pos < text.size()) {
+      const char d = text[*pos];
+      if (d == '"') {
+        if (!ScanValue(text, pos)) {
+          return false;
+        }
+        continue;
+      }
+      ++(*pos);
+      if (d == '{' || d == '[') {
+        ++depth;
+      } else if (d == '}' || d == ']') {
+        --depth;
+        if (depth == 0) {
+          return true;
+        }
+      }
+    }
+    return false;
+  }
+  // A scalar ends at a delimiter.
+  while (*pos < text.size()) {
+    const char d = text[*pos];
+    if (d == ',' || d == ']' || d == '}' || d == ' ' || d == '\t' ||
+        d == '\n' || d == '\r') {
+      break;
+    }
+    ++(*pos);
+  }
+  return true;
+}
+
+// Splits a JSON array into its elements.
+//
+// The elements are the raw slices of the array, so the caller can parse
+// each of them on its own. Returns false when the text is not an array.
+bool SplitJsonArray(std::string_view text, std::vector<std::string_view>* out) {
+  std::size_t pos = 0;
+  SkipWhitespace(text, &pos);
+  if (pos >= text.size() || text[pos] != '[') {
+    return false;
+  }
+  ++pos;
+  SkipWhitespace(text, &pos);
+  if (pos < text.size() && text[pos] == ']') {
+    return true;
+  }
+  while (true) {
+    SkipWhitespace(text, &pos);
+    const std::size_t start = pos;
+    if (!ScanValue(text, &pos)) {
+      return false;
+    }
+    out->push_back(text.substr(start, pos - start));
+    SkipWhitespace(text, &pos);
+    if (pos >= text.size()) {
+      return false;
+    }
+    if (text[pos] == ',') {
+      ++pos;
+      continue;
+    }
+    return text[pos] == ']';
+  }
+}
+
+// How one entry ended up.
+enum class EntryStatus {
+  kOk,
+  // The entry says where it applies but not what to apply.
+  kMissingHash,
+  // The entry does not describe a sample at all.
+  kInvalid,
+};
+
+// Reads one entry of the table.
+EntryStatus ParseTargetEntry(std::string_view text, FpTarget* out) {
+  JsonObject entry;
+  if (!JsonObject::Parse(text, &entry)) {
+    return EntryStatus::kInvalid;
+  }
+
+  std::string dimension;
+  if (!entry.GetString("dimension", &dimension)) {
+    return EntryStatus::kInvalid;
+  }
+  if (dimension == "canvas") {
+    out->dimension = FpDimension::kCanvas;
+  } else if (dimension == "webgl") {
+    out->dimension = FpDimension::kWebgl;
+  } else {
+    return EntryStatus::kInvalid;
+  }
+
+  std::int64_t width = 0;
+  std::int64_t length = 0;
+  if (!entry.GetInt64("width", &width) || !entry.GetInt64("length", &length)) {
+    return EntryStatus::kInvalid;
+  }
+  if (width <= 0 || length <= 0 || width > kMaxSide || length > kMaxSide) {
+    return EntryStatus::kInvalid;
+  }
+  out->width = static_cast<std::uint32_t>(width);
+  out->length = static_cast<std::uint32_t>(length);
+  // A canvas sample is a square of a fixed side length. A webgl sample
+  // has no such rule, so its two sides may differ.
+  if (out->dimension == FpDimension::kCanvas && out->width != out->length) {
+    return EntryStatus::kInvalid;
+  }
+
+  if (entry.Has("url_regex") && !entry.GetString("url_regex", &out->url_regex)) {
+    return EntryStatus::kInvalid;
+  }
+  if (entry.Has("url_glob") && !entry.GetString("url_glob", &out->url_glob)) {
+    return EntryStatus::kInvalid;
+  }
+
+  bool drew_text = false;
+  if (entry.GetBool("drew_text", &drew_text)) {
+    out->has_drew_text = true;
+    out->drew_text = drew_text;
+  } else if (entry.Has("drew_text")) {
+    return EntryStatus::kInvalid;
+  }
+
+  bool skip = false;
+  if (entry.GetBool("skip", &skip)) {
+    out->skip = skip;
+  } else if (entry.Has("skip")) {
+    return EntryStatus::kInvalid;
+  }
+
+  if (!entry.Has("target_hash")) {
+    return EntryStatus::kMissingHash;
+  }
+  if (!entry.GetString("target_hash", &out->target_hash)) {
+    return EntryStatus::kInvalid;
+  }
+  if (out->target_hash.empty()) {
+    return EntryStatus::kMissingHash;
+  }
+  return EntryStatus::kOk;
+}
+
+}  // namespace
+
+FpSamplingSpec SamplingSpecOf(const FpTarget& target) {
+  FpSamplingSpec spec;
+  spec.width = target.width;
+  spec.length = target.length;
+  if (target.has_drew_text) {
+    spec.drew_text = target.drew_text;
+  }
+  return spec;
+}
+
+bool ParseFpTargetConfig(std::string_view bundle_json,
+                         FpTargetTable* out,
+                         std::string* error) {
+  if (out == nullptr) {
+    return false;
+  }
+  *out = FpTargetTable();
+
+  JsonObject bundle;
+  if (!JsonObject::Parse(bundle_json, &bundle)) {
+    if (error != nullptr) {
+      *error = "the configuration bundle is not a JSON object";
+    }
+    return false;
+  }
+
+  const JsonValue* section_value = bundle.Find(kFpTargetConfigKey);
+  if (section_value == nullptr) {
+    // No section: the platform asked for no target, and the caller keeps
+    // the behaviour it had. That is not a malformed configuration.
+    return true;
+  }
+  if (section_value->kind != JsonKind::kObject) {
+    if (error != nullptr) {
+      *error = "the fp_target section is not a JSON object";
+    }
+    return false;
+  }
+
+  JsonObject section;
+  if (!JsonObject::Parse(section_value->text, &section)) {
+    if (error != nullptr) {
+      *error = "the fp_target section is malformed";
+    }
+    return false;
+  }
+
+  if (section.Has("similarity")) {
+    std::int64_t similarity = 0;
+    if (!section.GetInt64("similarity", &similarity) || similarity < 0 ||
+        similarity > 0xFFFFFFFFLL) {
+      if (error != nullptr) {
+        *error = "the fp_target similarity is not a threshold";
+      }
+      return false;
+    }
+    out->similarity = static_cast<std::uint32_t>(similarity);
+  }
+
+  const JsonValue* targets_value = section.Find("targets");
+  if (targets_value == nullptr) {
+    // The section says the threshold but names no target. Nothing to
+    // apply, and nothing wrong with it.
+    return true;
+  }
+  if (targets_value->kind != JsonKind::kArray) {
+    if (error != nullptr) {
+      *error = "the fp_target targets are not a JSON array";
+    }
+    return false;
+  }
+
+  std::vector<std::string_view> elements;
+  if (!SplitJsonArray(targets_value->text, &elements)) {
+    if (error != nullptr) {
+      *error = "the fp_target targets are malformed";
+    }
+    return false;
+  }
+
+  for (const std::string_view element : elements) {
+    FpTarget target;
+    const EntryStatus status = ParseTargetEntry(element, &target);
+    if (status == EntryStatus::kOk) {
+      out->targets.push_back(target);
+      continue;
+    }
+    if (status == EntryStatus::kMissingHash) {
+      ++out->skipped_missing_hash;
+      continue;
+    }
+    ++out->skipped_invalid;
+  }
+  return true;
+}
+
+}  // namespace lengsuo::fp
diff --git a/lengsuo/native/fp_target.h b/lengsuo/native/fp_target.h
new file mode 100644
index 0000000..67f7601
--- /dev/null
+++ b/lengsuo/native/fp_target.h
@@ -0,0 +1,115 @@
+// fp_target - the table of fingerprint target values (task T3).
+//
+// The platform decides what a canvas or a webgl sample of a given URL
+// should look like. The kernel receives those decisions as configuration
+// and applies them; it never decides a target value itself.
+//
+// The table is configuration, not code. Everything in it comes from the
+// ConfigBundle, so the same bundle gives the same behaviour on every
+// machine, and a bundle without targets gives exactly the behaviour the
+// kernel had before this task.
+//
+// The shape of one entry is:
+//
+//   dimension    "canvas" or "webgl"
+//   url_regex    a pattern that selects the URLs this entry speaks for;
+//                an empty pattern is the default of the dimension
+//   url_glob     the same thing in the glob form; url_regex wins when
+//                both are given
+//   target_hash  the fingerprint the sample must be brought to
+//   width        the width of the sample in pixels
+//   length       the height of the sample in pixels
+//   drew_text    whether the page drew text; optional, and when it is
+//                absent the entry does not constrain the question
+//   skip         optional; true says this URL must not be perturbed at
+//                all
+//
+// A malformed entry is dropped and counted. It never poisons the entries
+// around it and it never fails the whole table: one bad entry from the
+// platform must not take the browser's fingerprints down with it.
+//
+// The threshold that decides whether a sample is close enough to its
+// target is `similarity`, a value of the same section. It is optional, and
+// without it there is no verdict at all - see fp_converge.h.
+#ifndef LENGSUO_NATIVE_FP_TARGET_H_
+#define LENGSUO_NATIVE_FP_TARGET_H_
+
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "fp_sampling.h"
+
+namespace lengsuo::fp {
+
+// The name of the configuration section that carries the table.
+inline constexpr char kFpTargetConfigKey[] = "fp_target";
+
+// One target value.
+struct FpTarget {
+  // The dimension this entry speaks for.
+  FpDimension dimension = FpDimension::kCanvas;
+  // The pattern that selects the URLs. An empty pattern is the default of
+  // the dimension: it applies to every URL of that dimension that no
+  // other entry claims.
+  std::string url_regex;
+  // The same selection in the glob form. When url_regex is not empty this
+  // field is ignored.
+  std::string url_glob;
+  // The fingerprint the sample must be brought to.
+  std::string target_hash;
+  // The width of the sample in pixels.
+  std::uint32_t width = 0;
+  // The height of the sample in pixels.
+  std::uint32_t length = 0;
+  // True when the entry says whether the page drew text into the sample.
+  // False when the entry does not constrain the question at all.
+  bool has_drew_text = false;
+  // Whether the page drew text. Only meaningful when has_drew_text.
+  bool drew_text = false;
+  // True when this URL must not be perturbed at all.
+  bool skip = false;
+};
+
+// The table of target values.
+struct FpTargetTable {
+  // The entries that were read and are usable.
+  std::vector<FpTarget> targets;
+  // The threshold of the comparison. Absent when the platform did not
+  // configure one, and then no sample can be judged.
+  std::optional<std::uint32_t> similarity;
+  // How many entries were dropped because they carried no target value.
+  std::uint32_t skipped_missing_hash = 0;
+  // How many entries were dropped because they were malformed.
+  std::uint32_t skipped_invalid = 0;
+};
+
+// The sampling geometry the target speaks for.
+//
+// The geometry of a canvas sample is a square, so the two sides are the
+// same number; the geometry of a webgl sample is free.
+FpSamplingSpec SamplingSpecOf(const FpTarget& target);
+
+// Reads the fp_target section out of a frozen configuration bundle.
+//
+// A bundle without the section is not an error: it means the platform
+// asked for no target, and the caller keeps the behaviour it had. Only a
+// bundle that cannot be read at all fails; `*error` then says why.
+//
+// A malformed section fails the same way. An entry that is malformed is
+// dropped and counted, and the entries around it are still read.
+//
+// An entry is malformed when its dimension is not one of the two, or its
+// geometry does not describe a sample. An entry that is well formed but
+// carries no target value is counted apart, because that is a different
+// kind of problem: the entry says where it applies but not what to
+// apply.
+bool ParseFpTargetConfig(std::string_view bundle_json,
+                         FpTargetTable* out,
+                         std::string* error);
+
+}  // namespace lengsuo::fp
+
+#endif  // LENGSUO_NATIVE_FP_TARGET_H_
diff --git a/lengsuo/native/fp_target_match.cc b/lengsuo/native/fp_target_match.cc
new file mode 100644
index 0000000..cf45414
--- /dev/null
+++ b/lengsuo/native/fp_target_match.cc
@@ -0,0 +1,559 @@
+#include "fp_target_match.h"
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <limits>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include "profile_bundle.h"
+
+namespace lengsuo::fp {
+namespace {
+
+// ---------------------------------------------------------------------------
+// The pattern's syntax tree
+// ---------------------------------------------------------------------------
+
+struct RegexNode {
+  enum class Kind {
+    kLiteral,
+    kAny,
+    kClass,
+    kConcat,
+    kAlternate,
+    kRepeat,
+    kAnchorStart,
+    kAnchorEnd,
+  };
+  Kind kind = Kind::kLiteral;
+  std::uint8_t literal = 0;
+  bool negated = false;
+  std::vector<std::pair<std::uint8_t, std::uint8_t>> ranges;
+  std::vector<std::size_t> children;
+  std::uint32_t min = 1;
+  std::uint32_t max = 1;
+};
+
+using Ranges = std::vector<std::pair<std::uint8_t, std::uint8_t>>;
+
+// The complement of a set of ranges over the 256 bytes.
+Ranges ComplementRanges(const Ranges& ranges) {
+  Ranges sorted = ranges;
+  std::sort(sorted.begin(), sorted.end());
+  Ranges result;
+  std::uint32_t next = 0;
+  for (const auto& range : sorted) {
+    if (range.first > next) {
+      result.emplace_back(static_cast<std::uint8_t>(next),
+                          static_cast<std::uint8_t>(range.first - 1));
+    }
+    next = std::max(next, static_cast<std::uint32_t>(range.second) + 1);
+    if (next > 255) {
+      break;
+    }
+  }
+  if (next <= 255) {
+    result.emplace_back(static_cast<std::uint8_t>(next), 255);
+  }
+  return result;
+}
+
+Ranges DigitRanges() {
+  return {{'0', '9'}};
+}
+
+Ranges WordRanges() {
+  return {{'0', '9'}, {'A', 'Z'}, {'a', 'z'}, {'_', '_'}};
+}
+
+Ranges SpaceRanges() {
+  return {{' ', ' '}, {'\t', '\t'}, {'\n', '\n'}, {'\r', '\r'}, {'\f', '\f'},
+          {'\v', '\v'}};
+}
+
+// ---------------------------------------------------------------------------
+// The parser
+// ---------------------------------------------------------------------------
+
+class RegexParser {
+ public:
+  explicit RegexParser(std::string_view pattern) : pattern_(pattern) {}
+
+  bool Parse(std::vector<RegexNode>* nodes, std::size_t* root);
+
+ private:
+  bool ParsePattern(std::vector<RegexNode>* nodes, std::size_t* out);
+  bool ParseConcat(std::vector<RegexNode>* nodes, std::size_t* out);
+  bool ParseRepeat(std::vector<RegexNode>* nodes, std::size_t* out);
+  bool ParseAtom(std::vector<RegexNode>* nodes, std::size_t* out);
+  bool ParseEscape(std::vector<RegexNode>* nodes, std::size_t* out);
+  bool ParseClass(std::vector<RegexNode>* nodes, std::size_t* out);
+  bool ParseEscapeByte(Ranges* ranges,
+                       std::uint8_t* single,
+                       bool* has_single);
+
+  std::string_view pattern_;
+  std::size_t pos_ = 0;
+};
+
+// Reads the byte that follows a backslash.
+//
+// A set escape produces a set of ranges; every other escape produces one
+// byte. `has_single` says which of the two it was.
+bool RegexParser::ParseEscapeByte(Ranges* ranges,
+                                  std::uint8_t* single,
+                                  bool* has_single) {
+  if (pos_ >= pattern_.size()) {
+    return false;
+  }
+  const char c = pattern_[pos_];
+  ++pos_;
+  switch (c) {
+    case 'd':
+      *ranges = DigitRanges();
+      *has_single = false;
+      return true;
+    case 'D':
+      *ranges = ComplementRanges(DigitRanges());
+      *has_single = false;
+      return true;
+    case 'w':
+      *ranges = WordRanges();
+      *has_single = false;
+      return true;
+    case 'W':
+      *ranges = ComplementRanges(WordRanges());
+      *has_single = false;
+      return true;
+    case 's':
+      *ranges = SpaceRanges();
+      *has_single = false;
+      return true;
+    case 'S':
+      *ranges = ComplementRanges(SpaceRanges());
+      *has_single = false;
+      return true;
+    default:
+      break;
+  }
+  *ranges = {{static_cast<std::uint8_t>(c), static_cast<std::uint8_t>(c)}};
+  *single = static_cast<std::uint8_t>(c);
+  *has_single = true;
+  return true;
+}
+
+bool RegexParser::ParseEscape(std::vector<RegexNode>* nodes,
+                              std::size_t* out) {
+  ++pos_;  // the backslash
+  if (pos_ >= pattern_.size()) {
+    return false;
+  }
+  Ranges ranges;
+  std::uint8_t single = 0;
+  bool has_single = false;
+  if (!ParseEscapeByte(&ranges, &single, &has_single)) {
+    return false;
+  }
+  RegexNode node;
+  if (has_single) {
+    node.kind = RegexNode::Kind::kLiteral;
+    node.literal = single;
+  } else {
+    node.kind = RegexNode::Kind::kClass;
+    node.ranges = ranges;
+  }
+  nodes->push_back(node);
+  *out = nodes->size() - 1;
+  return true;
+}
+
+bool RegexParser::ParseClass(std::vector<RegexNode>* nodes,
+                              std::size_t* out) {
+  ++pos_;  // the '['
+  bool negated = false;
+  if (pos_ < pattern_.size() && pattern_[pos_] == '^') {
+    negated = true;
+    ++pos_;
+  }
+  Ranges ranges;
+  bool first = true;
+  while (true) {
+    if (pos_ >= pattern_.size()) {
+      return false;
+    }
+    if (pattern_[pos_] == ']' && !first) {
+      ++pos_;
+      break;
+    }
+    Ranges element;
+    std::uint8_t single = 0;
+    bool has_single = false;
+    if (!ParseEscapeByte(&element, &single, &has_single)) {
+      return false;
+    }
+    // A '-' between two single bytes is a range. A '-' after a set is
+    // the byte '-', because a set has no end to range from.
+    if (has_single && pos_ + 1 < pattern_.size() &&
+        pattern_[pos_] == '-' && pattern_[pos_ + 1] != ']') {
+      ++pos_;
+      Ranges high_element;
+      std::uint8_t high_single = 0;
+      bool high_has_single = false;
+      if (!ParseEscapeByte(&high_element, &high_single, &high_has_single)) {
+        return false;
+      }
+      if (!high_has_single || single > high_single) {
+        return false;
+      }
+      ranges.emplace_back(single, high_single);
+    } else {
+      for (const auto& range : element) {
+        ranges.push_back(range);
+      }
+    }
+    first = false;
+  }
+  RegexNode node;
+  node.kind = RegexNode::Kind::kClass;
+  node.negated = negated;
+  node.ranges = ranges;
+  nodes->push_back(node);
+  *out = nodes->size() - 1;
+  return true;
+}
+
+bool RegexParser::ParseAtom(std::vector<RegexNode>* nodes, std::size_t* out) {
+  if (pos_ >= pattern_.size()) {
+    return false;
+  }
+  const char c = pattern_[pos_];
+  if (c == '(') {
+    ++pos_;
+    std::size_t inner = 0;
+    if (!ParsePattern(nodes, &inner)) {
+      return false;
+    }
+    if (pos_ >= pattern_.size() || pattern_[pos_] != ')') {
+      return false;
+    }
+    ++pos_;
+    *out = inner;
+    return true;
+  }
+  if (c == '[') {
+    return ParseClass(nodes, out);
+  }
+  if (c == '\\') {
+    return ParseEscape(nodes, out);
+  }
+  if (c == '|' || c == ')' || c == '*' || c == '+' || c == '?') {
+    // A quantifier without an element before it, or a separator where an
+    // element belongs.
+    return false;
+  }
+  ++pos_;
+  RegexNode node;
+  node.kind = RegexNode::Kind::kLiteral;
+  node.literal = static_cast<std::uint8_t>(c);
+  if (c == '.') {
+    node.kind = RegexNode::Kind::kAny;
+  } else if (c == '^') {
+    node.kind = RegexNode::Kind::kAnchorStart;
+  } else if (c == '$') {
+    node.kind = RegexNode::Kind::kAnchorEnd;
+  }
+  nodes->push_back(node);
+  *out = nodes->size() - 1;
+  return true;
+}
+
+bool RegexParser::ParseRepeat(std::vector<RegexNode>* nodes, std::size_t* out) {
+  std::size_t atom = 0;
+  if (!ParseAtom(nodes, &atom)) {
+    return false;
+  }
+  if (pos_ >= pattern_.size()) {
+    *out = atom;
+    return true;
+  }
+  const char c = pattern_[pos_];
+  std::uint32_t min = 1;
+  std::uint32_t max = 1;
+  if (c == '*') {
+    min = 0;
+    max = std::numeric_limits<std::uint32_t>::max();
+    ++pos_;
+  } else if (c == '+') {
+    min = 1;
+    max = std::numeric_limits<std::uint32_t>::max();
+    ++pos_;
+  } else if (c == '?') {
+    min = 0;
+    max = 1;
+    ++pos_;
+  } else {
+    *out = atom;
+    return true;
+  }
+  RegexNode node;
+  node.kind = RegexNode::Kind::kRepeat;
+  node.children.push_back(atom);
+  node.min = min;
+  node.max = max;
+  nodes->push_back(node);
+  *out = nodes->size() - 1;
+  return true;
+}
+
+bool RegexParser::ParseConcat(std::vector<RegexNode>* nodes,
+                               std::size_t* out) {
+  std::vector<std::size_t> children;
+  while (pos_ < pattern_.size() && pattern_[pos_] != '|' &&
+         pattern_[pos_] != ')') {
+    std::size_t child = 0;
+    if (!ParseRepeat(nodes, &child)) {
+      return false;
+    }
+    children.push_back(child);
+  }
+  RegexNode node;
+  node.kind = RegexNode::Kind::kConcat;
+  node.children = children;
+  nodes->push_back(node);
+  *out = nodes->size() - 1;
+  return true;
+}
+
+bool RegexParser::ParsePattern(std::vector<RegexNode>* nodes,
+                               std::size_t* out) {
+  std::vector<std::size_t> alternatives;
+  while (true) {
+    std::size_t concat = 0;
+    if (!ParseConcat(nodes, &concat)) {
+      return false;
+    }
+    alternatives.push_back(concat);
+    if (pos_ < pattern_.size() && pattern_[pos_] == '|') {
+      ++pos_;
+      continue;
+    }
+    break;
+  }
+  if (alternatives.size() == 1) {
+    *out = alternatives[0];
+    return true;
+  }
+  RegexNode node;
+  node.kind = RegexNode::Kind::kAlternate;
+  node.children = alternatives;
+  nodes->push_back(node);
+  *out = nodes->size() - 1;
+  return true;
+}
+
+bool RegexParser::Parse(std::vector<RegexNode>* nodes, std::size_t* root) {
+  std::size_t parsed = 0;
+  if (!ParsePattern(nodes, &parsed)) {
+    return false;
+  }
+  // The whole pattern must be consumed: a leftover byte means the pattern
+  // is malformed, and a malformed pattern never matches.
+  if (pos_ != pattern_.size()) {
+    return false;
+  }
+  *root = parsed;
+  return true;
+}
+
+// ---------------------------------------------------------------------------
+// The matcher
+// ---------------------------------------------------------------------------
+
+// What to do with the position after a match.
+using Continuation = std::function<bool(std::size_t)>;
+
+bool MatchRepeat(const std::vector<RegexNode>& nodes,
+                 const RegexNode& repeat,
+                 std::uint32_t count,
+                 std::string_view text,
+                 std::size_t pos,
+                 const Continuation& next);
+
+bool MatchNodeOnce(const std::vector<RegexNode>& nodes,
+                   std::size_t index,
+                   std::string_view text,
+                   std::size_t pos,
+                   const Continuation& next);
+
+bool MatchSeq(const std::vector<RegexNode>& nodes,
+              const std::vector<std::size_t>& seq,
+              std::size_t from,
+              std::string_view text,
+              std::size_t pos,
+              const Continuation& next) {
+  if (from == seq.size()) {
+    return next(pos);
+  }
+  const RegexNode& node = nodes[seq[from]];
+  if (node.kind == RegexNode::Kind::kRepeat) {
+    return MatchRepeat(
+        nodes, node, 0, text, pos, [&](std::size_t end) {
+          return MatchSeq(nodes, seq, from + 1, text, end, next);
+        });
+  }
+  return MatchNodeOnce(nodes, seq[from], text, pos, [&](std::size_t end) {
+    return MatchSeq(nodes, seq, from + 1, text, end, next);
+  });
+}
+
+bool MatchRepeat(const std::vector<RegexNode>& nodes,
+                 const RegexNode& repeat,
+                 std::uint32_t count,
+                 std::string_view text,
+                 std::size_t pos,
+                 const Continuation& next) {
+  if (count < repeat.max) {
+    // Greedy: one more occurrence first, and only then the shorter way.
+    const bool matched =
+        MatchNodeOnce(nodes, repeat.children[0], text, pos,
+                      [&](std::size_t end) {
+                        return MatchRepeat(nodes, repeat, count + 1, text, end,
+                                           next);
+                      });
+    if (matched) {
+      return true;
+    }
+  }
+  if (count >= repeat.min) {
+    return next(pos);
+  }
+  return false;
+}
+
+bool ClassMatches(const RegexNode& node, char c) {
+  const std::uint8_t byte = static_cast<std::uint8_t>(c);
+  bool inside = false;
+  for (const auto& range : node.ranges) {
+    if (byte >= range.first && byte <= range.second) {
+      inside = true;
+      break;
+    }
+  }
+  return node.negated ? !inside : inside;
+}
+
+bool MatchNodeOnce(const std::vector<RegexNode>& nodes,
+                   std::size_t index,
+                   std::string_view text,
+                   std::size_t pos,
+                   const Continuation& next) {
+  const RegexNode& node = nodes[index];
+  switch (node.kind) {
+    case RegexNode::Kind::kLiteral:
+      return pos < text.size() &&
+             text[pos] == static_cast<char>(node.literal) && next(pos + 1);
+    case RegexNode::Kind::kAny:
+      return pos < text.size() && next(pos + 1);
+    case RegexNode::Kind::kClass:
+      return pos < text.size() && ClassMatches(node, text[pos]) &&
+             next(pos + 1);
+    case RegexNode::Kind::kAnchorStart:
+      return pos == 0 && next(pos);
+    case RegexNode::Kind::kAnchorEnd:
+      return pos == text.size() && next(pos);
+    case RegexNode::Kind::kConcat:
+      return MatchSeq(nodes, node.children, 0, text, pos, next);
+    case RegexNode::Kind::kAlternate:
+      for (const std::size_t alternative : node.children) {
+        if (MatchNodeOnce(nodes, alternative, text, pos, next)) {
+          return true;
+        }
+      }
+      return false;
+    case RegexNode::Kind::kRepeat:
+      return MatchRepeat(nodes, node, 0, text, pos, next);
+  }
+  return false;
+}
+
+// ---------------------------------------------------------------------------
+// The targeting
+// ---------------------------------------------------------------------------
+
+// The pattern that selects the URLs of a target.
+//
+// The regular expression wins when both forms are given.
+const std::string& EffectivePattern(const FpTarget& target) {
+  return target.url_regex.empty() ? target.url_glob : target.url_regex;
+}
+
+// True when the target speaks for the URL.
+bool PatternMatches(const FpTarget& target, std::string_view url) {
+  if (!target.url_regex.empty()) {
+    return MatchUrlRegex(target.url_regex, url);
+  }
+  if (!target.url_glob.empty()) {
+    return MatchGlob(target.url_glob, url);
+  }
+  // The dimension default: it speaks for every URL of its dimension.
+  return true;
+}
+
+}  // namespace
+
+bool MatchUrlRegex(std::string_view pattern, std::string_view url) {
+  std::vector<RegexNode> nodes;
+  std::size_t root = 0;
+  RegexParser parser(pattern);
+  if (!parser.Parse(&nodes, &root)) {
+    // A pattern that cannot be read never matches. It disables its
+    // target, and it never aborts the renderer.
+    return false;
+  }
+  return MatchNodeOnce(nodes, root, url, 0,
+                       [&](std::size_t pos) { return pos == url.size(); });
+}
+
+const FpTarget* SelectFpTarget(const FpTargetTable& table,
+                                std::string_view url,
+                                FpDimension dimension) {
+  const FpTarget* best = nullptr;
+  std::size_t best_length = 0;
+  for (const FpTarget& target : table.targets) {
+    if (target.dimension != dimension) {
+      continue;
+    }
+    if (!PatternMatches(target, url)) {
+      continue;
+    }
+    // The longest pattern is the most specific one. A tie keeps the
+    // earlier entry, so the table's order decides it and the answer does
+    // not depend on how the table was built.
+    const std::size_t length = EffectivePattern(target).size();
+    if (best == nullptr || length > best_length) {
+      best = &target;
+      best_length = length;
+    }
+  }
+  return best;
+}
+
+FpTargetDecision DecideForUrl(const FpTargetTable& table,
+                               std::string_view url,
+                               FpDimension dimension) {
+  FpTargetDecision decision;
+  const FpTarget* target = SelectFpTarget(table, url, dimension);
+  if (target == nullptr) {
+    return decision;
+  }
+  decision.target = target;
+  decision.apply = true;
+  decision.skip = target->skip;
+  return decision;
+}
+
+}  // namespace lengsuo::fp
diff --git a/lengsuo/native/fp_target_match.h b/lengsuo/native/fp_target_match.h
new file mode 100644
index 0000000..ed92174
--- /dev/null
+++ b/lengsuo/native/fp_target_match.h
@@ -0,0 +1,70 @@
+// fp_target_match - the URL targeting (task T3).
+//
+// Two rules shape this file.
+//
+// The most specific target wins. Several entries of a dimension may match
+// one URL; the longest url_regex is the most specific one, and a target
+// with an empty pattern is the default of its dimension and loses against
+// every pattern that names a URL.
+//
+// The matcher is ours, not the standard library's. A fingerprint product
+// needs the same pattern to select the same URL on every machine, and the
+// standard library does not promise that across implementations. So the
+// regular expression is a small subset with pinned semantics, and the glob
+// form is the one the profile layer already has - the same helper, not a
+// second one.
+//
+// The subset is:
+//
+//   .        one byte
+//   *  +  ?  repetition of the previous element
+//   |        alternation
+//   ( )      grouping
+//   [ ]      a character class, with ranges and a leading ^ for negation
+//   ^  $     the start and the end of the text
+//   \d \D \w \W \s \S  character sets
+//   \x        the byte x
+//
+// The whole text must match, exactly like the glob form. A pattern that
+// cannot be parsed never matches; it disables its target and is never
+// fatal.
+#ifndef LENGSUO_NATIVE_FP_TARGET_MATCH_H_
+#define LENGSUO_NATIVE_FP_TARGET_MATCH_H_
+
+#include <string_view>
+
+#include "fp_target.h"
+
+namespace lengsuo::fp {
+
+// The decision for one URL and one dimension.
+struct FpTargetDecision {
+  // The target that applies, or nullptr when none does.
+  const FpTarget* target = nullptr;
+  // True when a target applies. False means the caller keeps the existing
+  // behaviour.
+  bool apply = false;
+  // True when the target that applies says this URL must not be perturbed
+  // at all. It is only meaningful when `apply` is true.
+  bool skip = false;
+};
+
+// Matches a URL against one regular expression of the subset above.
+bool MatchUrlRegex(std::string_view pattern, std::string_view url);
+
+// Picks the target that applies to `url` in `dimension`.
+//
+// Returns nullptr when no target applies: the caller then keeps the
+// existing behaviour.
+const FpTarget* SelectFpTarget(const FpTargetTable& table,
+                                std::string_view url,
+                                FpDimension dimension);
+
+// The decision for one URL and one dimension.
+FpTargetDecision DecideForUrl(const FpTargetTable& table,
+                               std::string_view url,
+                               FpDimension dimension);
+
+}  // namespace lengsuo::fp
+
+#endif  // LENGSUO_NATIVE_FP_TARGET_MATCH_H_
diff --git a/lengsuo/native/fp_target_test.cc b/lengsuo/native/fp_target_test.cc
new file mode 100644
index 0000000..536b46f
--- /dev/null
+++ b/lengsuo/native/fp_target_test.cc
@@ -0,0 +1,313 @@
+// fp_target_test - the target-value table and URL targeting (task T3).
+//
+// The brief's rulings each get a test of their own:
+//
+//   * an entry without target_hash drops out and is counted: the browser
+//     keeps the existing behaviour and never crashes;
+//   * several matching entries: the longest url_regex wins;
+//   * no match in a dimension: no target, which is the existing behaviour;
+//   * a target with skip:true matches but turns perturbation off.
+//
+// The allowed values are fixtures of this test file. Production code holds no
+// target hash at all: everything comes from the ConfigBundle (contract 3).
+#include "fp_target.h"
+
+#include <gtest/gtest.h>
+
+#include <string>
+
+#include "fp_target_match.h"
+
+namespace lengsuo::fp {
+namespace {
+
+// A bundle whose fp_target section carries `entries` verbatim.
+std::string Bundle(const std::string& section_body) {
+  return R"({"fp_target":{)" + section_body + "}}";
+}
+
+std::string TwoTargets() {
+  return Bundle(
+      R"("similarity":8,"targets":[)"
+      R"({"dimension":"canvas","url_regex":"^https://a\\.example/.*",)"
+      R"("target_hash":"0011223344556677","width":300,"length":300,)"
+      R"("drew_text":true},)"
+      R"({"dimension":"webgl","url_regex":"","target_hash":"8899aabbccddeeff",)"
+      R"("width":64,"length":64}])");
+}
+
+// ---------------------------------------------------------------------------
+// Parsing
+// ---------------------------------------------------------------------------
+
+TEST(FpTargetParse, ReadsEveryField) {
+  FpTargetTable table;
+  std::string error;
+  ASSERT_TRUE(ParseFpTargetConfig(TwoTargets(), &table, &error)) << error;
+  ASSERT_EQ(table.targets.size(), 2u);
+
+  const FpTarget& canvas = table.targets[0];
+  EXPECT_EQ(canvas.dimension, FpDimension::kCanvas);
+  EXPECT_EQ(canvas.url_regex, "^https://a\\.example/.*");
+  EXPECT_EQ(canvas.target_hash, "0011223344556677");
+  EXPECT_EQ(canvas.width, 300u);
+  EXPECT_EQ(canvas.length, 300u);
+  EXPECT_TRUE(canvas.has_drew_text);
+  EXPECT_TRUE(canvas.drew_text);
+  EXPECT_FALSE(canvas.skip);
+
+  const FpTarget& webgl = table.targets[1];
+  EXPECT_EQ(webgl.dimension, FpDimension::kWebgl);
+  EXPECT_TRUE(webgl.url_regex.empty());
+  EXPECT_FALSE(webgl.has_drew_text);
+  EXPECT_FALSE(webgl.drew_text);
+
+  ASSERT_TRUE(table.similarity.has_value());
+  EXPECT_EQ(*table.similarity, 8u);
+}
+
+TEST(FpTargetParse, SimilarityAbsentIsNoThreshold) {
+  // Contract 3: thresholds come from the configuration. No configured
+  // threshold means "cannot judge", never a constant baked into the code.
+  FpTargetTable table;
+  std::string error;
+  ASSERT_TRUE(ParseFpTargetConfig(
+      Bundle(R"("targets":[])"), &table, &error)) << error;
+  EXPECT_FALSE(table.similarity.has_value());
+  EXPECT_TRUE(table.targets.empty());
+}
+
+TEST(FpTargetParse, MissingTargetHashDropsTheEntry) {
+  // The brief: a target value with no target_hash falls back to the existing
+  // behaviour and must not crash.
+  FpTargetTable table;
+  std::string error;
+  ASSERT_TRUE(ParseFpTargetConfig(
+      Bundle(R"("targets":[{"dimension":"canvas","url_regex":"a",)"
+             R"("width":10,"length":10}])"),
+      &table, &error))
+      << error;
+  EXPECT_TRUE(table.targets.empty());
+  EXPECT_EQ(table.skipped_missing_hash, 1u);
+  EXPECT_EQ(table.skipped_invalid, 0u);
+}
+
+TEST(FpTargetParse, UnknownDimensionDropsTheEntry) {
+  FpTargetTable table;
+  std::string error;
+  ASSERT_TRUE(ParseFpTargetConfig(
+      Bundle(R"("targets":[{"dimension":"audio","target_hash":"ff",)"
+             R"("width":10,"length":10}])"),
+      &table, &error))
+      << error;
+  EXPECT_TRUE(table.targets.empty());
+  EXPECT_EQ(table.skipped_invalid, 1u);
+}
+
+TEST(FpTargetParse, NonSquareGeometryDropsTheEntry) {
+  FpTargetTable table;
+  std::string error;
+  ASSERT_TRUE(ParseFpTargetConfig(
+      Bundle(R"("targets":[{"dimension":"canvas","target_hash":"ff",)"
+             R"("width":300,"length":150}])"),
+      &table, &error))
+      << error;
+  EXPECT_TRUE(table.targets.empty());
+  EXPECT_EQ(table.skipped_invalid, 1u);
+}
+
+TEST(FpTargetParse, MalformedEntryDoesNotPoisonTheTable) {
+  FpTargetTable table;
+  std::string error;
+  ASSERT_TRUE(ParseFpTargetConfig(
+      Bundle(R"("targets":[{"dimension":"canvas"},)"
+             R"({"dimension":"canvas","target_hash":"aa","width":8,)"
+             R"("length":8}])"),
+      &table, &error))
+      << error;
+  ASSERT_EQ(table.targets.size(), 1u);
+  EXPECT_EQ(table.targets[0].target_hash, "aa");
+  EXPECT_EQ(table.skipped_invalid, 1u);
+}
+
+TEST(FpTargetParse, AbsentSectionIsNotAnError) {
+  // A bundle with no fp_target section means "no targeting": the existing
+  // behaviour. It is not a malformed configuration.
+  FpTargetTable table;
+  std::string error;
+  ASSERT_TRUE(ParseFpTargetConfig(R"({"profile_sync":{}})", &table, &error))
+      << error;
+  EXPECT_TRUE(table.targets.empty());
+  EXPECT_FALSE(table.similarity.has_value());
+}
+
+TEST(FpTargetParse, MalformedJsonFails) {
+  FpTargetTable table;
+  std::string error;
+  EXPECT_FALSE(ParseFpTargetConfig(R"({"fp_target":)", &table, &error));
+  EXPECT_FALSE(error.empty());
+}
+
+TEST(FpTargetParse, TargetsMustBeAnArray) {
+  FpTargetTable table;
+  std::string error;
+  EXPECT_FALSE(ParseFpTargetConfig(
+      Bundle(R"("targets":{"dimension":"canvas"})"), &table, &error));
+  EXPECT_FALSE(error.empty());
+}
+
+// ---------------------------------------------------------------------------
+// Targeting
+// ---------------------------------------------------------------------------
+
+TEST(FpTargetMatch, LongestPatternWins) {
+  // The brief: several matches resolve to the most specific one, and longer
+  // url_regex means more specific. All three entries below speak for the
+  // same URL, so the answer can only come from the length.
+  FpTargetTable table;
+  std::string error;
+  ASSERT_TRUE(ParseFpTargetConfig(
+      Bundle(R"("targets":[)"
+             R"({"dimension":"canvas","url_regex":"^https://a\\.example/x",)"
+             R"("target_hash":"11","width":8,"length":8},)"
+             R"({"dimension":"canvas","url_regex":"^https://a\\.example/.*",)"
+             R"("target_hash":"22","width":8,"length":8},)"
+             R"({"dimension":"canvas","url_regex":"",)"
+             R"("target_hash":"33","width":8,"length":8}])"),
+      &table, &error))
+      << error;
+
+  const FpTarget* picked =
+      SelectFpTarget(table, "https://a.example/x", FpDimension::kCanvas);
+  ASSERT_NE(picked, nullptr);
+  // "^https://a\.example/.*" is the longest of the three.
+  EXPECT_EQ(picked->target_hash, "22");
+}
+
+TEST(FpTargetMatch, DimensionFiltersCandidates) {
+  FpTargetTable table;
+  std::string error;
+  ASSERT_TRUE(ParseFpTargetConfig(TwoTargets(), &table, &error)) << error;
+
+  // The webgl entry has an empty pattern (the dimension default), so it is
+  // the only candidate for a webgl URL.
+  const FpTarget* webgl =
+      SelectFpTarget(table, "https://b.example/", FpDimension::kWebgl);
+  ASSERT_NE(webgl, nullptr);
+  EXPECT_EQ(webgl->dimension, FpDimension::kWebgl);
+
+  // The canvas URL that matches nothing returns nothing: existing behaviour.
+  EXPECT_EQ(SelectFpTarget(table, "https://b.example/", FpDimension::kCanvas),
+            nullptr);
+}
+
+TEST(FpTargetMatch, EmptyPatternIsTheDimensionDefault) {
+  FpTargetTable table;
+  std::string error;
+  ASSERT_TRUE(ParseFpTargetConfig(TwoTargets(), &table, &error)) << error;
+
+  const FpTarget* picked =
+      SelectFpTarget(table, "https://anything.example/", FpDimension::kWebgl);
+  ASSERT_NE(picked, nullptr);
+  EXPECT_TRUE(picked->url_regex.empty());
+}
+
+TEST(FpTargetMatch, SpecificPatternBeatsTheDefault) {
+  FpTargetTable table;
+  std::string error;
+  ASSERT_TRUE(ParseFpTargetConfig(
+      Bundle(R"("targets":[)"
+             R"({"dimension":"canvas","url_regex":"","target_hash":"aa",)"
+             R"("width":8,"length":8},)"
+             R"({"dimension":"canvas","url_regex":"^https://x\\.example/",)"
+             R"("target_hash":"bb","width":8,"length":8}])"),
+      &table, &error))
+      << error;
+
+  const FpTarget* picked =
+      SelectFpTarget(table, "https://x.example/", FpDimension::kCanvas);
+  ASSERT_NE(picked, nullptr);
+  EXPECT_EQ(picked->target_hash, "bb");
+}
+
+TEST(FpTargetMatch, NoTargetFallsBackToExistingBehaviour) {
+  FpTargetTable table;  // empty: no fp_target section in the bundle
+  const FpTargetDecision decision =
+      DecideForUrl(table, "https://a.example/", FpDimension::kCanvas);
+  EXPECT_FALSE(decision.apply);
+  EXPECT_EQ(decision.target, nullptr);
+}
+
+TEST(FpTargetMatch, SkipTargetAppliesButPerturbsNothing) {
+  FpTargetTable table;
+  std::string error;
+  ASSERT_TRUE(ParseFpTargetConfig(
+      Bundle(R"("targets":[{"dimension":"canvas",)"
+             R"("url_regex":"^https://s\\.example/",)"
+             R"("target_hash":"aa","width":8,"length":8,"skip":true}])"),
+      &table, &error))
+      << error;
+
+  const FpTargetDecision decision =
+      DecideForUrl(table, "https://s.example/", FpDimension::kCanvas);
+  EXPECT_TRUE(decision.apply);
+  EXPECT_TRUE(decision.skip);
+  ASSERT_NE(decision.target, nullptr);
+}
+
+// ---------------------------------------------------------------------------
+// The url_regex subset
+// ---------------------------------------------------------------------------
+
+TEST(FpUrlRegex, MatchesLiteralsAndAnchors) {
+  EXPECT_TRUE(MatchUrlRegex("^https://a.example/", "https://a.example/"));
+  EXPECT_FALSE(MatchUrlRegex("^https://a.example/", "https://b.example/"));
+}
+
+TEST(FpUrlRegex, DotMatchesOneByte) {
+  EXPECT_TRUE(MatchUrlRegex("a.c", "abc"));
+  EXPECT_FALSE(MatchUrlRegex("a.c", "ac"));
+  // A dot inside a class is a literal dot.
+  EXPECT_TRUE(MatchUrlRegex("a[.]c", "a.c"));
+  EXPECT_FALSE(MatchUrlRegex("a[.]c", "abc"));
+}
+
+TEST(FpUrlRegex, Quantifiers) {
+  EXPECT_TRUE(MatchUrlRegex("ab*c", "ac"));
+  EXPECT_TRUE(MatchUrlRegex("ab*c", "abbbc"));
+  EXPECT_TRUE(MatchUrlRegex("ab+c", "abc"));
+  EXPECT_FALSE(MatchUrlRegex("ab+c", "ac"));
+  EXPECT_TRUE(MatchUrlRegex("ab?c", "ac"));
+  EXPECT_TRUE(MatchUrlRegex("ab?c", "abc"));
+  EXPECT_FALSE(MatchUrlRegex("ab?c", "abbc"));
+}
+
+TEST(FpUrlRegex, ClassesAndEscapes) {
+  EXPECT_TRUE(MatchUrlRegex("[a-c]+", "abc"));
+  EXPECT_FALSE(MatchUrlRegex("[a-c]+", "abd"));
+  EXPECT_TRUE(MatchUrlRegex("[^a-c]+", "xyz"));
+  EXPECT_FALSE(MatchUrlRegex("[^a-c]+", "xay"));
+  EXPECT_TRUE(MatchUrlRegex(R"(https://\w+\.example/)", "https://host.example/"));
+  EXPECT_TRUE(MatchUrlRegex(R"(\d+)", "12"));
+  // The subset has no repetition counts, so a brace is a literal byte.
+  EXPECT_TRUE(MatchUrlRegex(R"(\d{2})", "1{2}"));
+  EXPECT_FALSE(MatchUrlRegex(R"(\d{2})", "12"));
+}
+
+TEST(FpUrlRegex, FullMatchOnly) {
+  // Consistent with MatchGlob: the whole text must match.
+  EXPECT_FALSE(MatchUrlRegex("abc", "xabc"));
+  EXPECT_FALSE(MatchUrlRegex("abc", "abcx"));
+  EXPECT_TRUE(MatchUrlRegex("abc", "abc"));
+  EXPECT_TRUE(MatchUrlRegex("^abc$", "abc"));
+}
+
+TEST(FpUrlRegex, MalformedPatternNeverMatches) {
+  // A pattern that cannot be parsed disables the target, which is the
+  // specified fallback - it never aborts the renderer.
+  EXPECT_FALSE(MatchUrlRegex("[a-", "a"));
+  EXPECT_FALSE(MatchUrlRegex(R"(\)", "x"));
+}
+
+}  // namespace
+}  // namespace lengsuo::fp

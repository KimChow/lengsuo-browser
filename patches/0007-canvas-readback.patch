+  // Lengsuo: apply profile canvas noise to the readback buffer. No-op
+  // unless the browser passed --lengsuo-managed-canvas. alpha=0 pixels
+  // are preserved; per-channel |delta| <= 13.
+  if (image_data && sw > 0 && sh > 0) {
+    SkPixmap lengsuo_noise_pixmap = image_data->GetSkPixmap();
+    // ImageData is always RGBA8888 by spec; this Linux build's kN32 is BGRA,
+    // so comparing against kN32 wrongly skips the noise on every readback.
+    if (lengsuo_noise_pixmap.addr() &&
+        lengsuo_noise_pixmap.info().colorType() == kRGBA_8888_SkColorType) {
+      lengsuo::ApplyProfileCanvasNoise(
+          const_cast<void*>(lengsuo_noise_pixmap.addr()),
+          static_cast<uint32_t>(sw), static_cast<uint32_t>(sh),
+          static_cast<uint64_t>(lengsuo_noise_pixmap.rowBytes()));
+    }
+  }
   return image_data;

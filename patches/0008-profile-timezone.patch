 // static
 void TimeZoneController::Init() {
+  const auto managed_timezone =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+          "lengsuo-managed-timezone");
+  if (!managed_timezone.empty()) {
+    // Retain the override for the renderer lifetime, including host updates.
+    DEFINE_STATIC_LOCAL(std::unique_ptr<TimeZoneOverride>, managed_override, ());
+    if (!managed_override) {
+      auto result = SetTimeZoneOverride(String::FromUtf8(managed_timezone));
+      CHECK(result.status == TimeZoneOverrideStatus::kSuccess);
+      managed_override = std::move(result.handle);
+    }
+  }
   if (base::CommandLine::ForCurrentProcess()->HasSwitch(
           blink::switches::kTopChromeWebUI) &&
       base::FeatureList::IsEnabled(features::kWebUIBypassMojoConnections)) {

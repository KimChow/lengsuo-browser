+namespace {
+
+// Resolves a declared-but-absent family onto a real installed family.
+//
+// The candidate pool is the CSS generic families, which the platform font
+// manager resolves through its fontconfig aliases without enumerating the
+// installed set. That matters: on Linux the renderer's SkFontConfigInterface is
+// a mojo FontLoader whose countFamilies()/getFamilyName() are
+// SK_ABORT("Not implemented."), so any enumeration of the host's families
+// aborts the process (the same defect Blink hits for an unknown family name).
+// Naming three generic families avoids that path while still handing each
+// declared family a real, measurable typeface.
+//
+// The choice is a pure function of the declared name (native/font_substitution.h),
+// so two renderer processes handed one profile agree. Returns null when no
+// substitution applies -- no set installed, the family is not declared, or the
+// generics do not resolve -- in which case the caller keeps the native
+// "unresolved" result.
+sk_sp<SkTypeface> LengsuoSubstitutedTypeface(
+    const AtomicString& family,
+    const FontDescription& font_description) {
+  SkFontMgr* const font_manager = skia::DefaultFontMgr().get();
+  if (!font_manager) {
+    return nullptr;
+  }
+  static constexpr std::string_view kGenericCandidates[] = {
+      "serif", "sans-serif", "monospace"};
+  const std::string substitute = lengsuo::fp::FontSubstituteFor(
+      family.Utf8(), std::span<const std::string_view>(kGenericCandidates));
+  if (substitute.empty()) {
+    return nullptr;
+  }
+  return font_manager->matchFamilyStyle(substitute.c_str(),
+                                        font_description.SkiaFontStyle());
+}
+
+}  // namespace
+
 sk_sp<SkTypeface> FontCache::CreateTypeface(
     const FontDescription& font_description,
     const FontFaceCreationParams& creation_params,
@@ -306,6 +347,14 @@ sk_sp<SkTypeface> FontCache::CreateTypeface(
 #endif  // BUILDFLAG(IS_ANDROID)
   sk_sp<SkTypeface> typeface = MatchFamilyStyle(
       name.empty() ? nullptr : name.c_str(), font_description.SkiaFontStyle());
+  // Lengsuo gamma2: a family the profile declares is made to resolve to a real
+  // installed family when the host lacks it, instead of falling through to the
+  // default fallback. Additive only -- a family the host resolves is never
+  // touched -- and reusing the host's own glyphs, so measurement and rendering
+  // stay consistent (docs/font-dimension.md). No set installed => no-op.
+  if (!typeface) {
+    typeface = LengsuoSubstitutedTypeface(family, font_description);
+  }
   return typeface;
 }


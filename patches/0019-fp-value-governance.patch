+// Lengsuo: the page URL a fingerprint target value is selected by. Empty when
+// this card's targets are not configured - then no URL string is built at all -
+// and empty when the context has no document, which keeps the profile-derived
+// value.
+std::string LengsuoFpTargetUrl(ExecutionContext* execution_context) {
+  if (execution_context == nullptr ||
+      !lengsuo::fp::HasFpTargets(lengsuo::fp::FpDimension::kWebgl)) {
+    return std::string();
+  }
+  return execution_context->Url().GetString().Utf8();
+}
